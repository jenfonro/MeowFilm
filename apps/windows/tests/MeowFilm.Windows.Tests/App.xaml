<Application
    x:Class="MeowFilm.Windows.Tests.TestApplication"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeowFilm.Capabilities">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="LyricTestWord">
                <local:MusicLyricWordView Word="{Binding}" FontSize="20" FontWeight="Normal" Foreground="Gray" Highlight="White" />
            </DataTemplate>
            <DataTemplate x:Key="LyricTestLine">
                <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><local:MusicWrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:MusicLyricWordView Word="{Binding}" FontSize="20" FontWeight="Normal" Foreground="Gray" Highlight="White" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
