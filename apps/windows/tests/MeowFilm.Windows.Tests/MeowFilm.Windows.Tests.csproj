<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>../../app/app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>../../src/MeowFilm.Desktop/Assets/Meowfilm.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../app/AppSystemMediaAttachment.cs" Link="App/AppSystemMediaAttachment.cs" />
    <Compile Include="../../app/AppPlaybackCoordinator.cs" Link="App/AppPlaybackCoordinator.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../../packages/novel-rules/test/fixtures.json" LogicalName="NovelFixtures.json" />
    <ProjectReference Include="../../src/MeowFilm.Core/MeowFilm.Core.csproj" />
    <ProjectReference Include="../../src/MeowFilm.Audio/MeowFilm.Audio.csproj" />
    <ProjectReference Include="../../src/MeowFilm.Platform/MeowFilm.Platform.csproj" />
    <ProjectReference Include="../../src/MeowFilm.Capabilities/MeowFilm.Capabilities.csproj" />
    <ProjectReference Include="../../src/MeowFilm.AppHost/MeowFilm.AppHost.csproj" />
    <ProjectReference Include="../../src/MeowFilm.SystemMedia/MeowFilm.SystemMedia.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[1.8.260921001]" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>
</Project>
