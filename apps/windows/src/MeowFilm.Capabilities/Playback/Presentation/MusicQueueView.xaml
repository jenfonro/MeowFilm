<UserControl x:Class="MeowFilm.Capabilities.MusicQueueView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 xmlns:art="clr-namespace:MeowFilm.Desktop.Artwork;assembly=MeowFilm.Desktop"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="14"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <Style x:Key="Queue.Text" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
    <Style.Triggers>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></Trigger>
     <MultiDataTrigger><MultiDataTrigger.Conditions>
      <Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=(desktop:DesktopTheme.IsHighContrast)}" Value="True"/>
      <Condition Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
     </MultiDataTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></MultiDataTrigger>
     <MultiDataTrigger><MultiDataTrigger.Conditions>
      <Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=(desktop:DesktopTheme.IsHighContrast)}" Value="True"/>
      <Condition Binding="{Binding IsKeyboardFocusWithin,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
     </MultiDataTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></MultiDataTrigger>
    </Style.Triggers>
   </Style>
   <Style TargetType="TextBlock" BasedOn="{StaticResource Queue.Text}">
    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="20,18,8,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <desktop:NoticeOutlet Message="{Binding QueueSurfaceStatus}"/>
  <Grid Margin="0,0,12,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="播放列表" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding QueueSurfaceCountText}" FontSize="12" Style="{StaticResource Queue.Text}"
               Margin="5,2,0,0" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="收藏全部" Click="FavoriteAll_Click" IsEnabled="{Binding CanClearQueueSurface}"
            Style="{StaticResource MeowFilm.IconButton}" Padding="6,4" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
            FontSize="12" AutomationProperties.Name="收藏全部"/>
    <Button Content="清空" Click="Clear_Click" IsEnabled="{Binding CanClearQueueSurface}"
            Style="{StaticResource MeowFilm.IconButton}" Padding="6,4" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
            FontSize="12" AutomationProperties.Name="清空播放列表"/>
   </StackPanel>
  </Grid>
  <ListBox x:Name="QueueList" Grid.Row="1" ItemsSource="{Binding QueueSurfaceRows}" Background="Transparent"
           BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
           PreviewMouseWheel="QueueList_MouseWheel" PreviewKeyDown="QueueList_KeyDown"
           ScrollViewer.ScrollChanged="QueueList_ScrollChanged"
           VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
           VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="播放列表">
   <ListBox.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource Capability.OverlayScrollViewer}"/></ListBox.Resources>
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,8,2"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="RowSurface" Background="{TemplateBinding Background}" CornerRadius="6">
      <ContentPresenter/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource MeowFilm.Brush.ItemHover}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource MeowFilm.Brush.ItemHover}"/></Trigger>
      <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsKeyboardFocusWithin" Value="True"/></MultiTrigger.Conditions><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></MultiTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate>
    <Grid x:Name="QueueRow" Height="58" Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
     <Button Tag="{Binding}" Click="Play_Click" Grid.ColumnSpan="3" Background="Transparent" BorderThickness="0"
             Padding="0" Margin="0" HorizontalContentAlignment="Stretch" FocusVisualStyle="{DynamicResource MeowFilm.FocusVisual}" AutomationProperties.Name="{Binding Title}">
      <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></ControlTemplate></Button.Template>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
       <Grid Width="42" Height="42" HorizontalAlignment="Left" local:CardClip.Radius="4">
        <art:ArtworkImage Address="{Binding Cover}"/>
        <Border Background="#60000000">
         <Path Data="M0,0 L0,18 L14,9 Z" Fill="White" Width="14" Height="18"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsMouseOver,ElementName=QueueRow}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
           <DataTrigger Binding="{Binding IsKeyboardFocusWithin,ElementName=QueueRow}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
          </Style.Triggers>
         </Style></Border.Style>
        </Border>
       </Grid>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Queue.Text}">
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
           <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="False"><Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/></Trigger>
           <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsCurrent}" Value="True"/><Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=(desktop:DesktopTheme.IsHighContrast)}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Accent}"/></MultiDataTrigger>
          </Style.Triggers>
         </Style></TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding Artist}" TextTrimming="CharacterEllipsis" FontSize="12"
                   Style="{StaticResource Queue.Text}" Margin="0,3,0,0"/>
       </StackPanel>
       <TextBlock Grid.Column="2" Text="{Binding Duration}" VerticalAlignment="Center" HorizontalAlignment="Right"
                  FontSize="12" Style="{StaticResource Queue.Text}"/>
      </Grid>
     </Button>
     <Button Grid.Column="3" Tag="{Binding}" Click="Remove_Click" Content="&#xE711;"
             Width="28" Height="28" Margin="0" Background="Transparent" BorderThickness="0"
             VerticalAlignment="Center" AutomationProperties.Name="从播放列表移除">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MeowFilm.IconButton}">
       <Setter Property="Opacity" Value="0"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver,ElementName=QueueRow}" Value="True"><Setter Property="Opacity" Value=".8"/></DataTrigger>
        <DataTrigger Binding="{Binding IsKeyboardFocusWithin,ElementName=QueueRow}" Value="True"><Setter Property="Opacity" Value=".8"/></DataTrigger>
        <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter Property="Opacity" Value="1"/></Trigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=(desktop:DesktopTheme.IsHighContrast)}" Value="True"/><Condition Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></MultiDataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=(desktop:DesktopTheme.IsHighContrast)}" Value="True"/><Condition Binding="{Binding IsKeyboardFocusWithin,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></MultiDataTrigger>
       </Style.Triggers>
      </Style></Button.Style>
     </Button>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </Grid>
</UserControl>
