<UserControl x:Class="MeowFilm.Capabilities.MusicPlayerDetailView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto"
 PreviewKeyDown="Detail_PreviewKeyDown" PreviewKeyUp="Detail_PreviewKeyUp"
 LostKeyboardFocus="Detail_LostKeyboardFocus">
 <UserControl.Style>
  <Style TargetType="UserControl">
   <!-- The page's only backdrop; detail content and footer stay transparent over it. -->
   <Setter Property="Background" Value="{Binding PlayerBackground}"/>
   <Style.Triggers>
    <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Style>
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <local:MusicLyricRowMarginConverter x:Key="Player.LyricRowMargin"/>
   <ResourceDictionary x:Key="Player.FooterPalette">
    <SolidColorBrush x:Key="Capability.Player.Foreground" Color="#C5C3C8"/>
    <SolidColorBrush x:Key="Capability.Player.Text" Color="#EBEAED"/>
    <SolidColorBrush x:Key="Capability.Player.Muted" Color="#C5C3C8"/>
    <SolidColorBrush x:Key="Capability.Player.Hover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Capability.Player.Pressed" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Capability.Player.Rail" Color="#26FFFFFF"/>
   </ResourceDictionary>
   <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="#EBEAED"/>
    <Style.Triggers>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
     </Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Player.OptionalText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,5,0,0"/>
    <Style.Triggers>
     <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Player.DetailTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="#9B969B"/><Setter Property="Padding" Value="12,6"/>
    <Setter Property="Margin" Value="0"/><Setter Property="GroupName" Value="PlayerDetail"/>
    <Setter Property="Template">
     <Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="TabSurface" Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="TabSurface" Property="Background" Value="#18FFFFFF"/>
        <Setter Property="Foreground" Value="#F3F1F4"/><Setter Property="FontWeight" Value="SemiBold"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#10FFFFFF"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value>
    </Setter>
   </Style>
   <Style x:Key="Player.LyricAdjust" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
    <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#EBEAED"/>
    <Setter Property="BorderBrush" Value="#30FFFFFF"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Setter Property="IsEnabled" Value="{Binding CanAdjustLyricOffset}"/>
    <Style.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter Property="Background" Value="#14FFFFFF"/><Setter Property="BorderBrush" Value="#60FFFFFF"/>
     </Trigger>
     <Trigger Property="IsPressed" Value="True">
      <Setter Property="Background" Value="#22FFFFFF"/><Setter Property="BorderBrush" Value="#80FFFFFF"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#E0FFFFFF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#18FFFFFF"/>
     </Trigger>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
     </Trigger>
     <MultiTrigger><MultiTrigger.Conditions>
      <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsKeyboardFocused" Value="True"/>
     </MultiTrigger.Conditions><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></MultiTrigger>
     <MultiTrigger><MultiTrigger.Conditions>
      <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsMouseOver" Value="True"/>
     </MultiTrigger.Conditions>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
     </MultiTrigger>
     <MultiTrigger><MultiTrigger.Conditions>
      <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsPressed" Value="True"/>
     </MultiTrigger.Conditions>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
     </MultiTrigger>
     <MultiTrigger><MultiTrigger.Conditions>
      <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsEnabled" Value="False"/>
     </MultiTrigger.Conditions>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
     </MultiTrigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Player.LyricTranslation" TargetType="Button" BasedOn="{StaticResource Player.LyricAdjust}">
    <Setter Property="Margin" Value="0,10,0,0"/>
    <Setter Property="IsEnabled" Value="{Binding IsLyrics}"/>
    <Setter Property="AutomationProperties.Name" Value="显示译文歌词"/>
    <Setter Property="AutomationProperties.ItemStatus" Value="已隐藏"/>
    <Setter Property="ToolTip" Value="显示译文歌词"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding ShowLyricTranslation}" Value="True">
      <Setter Property="Background" Value="#18FFFFFF"/>
      <Setter Property="BorderBrush" Value="#60FFFFFF"/>
      <Setter Property="AutomationProperties.Name" Value="隐藏译文歌词"/>
      <Setter Property="AutomationProperties.ItemStatus" Value="已显示"/>
      <Setter Property="ToolTip" Value="隐藏译文歌词"/>
     </DataTrigger>
     <MultiDataTrigger>
      <MultiDataTrigger.Conditions>
       <Condition Binding="{Binding ShowLyricTranslation}" Value="True"/>
       <Condition Binding="{Binding IsEnabled,RelativeSource={RelativeSource Self}}" Value="False"/>
      </MultiDataTrigger.Conditions>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#18FFFFFF"/>
     </MultiDataTrigger>
     <MultiDataTrigger>
      <MultiDataTrigger.Conditions>
       <Condition Binding="{Binding ShowLyricTranslation}" Value="True"/>
       <Condition Binding="{Binding (desktop:DesktopTheme.IsHighContrast),RelativeSource={RelativeSource Self}}" Value="True"/>
      </MultiDataTrigger.Conditions>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
     </MultiDataTrigger>
     <MultiDataTrigger>
      <MultiDataTrigger.Conditions>
       <Condition Binding="{Binding ShowLyricTranslation}" Value="False"/>
       <Condition Binding="{Binding (desktop:DesktopTheme.IsHighContrast),RelativeSource={RelativeSource Self}}" Value="True"/>
      </MultiDataTrigger.Conditions>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
     </MultiDataTrigger>
     <MultiTrigger>
      <MultiTrigger.Conditions>
       <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/>
       <Condition Property="IsEnabled" Value="False"/>
      </MultiTrigger.Conditions>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
     </MultiTrigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Player.LyricPreviewAction" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
    <Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="6,1"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="#C5C3C8"/><Setter Property="Background" Value="#08FFFFFF"/>
    <Setter Property="BorderBrush" Value="#30FFFFFF"/>
    <Setter Property="Template">
     <Setter.Value><ControlTemplate TargetType="Button">
      <Border CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate></Setter.Value>
    </Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid MaxWidth="1240" Margin="0,88,0,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Viewbox Margin="12,0,0,0" MaxWidth="500" MaxHeight="560" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
   <Canvas Width="520" Height="600">
    <Ellipse Canvas.Left="53" Canvas.Top="103" Width="414" Height="414" Fill="#0AFFFFFF" Stroke="#20FFFFFF" StrokeThickness="1"/>
    <local:MusicRecordView x:Name="DetailRecord" Canvas.Left="66" Canvas.Top="116" Width="388" Height="388"
     Address="{Binding CurrentArtwork}" Playing="{Binding IsPlaying}" SwipeEnabled="{Binding CanPlay}"
     TrackIdentity="{Binding CurrentTrackIdentity}" SwipeIdentity="{Binding PlaybackPresentationKey}" SwipeCommitted="DetailRecord_SwipeCommitted"
     AutomationProperties.Name="唱片切歌"/>
    <Canvas Canvas.Left="244" Canvas.Top="8" Width="220" Height="130" IsHitTestVisible="False">
     <Canvas.RenderTransform><RotateTransform x:Name="NeedleRotation" CenterX="17" CenterY="17"/></Canvas.RenderTransform>
     <Ellipse Width="34" Height="34" Fill="#20606060"/>
     <Path Data="M17,17 C38,39 77,76 99,86 C125,94 152,96 190,101" Stroke="#F4F4F5"
           StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     <Ellipse Canvas.Left="7" Canvas.Top="7" Width="20" Height="20" Fill="#EEEEF0" Stroke="#99FFFFFF" StrokeThickness="1"/>
     <Ellipse Canvas.Left="13" Canvas.Top="13" Width="8" Height="8" Fill="#B3B3B8"/>
     <Path Data="M153,92 L180,95 179,107 152,104 Z" Fill="#F8F8FA"/>
     <Border Canvas.Left="179" Canvas.Top="92" Width="18" Height="20" Background="#FDFDFE" CornerRadius="3"
             RenderTransformOrigin=".5,.5">
      <Border.RenderTransform><RotateTransform Angle="7"/></Border.RenderTransform>
      <Border Margin="4" BorderBrush="#DDDDE2" BorderThickness="0,1,0,1"/>
     </Border>
    </Canvas>
   </Canvas>
  </Viewbox>
  <Grid Grid.Column="1" Margin="28,18,20,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock x:Name="DetailTitle" Text="{Binding CurrentTitle}" FontSize="26" FontWeight="SemiBold"
               TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
    <WrapPanel Opacity=".68" Margin="0,0,0,18">
     <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
       <DataTrigger Binding="{Binding CurrentAlbum}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       <DataTrigger Binding="{Binding CurrentAlbum}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="专辑：" FontSize="14"/><TextBlock Text="{Binding CurrentAlbum}" FontSize="14" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
       <DataTrigger Binding="{Binding CurrentArtist}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       <DataTrigger Binding="{Binding CurrentArtist}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="歌手：" FontSize="14"/><TextBlock Text="{Binding CurrentArtist}" FontSize="14" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal">
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
       <DataTrigger Binding="{Binding CurrentSource}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="来源：" FontSize="14"/><TextBlock Text="{Binding CurrentSource}" FontSize="14" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </WrapPanel>
   </StackPanel>
    <Border Grid.Row="1" Margin="0,0,0,8" Background="#0DFFFFFF" CornerRadius="16" HorizontalAlignment="Left">
     <StackPanel Orientation="Horizontal">
      <RadioButton Content="歌词" Style="{StaticResource Player.DetailTab}" IsChecked="True"/>
      <RadioButton Content="相似推荐" Style="{StaticResource Player.DetailTab}" IsHitTestVisible="False"/>
      <Button Content="心动模式" Click="Heartbeat_Click" IsEnabled="{Binding CanHeartbeatCurrent}" Visibility="{Binding CanHeartbeatCurrent,Converter={StaticResource MeowFilm.BoolToVisibility}}"
              Style="{StaticResource MeowFilm.QuietButton}" FontSize="13" Padding="12,6" Margin="4,0"
              AutomationProperties.Name="从当前歌曲开始心动"/>
     </StackPanel>
    </Border>
   <Grid x:Name="LyricViewport" Grid.Row="2" Margin="-76,0,0,0">
    <!-- OpacityMask composites the lyric viewport into an intermediate surface: use grayscale here only. -->
    <Grid x:Name="LyricFadeViewport" Background="Transparent" ClipToBounds="True">
     <Grid.OpacityMask>
      <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,1">
       <GradientStop Color="Transparent" Offset="0"/><GradientStop Color="Black" Offset=".10"/>
       <GradientStop Color="Black" Offset=".90"/><GradientStop Color="Transparent" Offset="1"/>
      </LinearGradientBrush>
     </Grid.OpacityMask>
    <local:MusicLyricList Background="Transparent" BorderThickness="0" Padding="0"
     TextOptions.TextRenderingMode="Grayscale"
     Position="{Binding LyricPositionSeconds}" IsPlaying="{Binding IsPlaying}"
     PlaybackRate="{Binding AcceptedPlaybackRate}" PresentationKey="{Binding PlaybackPresentationKey}"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
     VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
     VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page"
     IsTabStop="True"
     x:Name="LyricList" ItemsSource="{Binding Lyrics}" SelectedIndex="{Binding LyricDisplayIndex,Mode=OneWay}"
     AutomationProperties.Name="歌词">
     <ListBox.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource Capability.OverlayScrollViewer}"/></ListBox.Resources>
     <ListBox.Template><ControlTemplate TargetType="ListBox">
      <ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Capability.OverlayScrollViewer}">
       <ItemsPresenter/>
      </ScrollViewer>
     </ControlTemplate></ListBox.Template>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Margin"><Setter.Value><MultiBinding Converter="{StaticResource Player.LyricRowMargin}">
       <Binding Path="DataContext" RelativeSource="{RelativeSource Self}"/>
       <Binding Path="DataContext.FirstLyric" RelativeSource="{RelativeSource AncestorType=local:MusicPlayerDetailView}"/>
       <Binding Path="DataContext.LastLyric" RelativeSource="{RelativeSource AncestorType=local:MusicPlayerDetailView}"/>
       <Binding Path="ViewportHeight" RelativeSource="{RelativeSource AncestorType=ScrollViewer}"/>
       <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="Opacity" Value=".40"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <ContentPresenter/>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter Property="Opacity" Value="1"/></Trigger>
       <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Opacity" Value="1"/></Trigger>
      </Style.Triggers>
     </Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <Border Padding="76,11,16,11" MinHeight="47">
        <StackPanel>
         <TextBlock Text="{Binding Text}" FontSize="20" TextWrapping="Wrap">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers><DataTrigger Binding="{Binding Words.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding Words}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
         </TextBlock>
         <ItemsControl ItemsSource="{Binding Words}" AutomationProperties.Name="逐字歌词">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
           <local:MusicLyricWordView Word="{Binding}" FontSize="20" Foreground="#8B898C" Highlight="#F4F3F6"/>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         <TextBlock x:Name="LyricTranslation" Text="{Binding Translation}" TextWrapping="Wrap">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Player.OptionalText}">
           <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.ShowLyricTranslation,RelativeSource={RelativeSource AncestorType=local:MusicPlayerDetailView}}" Value="False">
             <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
           </Style.Triggers>
          </Style></TextBlock.Style>
         </TextBlock>
         <TextBlock Text="{Binding Romanization}" Style="{StaticResource Player.OptionalText}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
     </DataTemplate></ListBox.ItemTemplate>
    </local:MusicLyricList>
    </Grid>
    <Border x:Name="LyricPreviewFrame" VerticalAlignment="Center" CornerRadius="12"
            Background="#12FFFFFF" BorderBrush="#48FFFFFF" BorderThickness="1" MinHeight="47"
            Visibility="{Binding HasLyricPreview,Converter={StaticResource MeowFilm.BoolToVisibility}}">
      <Button x:Name="ConfirmLyric" Click="PlayLyric_Click" HorizontalAlignment="Left" VerticalAlignment="Center"
              Style="{StaticResource Player.LyricPreviewAction}" Margin="8,0,0,0"
              IsEnabled="{Binding CanConfirmLyricPreview}" AutomationProperties.Name="播放此处">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="9" VerticalAlignment="Center"
                   Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
        <TextBlock Text="{Binding LyricPreviewTime}" Margin="4,0,0,0" VerticalAlignment="Center"
                   Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                   Typography.NumeralAlignment="Tabular"/>
       </StackPanel>
      </Button>
    </Border>
    <TextBlock x:Name="LyricState" Text="{Binding LyricStatus}" FontSize="20"
               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>

   </Grid>
   <StackPanel x:Name="LyricControlRail" Grid.Column="1" Grid.Row="2" Margin="12,16,0,0" VerticalAlignment="Top">
    <StackPanel x:Name="LyricTimingRail">
     <Button x:Name="DelayLyricButton" Click="DelayLyric_Click"
             Style="{StaticResource Player.LyricAdjust}" ToolTip="歌词延后 0.5 秒" AutomationProperties.Name="歌词延后 0.5 秒">
      <Grid Width="26" Height="26" IsHitTestVisible="False">
       <Path Data="M4,9 A9.85,9.85 0 1 1 4,17 M4,4.5 L4,9 8.5,9" StrokeThickness="1.2"
             StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
             Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
       <TextBlock Text="5" FontSize="10" Margin="0,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Grid>
     </Button>
     <Button x:Name="AdvanceLyricButton" Click="AdvanceLyric_Click"
             Style="{StaticResource Player.LyricAdjust}" ToolTip="歌词提前 0.5 秒" AutomationProperties.Name="歌词提前 0.5 秒">
      <Grid Width="26" Height="26" IsHitTestVisible="False">
       <Path Data="M22,9 A9.85,9.85 0 1 0 22,17 M22,4.5 L22,9 17.5,9" StrokeThickness="1.2"
             StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
             Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
       <TextBlock Text="5" FontSize="10" Margin="0,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Grid>
     </Button>
    </StackPanel>
    <Border Height="1" Margin="9,2,9,0" Background="#30FFFFFF" IsHitTestVisible="False"/>
    <Button x:Name="LyricTranslationButton" Click="Translation_Click"
            Style="{StaticResource Player.LyricTranslation}">
     <Viewbox Width="24" Height="24" Stretch="Uniform" IsHitTestVisible="False">
      <Path Data="M3,5 L15,5 M9,3 L9,5 M12,5 C11,11 8,14 3,16 M5,8 C6,12 9,14 12,16 M13,21 L17,10 L21,21 M14.5,17 L19.5,17"
            StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
     </Viewbox>
    </Button>
   </StackPanel>
  </Grid>
 </Grid>
  <ContentControl x:Name="DetailPlayerHost" Grid.Row="1" HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch" Focusable="False" IsTabStop="False"/>
 </Grid>
</UserControl>
