<UserControl x:Class="MeowFilm.Capabilities.MusicSourcePickerDialogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities">
 <UserControl.Resources>
  <ResourceDictionary>
   <local:MusicVisibilityConverter x:Key="Visible"/>
   <Style TargetType="Button" BasedOn="{StaticResource MeowFilm.GhostButton}">
    <Setter Property="MinWidth" Value="36"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Margin" Value="4,0"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="CornerRadius" Value="8"/>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Border x:Name="SourcePanel" Width="410" Padding="16" CornerRadius="20"
  Background="{ThemeResource MeowFilm.Brush.FloatingSurface}"
  BorderBrush="{ThemeResource MeowFilm.Brush.Border}" BorderThickness="1">
  <Grid RowSpacing="12">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Grid>
    <TextBlock Text="音源选择" FontSize="20" VerticalAlignment="Center"/>
    <Button x:Name="CloseSourcesButton" HorizontalAlignment="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons" Click="CloseSources_Click" AutomationProperties.Name="关闭音源选择"/>
   </Grid>
   <Border Grid.Row="1" Padding="10,8" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}">
    <StackPanel>
     <TextBlock Text="当前播放" FontSize="12" Margin="0,0,0,4"/>
     <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="30"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="CurrentSourceSymbol" Text="{x:Bind Playback.CurrentSourceSymbol,Mode=OneWay}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1">
       <TextBlock x:Name="CurrentSourceQuality" Text="{x:Bind Playback.CurrentSourceQuality,Mode=OneWay}"/>
       <TextBlock x:Name="CurrentSourceDescription" Text="{x:Bind Playback.CurrentSourceDescription,Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </Grid>
    </StackPanel>
   </Border>
   <ScrollViewer x:Name="SourceChoicesScroll" Grid.Row="2" MinHeight="80" MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <TextBlock x:Name="SourceEmptyState" Text="暂无已确认可切换音源" HorizontalAlignment="Center" Margin="0,18"
      Visibility="{x:Bind Playback.HasEmptySources,Mode=OneWay,Converter={StaticResource Visible}}"
      AutomationProperties.LiveSetting="Polite"/>
     <ItemsControl ItemsSource="{x:Bind Playback.SourceChoices}" IsEnabled="{x:Bind Playback.CanSwitchSource,Mode=OneWay}">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="local:MusicSourceChoice">
        <Button x:Name="SourceChoice" Tag="{x:Bind}" Click="SourceChoice_Click" Loaded="SourceChoice_Loaded"
         IsEnabled="{x:Bind Selectable}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
         Padding="12,10" Margin="0,2" AutomationProperties.Name="{x:Bind Provider}">
         <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="30"/>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind QualitySymbol}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1">
           <TextBlock Text="{x:Bind Quality}"/>
           <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"><Run Text="{x:Bind Platform}"/><Run Text=" · "/><Run Text="{x:Bind Provider}"/></TextBlock>
           <TextBlock Text="{x:Bind Recording}" FontSize="11" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{x:Bind State}" FontSize="12" VerticalAlignment="Center"/>
         </Grid>
        </Button>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="3">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Button x:Name="AutomaticSourceButton" Content="自动选择" Tag="{x:Bind Playback.AutomaticSourceChoice,Mode=OneWay}" Click="SourceChoice_Click" IsEnabled="{x:Bind Playback.CanSwitchSource,Mode=OneWay}"/>
    <TextBlock Grid.Column="1" Text="正在搜索音源…" FontSize="12" VerticalAlignment="Center" Visibility="{x:Bind Playback.IsLoadingSources,Mode=OneWay,Converter={StaticResource Visible}}"/>
    <Button x:Name="LoadMoreSourcesButton" Grid.Column="2" Content="加载更多" Click="LoadMoreSources_Click" IsEnabled="{x:Bind Playback.CanLoadMoreSources,Mode=OneWay}" AutomationProperties.Name="加载更多"/>
   </Grid>
  </Grid>
 </Border>
</UserControl>
