<UserControl x:Class="MeowFilm.Capabilities.MusicPlayerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities" xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 xmlns:art="clr-namespace:MeowFilm.Desktop.Artwork;assembly=MeowFilm.Desktop"
 x:Name="Root" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" TextOptions.TextFormattingMode="Display"
 TextOptions.TextRenderingMode="Auto">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MeowFilm.Capabilities;component/Settings/SettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="Button" BasedOn="{StaticResource MeowFilm.IconButton}"><Setter Property="Margin" Value="4,0"/><Setter Property="Foreground" Value="#777E90"/><Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Player.FmChoice" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
   <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="4"/>
   <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="8"/>
   <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
   <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Hover}"/>
   <Style.Triggers>
    <Trigger Property="AutomationProperties.ItemStatus" Value="已选中">
     <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.AccentSoft}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
    </Trigger>
    <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
     <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
    </Trigger>
    <MultiTrigger><MultiTrigger.Conditions>
     <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/>
     <Condition Property="AutomationProperties.ItemStatus" Value="已选中"/>
    </MultiTrigger.Conditions>
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
     <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
    </MultiTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Player.CurrentQualityItem" TargetType="MenuItem" BasedOn="{StaticResource MeowFilm.MenuItem}">
   <Style.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.ItemSelected}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></MultiTrigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsHighlighted" Value="True"/></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></MultiTrigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></MultiTrigger>
   </Style.Triggers>
  </Style>
 </ResourceDictionary></UserControl.Resources>
  <Grid Background="Transparent" PreviewMouseLeftButtonDown="Surface_MouseDown" MouseLeftButtonUp="Surface_MouseUp">
   <Grid.RowDefinitions><RowDefinition Height="8"/><RowDefinition Height="72"/></Grid.RowDefinitions>
   <local:SeekBar x:Name="Progress" Grid.RowSpan="2" Panel.ZIndex="2" VerticalAlignment="Top" Height="16" RailAtTop="True"
    Minimum="0" Maximum="{Binding DurationSeconds}" PlayedBrush="{Binding PlayerProgressBrush}" RailBrush="{DynamicResource Capability.Player.Rail}"
    Value="{Binding PositionSeconds,Mode=OneWay}" ChorusSeconds="{Binding ChorusPositionSeconds}"
    IsPlaying="{Binding IsPlaying}" PlaybackRate="{Binding AcceptedPlaybackRate}"
    PresentationKey="{Binding PlaybackPresentationKey}"
    IsEnabled="{Binding CanSeek}" AutomationProperties.Name="播放进度"/>
   <Grid Grid.Row="1">
    <Grid.Resources>
     <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource Capability.Player.Foreground}"/>
      <Style.Triggers>
       <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="False"/></MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Capability.Player.Hover}"/></MultiTrigger>
       <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="False"/></MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Capability.Player.Pressed}"/></MultiTrigger>
      </Style.Triggers>
     </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid x:Name="MetadataPanel" Margin="30,0,0,0" HorizontalAlignment="Left">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="ArtworkButton" Click="Lyrics_Click" Width="60" Height="60" Padding="0" Margin="0,0,12,0" BorderThickness="0" AutomationProperties.Name="打开歌曲与歌词">
      <local:MusicRecordView Width="60" Height="60" Address="{Binding CurrentArtwork}" Playing="{Binding IsPlaying}"/>

     </Button>
     <StackPanel x:Name="MetadataText" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="180"
                UseLayoutRounding="True" SnapsToDevicePixels="True">
      <StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource Capability.Text}"><Setter Property="Foreground" Value="{DynamicResource Capability.Player.Text}"/><Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></Trigger></Style.Triggers></Style></StackPanel.Resources>
      <TextBlock Text="{Binding CurrentTitle}" FontSize="14" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding CurrentArtist}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Capability.Muted}">
        <Setter Property="Foreground" Value="{DynamicResource Capability.Player.Muted}"/>
        <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
         <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
        </Trigger></Style.Triggers>
       </Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
      <Button x:Name="FavoriteButton" Grid.Column="2" Click="Favorite_Click" IsEnabled="{Binding CanPlay}"
              MinWidth="32" Height="32" Margin="0" Padding="3"
              AutomationProperties.Name="{Binding CurrentFavoriteLabel}">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
        <Setter Property="Width" Value="Auto"/><Setter Property="MinHeight" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Capability.Player.Foreground}"/>
         <Style.Triggers>
          <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></Trigger>
        </Style.Triggers>
       </Style></Button.Style>
       <Button.Template><ControlTemplate TargetType="Button">
        <Border x:Name="FavoriteSurface" Background="Transparent" CornerRadius="16" Padding="{TemplateBinding Padding}">
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
           <Path>
            <Path.Style><Style TargetType="Path" BasedOn="{StaticResource Capability.FavoriteIcon}">
            <Style.Triggers><DataTrigger Binding="{Binding IsCurrentFavorite}" Value="True">
             <Setter Property="Fill" Value="#FC3D49"/><Setter Property="Stroke" Value="#FC3D49"/>
            </DataTrigger></Style.Triggers>
           </Style></Path.Style>
          </Path>
           <TextBlock x:Name="FavoriteBadge" Text="" Width="18" Foreground="#FC3D49"
                      FontSize="9" FontWeight="SemiBold" Margin="-1,-3,0,0" VerticalAlignment="Top"/>
         </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger SourceName="FavoriteBadge" Property="Text" Value=""><Setter TargetName="FavoriteBadge" Property="Visibility" Value="Collapsed"/></Trigger>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FavoriteSurface" Property="Background" Value="{DynamicResource Capability.Player.Hover}"/></Trigger>
         <Trigger Property="IsPressed" Value="True"><Setter TargetName="FavoriteSurface" Property="Background" Value="{DynamicResource Capability.Player.Pressed}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Button.Template>
      </Button>
    </Grid>
    <StackPanel x:Name="TransportPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Button x:Name="ModeButton" Content="{Binding PlaybackModeGlyph}" Click="Mode_Click"
             IsEnabled="{Binding CanChangePlaybackMode}" ToolTip="{Binding PlaybackModeText}"
             AutomationProperties.Name="{Binding PlaybackModeText}"/>
     <local:SkipButton x:Name="PreviousButton" Next="False" Style="{StaticResource {x:Type Button}}" Click="Previous_Click" IsEnabled="{Binding CanPlay}" AutomationProperties.Name="上一首"/>
     <Button x:Name="PlayButton" Click="Play_Click" IsEnabled="{Binding CanTogglePlayback}" AutomationProperties.Name="播放或暂停" Width="40" Height="40" Margin="8,0">
      <Button.Style><Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/><Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Accent}"/><Setter Property="Foreground" Value="White"/><Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></Trigger></Style.Triggers></Style></Button.Style>
      <Button.Template><ControlTemplate TargetType="Button">
       <Grid Width="40" Height="40"><Ellipse Fill="{TemplateBinding Background}"/>
        <Path x:Name="TransportGlyph" Width="40" Height="40" Stretch="None" Fill="{TemplateBinding Foreground}" Data="M15.5,11 L29,20 L15.5,29 Z"/>
       </Grid>
       <ControlTemplate.Triggers><DataTrigger Binding="{Binding PlayGlyph}" Value="Ⅱ"><Setter TargetName="TransportGlyph" Property="Data" Value="M13,11 L17,11 17,29 13,29 Z M23,11 L27,11 27,29 23,29 Z"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Button.Template>
     </Button>
     <local:SkipButton x:Name="NextButton" Style="{StaticResource {x:Type Button}}" Click="Next_Click" IsEnabled="{Binding CanPlay}" AutomationProperties.Name="下一首"/>
     <Button Click="Queue_Click" AutomationProperties.Name="播放队列"><Path Data="M0,1 L4,3 0,5 Z M7,3 L18,3 M0,10 L18,10 M0,17 L18,17" Width="19" Height="19" StrokeThickness="1.3" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/></Button>
    </StackPanel>
    <StackPanel x:Name="OptionsPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
     <Button x:Name="QualityButton" Width="80" Click="Quality_Click" ContextMenuOpening="Quality_ContextMenuOpening" AutomationProperties.Name="{Binding CurrentQualityLabel,StringFormat='音质：{0}'}">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding HasQualityButton}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
      <Button.ContextMenu>
       <ContextMenu x:Name="QualityMenu" Style="{StaticResource MeowFilm.ContextMenu}" Placement="Top" Closed="Quality_Closed" FontSize="13"
                    FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}">
        <MenuItem x:Name="SourceListItem" Header="查看更多" Style="{StaticResource MeowFilm.MenuItem}" IsEnabled="{Binding CanSwitchSource}" Click="SourceList_Click" AutomationProperties.Name="查看更多音源"/>
        <Separator/>
       </ContextMenu>
      </Button.ContextMenu>
      <Border Width="72" CornerRadius="3" BorderThickness="1" BorderBrush="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Padding="6,2"><TextBlock TextAlignment="Center" Text="{Binding CurrentQualityLabel}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="10"/></Border>
     </Button>
     <Button x:Name="PlaylistButton" Content="&#xE710;" Click="PlaylistMenu_Click" IsEnabled="{Binding CanPlay}" AutomationProperties.Name="收藏到歌单"/>
     <Button x:Name="VolumeButton" Content="&#xE767;" Click="Volume_Click" AutomationProperties.Name="音量"/>
     <Button x:Name="MoreButton" Content="&#xE712;" Click="More_Click" AutomationProperties.Name="更多"/>
    </StackPanel>
   </Grid>
   <Popup x:Name="FmPopup" PlacementTarget="{Binding ElementName=ModeButton}" Placement="Top"
          StaysOpen="False" AllowsTransparency="True" Closed="FmPopup_Closed" PopupAnimation="None">
    <Border Style="{StaticResource Settings.PopupSurface}" Width="368" Padding="16"
            KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="FmPopup_KeyDown">
     <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   Style="{StaticResource MeowFilm.SettingsScrollViewer}">
      <StackPanel>
       <TextBlock Text="私人漫游" Style="{StaticResource Settings.PopupTitle}" Margin="4,0,4,12"/>
       <StackPanel x:Name="FmModeChoices"/>
       <TextBlock Text="场景模式" FontSize="14" FontWeight="SemiBold" Margin="4,20,4,8"/>
       <UniformGrid x:Name="FmSceneChoices" Columns="4"/>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Popup>
   <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True"><Border Style="{StaticResource MeowFilm.FloatingSurface}" Margin="8" Padding="16"><Slider x:Name="VolumeSlider" Width="130" Minimum="0" Maximum="100" Value="{Binding Volume}" PreviewMouseLeftButtonUp="VolumeCommit_MouseUp" PreviewKeyUp="VolumeCommit_KeyUp" AutomationProperties.Name="音量"/></Border></Popup>
   <Popup x:Name="PlaylistPopup" PlacementTarget="{Binding ElementName=PlaylistButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True"><Border Style="{StaticResource MeowFilm.FloatingSurface}" Margin="8" Padding="12"><ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Playlists}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Id}" Click="AddCurrent_Click" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" HorizontalContentAlignment="Left" MinWidth="180"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border></Popup>
   <Popup x:Name="SourcePopup" PlacementTarget="{Binding ElementName=Root}" desktop:DialogPlacement.Centered="True"
          StaysOpen="False" AllowsTransparency="True" Closed="SourcePopup_Closed">
    <Border x:Name="SourcePanel" Width="520" Margin="16" Padding="20" KeyboardNavigation.TabNavigation="Cycle">
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Settings.PopupSurface}">
      <Setter Property="CornerRadius" Value="20"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.FloatingSurface}"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.16"/></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
       <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
       <Setter Property="BorderThickness" Value="1"/><Setter Property="Effect" Value="{x:Null}"/>
      </Trigger></Style.Triggers>
     </Style></Border.Style>
     <Border.Resources>
      <Style x:Key="Source.Choice" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
       <Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="12,10"/>
       <Setter Property="MinHeight" Value="60"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Key}" Value="auto"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding Current}" Value="True"><Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.ItemSelected}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.ItemHover}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.ItemHover}"/></Trigger>
        <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
         <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
        </Trigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions>
         <Condition Binding="{Binding Current}" Value="True"/>
         <Condition Binding="{Binding (desktop:DesktopTheme.IsHighContrast),RelativeSource={RelativeSource Self}}" Value="True"/>
        </MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></MultiDataTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
         <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        </MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsKeyboardFocused" Value="True"/></MultiTrigger.Conditions>
         <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        </MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions>
         <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        </MultiTrigger>
       </Style.Triggers>
      </Style>
     </Border.Resources>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12">
       <Button x:Name="CloseSourcesButton" DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource Settings.PopupClose}" Click="CloseSources_Click" AutomationProperties.Name="关闭音源选择"/>
       <TextBlock Text="音源选择" Style="{StaticResource Settings.PopupTitle}" VerticalAlignment="Center"/>
      </DockPanel>
      <Border x:Name="CurrentSourcePanel" Grid.Row="1" Padding="10,8" Margin="0,0,0,8" CornerRadius="12">
       <Border.Style><Style TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.ItemSelected}"/>
        <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
         <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
         <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter Property="BorderThickness" Value="1"/>
        </Trigger></Style.Triggers>
       </Style></Border.Style>
       <StackPanel>
        <TextBlock Text="当前播放" Style="{StaticResource Settings.Subtitle}" Margin="0,0,0,4"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock x:Name="CurrentSourceSymbol" Text="{Binding CurrentSourceSymbol}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <TextBlock x:Name="CurrentSourceQuality" Text="{Binding CurrentSourceQuality}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="CurrentSourceDescription" Text="{Binding CurrentSourceDescription}" Style="{StaticResource Settings.Subtitle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </Grid>
       </StackPanel>
      </Border>
      <ScrollViewer x:Name="SourceChoicesScroll" Grid.Row="2" MinHeight="80" MaxHeight="300" Style="{StaticResource MeowFilm.SettingsScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel>
        <TextBlock x:Name="SourceEmptyState" Text="暂无已确认可切换音源" HorizontalAlignment="Center" Margin="0,18" AutomationProperties.LiveSetting="Polite">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Settings.Subtitle}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
           <Condition Binding="{Binding HasConfirmedSourceChoices}" Value="False"/><Condition Binding="{Binding IsLoadingSources}" Value="False"/>
          </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
         </Style></TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding SourceChoices}" IsEnabled="{Binding CanSwitchSource}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Tag="{Binding}" Click="SourceChoice_Click" IsEnabled="{Binding Selectable}" HorizontalContentAlignment="Stretch"
                 Style="{StaticResource Source.Choice}" AutomationProperties.Name="{Binding Provider}">
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding QualitySymbol}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
             <TextBlock Text="{Binding Quality}" FontWeight="SemiBold" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
             <TextBlock Margin="0,3,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"><Run Text="{Binding Platform,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Provider,Mode=OneWay}"/></TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="2" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}">
             <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding State}"/><Style.Triggers><DataTrigger Binding="{Binding Current}" Value="True"><Setter Property="Text" Value="当前"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
           </Grid>
         </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </ScrollViewer>
      <DockPanel Grid.Row="3" Margin="0,12,0,0">
       <Button x:Name="LoadMoreSourcesButton" DockPanel.Dock="Right" Content="加载更多" Click="LoadMoreSources_Click"
               Style="{StaticResource Settings.Button}" IsEnabled="{Binding CanLoadMoreSources}" Margin="8,0,0,0"/>
       <Button x:Name="AutomaticSourceButton" DockPanel.Dock="Left" Content="自动选择" Tag="{Binding AutomaticSourceChoice}"
               Click="SourceChoice_Click" IsEnabled="{Binding CanSwitchSource}" Margin="0,0,8,0">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
         <Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="32"/>
         <Style.Triggers><DataTrigger Binding="{Binding AutomaticSourceChoice.Current}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
        </Style></Button.Style>
       </Button>
       <TextBlock Text="正在搜索音源…" FontSize="12" VerticalAlignment="Center" Visibility="{Binding IsLoadingSources,Converter={StaticResource MeowFilm.BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
     </Grid>
    </Border>
   </Popup>
    <Popup x:Name="RatePopup" PlacementTarget="{Binding ElementName=MoreButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
     <Border Style="{StaticResource MeowFilm.FloatingSurface}" Margin="8" Padding="12">
      <StackPanel DataContext="{Binding PlacementTarget.DataContext,ElementName=RatePopup}">
       <TextBlock Text="播放倍速" Margin="0,0,0,8"/>
       <Slider x:Name="RateSlider" Width="190" Minimum="0.5" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True"
        Value="{Binding PlaybackRate,Mode=OneWay}" IsEnabled="{Binding CanChangePlaybackRate}"
        PreviewMouseLeftButtonUp="Rate_MouseUp" PreviewKeyUp="Rate_KeyUp" AutomationProperties.Name="播放倍速"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
        <Button Content="−" Click="RateDown_Click" IsEnabled="{Binding CanChangePlaybackRate}" AutomationProperties.Name="降低播放倍速"/>
        <Button Content="1.0×" Click="RateReset_Click" IsEnabled="{Binding CanChangePlaybackRate}" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="12" AutomationProperties.Name="恢复正常播放倍速"/>
        <Button Content="+" Click="RateUp_Click" IsEnabled="{Binding CanChangePlaybackRate}" AutomationProperties.Name="提高播放倍速"/>
       </StackPanel>
      </StackPanel>
     </Border>
    </Popup>
  </Grid>
</UserControl>
