<UserControl x:Class="MeowFilm.Capabilities.MusicPlayerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities" xmlns:desktop="using:MeowFilm.Desktop" x:Name="Root">
 <UserControl.Resources><ResourceDictionary>
  <local:MusicVisibilityConverter x:Key="Visible"/>
  <Style TargetType="Button" BasedOn="{StaticResource MeowFilm.GhostButton}"><Setter Property="MinWidth" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="6"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="Player.MenuChoice" TargetType="local:MusicPlayerMenuChoice">
   <Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,7"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:MusicPlayerMenuChoice">
    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
     <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"/></VisualStateGroup></VisualStateManager.VisualStateGroups>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <local:MusicPlaybackIcon Key="{TemplateBinding IconKey}" Foreground="{TemplateBinding Foreground}" Width="18" Height="18" Margin="0,0,10,0" Visibility="{Binding IconKey,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource Visible}}"/>
     <TextBlock x:Name="TextBlock" Grid.Column="1" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="Normal" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <MenuFlyout x:Name="ModeMenu" MenuFlyoutPresenterStyle="{StaticResource MeowFilm.ContextMenu}"/>
  <MenuFlyout x:Name="QualityMenu" MenuFlyoutPresenterStyle="{StaticResource MeowFilm.ContextMenu}"/>
  <MenuFlyout x:Name="MoreMenu" MenuFlyoutPresenterStyle="{StaticResource MeowFilm.ContextMenu}"/>
  <DataTemplate x:Key="FmPanelTemplate">
   <Border Width="368" Padding="14" CornerRadius="14" BorderThickness="1" BorderBrush="#60FFFFFF" Background="{Binding PlayerBackground}" RequestedTheme="Dark" TabFocusNavigation="Cycle">
    <Border.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///MeowFilm.Capabilities/Playback/Presentation/MusicPlayerView.FmButton.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Border.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><TextBlock x:Name="FmTitle" Text="{Binding PlaybackFmTitle}" FontSize="14" Foreground="#C5C3C8" VerticalAlignment="Center" TextAlignment="Center"/><Button x:Name="CloseFmButton" Template="{StaticResource Player.FmButtonTemplate}" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0" Margin="0" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" Foreground="#EBEAED" HorizontalAlignment="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons" Click="CloseFm_Click" AutomationProperties.Name="关闭频道选择"/></Grid>
     <ScrollViewer x:Name="FmScroll" Grid.Row="1" desktop:OverlayScrollChrome.Enabled="True" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel><StackPanel x:Name="FmModeChoices"/><TextBlock x:Name="FmSceneCaption" Text="场景模式" FontSize="13" Foreground="#C5C3C8" Margin="0,12,0,12"/><Border x:Name="FmSceneSurface" CornerRadius="12" Padding="6" Background="#12FFFFFF"><Grid x:Name="FmSceneChoices"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid></Border></StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </DataTemplate>
  <Flyout x:Name="PlaylistPopup" Placement="Top">
   <ScrollViewer MaxHeight="300" MinWidth="180"><ItemsControl ItemsSource="{Binding Playlists}"><ItemsControl.ItemTemplate><DataTemplate>
    <Button Tag="{Binding Id}" Content="{Binding Name}" Click="AddCurrent_Click" HorizontalAlignment="Stretch"/>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </Flyout>
  <Flyout x:Name="VolumePopup" Placement="Top"><StackPanel Width="180">
   <TextBlock Text="音量" Margin="0,0,0,8"/>
   <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding Volume,Mode=TwoWay}" PointerReleased="VolumeCommit_PointerReleased" KeyUp="VolumeCommit_KeyUp" AutomationProperties.Name="音量"/>
  </StackPanel></Flyout>
  <Flyout x:Name="RatePopup" Placement="Top"><StackPanel Width="210">
   <TextBlock Text="播放倍速" Margin="0,0,0,8"/>
   <Slider x:Name="RateSlider" Minimum="0.5" Maximum="3" StepFrequency="0.1" Value="{Binding PlaybackRate,Mode=OneWay}" IsEnabled="{Binding CanChangePlaybackRate}" PointerReleased="Rate_PointerReleased" KeyUp="Rate_KeyUp" AutomationProperties.Name="播放倍速"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="−" FontSize="16" Click="RateDown_Click" IsEnabled="{Binding CanChangePlaybackRate}" AutomationProperties.Name="降低播放倍速"/><Button Content="1.0×" FontSize="12" Click="RateReset_Click" IsEnabled="{Binding CanChangePlaybackRate}" AutomationProperties.Name="恢复正常播放倍速"/><Button Content="+" FontSize="16" Click="RateUp_Click" IsEnabled="{Binding CanChangePlaybackRate}" AutomationProperties.Name="提高播放倍速"/></StackPanel>
  </StackPanel></Flyout>
  <Flyout x:Name="SourcePopup" Placement="Full">
   <Border x:Name="SourcePanel" Width="410" Padding="16" CornerRadius="20" Background="{ThemeResource MeowFilm.Brush.FloatingSurface}">
   <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="音源选择" FontSize="20"/><Button x:Name="CloseSourcesButton" HorizontalAlignment="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons" Click="CloseSources_Click" AutomationProperties.Name="关闭音源选择"/></Grid>
    <Border Grid.Row="1" Padding="10,8" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}"><StackPanel>
     <TextBlock Text="当前播放" FontSize="12" Margin="0,0,0,4"/>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="CurrentSourceSymbol" Text="{Binding CurrentSourceSymbol}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock x:Name="CurrentSourceQuality" Text="{Binding CurrentSourceQuality}"/><TextBlock x:Name="CurrentSourceDescription" Text="{Binding CurrentSourceDescription}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
     </Grid>
    </StackPanel></Border>
    <ScrollViewer x:Name="SourceChoicesScroll" Grid.Row="2" MinHeight="80" MaxHeight="300" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock x:Name="SourceEmptyState" Text="暂无已确认可切换音源" HorizontalAlignment="Center" Margin="0,18" Visibility="{Binding HasEmptySources,Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite"/>
     <ItemsControl ItemsSource="{Binding SourceChoices}" IsEnabled="{Binding CanSwitchSource}"><ItemsControl.ItemTemplate><DataTemplate>
      <Button x:Name="SourceChoice" Tag="{Binding}" Click="SourceChoice_Click" Loaded="SourceChoice_Loaded" IsEnabled="{Binding Selectable}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" Margin="0,2" AutomationProperties.Name="{Binding Provider}">
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding QualitySymbol}" Foreground="{Binding Foreground,ElementName=SourceChoice}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Quality}" Foreground="{Binding Foreground,ElementName=SourceChoice}"/><TextBlock Foreground="{Binding Foreground,ElementName=SourceChoice}" FontSize="12" TextTrimming="CharacterEllipsis"><Run Text="{Binding Platform}"/><Run Text=" · "/><Run Text="{Binding Provider}"/></TextBlock><TextBlock Text="{Binding Recording}" Foreground="{Binding Foreground,ElementName=SourceChoice}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{Binding Foreground,ElementName=SourceChoice}" FontSize="12" VerticalAlignment="Center"/>
       </Grid>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="AutomaticSourceButton" Content="自动选择" Tag="{Binding AutomaticSourceChoice}" Click="SourceChoice_Click" IsEnabled="{Binding CanSwitchSource}"/>
     <TextBlock Grid.Column="1" Text="正在搜索音源…" FontSize="12" VerticalAlignment="Center" Visibility="{Binding IsLoadingSources,Converter={StaticResource Visible}}"/>
     <Button x:Name="LoadMoreSourcesButton" Grid.Column="2" Content="加载更多" Click="LoadMoreSources_Click" IsEnabled="{Binding CanLoadMoreSources}" AutomationProperties.Name="加载更多"/>
    </Grid>
   </Grid></Border>
  </Flyout>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="Transparent" PointerPressed="Surface_PointerPressed" PointerReleased="Surface_PointerReleased">
  <Grid.RowDefinitions><RowDefinition Height="8"/><RowDefinition Height="72"/></Grid.RowDefinitions>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid x:Name="MetadataPanel" Margin="30,0,0,0" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="ArtworkButton" Click="Lyrics_Click" Width="60" Height="60" Padding="0" Margin="0,0,12,0" AutomationProperties.Name="打开歌曲与歌词"/>
    <StackPanel x:Name="MetadataText" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="180"><TextBlock Text="{x:Bind State.CurrentTitle,Mode=OneWay}" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind State.CurrentArtist,Mode=OneWay}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    <desktop:FavoriteButton x:Name="FavoriteButton" Grid.Column="2" Click="Favorite_Click" IsEnabled="{x:Bind State.CanPlay,Mode=OneWay}" IsFavorited="{x:Bind State.IsCurrentFavorite,Mode=OneWay}" IconSize="18" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind State.CurrentFavoriteLabel,Mode=OneWay}"/>
   </Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Button x:Name="ModeButton" Click="Mode_Click" IsEnabled="{x:Bind State.CanChangePlaybackMode,Mode=OneWay}" AutomationProperties.Name="{x:Bind State.PlaybackModeText,Mode=OneWay}"><local:MusicPlaybackIcon Key="{x:Bind State.PlaybackModeIcon,Mode=OneWay}" Foreground="{Binding Foreground,ElementName=ModeButton}"/></Button>
    <local:SkipButton x:Name="PreviousButton" Next="False" Click="Previous_Click" IsEnabled="{x:Bind State.CanPlay,Mode=OneWay}" AutomationProperties.Name="上一首"/>
    <Button x:Name="PlayButton" Style="{StaticResource MeowFilm.PrimaryButton}" Click="Play_Click" IsEnabled="{x:Bind State.CanTogglePlayback,Mode=OneWay}" Width="40" Height="40" MinWidth="40" MinHeight="40" Padding="0" Margin="8,0" CornerRadius="20" BorderThickness="0" Background="{ThemeResource MeowFilm.Brush.Accent}" Foreground="White" AutomationProperties.Name="播放或暂停"><Path x:Name="PlayGlyph" Width="40" Height="40" Stretch="None" Fill="{Binding Foreground,ElementName=PlayButton}" Data="M15.5,11 L29,20 L15.5,29 Z"/></Button>
    <local:SkipButton x:Name="NextButton" Click="Next_Click" IsEnabled="{x:Bind State.CanPlay,Mode=OneWay}" AutomationProperties.Name="下一首"/>
    <Button x:Name="QueueButton" Click="Queue_Click" AutomationProperties.Name="播放队列"><Path Data="M0,1 L4,3 0,5 Z M7,3 L18,3 M0,10 L18,10 M0,17 L18,17" Width="19" Height="19" StrokeThickness="1.3" Stroke="{Binding Foreground,ElementName=QueueButton}" Stretch="Uniform"/></Button>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
    <Button x:Name="QualityButton" Width="80" HorizontalContentAlignment="Stretch" Click="Quality_Click" Visibility="{x:Bind State.HasQualityButton,Mode=OneWay,Converter={StaticResource Visible}}" AutomationProperties.Name="{x:Bind State.CurrentQualityLabel,Mode=OneWay}"><Border x:Name="QualityBadge" BorderThickness="1" CornerRadius="3" Padding="6,2" BorderBrush="{Binding Foreground,ElementName=QualityButton}"><TextBlock Text="{x:Bind State.CurrentQualityLabel,Mode=OneWay}" Foreground="{Binding Foreground,ElementName=QualityButton}" FontSize="10" TextAlignment="Center"/></Border></Button>
    <Button x:Name="PlaylistButton" Click="PlaylistMenu_Click" IsEnabled="{x:Bind State.CanPlay,Mode=OneWay}" AutomationProperties.Name="收藏到歌单"><FontIcon Glyph="&#xE710;" FontSize="20" Foreground="{Binding Foreground,ElementName=PlaylistButton}"/></Button>
    <Button x:Name="DesktopLyricsButton" Click="DesktopLyrics_Click" IsEnabled="{x:Bind State.CanToggleDesktopLyrics,Mode=OneWay}" AutomationProperties.Name="{x:Bind State.DesktopLyricsLabel,Mode=OneWay}" ToolTipService.ToolTip="{x:Bind State.DesktopLyricsLabel,Mode=OneWay}"><TextBlock Text="桌" FontSize="15" Foreground="{Binding Foreground,ElementName=DesktopLyricsButton}"/></Button>
    <Button x:Name="VolumeButton" Click="Volume_Click" AutomationProperties.Name="音量"><FontIcon Glyph="&#xE767;" FontSize="20" Foreground="{Binding Foreground,ElementName=VolumeButton}"/></Button>
    <Button x:Name="MoreButton" Click="More_Click" AutomationProperties.Name="更多播放选项"><FontIcon Glyph="&#xE712;" FontSize="20" Foreground="{Binding Foreground,ElementName=MoreButton}"/></Button>
   </StackPanel>
  </Grid>
  <local:SeekBar x:Name="Progress" Grid.RowSpan="2" Canvas.ZIndex="2" VerticalAlignment="Top" Margin="0,-43,0,0" RailAtTop="True" Minimum="0" Maximum="{x:Bind State.DurationSeconds,Mode=OneWay}" PlayedBrush="{x:Bind State.PlayerProgressBrush,Mode=OneWay}" Value="{Binding PositionSeconds,Mode=OneWay}" ChorusSeconds="{x:Bind State.ChorusPositionSeconds,Mode=OneWay}" CacheFraction="{x:Bind State.PlaybackCacheFraction,Mode=OneWay}" IsPlaying="{x:Bind State.IsPlaying,Mode=OneWay}" PlaybackRate="{x:Bind State.AcceptedPlaybackRate,Mode=OneWay}" PresentationKey="{x:Bind State.PlaybackPresentationKey,Mode=OneWay}" IsEnabled="{x:Bind State.CanSeek,Mode=OneWay}" AutomationProperties.Name="播放进度"/>
 </Grid>
</UserControl>
