<UserControl x:Class="MeowFilm.Capabilities.MusicPlayerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities" xmlns:desktop="using:MeowFilm.Desktop" x:Name="Root">
 <UserControl.Resources><ResourceDictionary>
  <local:MusicVisibilityConverter x:Key="Visible"/>
  <Style TargetType="Button" BasedOn="{StaticResource MeowFilm.GhostButton}"><Setter Property="MinWidth" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="6"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="Player.MenuChoice" TargetType="local:MusicPlayerMenuChoice">
   <Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,7"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:MusicPlayerMenuChoice">
    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
     <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"/></VisualStateGroup></VisualStateManager.VisualStateGroups>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <local:MusicPlaybackIcon Key="{TemplateBinding IconKey}" Foreground="{TemplateBinding Foreground}" Width="18" Height="18" Margin="0,0,10,0" Visibility="{Binding IconKey,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource Visible}}"/>
     <TextBlock x:Name="TextBlock" Grid.Column="1" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="Normal" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <MenuFlyout x:Name="ModeMenu" Placement="Top" MenuFlyoutPresenterStyle="{StaticResource MeowFilm.ContextMenu}"/>
  <MenuFlyout x:Name="QualityMenu" Placement="Top" MenuFlyoutPresenterStyle="{StaticResource MeowFilm.ContextMenu}"/>
  <MenuFlyout x:Name="MoreMenu" Placement="Top" MenuFlyoutPresenterStyle="{StaticResource MeowFilm.ContextMenu}"/>
  <DataTemplate x:Key="FmPanelTemplate" x:DataType="local:MusicQueueController">
   <Border Width="368" Padding="14" CornerRadius="14" BorderThickness="1" BorderBrush="#60FFFFFF" RequestedTheme="Dark" TabFocusNavigation="Cycle">
    <Border.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///MeowFilm.Capabilities/Playback/Presentation/MusicPlayerView.FmButton.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Border.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><TextBlock x:Name="FmTitle" Text="{x:Bind PlaybackFmTitle,Mode=OneWay}" FontSize="14" Foreground="#C5C3C8" VerticalAlignment="Center" TextAlignment="Center"/><Button x:Name="CloseFmButton" Template="{StaticResource Player.FmButtonTemplate}" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0" Margin="0" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" Foreground="#EBEAED" HorizontalAlignment="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons" Click="CloseFm_Click" AutomationProperties.Name="关闭频道选择"/></Grid>
     <ScrollViewer x:Name="FmScroll" Grid.Row="1" desktop:OverlayScrollChrome.Enabled="True" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel><StackPanel x:Name="FmModeChoices"/><TextBlock x:Name="FmSceneCaption" Text="场景模式" FontSize="13" Foreground="#C5C3C8" Margin="0,12,0,12"/><Border x:Name="FmSceneSurface" CornerRadius="12" Padding="6" Background="#12FFFFFF"><Grid x:Name="FmSceneChoices"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid></Border></StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </DataTemplate>
  <Flyout x:Name="PlaylistPopup" Placement="Top">
   <ScrollViewer MaxHeight="300" MinWidth="180"><ItemsControl ItemsSource="{x:Bind Library.Playlists}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:PlaylistRow">
    <Button Tag="{x:Bind Id}" Content="{x:Bind Name}" Click="AddCurrent_Click" HorizontalAlignment="Stretch"/>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </Flyout>
  <Flyout x:Name="VolumePopup" Placement="Top"><StackPanel Width="180">
   <TextBlock Text="音量" Margin="0,0,0,8"/>
   <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind ToVolumeDouble(Playback.Volume),Mode=TwoWay,BindBack=FromVolumeDouble}" PointerReleased="VolumeCommit_PointerReleased" KeyUp="VolumeCommit_KeyUp" AutomationProperties.Name="音量"/>
  </StackPanel></Flyout>
  <Flyout x:Name="RatePopup" Placement="Top"><StackPanel Width="210">
   <TextBlock Text="播放倍速" Margin="0,0,0,8"/>
   <Slider x:Name="RateSlider" Minimum="0.5" Maximum="3" StepFrequency="0.1" Value="{x:Bind Playback.PlaybackRate,Mode=OneWay}" IsEnabled="{x:Bind Playback.CanChangePlaybackRate,Mode=OneWay}" PointerReleased="Rate_PointerReleased" KeyUp="Rate_KeyUp" AutomationProperties.Name="播放倍速"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="−" FontSize="16" Click="RateDown_Click" IsEnabled="{x:Bind Playback.CanChangePlaybackRate,Mode=OneWay}" AutomationProperties.Name="降低播放倍速"/><Button Content="1.0×" FontSize="12" Click="RateReset_Click" IsEnabled="{x:Bind Playback.CanChangePlaybackRate,Mode=OneWay}" AutomationProperties.Name="恢复正常播放倍速"/><Button Content="+" FontSize="16" Click="RateUp_Click" IsEnabled="{x:Bind Playback.CanChangePlaybackRate,Mode=OneWay}" AutomationProperties.Name="提高播放倍速"/></StackPanel>
  </StackPanel></Flyout>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="Transparent" PointerPressed="Surface_PointerPressed" PointerReleased="Surface_PointerReleased">
  <Grid.RowDefinitions><RowDefinition Height="8"/><RowDefinition Height="72"/></Grid.RowDefinitions>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid x:Name="MetadataPanel" Margin="30,0,0,0" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="ArtworkButton" Click="Lyrics_Click" Width="60" Height="60" Padding="0" Margin="0,0,12,0" AutomationProperties.Name="打开歌曲与歌词">
     <local:MusicRecordView x:Name="RecordView" Width="60" Height="60" Address="{x:Bind Playback.CurrentArtwork,Mode=OneWay}" ArtworkIdentity="{x:Bind Playback.CurrentArtworkIdentity,Mode=OneWay}" TrackIdentity="{x:Bind Playback.CurrentTrackIdentity,Mode=OneWay}"/>
    </Button>
    <StackPanel x:Name="MetadataText" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="180"><TextBlock Text="{x:Bind Playback.CurrentTitle,Mode=OneWay}" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Playback.CurrentArtist,Mode=OneWay}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    <desktop:FavoriteButton x:Name="FavoriteButton" Grid.Column="2" Click="Favorite_Click" IsEnabled="{x:Bind Playback.CanFavoriteCurrent,Mode=OneWay}" IsFavorited="{x:Bind Playback.IsCurrentFavorite,Mode=OneWay}" IconSize="18" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Playback.CurrentFavoriteLabel,Mode=OneWay}"/>
   </Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Button x:Name="ModeButton" Click="Mode_Click" IsEnabled="{x:Bind Queue.CanChangePlaybackMode,Mode=OneWay}" AutomationProperties.Name="{x:Bind Queue.PlaybackModeText,Mode=OneWay}"><local:MusicPlaybackIcon Key="{x:Bind Queue.PlaybackModeIcon,Mode=OneWay}" Foreground="{x:Bind ModeButton.Foreground,Mode=OneWay}"/></Button>
    <local:SkipButton x:Name="PreviousButton" Next="False" Click="Previous_Click" IsEnabled="{x:Bind Playback.CanStep,Mode=OneWay}" AutomationProperties.Name="上一首"/>
    <Button x:Name="PlayButton" Style="{StaticResource MeowFilm.PrimaryButton}" Click="Play_Click" IsEnabled="{x:Bind Playback.CanTogglePlayback,Mode=OneWay}" Width="40" Height="40" MinWidth="40" MinHeight="40" Padding="0" Margin="8,0" CornerRadius="20" BorderThickness="0" Background="{ThemeResource MeowFilm.Brush.Accent}" Foreground="White" AutomationProperties.Name="播放或暂停"><Path x:Name="PlayGlyph" Width="40" Height="40" Stretch="None" Fill="{x:Bind PlayButton.Foreground,Mode=OneWay}" Data="M15.5,11 L29,20 L15.5,29 Z"/></Button>
    <local:SkipButton x:Name="NextButton" Click="Next_Click" IsEnabled="{x:Bind Playback.CanStep,Mode=OneWay}" AutomationProperties.Name="下一首"/>
    <Button x:Name="QueueButton" Click="Queue_Click" AutomationProperties.Name="播放队列"><Path Data="M0,1 L4,3 0,5 Z M7,3 L18,3 M0,10 L18,10 M0,17 L18,17" Width="19" Height="19" StrokeThickness="1.3" Stroke="{x:Bind QueueButton.Foreground,Mode=OneWay}" Stretch="Uniform"/></Button>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
    <Button x:Name="QualityButton" Width="80" HorizontalContentAlignment="Stretch" Click="Quality_Click" Visibility="{x:Bind Playback.HasQualityButton,Mode=OneWay,Converter={StaticResource Visible}}" AutomationProperties.Name="{x:Bind Playback.CurrentQualityLabel,Mode=OneWay}"><Border x:Name="QualityBadge" BorderThickness="1" CornerRadius="3" Padding="6,2" BorderBrush="{x:Bind QualityButton.Foreground,Mode=OneWay}"><TextBlock Text="{x:Bind Playback.CurrentQualityLabel,Mode=OneWay}" Foreground="{x:Bind QualityButton.Foreground,Mode=OneWay}" FontSize="10" TextAlignment="Center"/></Border></Button>
    <Button x:Name="PlaylistButton" Click="PlaylistMenu_Click" IsEnabled="{x:Bind Playback.CanAddCurrentToPlaylist,Mode=OneWay}" AutomationProperties.Name="收藏到歌单"><FontIcon Glyph="&#xE710;" FontSize="20" Foreground="{x:Bind PlaylistButton.Foreground,Mode=OneWay}"/></Button>
    <Button x:Name="DesktopLyricsButton" Click="DesktopLyrics_Click" IsEnabled="{x:Bind Lyrics.CanToggleDesktopLyrics,Mode=OneWay}" AutomationProperties.Name="{x:Bind Lyrics.DesktopLyricsLabel,Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Lyrics.DesktopLyricsLabel,Mode=OneWay}"><TextBlock Text="桌" FontSize="15" Foreground="{x:Bind DesktopLyricsButton.Foreground,Mode=OneWay}"/></Button>
    <Button x:Name="VolumeButton" Click="Volume_Click" AutomationProperties.Name="音量"><FontIcon Glyph="&#xE767;" FontSize="20" Foreground="{x:Bind VolumeButton.Foreground,Mode=OneWay}"/></Button>
    <Button x:Name="MoreButton" Click="More_Click" AutomationProperties.Name="更多播放选项"><FontIcon Glyph="&#xE712;" FontSize="20" Foreground="{x:Bind MoreButton.Foreground,Mode=OneWay}"/></Button>
   </StackPanel>
  </Grid>
  <local:SeekBar x:Name="Progress" Grid.RowSpan="2" Canvas.ZIndex="2" VerticalAlignment="Top" Margin="0,-43,0,0" RailAtTop="True" Minimum="0" Maximum="{x:Bind Clock.DurationSeconds,Mode=OneWay}" PlayedBrush="{x:Bind Playback.PlayerProgressBrush,Mode=OneWay}" ChorusSeconds="{x:Bind Playback.ChorusPositionSeconds,Mode=OneWay}" CacheFraction="{x:Bind Clock.PlaybackCacheFraction,Mode=OneWay}" PlaybackRate="{x:Bind Playback.AcceptedPlaybackRate,Mode=OneWay}" PresentationKey="{x:Bind Playback.PlaybackPresentationKey,Mode=OneWay}" IsEnabled="{x:Bind Playback.CanSeek,Mode=OneWay}" AutomationProperties.Name="播放进度"/>
 </Grid>
</UserControl>
