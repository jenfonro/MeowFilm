{
  "initial": {
    "episodeCleanRegexRules": [
      "\\[(?!\\s*[Ss]\\d{1,2}(?:\\s*[Ee]\\d{1,5})?\\s*\\])[^\\]]*\\]",
      "【(?!\\s*[Ss]\\d{1,2}(?:\\s*[Ee]\\d{1,5})?\\s*】)[^】]*】",
      "\\((?!\\s*[Ss]\\d{1,2}(?:\\s*[Ee]\\d{1,5})?\\s*\\))[^)]*\\)",
