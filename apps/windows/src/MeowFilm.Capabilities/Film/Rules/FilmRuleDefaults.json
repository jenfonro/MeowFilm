        "pattern": "^[\\s\\[\\]\\(\\){}【】._=-]*0*(\\d{1,4})[\\s\\[\\]\\(\\){}【】._=-]*(?:\\.[A-Za-z0-9]{1,6})?\\s*$",
        "replace": "E$1",
        "flags": "i"
      }
    ],
    "movieRules": [
