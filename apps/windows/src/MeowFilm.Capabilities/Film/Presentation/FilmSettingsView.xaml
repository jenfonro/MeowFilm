<UserControl x:Class="MeowFilm.Capabilities.FilmSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 x:Name="Root"
 UseLayoutRounding="True" SnapsToDevicePixels="True" ClipToBounds="True"
 Loaded="View_Loaded" Unloaded="View_Unloaded" IsVisibleChanged="View_IsVisibleChanged" SizeChanged="View_SizeChanged">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MeowFilm.Capabilities;component/Film/Presentation/FilmSettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <UserControl.Style><Style TargetType="UserControl">
  <Setter Property="Background" Value="{DynamicResource Settings.Brush.Ground}"/>
  <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
  <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
  </Trigger></Style.Triggers>
 </Style></UserControl.Style>
 <Grid x:Name="ContentFrame" Margin="32,0,32,16" local:SettingsLayout.Mode="Sections">
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions>
  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MeowFilm.Brush.Border}">
   <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
    <StackPanel x:Name="SettingsNavigation" Orientation="Horizontal" AutomationProperties.Name="影视设置分类">
     <RadioButton Content="魔法匹配" Tag="rules" GroupName="FilmSettingsSection" IsChecked="True" Style="{StaticResource FilmSettings.Anchor}" Checked="Section_Checked" PreviewKeyDown="Section_KeyDown" AutomationProperties.Name="魔法匹配"/>
     <RadioButton Content="猫源管理" Tag="cats" GroupName="FilmSettingsSection" Style="{StaticResource FilmSettings.Anchor}" Checked="Section_Checked" PreviewKeyDown="Section_KeyDown" AutomationProperties.Name="猫源管理"/>
     <RadioButton Content="视频源管理" Tag="videos" GroupName="FilmSettingsSection" Style="{StaticResource FilmSettings.Anchor}" Checked="Section_Checked" PreviewKeyDown="Section_KeyDown" AutomationProperties.Name="视频源管理"/>
     <RadioButton Content="数据源" Tag="metadata" GroupName="FilmSettingsSection" Style="{StaticResource FilmSettings.Anchor}" Checked="Section_Checked" PreviewKeyDown="Section_KeyDown" AutomationProperties.Name="数据源设置" Visibility="{Binding HasMetadataSettings,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
     <RadioButton Content="网盘账号" Tag="pan" GroupName="FilmSettingsSection" Style="{StaticResource FilmSettings.Anchor}" Checked="Section_Checked" PreviewKeyDown="Section_KeyDown" AutomationProperties.Name="网盘账号"/>
     <StackPanel x:Name="BusinessNavigation" Orientation="Horizontal" Visibility="Collapsed">
      <RadioButton Content="智能播放设置" Tag="preferences" GroupName="FilmSettingsSection" Style="{StaticResource FilmSettings.Anchor}" Checked="Section_Checked" PreviewKeyDown="Section_KeyDown"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <Grid x:Name="MetadataPage" Grid.Row="1" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
    <TextBlock Text="正在处理数据源设置…" VerticalAlignment="Center" Visibility="{Binding MetadataBusy,Converter={StaticResource MeowFilm.BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
    <Button Content="重试" Click="MetadataRetry_Click" Style="{StaticResource Settings.Button}" Visibility="{Binding MetadataFailed,Converter={StaticResource MeowFilm.BoolToVisibility}}" IsEnabled="{Binding MetadataIdle}" AutomationProperties.Name="重新读取数据源设置"/>
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource MeowFilm.SettingsScrollViewer}" AutomationProperties.Name="数据源配置">
    <StackPanel IsEnabled="{Binding CanEditMetadata}" Visibility="{Binding MetadataLoaded,Converter={StaticResource MeowFilm.BoolToVisibility}}" Margin="0,0,12,0">
     <Border Style="{StaticResource Settings.Section}"><StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
       <TextBlock Text="豆瓣配置" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center"/>
       <Button Content="保存" Tag="douban" Click="MetadataSave_Click" Style="{StaticResource Settings.PrimaryButton}" Margin="12,0,0,0" AutomationProperties.Name="保存豆瓣设置"/>
      </StackPanel>
      <TextBlock Text="豆瓣数据代理" Margin="0,0,0,8"/>
      <ComboBox x:Name="DoubanDataProxy" ItemsSource="{Binding DoubanDataRoutes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="DoubanRoute_Changed" Style="{StaticResource Settings.ComboBox}" AutomationProperties.Name="豆瓣数据代理"/>
      <StackPanel x:Name="DoubanDataAddressField" Visibility="Collapsed">
       <TextBlock Text="豆瓣代理地址" Margin="0,12,0,8"/>
       <TextBox x:Name="DoubanDataAddress" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="豆瓣代理地址"/>
      </StackPanel>
      <TextBlock Text="豆瓣图片代理" Margin="0,12,0,8"/>
      <ComboBox x:Name="DoubanImageProxy" ItemsSource="{Binding DoubanImageRoutes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="DoubanRoute_Changed" Style="{StaticResource Settings.ComboBox}" AutomationProperties.Name="豆瓣图片代理"/>
      <StackPanel x:Name="DoubanImageAddressField" Visibility="Collapsed">
       <TextBlock Text="豆瓣图片代理地址" Margin="0,12,0,8"/>
       <TextBox x:Name="DoubanImageAddress" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="豆瓣图片代理地址"/>
      </StackPanel>
      <TextBlock Text="豆瓣搜索 Cookie" Margin="0,12,0,8"/>
      <TextBox x:Name="DoubanCookie" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="豆瓣搜索 Cookie"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Settings.Section}"><StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
       <TextBlock Text="TMDB 设置" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center"/>
       <Button x:Name="MetadataSave" Content="保存" Tag="tmdb" Click="MetadataSave_Click" Style="{StaticResource Settings.PrimaryButton}" Margin="12,0,0,0" AutomationProperties.Name="保存 TMDB 设置"/>
      </StackPanel>
      <TextBlock Text="TMDB API TOKEN" Margin="0,0,0,8"/>
      <TextBox x:Name="MetadataApiToken" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="TMDB API TOKEN"/>
      <TextBlock Text="TMDB 数据代理地址" Margin="0,12,0,8"/>
      <TextBox x:Name="MetadataApiBase" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="TMDB 数据代理地址"/>
      <TextBlock Text="TMDB 图片代理地址" Margin="0,12,0,8"/>
      <TextBox x:Name="MetadataImageBase" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="TMDB 图片代理地址"/>
      <Grid Margin="0,12,0,0" local:SettingsLayout.Mode="Pair">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Style="{StaticResource Settings.PairGap}"/><ColumnDefinition Style="{StaticResource Settings.PairColumn}"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="语言" Margin="0,0,0,8"/><TextBox x:Name="MetadataLanguage" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="TMDB 语言"/></StackPanel>
       <StackPanel Style="{StaticResource Settings.PairRight}"><TextBlock Text="地区" Margin="0,0,0,8"/><TextBox x:Name="MetadataRegion" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="TMDB 地区"/></StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
       <TextBlock Text="包含成人内容" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <CheckBox x:Name="MetadataIncludeAdult" Style="{StaticResource Settings.Switch}" AutomationProperties.Name="包含成人内容"/>
      </StackPanel>
     </StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Grid x:Name="BusinessPage" Grid.Row="1" Visibility="Collapsed"/>
  <local:PanAccountsView x:Name="PanPage" Grid.Row="1" Visibility="Collapsed"/>
  <Grid x:Name="RulesPage" Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
    <StackPanel.Style><Style TargetType="StackPanel">
     <Setter Property="Visibility" Value="Collapsed"/>
     <Style.Triggers>
      <DataTrigger Binding="{Binding RulesBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding RulesFailed}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     </Style.Triggers>
    </Style></StackPanel.Style>
    <TextBlock Text="正在处理规则…" VerticalAlignment="Center" Visibility="{Binding RulesBusy,Converter={StaticResource MeowFilm.BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
    <Button Content="重试" Click="RulesRetry_Click" Style="{StaticResource Settings.Button}" Visibility="{Binding RulesFailed,Converter={StaticResource MeowFilm.BoolToVisibility}}" IsEnabled="{Binding RulesIdle}" AutomationProperties.Name="重新读取魔法规则"/>
    <Button Content="取消" Click="RulesCancel_Click" Margin="8,0,0,0" Style="{StaticResource Settings.QuietButton}" Visibility="{Binding RulesBusy,Converter={StaticResource MeowFilm.BoolToVisibility}}" AutomationProperties.Name="取消规则操作"/>
   </StackPanel>
   <ScrollViewer x:Name="RulesScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Style="{StaticResource MeowFilm.SettingsScrollViewer}" AutomationProperties.Name="魔法匹配设置">
    <StackPanel>
    <StackPanel x:Name="RuleSections" Margin="0,0,12,0" IsEnabled="{Binding CanEditRules}" Visibility="{Binding RulesLoaded,Converter={StaticResource MeowFilm.BoolToVisibility}}">
     <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
       <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="恢复默认规则" Tag="Episode" Click="RestoreRules_Click" Style="{StaticResource Settings.DangerButton}" AutomationProperties.Name="恢复列表净化默认规则"/>
        <TextBlock Text="列表净化设置" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center"/>
       </DockPanel>
       <local:FilmSettingsRuleEditor x:Name="EpisodeCleanEditor" Title="剧集列表净化规则" Tag="episodeClean"/>
       <local:FilmSettingsRuleEditor x:Name="EpisodeEditor" Title="集数匹配规则" Tag="episode" HasReplacement="True"/>
       <TextBlock Text="文件名" Margin="0,0,0,8"/>
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="测试" Tag="Episode" Style="{StaticResource Settings.Button}" Margin="12,0,0,0" Click="TestRules_Click" AutomationProperties.Name="测试列表净化与集数匹配"/>
        <TextBox x:Name="EpisodeInput" Style="{StaticResource Settings.TextBox}" TextChanged="RuleInput_Changed" AutomationProperties.Name="列表净化测试文件名"/>
       </DockPanel>
       <StackPanel x:Name="EpisodeResults" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="列表净化测试结果"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
       <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="恢复默认规则" Tag="Movie" Click="RestoreRules_Click" Style="{StaticResource Settings.DangerButton}" AutomationProperties.Name="恢复电影匹配默认规则"/>
        <TextBlock Text="电影匹配设置" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center"/>
       </DockPanel>
       <local:FilmSettingsRuleEditor x:Name="MovieEditor" Title="电影匹配规则" Tag="movie" HasReplacement="True"/>
       <TextBlock Text="文件名" Margin="0,0,0,8"/>
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="测试" Tag="Movie" Style="{StaticResource Settings.Button}" Margin="12,0,0,0" Click="TestRules_Click" AutomationProperties.Name="测试电影匹配"/>
        <TextBox x:Name="MovieInput" Style="{StaticResource Settings.TextBox}" TextChanged="RuleInput_Changed" AutomationProperties.Name="电影匹配测试文件名"/>
       </DockPanel>
       <StackPanel x:Name="MovieResults" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="电影匹配测试结果"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
       <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="恢复默认规则" Tag="Search" Click="RestoreRules_Click" Style="{StaticResource Settings.DangerButton}" AutomationProperties.Name="恢复搜索列表净化默认规则"/>
        <TextBlock Text="搜索列表净化设置" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center"/>
       </DockPanel>
       <local:FilmSettingsRuleEditor x:Name="SearchEditor" Title="搜索列表净化规则" Tag="search"/>
       <TextBlock Text="搜索词（可空）" Margin="0,0,0,8"/>
       <TextBox x:Name="SearchQuery" Style="{StaticResource Settings.TextBox}" TextChanged="RuleInput_Changed" AutomationProperties.Name="搜索列表净化测试搜索词"/>
       <TextBlock Text="结果标题" Margin="0,12,0,8"/>
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="测试" Tag="Search" Style="{StaticResource Settings.Button}" Margin="12,0,0,0" Click="TestRules_Click" AutomationProperties.Name="测试搜索列表净化"/>
        <TextBox x:Name="SearchInput" Style="{StaticResource Settings.TextBox}" TextChanged="RuleInput_Changed" AutomationProperties.Name="搜索列表净化测试结果标题"/>
       </DockPanel>
       <StackPanel x:Name="SearchResults" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="搜索列表净化测试结果"/>
      </StackPanel>
     </Border>
    </StackPanel>
     <ContentControl x:Name="SiteCleanHost"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Grid x:Name="CatsPage" Grid.Row="1" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <WrapPanel Margin="0,16,0,10">
    <Button Content="导入本地文件" Style="{StaticResource Settings.PrimaryButton}" IsEnabled="{Binding CanEditSources}" Click="ImportLocal_Click" Margin="0,0,10,6" AutomationProperties.Name="从本地文件导入猫源"/>
    <Button Content="网络导入" Style="{StaticResource Settings.Button}" IsEnabled="{Binding CanEditSources}" Click="ImportNetwork_Click" Margin="0,0,10,6"/>
    <Button Content="刷新" Style="{StaticResource Settings.Button}" IsEnabled="{Binding SourcesIdle}" Click="RefreshSources_Click" Margin="0,0,10,6" AutomationProperties.Name="刷新猫源管理"/>
    <Button Content="删除所选" Style="{StaticResource Settings.DangerButton}" IsEnabled="{Binding CanDeleteCats}" Click="DeleteSelectedCats_Click" Margin="0,0,10,6" AutomationProperties.Name="删除选中猫源"/>
   </WrapPanel>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
    <TextBlock Text="{Binding SourceWork}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    <Button Content="取消" Click="SourcesCancel_Click" Style="{StaticResource Settings.QuietButton}" Margin="8,0,0,0" Visibility="{Binding SourcesBusy,Converter={StaticResource MeowFilm.BoolToVisibility}}" AutomationProperties.Name="取消猫源操作"/>
    <Button Content="重试" Click="RefreshSources_Click" Style="{StaticResource Settings.Button}" Visibility="{Binding SourcesFailed,Converter={StaticResource MeowFilm.BoolToVisibility}}" IsEnabled="{Binding SourcesIdle}" AutomationProperties.Name="重试猫源读取"/>
   </StackPanel>
   <Grid Grid.Row="2">
    <Border Style="{StaticResource Settings.ListSurface}">
    <DataGrid x:Name="CatsGrid" Style="{StaticResource FilmSettings.Grid}" ItemsSource="{Binding CatRows}" FrozenColumnCount="3" IsEnabled="{Binding CanEditSources}" AutomationProperties.Name="猫源列表">
     <DataGrid.Columns>
      <DataGridTemplateColumn Width="38">
       <DataGridTemplateColumn.Header><CheckBox x:Name="SelectAllCats" Style="{StaticResource Settings.CheckBox}" Click="SelectAllCats_Click" AutomationProperties.Name="选择全部猫源"/></DataGridTemplateColumn.Header>
       <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource Settings.CheckBox}" IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding Name,StringFormat='选择猫源{0}'}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="启用" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <CheckBox Style="{StaticResource Settings.Switch}" IsChecked="{Binding Enabled,Mode=OneWay}" Click="CatEnabled_Click" AutomationProperties.Name="{Binding Name,StringFormat='启用猫源{0}'}"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="220" ElementStyle="{StaticResource FilmSettings.CellText}"/>
      <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="68" ElementStyle="{StaticResource FilmSettings.CellText}"/>
      <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="100" ElementStyle="{StaticResource FilmSettings.ErrorCell}"/>
      <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedText}" Width="156" ElementStyle="{StaticResource FilmSettings.DateCell}"/>
      <DataGridTextColumn Header="更新状态" Binding="{Binding UpdateText}" Width="110" ElementStyle="{StaticResource FilmSettings.UpdateCell}"/>
      <DataGridTemplateColumn Header="操作" Width="208"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <StackPanel Orientation="Horizontal">
        <Button Content="编辑" Style="{StaticResource Settings.QuietButton}" Click="EditCat_Click" AutomationProperties.Name="{Binding Name,StringFormat='编辑猫源{0}'}"/>
        <Button Content="更新" Style="{StaticResource Settings.QuietButton}" Click="UpdateCat_Click" AutomationProperties.Name="{Binding Name,StringFormat='更新猫源{0}'}"/>
        <Button Content="重启" Style="{StaticResource Settings.QuietButton}" IsEnabled="{Binding CanRestart}" Click="RestartCat_Click" AutomationProperties.Name="{Binding Name,StringFormat='重启猫源{0}'}"/>
        <Button Content="删除" Style="{StaticResource Settings.DangerButton}" Click="DeleteCat_Click" AutomationProperties.Name="{Binding Name,StringFormat='删除猫源{0}'}"/>
       </StackPanel>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    </Border>
    <TextBlock Text="暂无猫源" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding CatsEmpty,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
   </Grid>
  </Grid>
  <Grid x:Name="VideosPage" Grid.Row="1" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <WrapPanel Margin="0,16,0,10">
    <Button Content="检测所选" Style="{StaticResource Settings.Button}" IsEnabled="{Binding CanDetectVideos}" Click="DetectSelectedVideos_Click" Margin="0,0,10,6"/>
    <Button Content="删除所选" Style="{StaticResource Settings.DangerButton}" IsEnabled="{Binding CanDeleteVideos}" Click="DeleteSelectedVideos_Click" Margin="0,0,10,6" AutomationProperties.Name="删除选中视频源"/>
    <Button Content="刷新" Style="{StaticResource Settings.Button}" IsEnabled="{Binding SourcesIdle}" Click="RefreshSources_Click" Margin="0,0,10,6" AutomationProperties.Name="刷新视频源管理"/>
   </WrapPanel>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
    <TextBlock Text="{Binding SourceWork}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    <Button Content="取消" Click="SourcesCancel_Click" Style="{StaticResource Settings.QuietButton}" Margin="8,0,0,0" Visibility="{Binding SourcesBusy,Converter={StaticResource MeowFilm.BoolToVisibility}}" AutomationProperties.Name="取消视频源操作"/>
    <Button Content="重试" Click="RefreshSources_Click" Style="{StaticResource Settings.Button}" Visibility="{Binding SourcesFailed,Converter={StaticResource MeowFilm.BoolToVisibility}}" IsEnabled="{Binding SourcesIdle}" AutomationProperties.Name="重试视频源读取"/>
   </StackPanel>
   <Grid Grid.Row="2">
    <Border Style="{StaticResource Settings.ListSurface}">
    <DataGrid x:Name="VideosGrid" Style="{StaticResource FilmSettings.Grid}" ItemsSource="{Binding VideoRows}" FrozenColumnCount="2" IsEnabled="{Binding CanEditSources}" AutomationProperties.Name="视频源列表">
     <DataGrid.Columns>
      <DataGridTemplateColumn Width="38">
       <DataGridTemplateColumn.Header><CheckBox x:Name="SelectAllVideos" Style="{StaticResource Settings.CheckBox}" Click="SelectAllVideos_Click" AutomationProperties.Name="选择全部视频源"/></DataGridTemplateColumn.Header>
       <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource Settings.CheckBox}" IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding Name,StringFormat='选择视频源{0}'}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="站源名称" Binding="{Binding Name}" Width="200" ElementStyle="{StaticResource FilmSettings.CellText}"/>
      <DataGridTextColumn Header="路由 / API" Binding="{Binding Api}" Width="190" ElementStyle="{StaticResource FilmSettings.CellText}"/>
      <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="100" ElementStyle="{StaticResource FilmSettings.CellText}"/>
      <DataGridTemplateColumn Header="启用" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <CheckBox Style="{StaticResource Settings.Switch}" IsChecked="{Binding Enabled,Mode=OneWay}" Tag="enabled" Click="VideoOption_Click" AutomationProperties.Name="{Binding Name,StringFormat='启用视频源{0}'}"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="首页显示" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <CheckBox Style="{StaticResource Settings.CheckBox}" IsChecked="{Binding HomeVisible,Mode=OneWay}" Tag="home" Click="VideoOption_Click" AutomationProperties.Name="{Binding Name,StringFormat='首页显示{0}'}"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="搜索启用" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <CheckBox Style="{StaticResource Settings.CheckBox}" IsChecked="{Binding SearchEnabled,Mode=OneWay}" Tag="search" Click="VideoOption_Click" AutomationProperties.Name="{Binding Name,StringFormat='搜索启用{0}'}"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="聚合图片来源" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <RadioButton Style="{StaticResource FilmSettings.Radio}" IsChecked="{Binding AggregateImages,Mode=OneWay}" GroupName="FilmAggregateImages" Click="AggregateImages_Click" AutomationProperties.Name="{Binding Name,StringFormat='聚合图片来源{0}'}"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="排序" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <TextBox Text="{Binding OrderText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Settings.TextBox}" Height="32" Padding="6,4" HorizontalContentAlignment="Right" LostKeyboardFocus="VideoOrder_LostFocus" PreviewKeyDown="VideoOrder_KeyDown" AutomationProperties.Name="{Binding Name,StringFormat='视频源{0}排序'}"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorText}" Width="230" ElementStyle="{StaticResource FilmSettings.ErrorCell}"/>
      <DataGridTemplateColumn Header="操作" Width="108"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <StackPanel Orientation="Horizontal">
        <Button Content="检测" Style="{StaticResource Settings.QuietButton}" IsEnabled="{Binding CanDetect}" Click="DetectVideo_Click" AutomationProperties.Name="{Binding Name,StringFormat='检测视频源{0}'}"/>
        <Button Content="删除" Style="{StaticResource Settings.DangerButton}" Click="DeleteVideo_Click" AutomationProperties.Name="{Binding Name,StringFormat='删除视频源{0}'}"/>
       </StackPanel>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    </Border>
    <TextBlock Text="暂无视频源" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding VideosEmpty,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
   </Grid>
  </Grid>
  <desktop:NoticeOutlet x:Name="Notices"/>
  <Popup x:Name="ActionPopup" PlacementTarget="{Binding ElementName=Root}" desktop:DialogPlacement.Centered="True"
         StaysOpen="False" AllowsTransparency="True" Opened="ActionPopup_Opened" Closed="ActionPopup_Closed">
   <Border x:Name="PopupSurface" Width="360" Padding="20" Style="{StaticResource Settings.PopupSurface}">
    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity=".13"/></Border.Effect>
    <ScrollViewer x:Name="PopupScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="ActionPopup_KeyDown">
      <TextBlock x:Name="PopupTitle" Style="{StaticResource Settings.PopupTitle}" TextWrapping="Wrap"/>
      <TextBlock x:Name="PopupMessage" TextWrapping="Wrap" Margin="0,12,0,0"/>
      <StackPanel x:Name="PopupFields" Margin="0,16,0,0" Visibility="Collapsed">
       <StackPanel x:Name="ImportTargetField" Visibility="Collapsed" Margin="0,0,0,14">
        <TextBlock Text="导入目标" Margin="0,0,0,8"/>
        <ComboBox x:Name="ImportTarget" Style="{StaticResource Settings.ComboBox}" DisplayMemberPath="Name"
                  SelectionChanged="ImportTarget_Changed" AutomationProperties.Name="猫源导入目标"/>
       </StackPanel>
       <TextBlock Text="名称" Margin="0,0,0,8"/>
       <TextBox x:Name="CatNameBox" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="猫源名称"/>
       <StackPanel x:Name="CatUrlField" Margin="0,14,0,0">
        <TextBlock Text="网络 URL" Margin="0,0,0,8"/>
        <TextBox x:Name="CatUrlBox" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="猫源网络 URL"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
       <Button x:Name="PopupCancel" Content="取消" Style="{StaticResource Settings.QuietButton}" Click="PopupCancel_Click" MinWidth="64"/>
       <Button x:Name="PopupAccept" Content="确定" Style="{StaticResource Settings.PrimaryButton}" Click="PopupAccept_Click" MinWidth="64" Margin="8,0,0,0"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Popup>
 </Grid>
</UserControl>
