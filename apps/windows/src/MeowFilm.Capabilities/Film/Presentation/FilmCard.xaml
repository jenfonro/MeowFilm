<UserControl xmlns:desktop="using:MeowFilm.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="using:MeowFilm.Capabilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MeowFilm.Capabilities.FilmCard" x:Name="Card" HorizontalAlignment="Left" VerticalAlignment="Top">
 <UserControl.Resources>
  <local:FilmVisibilityConverter x:Key="Film.Visible" />
  <local:FilmScaleConverter x:Key="Film.Scale" />
 </UserControl.Resources>
 <Button x:Name="HitButton" Click="Activate_Click" Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" AutomationProperties.Name="{Binding Title}" local:CardMotion.Enabled="True">
  <StackPanel>
   <local:AspectRatioDecorator AspectRatio="176,264">
    <Grid>
    <Grid x:Name="PosterFrame" local:CardClip.Radius="14" RenderTransformOrigin=".5,.5">
     <Grid.RenderTransform><ScaleTransform ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton,Converter={StaticResource Film.Scale},ConverterParameter=.03}" ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton,Converter={StaticResource Film.Scale},ConverterParameter=.03}" /></Grid.RenderTransform>
     <local:FilmPlaybackPoster x:Name="Poster" Address="{Binding Poster}" RenderTransformOrigin=".5,.5">
      <local:FilmPlaybackPoster.RenderTransform><ScaleTransform ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton,Converter={StaticResource Film.Scale},ConverterParameter=.05}" ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton,Converter={StaticResource Film.Scale},ConverterParameter=.05}" /></local:FilmPlaybackPoster.RenderTransform>
     </local:FilmPlaybackPoster>
     <local:FilmHoverShade x:Name="HoverShade" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton}" />
     <local:FilmPlayMark Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton}" />
     <Border x:Name="ScoreBadge" Background="#EC4899" Width="32" Height="32" CornerRadius="16" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding HasScore,Converter={StaticResource Film.Visible}}">
      <Border.RenderTransform><ScaleTransform ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton,Converter={StaticResource Film.Scale},ConverterParameter=.1}" ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton,Converter={StaticResource Film.Scale},ConverterParameter=.1}" /></Border.RenderTransform>
      <TextBlock Text="{Binding Score}" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Border>
    </Grid>
     <Border x:Name="TextBadge" Background="#F97316" CornerRadius="8" Padding="8,2" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding HasTextBadge,Converter={StaticResource Film.Visible}}">
      <TextBlock Text="{Binding TextBadge}" Foreground="White" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" />
     </Border>
    </Grid>
   </local:AspectRatioDecorator>
   <TextBlock Text="{Binding Title}" Margin="0,9,0,0" Height="21" FontSize="15" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
   <Border x:Name="SiteLabel" Margin="0,3,0,0" Padding="8,2" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center" MaxWidth="{Binding ActualWidth,ElementName=Card}" Visibility="{Binding HasSubtitle,Converter={StaticResource Film.Visible}}">
    <TextBlock x:Name="Subtitle" Text="{Binding Subtitle}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
   </Border>
  </StackPanel>
 </Button>
</UserControl>
