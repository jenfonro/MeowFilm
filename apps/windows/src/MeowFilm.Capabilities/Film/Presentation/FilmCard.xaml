<UserControl x:Class="MeowFilm.Capabilities.FilmCard" x:Name="Card"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 xmlns:art="clr-namespace:MeowFilm.Desktop.Artwork;assembly=MeowFilm.Desktop"
 Width="176" Height="294" Background="Transparent"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <local:FilmScaleConverter x:Key="Film.Scale"/>
   <Style x:Key="Film.CardButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Button x:Name="HitButton" Style="{StaticResource Film.CardButton}"
         local:CardMotion.Enabled="True" Click="Activate_Click"
         AutomationProperties.Name="{Binding Title}">
  <StackPanel Width="176">
   <Grid x:Name="PosterFrame" Width="176" Height="264" local:CardClip.Radius="14"
         RenderTransformOrigin=".5,0">
    <Grid.RenderTransform><ScaleTransform
     ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton,Converter={StaticResource Film.Scale},ConverterParameter=0.03}"
     ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton,Converter={StaticResource Film.Scale},ConverterParameter=0.03}"/>
    </Grid.RenderTransform>
    <Border Background="{DynamicResource MeowFilm.Brush.Hover}"/>
    <art:ArtworkImage Address="{Binding Poster}" Stretch="UniformToFill"
                      AutomationProperties.Name="{Binding Title,StringFormat=影片海报 {0}}"
                      RenderTransformOrigin=".5,.5">
     <art:ArtworkImage.RenderTransform><ScaleTransform
      ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton,Converter={StaticResource Film.Scale},ConverterParameter=0.05}"
      ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton,Converter={StaticResource Film.Scale},ConverterParameter=0.05}"/>
     </art:ArtworkImage.RenderTransform>
    </art:ArtworkImage>
    <local:FilmHoverShade x:Name="HoverShade"
                          Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton}"/>
    <local:FilmPlayMark Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton}"/>
    <Border x:Name="ScoreBadge" Width="32" Height="32" CornerRadius="16" Margin="0,8,8,0"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Visibility="{Binding HasScore,Converter={StaticResource MeowFilm.BoolToVisibility}}"
            RenderTransformOrigin=".5,.5">
     <Border.Style><Style TargetType="Border">
      <Setter Property="Background" Value="#EC4899"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity=".25" Color="#EC4899"/></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
       <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
       <Setter Property="Effect" Value="{x:Null}"/>
      </Trigger></Style.Triggers>
     </Style></Border.Style>
     <Border.RenderTransform><ScaleTransform
      ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton,Converter={StaticResource Film.Scale},ConverterParameter=0.1}"
      ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=HitButton,Converter={StaticResource Film.Scale},ConverterParameter=0.1}"/>
     </Border.RenderTransform>
     <TextBlock Text="{Binding Score}" Foreground="White" FontSize="12" FontWeight="ExtraBold"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
   </Grid>
   <TextBlock Text="{Binding Title}" Margin="0,9,0,0" Height="21"
              Foreground="{DynamicResource MeowFilm.Brush.Text}"
              FontSize="15" FontWeight="ExtraBold" TextAlignment="Center"
              TextTrimming="CharacterEllipsis"/>
  </StackPanel>
 </Button>
</UserControl>
