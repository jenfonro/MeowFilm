<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:desktop="using:MeowFilm.Desktop" xmlns:local="using:MeowFilm.Capabilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MeowFilm.Capabilities.FilmView" Background="Transparent" UseLayoutRounding="True" x:Name="FilmRoot">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="Film.FilterBorder" Color="Transparent" />
     <Thickness x:Key="Film.FilterBorderThickness">0</Thickness>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="Film.FilterBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
     <Thickness x:Key="Film.FilterBorderThickness">1</Thickness>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style x:Key="Film.MoreButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
    <Setter Property="Foreground" Value="{ThemeResource MeowFilm.Brush.Muted}" />
    <Setter Property="Padding" Value="13,5,11,5" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
   </Style>
   <Style x:Key="Film.ShelfTitleButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
    <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.SectionHeading}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,0,8,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
   </Style>
   <Style x:Key="Film.ShelfRefreshButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.IconButton}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0" />
   </Style>
   <Style x:Key="Film.PageButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
    <Setter Property="MinWidth" Value="128" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="CornerRadius" Value="22" />
   </Style>
   <Style x:Key="Film.FilterGroup" TargetType="Border" BasedOn="{StaticResource MeowFilm.FilterGroup}">
    <Setter Property="BorderBrush" Value="{ThemeResource Film.FilterBorder}" />
    <Setter Property="BorderThickness" Value="{ThemeResource Film.FilterBorderThickness}" />
   </Style>
   <Style x:Key="Film.FilterChip" TargetType="ToggleButton" BasedOn="{StaticResource MeowFilm.FilterChip}">
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="ToggleButton">
       <Grid>
        <VisualStateManager.VisualStateGroups>
         <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="FilmFilterContent.Background" Value="{ThemeResource MeowFilm.Brush.Hover}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="FilmFilterContent.Background" Value="{ThemeResource MeowFilm.Brush.Pressed}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="FilmFilterContent.Opacity" Value="0.6" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Checked"><VisualState.Setters>
           <Setter Target="FilmFilterContent.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}" />
           <Setter Target="FilmFilterContent.Foreground" Value="{ThemeResource MeowFilm.Brush.AccentText}" />
          </VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPointerOver"><VisualState.Setters>
           <Setter Target="FilmFilterContent.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}" />
           <Setter Target="FilmFilterContent.Foreground" Value="{ThemeResource MeowFilm.Brush.AccentText}" />
          </VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPressed"><VisualState.Setters>
           <Setter Target="FilmFilterContent.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}" />
           <Setter Target="FilmFilterContent.Foreground" Value="{ThemeResource MeowFilm.Brush.AccentText}" />
          </VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedDisabled"><VisualState.Setters>
           <Setter Target="FilmFilterContent.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}" />
           <Setter Target="FilmFilterContent.Foreground" Value="{ThemeResource MeowFilm.Brush.AccentText}" />
           <Setter Target="FilmFilterContent.Opacity" Value="0.6" />
          </VisualState.Setters></VisualState>
         </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ContentPresenter x:Name="FilmFilterContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
       </Grid>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <local:FilmActionNameConverter x:Key="Film.ActionName" />
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Background="Transparent">
  <desktop:NoticeOutlet x:Name="Notices" />
  <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource MeowFilm.OverlayScrollViewer}" Visibility="{x:Bind Module.IsHome, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
   <ItemsControl ItemsSource="{x:Bind Module.Sections}" Margin="40,12,40,20">
    <ItemsControl.ItemsPanel>
     <ItemsPanelTemplate>
      <StackPanel />
     </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate x:DataType="local:FilmHomeSection">
      <StackPanel Margin="0,0,0,28">
       <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
         <ColumnDefinition />
         <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Tag="{x:Bind}" Click="More_Click" Style="{StaticResource Film.ShelfTitleButton}" AutomationProperties.Name="{x:Bind Title, Converter={StaticResource Film.ActionName}, ConverterParameter=查看更多}">
         <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind Title}" FontSize="{StaticResource MeowFilm.Font.Size.SectionHeading}" VerticalAlignment="Center" /><FontIcon Glyph="&#xE76C;" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Grid.Column="1" Click="HomeRefresh_Click" Style="{StaticResource Film.ShelfRefreshButton}" IsEnabled="{x:Bind CanRefresh, Mode=OneWay}" AutomationProperties.Name="{x:Bind Title, Converter={StaticResource Film.ActionName}, ConverterParameter=刷新}"><FontIcon Glyph="&#xE72C;" FontSize="16" /></Button>
       </Grid>
       <local:FilmShelf ItemActivated="Shelf_ItemActivated" RetryRequested="Shelf_RetryRequested" />
      </StackPanel>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <ScrollViewer x:Name="FilmDataPage" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource MeowFilm.OverlayScrollViewer}" Visibility="{x:Bind Module.IsData, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
   <StackPanel Margin="40,12,40,36">
    <Grid Margin="0,0,0,16">
     <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
     </Grid.ColumnDefinitions>
     <TextBlock x:Name="DataTitle" Text="{x:Bind Module.ActiveData.Title, Mode=OneWay}" Style="{StaticResource MeowFilm.SectionHeading}" />
     <Button Grid.Column="1" Content="刷新" Click="DataRefresh_Click" Style="{StaticResource Film.MoreButton}" IsEnabled="{x:Bind Module.ActiveData.CanRefresh, Mode=OneWay}" AutomationProperties.Name="刷新影片数据" />
    </Grid>
    <Border Margin="0,0,0,20">
     <ItemsControl x:Name="DataFilters" ItemsSource="{x:Bind Module.ActiveData.FilterRows, Mode=OneWay}">
      <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate>
        <StackPanel />
       </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="local:FilmFilterRow">
        <Grid Margin="0,5">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <TextBlock Text="{x:Bind Label}" Style="{StaticResource MeowFilm.FilterLabel}" />
         <Border Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource Film.FilterGroup}">
          <ItemsControl ItemsSource="{x:Bind Options}">
           <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
             <desktop:WrapPanel />
            </ItemsPanelTemplate>
           </ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:FilmFilterOption">
             <ToggleButton Content="{x:Bind Label}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Style="{StaticResource Film.FilterChip}" Click="Filter_Click" AutomationProperties.Name="{x:Bind AutomationName}" />
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </Border>
        </Grid>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </Border>
    <Grid MinHeight="260">
     <ProgressRing x:Name="DataLoadingRing" x:Load="{x:Bind Module.ActiveData.ShowLoading, Mode=OneWay, FallbackValue=False}" IsActive="True" />
     <ItemsControl x:Name="DataItems" ItemsSource="{x:Bind Module.ActiveData.Items, Mode=OneWay}" AutomationProperties.Name="影片列表" Visibility="{x:Bind Module.ActiveData.HasItems, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
      <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate>
        <local:AdaptiveCardPanel />
       </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="local:FilmCardItem">
        <local:FilmCard Activated="DataCard_Activated" />
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind Module.ActiveData.ShowStatus, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
      <TextBlock Text="{x:Bind Module.ActiveData.StatusText, Mode=OneWay}" Foreground="{ThemeResource MeowFilm.Brush.Muted}" FontSize="15" TextAlignment="Center" />
      <Button Content="重试" Margin="0,14,0,0" Style="{StaticResource Film.PageButton}" Visibility="{x:Bind Module.ActiveData.CanRetry, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" Click="DataRetry_Click" AutomationProperties.Name="重试加载影片数据" />
     </StackPanel>
    </Grid>
    <Button x:Name="DataPageAction" HorizontalAlignment="Center" Content="{x:Bind Module.ActiveData.PageActionText, Mode=OneWay}" IsEnabled="{x:Bind Module.ActiveData.CanPage, Mode=OneWay}" Visibility="{x:Bind Module.ActiveData.ShowPageAction, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" Style="{StaticResource Film.PageButton}" Click="DataPageAction_Click" AutomationProperties.Name="加载更多影片" />
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="PlaybackPage" Background="Transparent" Visibility="{x:Bind Module.IsPlayback, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
   <local:FilmPlaybackView x:Name="PlaybackView" DataContext="{x:Bind Module.Playback, Mode=OneWay}" Visibility="{x:Bind Module.HasPlayback, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" RecommendationRequested="Playback_RecommendationRequested" />
   <TextBlock x:Name="PlaybackEmpty" Text="尚未选择影片" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource MeowFilm.Brush.Muted}" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind Module.HasPlayback, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}, ConverterParameter=Not}">
     </TextBlock>
  </Grid>
 </Grid>
</UserControl>
