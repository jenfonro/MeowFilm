<UserControl xmlns:desktop="using:MeowFilm.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="using:MeowFilm.Capabilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MeowFilm.Capabilities.FilmSettingsRuleEditor" x:Name="Root">
 <UserControl.Resources>
  <ResourceDictionary>
   <local:FilmVisibilityConverter x:Key="Film.Visible" />
   <local:FilmEmptyConverter x:Key="Film.Empty" />
  </ResourceDictionary>
 </UserControl.Resources>
 <StackPanel Margin="0,0,0,12" Spacing="8">
  <TextBlock Text="{Binding Title,ElementName=Root}" />
  <Grid ColumnSpacing="8">
   <Grid.ColumnDefinitions>
    <ColumnDefinition />
    <ColumnDefinition Width="Auto" />
   </Grid.ColumnDefinitions>
   <StackPanel Spacing="8">
    <TextBox x:Name="NewPattern" Header="新正则" AutomationProperties.Name="新增正则" />
    <TextBox x:Name="NewReplace" Header="替换" AutomationProperties.Name="新增替换" Visibility="{Binding HasReplacement,ElementName=Root,Converter={StaticResource Film.Visible}}" />
   </StackPanel>
   <Button x:Name="AddButton" Grid.Column="1" Content="添加" Style="{StaticResource Settings.PrimaryButton}" Click="Add_Click" VerticalAlignment="Bottom" Margin="0,0,0,2" />
  </Grid>
  <ItemsControl x:Name="RuleList" ItemsSource="{Binding Rows,ElementName=Root}">
   <ItemsControl.ItemTemplate>
    <DataTemplate>
     <Border Style="{StaticResource Settings.RuleSurface}" Margin="0,0,0,8">
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="24" />
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Number}" VerticalAlignment="Top" Margin="0,8,0,0" />
       <StackPanel Grid.Column="1" Spacing="8">
        <TextBox Text="{Binding Pattern,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding PatternLabel}" />
        <TextBox Text="{Binding Replace,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ReplaceLabel}" Visibility="{Binding HasReplacement,Converter={StaticResource Film.Visible}}" />
        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Visibility="{Binding Preview,Converter={StaticResource Film.Visible}}" />
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0" Spacing="8">
        <Button Content="保存" Style="{StaticResource Settings.Button}" Click="Save_Click" AutomationProperties.Name="{Binding SaveLabel}" />
        <Button Content="删除" Style="{StaticResource Settings.DangerButton}" Click="Delete_Click" AutomationProperties.Name="{Binding DeleteLabel}" />
       </StackPanel>
      </Grid>
     </Border>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="暂无规则" Visibility="{Binding Rows.Count,ElementName=Root,Converter={StaticResource Film.Empty}}" />
 </StackPanel>
</UserControl>
