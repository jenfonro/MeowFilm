<UserControl x:Class="MeowFilm.Capabilities.FilmSettingsRuleEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 x:Name="Root">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MeowFilm.Capabilities;component/Film/Presentation/FilmSettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="Rule.Pattern" TargetType="TextBox" BasedOn="{StaticResource Settings.TextBox}">
    <Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
   </Style>
   <Style x:Key="Rule.Replace" TargetType="TextBox" BasedOn="{StaticResource Rule.Pattern}">
    <Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers>
     <Trigger Property="local:FilmSettingsRuleEditor.HasReplacement" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="local:SettingsLayout.IsNarrow" Value="True"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Margin" Value="0,8,0,0"/></Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Rule.ReplaceColumn" TargetType="ColumnDefinition">
    <Setter Property="Width" Value="0"/>
    <Style.Triggers>
     <Trigger Property="local:FilmSettingsRuleEditor.HasReplacement" Value="True"><Setter Property="Width" Value="160"/></Trigger>
     <Trigger Property="local:SettingsLayout.IsNarrow" Value="True"><Setter Property="Width" Value="0"/></Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Rule.Preview" TargetType="TextBlock" BasedOn="{StaticResource Settings.Subtitle}">
    <Setter Property="Margin" Value="0,6,0,0"/><Setter Property="TextWrapping" Value="Wrap"/>
    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <StackPanel Margin="0,0,0,12">
  <TextBlock Text="{Binding Title,ElementName=Root}" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <Grid Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Style="{StaticResource Rule.ReplaceColumn}"/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="新正则" Style="{StaticResource Settings.Subtitle}" Margin="0,0,0,6"/>
   <TextBlock Text="替换" Grid.Column="1" Margin="8,0,0,6">
    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Settings.Subtitle}">
     <Setter Property="Visibility" Value="Collapsed"/>
     <Style.Triggers>
      <DataTrigger Binding="{Binding HasReplacement,ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      <Trigger Property="local:SettingsLayout.IsNarrow" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
     </Style.Triggers>
    </Style></TextBlock.Style>
   </TextBlock>
   <TextBox x:Name="NewPattern" Grid.Row="1" Style="{StaticResource Rule.Pattern}" AutomationProperties.Name="{Binding Title,ElementName=Root,StringFormat='新增{0}正则'}"/>
   <TextBox x:Name="NewReplace" AutomationProperties.Name="{Binding Title,ElementName=Root,StringFormat='新增{0}替换'}">
    <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource Rule.Replace}">
     <Setter Property="Grid.Row" Value="1"/>
     <Style.Triggers><Trigger Property="local:SettingsLayout.IsNarrow" Value="True"><Setter Property="Grid.Row" Value="2"/></Trigger></Style.Triggers>
    </Style></TextBox.Style>
   </TextBox>
   <Button x:Name="AddButton" Content="添加" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right"
           Style="{StaticResource Settings.PrimaryButton}" Click="Add_Click" AutomationProperties.Name="{Binding Title,ElementName=Root,StringFormat='添加{0}'}"/>
  </Grid>
  <ItemsControl x:Name="RuleList" ItemsSource="{Binding Rows,ElementName=Root}" AutomationProperties.Name="{Binding Title,ElementName=Root}">
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource Settings.RuleSurface}" Margin="0,0,0,8">
     <DockPanel>
      <TextBlock Text="{Binding Number,StringFormat={}{0}.}" Width="24" Margin="0,8,8,0" VerticalAlignment="Top" TextAlignment="Right" Style="{StaticResource Settings.Subtitle}"/>
     <StackPanel>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Style="{StaticResource Rule.ReplaceColumn}"/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBox Text="{Binding Pattern,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Rule.Pattern}" AutomationProperties.Name="{Binding PatternLabel}"/>
       <TextBox Text="{Binding Replace,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Rule.Replace}" AutomationProperties.Name="{Binding ReplaceLabel}"/>
       <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Content="保存" Style="{StaticResource Settings.PrimaryButton}" Click="Save_Click" AutomationProperties.Name="{Binding SaveLabel}"/>
        <Button Content="删除" Margin="8,0,0,0" Style="{StaticResource Settings.DangerButton}" Click="Delete_Click" AutomationProperties.Name="{Binding DeleteLabel}"/>
       </StackPanel>
      </Grid>
      <TextBlock Text="{Binding Preview}" Style="{StaticResource Rule.Preview}"/>
     </StackPanel>
     </DockPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="暂无规则" Margin="0,8">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Settings.Subtitle}">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers><DataTrigger Binding="{Binding Rows.Count,ElementName=Root}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
   </Style></TextBlock.Style>
  </TextBlock>

 </StackPanel>
</UserControl>
