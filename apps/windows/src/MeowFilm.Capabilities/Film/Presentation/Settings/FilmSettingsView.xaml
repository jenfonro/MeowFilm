<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:desktop="using:MeowFilm.Desktop" xmlns:local="using:MeowFilm.Capabilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MeowFilm.Capabilities.FilmSettingsView" x:Name="Root" UseLayoutRounding="True" Loaded="View_Loaded" Unloaded="View_Unloaded" SizeChanged="View_SizeChanged" Foreground="{ThemeResource MeowFilm.Brush.Text}">
 <UserControl.Resources>
  <ResourceDictionary>
   <DataTemplate x:Key="FilmSettings.RuleResultLine" x:DataType="local:FilmRuleResultLine">
    <TextBlock Text="{x:Bind Display}" Style="{StaticResource Settings.Text}" TextWrapping="Wrap" Margin="0,3,0,0" AutomationProperties.Name="{x:Bind Name}" />
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Cat.Name" x:DataType="local:FilmSettingsCatRow">
    <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource FilmSettings.CellText}" VerticalAlignment="Center" Margin="6,0" />
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Cat.Type" x:DataType="local:FilmSettingsCatRow">
    <TextBlock Text="{x:Bind TypeText, Mode=OneWay}" Style="{StaticResource FilmSettings.CellText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" />
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Cat.State" x:DataType="local:FilmSettingsCatRow">
    <desktop:ManagementStatus Content="{x:Bind StateText, Mode=OneWay}" Tone="{x:Bind StateTone, Mode=OneWay}" HorizontalAlignment="Center" Margin="6,0" AutomationProperties.Name="{x:Bind StateAccessibleName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind ErrorHelpText, Mode=OneWay}" />
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Cat.Enabled" x:DataType="local:FilmSettingsCatRow">
    <CheckBox IsChecked="{x:Bind Enabled, Mode=OneWay}" Click="CatEnabled_Click" Style="{StaticResource MeowFilm.Switch}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind EnabledAccessibleName, Mode=OneWay}" />
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Cat.Modified" x:DataType="local:FilmSettingsCatRow">
    <TextBlock Text="{x:Bind ModifiedText, Mode=OneWay}" Style="{StaticResource FilmSettings.CellText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" />
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Cat.Update" x:DataType="local:FilmSettingsCatRow">
    <desktop:ManagementStatus Content="{x:Bind UpdateText, Mode=OneWay}" Tone="{x:Bind UpdateTone, Mode=OneWay}" HorizontalAlignment="Center" Margin="6,0" AutomationProperties.Name="{x:Bind UpdateAccessibleName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind UpdateErrorHelpText, Mode=OneWay}" />
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Cat.Actions" x:DataType="local:FilmSettingsCatRow">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
     <Button Content="编辑" Style="{StaticResource MeowFilm.ManagementRowButton}" Padding="8,0" Click="EditCat_Click" AutomationProperties.Name="{x:Bind EditAccessibleName, Mode=OneWay}" />
     <Button Content="更新" Style="{StaticResource MeowFilm.ManagementRowButton.Primary}" Padding="8,0" Click="UpdateCat_Click" AutomationProperties.Name="{x:Bind UpdateActionAccessibleName, Mode=OneWay}" />
     <Button Content="重启" Style="{StaticResource MeowFilm.ManagementRowButton}" Padding="8,0" IsEnabled="{x:Bind CanRestart, Mode=OneWay}" Click="RestartCat_Click" AutomationProperties.Name="{x:Bind RestartAccessibleName, Mode=OneWay}" />
     <Button Content="删除" Style="{StaticResource MeowFilm.ManagementRowButton.Danger}" Padding="8,0" Click="DeleteCat_Click" AutomationProperties.Name="{x:Bind DeleteAccessibleName, Mode=OneWay}" />
    </StackPanel>
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Video.Name" x:DataType="local:FilmSettingsVideoRow">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
     <Border Style="{StaticResource FilmSettings.AggregateBadge}" CornerRadius="4" BorderThickness="1" Margin="0,0,6,0" Padding="0,2" Visibility="{x:Bind AggregateImages, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
      <TextBlock Text="聚合" Style="{StaticResource FilmSettings.AggregateText}" Margin="6,0" />
     </Border>
     <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource FilmSettings.CellText}" VerticalAlignment="Center" Margin="0" />
    </StackPanel>
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Video.State" x:DataType="local:FilmSettingsVideoRow">
    <desktop:ManagementStatus Content="{x:Bind StateText, Mode=OneWay}" Tone="{x:Bind StateTone, Mode=OneWay}" IsTabStop="{x:Bind HasDiagnostics, Mode=OneWay}" Click="VideoStatus_Click" HorizontalAlignment="Center" Margin="6,0" AutomationProperties.Name="{x:Bind StateAccessibleName, Mode=OneWay}" />
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Video.Enabled" x:DataType="local:FilmSettingsVideoRow">
    <CheckBox Tag="enabled" IsChecked="{x:Bind Enabled, Mode=OneWay}" Click="VideoOption_Click" Style="{StaticResource MeowFilm.Switch}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind EnabledAccessibleName, Mode=OneWay}" />
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Video.Home" x:DataType="local:FilmSettingsVideoRow">
    <CheckBox Tag="home" IsChecked="{x:Bind HomeVisible, Mode=OneWay}" Click="VideoOption_Click" Style="{StaticResource MeowFilm.ManagementCheck}" Padding="0" MinHeight="0" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind HomeAccessibleName, Mode=OneWay}" />
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Video.Search" x:DataType="local:FilmSettingsVideoRow">
    <CheckBox Tag="search" IsChecked="{x:Bind SearchEnabled, Mode=OneWay}" Click="VideoOption_Click" Style="{StaticResource MeowFilm.ManagementCheck}" Padding="0" MinHeight="0" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind SearchAccessibleName, Mode=OneWay}" />
   </DataTemplate>
   <DataTemplate x:Key="FilmSettings.Video.Actions" x:DataType="local:FilmSettingsVideoRow">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
     <Button Content="检测" Style="{StaticResource MeowFilm.ManagementRowButton}" Padding="8,0" IsEnabled="{x:Bind CanDetect, Mode=OneWay}" Click="DetectVideo_Click" AutomationProperties.Name="{x:Bind DetectAccessibleName, Mode=OneWay}" />
     <Button Content="删除" Style="{StaticResource MeowFilm.ManagementRowButton.Danger}" Padding="8,0" Click="DeleteVideo_Click" AutomationProperties.Name="{x:Bind DeleteAccessibleName, Mode=OneWay}" />
     <Button Content="···" Style="{StaticResource MeowFilm.ManagementRowButton}" Padding="8,0" AutomationProperties.Name="{x:Bind MoreAccessibleName, Mode=OneWay}">
      <Button.Flyout>
       <MenuFlyout Placement="BottomEdgeAlignedLeft">
        <ToggleMenuFlyoutItem Text="设置聚合图片" Tag="{x:Bind}" IsChecked="{x:Bind AggregateImages, Mode=OneWay}" Click="VideoAggregate_Click" />
       </MenuFlyout>
      </Button.Flyout>
     </Button>
    </StackPanel>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <UserControl.Background><ThemeResource ResourceKey="Film.SettingsGround" /></UserControl.Background>
 <Grid x:Name="ContentFrame" Style="{StaticResource MeowFilm.SettingsPage}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition />
  </Grid.RowDefinitions>
  <Border Style="{StaticResource MeowFilm.SettingsNavigationBar}">
   <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
    <StackPanel x:Name="SettingsNavigation" Orientation="Horizontal" AutomationProperties.Name="影视设置分类">
     <RadioButton Content="魔法匹配" Tag="rules" GroupName="FilmSettingsSection" IsChecked="True" Style="{StaticResource MeowFilm.SettingsArea}" Checked="Section_Checked" AutomationProperties.Name="魔法匹配" KeyDown="Section_KeyDown" />
     <RadioButton Content="猫源管理" Tag="cats" GroupName="FilmSettingsSection" Style="{StaticResource MeowFilm.SettingsArea}" Checked="Section_Checked" AutomationProperties.Name="猫源管理" KeyDown="Section_KeyDown" />
     <RadioButton Content="视频源管理" Tag="videos" GroupName="FilmSettingsSection" Style="{StaticResource MeowFilm.SettingsArea}" Checked="Section_Checked" AutomationProperties.Name="视频源管理" KeyDown="Section_KeyDown" />
     <RadioButton Content="数据源" Tag="metadata" GroupName="FilmSettingsSection" Style="{StaticResource MeowFilm.SettingsArea}" Checked="Section_Checked" AutomationProperties.Name="数据源设置" Visibility="{x:Bind HasMetadataSettings, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" KeyDown="Section_KeyDown" />
     <RadioButton Content="网盘账号" Tag="pan" GroupName="FilmSettingsSection" Style="{StaticResource MeowFilm.SettingsArea}" Checked="Section_Checked" AutomationProperties.Name="网盘账号" KeyDown="Section_KeyDown" />
     <RadioButton Content="内置网盘接管" Tag="pan-routing" GroupName="FilmSettingsSection" Style="{StaticResource MeowFilm.SettingsArea}" Checked="Section_Checked" AutomationProperties.Name="内置网盘接管" KeyDown="Section_KeyDown" />
     <StackPanel x:Name="BusinessNavigation" Orientation="Horizontal" Visibility="Collapsed">
      <RadioButton Content="智能播放设置" Tag="preferences" GroupName="FilmSettingsSection" Style="{StaticResource MeowFilm.SettingsArea}" Checked="Section_Checked" KeyDown="Section_KeyDown" />
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <Grid x:Name="MetadataPage" Grid.Row="1" Visibility="Collapsed">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition />
   </Grid.RowDefinitions>
   <Button Content="重试" Click="MetadataRetry_Click" Style="{StaticResource Settings.Button}" Margin="0,8,0,0" HorizontalAlignment="Left" Visibility="{x:Bind MetadataFailed, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" IsEnabled="{x:Bind MetadataIdle, Mode=OneWay}" AutomationProperties.Name="重新读取数据源设置" />
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource MeowFilm.SettingsScrollViewer}" AutomationProperties.Name="数据源配置">
    <ContentControl IsEnabled="{x:Bind MetadataLoaded, Mode=OneWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
     <StackPanel Visibility="{x:Bind MetadataLoaded, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
      <Border Style="{StaticResource Settings.Section}">
       <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
         <TextBlock Text="豆瓣配置" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center" />
         <Button Content="保存" Tag="douban" Click="MetadataSave_Click" Style="{StaticResource Settings.PrimaryButton}" Margin="12,0,0,0" AutomationProperties.Name="保存豆瓣设置" />
        </StackPanel>
        <TextBlock Text="豆瓣数据代理" Margin="0,0,0,8" />
        <ComboBox x:Name="DoubanDataProxy" ItemsSource="{x:Bind DoubanDataRoutes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="DoubanRoute_Changed" Style="{StaticResource MeowFilm.SettingsComboBox}" AutomationProperties.Name="豆瓣数据代理" />
        <StackPanel x:Name="DoubanDataAddressField" Visibility="Collapsed">
         <TextBlock Text="豆瓣代理地址" Margin="0,12,0,8" />
         <TextBox x:Name="DoubanDataAddress" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="豆瓣代理地址" />
        </StackPanel>
        <TextBlock Text="豆瓣图片代理" Margin="0,12,0,8" />
        <ComboBox x:Name="DoubanImageProxy" ItemsSource="{x:Bind DoubanImageRoutes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="DoubanRoute_Changed" Style="{StaticResource MeowFilm.SettingsComboBox}" AutomationProperties.Name="豆瓣图片代理" />
        <StackPanel x:Name="DoubanImageAddressField" Visibility="Collapsed">
         <TextBlock Text="豆瓣图片代理地址" Margin="0,12,0,8" />
         <TextBox x:Name="DoubanImageAddress" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="豆瓣图片代理地址" />
        </StackPanel>
        <TextBlock Text="豆瓣搜索 Cookie" Margin="0,12,0,8" />
        <TextBox x:Name="DoubanCookie" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="豆瓣搜索 Cookie" />
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Settings.Section}">
       <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
         <TextBlock Text="TMDB 设置" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center" />
         <Button x:Name="MetadataSave" Content="保存" Tag="tmdb" Click="MetadataSave_Click" Style="{StaticResource Settings.PrimaryButton}" Margin="12,0,0,0" AutomationProperties.Name="保存 TMDB 设置" />
        </StackPanel>
        <TextBlock Text="TMDB API 密钥" Margin="0,0,0,8" />
        <TextBox x:Name="MetadataApiToken" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="TMDB API 密钥" />
        <TextBlock Text="TMDB 数据代理地址" Margin="0,12,0,8" />
        <TextBox x:Name="MetadataApiBase" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="TMDB 数据代理地址" />
        <TextBlock Text="TMDB 图片代理地址" Margin="0,12,0,8" />
        <TextBox x:Name="MetadataImageBase" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="TMDB 图片代理地址" />
        <Grid Margin="0,12,0,0" local:SettingsLayout.Mode="Pair">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
         </Grid.RowDefinitions>
         <StackPanel Grid.Column="0">
          <TextBlock Text="语言" Margin="0,0,0,8" />
          <TextBox x:Name="MetadataLanguage" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="TMDB 语言" />
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="地区" Margin="0,0,0,8" />
          <TextBox x:Name="MetadataRegion" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="TMDB 地区" />
         </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
         <TextBlock Text="包含成人内容" VerticalAlignment="Center" Margin="0,0,12,0" />
         <CheckBox x:Name="MetadataIncludeAdult" Style="{StaticResource MeowFilm.Switch}" AutomationProperties.Name="包含成人内容" />
        </StackPanel>
       </StackPanel>
      </Border>
     </StackPanel>
    </ContentControl>
   </ScrollViewer>
  </Grid>
  <Grid x:Name="BusinessPage" Grid.Row="1" Visibility="Collapsed" />
  <local:PanAccountsView x:Name="PanPage" Grid.Row="1" Visibility="Collapsed" />
  <ScrollViewer x:Name="PanInterceptionPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource MeowFilm.SettingsScrollViewer}" AutomationProperties.Name="内置网盘接管设置">
   <StackPanel>
    <Button Content="重试" Click="SourcesRetry_Click" Style="{StaticResource Settings.Button}" Visibility="{x:Bind SourcesFailed, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" IsEnabled="{x:Bind SourcesIdle, Mode=OneWay}" AutomationProperties.Name="重新读取内置网盘接管设置" />
    <Border Style="{StaticResource Settings.Section}">
     <StackPanel>
      <TextBlock Text="内置网盘接管" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,12" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
       <TextBlock Text="百度网盘" Width="120" VerticalAlignment="Center" />
       <CheckBox x:Name="BaiduInterception" Tag="baidu" IsEnabled="{x:Bind CanEditPanInterception, Mode=OneWay}" Style="{StaticResource MeowFilm.Switch}" Click="PanInterception_Click" AutomationProperties.Name="百度网盘内置接管" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
       <TextBlock Text="夸克网盘" Width="120" VerticalAlignment="Center" />
       <CheckBox x:Name="QuarkInterception" Tag="quark" IsEnabled="{x:Bind CanEditPanInterception, Mode=OneWay}" Style="{StaticResource MeowFilm.Switch}" Click="PanInterception_Click" AutomationProperties.Name="夸克网盘内置接管" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
       <TextBlock Text="UC 网盘" Width="120" VerticalAlignment="Center" />
       <CheckBox x:Name="UcInterception" Tag="uc" IsEnabled="{x:Bind CanEditPanInterception, Mode=OneWay}" Style="{StaticResource MeowFilm.Switch}" Click="PanInterception_Click" AutomationProperties.Name="UC 网盘内置接管" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
       <TextBlock Text="天翼云盘" Width="120" VerticalAlignment="Center" />
       <CheckBox x:Name="TianyiInterception" Tag="tianyi" IsEnabled="{x:Bind CanEditPanInterception, Mode=OneWay}" Style="{StaticResource MeowFilm.Switch}" Click="PanInterception_Click" AutomationProperties.Name="天翼云盘内置接管" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="移动云盘" Width="120" VerticalAlignment="Center" />
       <CheckBox x:Name="YidongInterception" Tag="yidong" IsEnabled="{x:Bind CanEditPanInterception, Mode=OneWay}" Style="{StaticResource MeowFilm.Switch}" Click="PanInterception_Click" AutomationProperties.Name="移动云盘内置接管" />
      </StackPanel>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="RulesPage" Grid.Row="1">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition />
   </Grid.RowDefinitions>
   <Button Content="重试" Click="RulesRetry_Click" Style="{StaticResource Settings.Button}" Margin="0,8,0,0" HorizontalAlignment="Left" Visibility="{x:Bind RulesFailed, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" IsEnabled="{x:Bind RulesIdle, Mode=OneWay}" AutomationProperties.Name="重新读取魔法规则" />
   <ScrollViewer x:Name="RulesScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource MeowFilm.SettingsScrollViewer}" AutomationProperties.Name="魔法匹配设置">
    <StackPanel>
     <ContentControl IsEnabled="{x:Bind RulesLoaded, Mode=OneWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
      <StackPanel x:Name="RuleSections" Visibility="{x:Bind RulesLoaded, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
       <Border Style="{StaticResource Settings.Section}">
        <StackPanel>
         <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="恢复默认规则" Tag="Episode" Click="RestoreRules_Click" Style="{StaticResource Settings.QuietButton}" AutomationProperties.Name="恢复列表净化默认规则" Grid.Column="1" />
          <Grid Grid.Column="0">
           <TextBlock Text="列表净化设置" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center" />
          </Grid>
         </Grid>
         <local:FilmSettingsRuleEditor x:Name="EpisodeCleanEditor" Title="剧集列表净化规则" Tag="episodeClean" />
         <local:FilmSettingsRuleEditor x:Name="EpisodeEditor" Title="集数匹配规则" Tag="episode" HasReplacement="True" />
         <TextBlock Text="文件名" Margin="0,0,0,8" />
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="测试" Tag="Episode" Style="{StaticResource Settings.Button}" Margin="12,0,0,0" Click="TestRules_Click" AutomationProperties.Name="测试列表净化与集数匹配" Grid.Column="1" />
          <Grid Grid.Column="0">
           <TextBox x:Name="EpisodeInput" Style="{StaticResource Settings.TextBox}" TextChanged="RuleInput_Changed" AutomationProperties.Name="列表净化测试文件名" />
          </Grid>
         </Grid>
         <ItemsControl x:Name="EpisodeResults" ItemsSource="{x:Bind EpisodeResultLines}" ItemTemplate="{StaticResource FilmSettings.RuleResultLine}" Margin="0,10,0,0" IsTabStop="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="列表净化测试结果" />
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Settings.Section}">
        <StackPanel>
         <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="恢复默认规则" Tag="Movie" Click="RestoreRules_Click" Style="{StaticResource Settings.QuietButton}" AutomationProperties.Name="恢复电影匹配默认规则" Grid.Column="1" />
          <Grid Grid.Column="0">
           <TextBlock Text="电影匹配设置" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center" />
          </Grid>
         </Grid>
         <local:FilmSettingsRuleEditor x:Name="MovieEditor" Title="电影匹配规则" Tag="movie" HasReplacement="True" />
         <TextBlock Text="文件名" Margin="0,0,0,8" />
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="测试" Tag="Movie" Style="{StaticResource Settings.Button}" Margin="12,0,0,0" Click="TestRules_Click" AutomationProperties.Name="测试电影匹配" Grid.Column="1" />
          <Grid Grid.Column="0">
           <TextBox x:Name="MovieInput" Style="{StaticResource Settings.TextBox}" TextChanged="RuleInput_Changed" AutomationProperties.Name="电影匹配测试文件名" />
          </Grid>
         </Grid>
         <ItemsControl x:Name="MovieResults" ItemsSource="{x:Bind MovieResultLines}" ItemTemplate="{StaticResource FilmSettings.RuleResultLine}" Margin="0,10,0,0" IsTabStop="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="电影匹配测试结果" />
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Settings.Section}">
        <StackPanel>
         <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="恢复默认规则" Tag="Search" Click="RestoreRules_Click" Style="{StaticResource Settings.QuietButton}" AutomationProperties.Name="恢复搜索列表净化默认规则" Grid.Column="1" />
          <Grid Grid.Column="0">
           <TextBlock Text="搜索列表净化设置" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center" />
          </Grid>
         </Grid>
         <local:FilmSettingsRuleEditor x:Name="SearchEditor" Title="搜索列表净化规则" Tag="search" />
         <TextBlock Text="搜索词（可空）" Margin="0,0,0,8" />
         <TextBox x:Name="SearchQuery" Style="{StaticResource Settings.TextBox}" TextChanged="RuleInput_Changed" AutomationProperties.Name="搜索列表净化测试搜索词" />
         <TextBlock Text="结果标题" Margin="0,12,0,8" />
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="测试" Tag="Search" Style="{StaticResource Settings.Button}" Margin="12,0,0,0" Click="TestRules_Click" AutomationProperties.Name="测试搜索列表净化" Grid.Column="1" />
          <Grid Grid.Column="0">
           <TextBox x:Name="SearchInput" Style="{StaticResource Settings.TextBox}" TextChanged="RuleInput_Changed" AutomationProperties.Name="搜索列表净化测试结果标题" />
          </Grid>
         </Grid>
         <ItemsControl x:Name="SearchResults" ItemsSource="{x:Bind SearchResultLines}" ItemTemplate="{StaticResource FilmSettings.RuleResultLine}" Margin="0,10,0,0" IsTabStop="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="搜索列表净化测试结果" />
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Settings.Section}">
        <StackPanel>
         <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="恢复默认规则" Tag="Season" Click="RestoreRules_Click" Style="{StaticResource Settings.QuietButton}" AutomationProperties.Name="恢复原始标题季度提取默认规则" Grid.Column="1" />
          <Grid Grid.Column="0">
           <TextBlock Text="原始标题季度提取设置" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center" />
          </Grid>
         </Grid>
         <local:FilmSettingsRuleEditor x:Name="SeasonEditor" Title="原始标题季度提取规则" Tag="season" HasReplacement="True" />
         <TextBlock Text="基础片名（可空）" Margin="0,0,0,8" />
         <TextBox x:Name="SeasonQuery" Style="{StaticResource Settings.TextBox}" TextChanged="RuleInput_Changed" AutomationProperties.Name="季度提取测试基础片名" />
         <TextBlock Text="原始标题" Margin="0,12,0,8" />
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="测试" Tag="Season" Style="{StaticResource Settings.Button}" Margin="12,0,0,0" Click="TestRules_Click" AutomationProperties.Name="测试原始标题季度提取" Grid.Column="1" />
          <Grid Grid.Column="0">
           <TextBox x:Name="SeasonInput" Style="{StaticResource Settings.TextBox}" TextChanged="RuleInput_Changed" AutomationProperties.Name="季度提取测试原始标题" />
          </Grid>
         </Grid>
         <ItemsControl x:Name="SeasonResults" ItemsSource="{x:Bind SeasonResultLines}" ItemTemplate="{StaticResource FilmSettings.RuleResultLine}" Margin="0,10,0,0" IsTabStop="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="原始标题季度提取测试结果" />
        </StackPanel>
       </Border>
      </StackPanel>
     </ContentControl>
     <ContentControl x:Name="SiteCleanHost" />
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Grid x:Name="CatsPage" Grid.Row="1" Style="{StaticResource MeowFilm.SettingsBody}" Visibility="Collapsed">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition />
   </Grid.RowDefinitions>
   <StackPanel Style="{StaticResource MeowFilm.ManagementTitleRow}">
    <TextBlock Text="猫源管理" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
    <Button Content="添加本地文件" Style="{StaticResource Settings.PrimaryButton}" Margin="4,0,0,0" IsEnabled="{x:Bind CanEditSources, Mode=OneWay}" Click="ImportLocal_Click" AutomationProperties.Name="添加本地文件" />
    <Button Content="添加网络源" Style="{StaticResource Settings.PrimaryButton}" Margin="4,0,0,0" IsEnabled="{x:Bind CanEditSources, Mode=OneWay}" Click="ImportNetwork_Click" AutomationProperties.Name="添加网络猫源" />
    <Button Content="删除所选" Style="{StaticResource MeowFilm.ManagementDeleteSelected}" IsEnabled="{x:Bind CanDeleteCats, Mode=OneWay}" Click="DeleteSelectedCats_Click" AutomationProperties.Name="删除选中猫源" />
    <Button Content="重试" Click="SourcesRetry_Click" Style="{StaticResource Settings.Button}" Margin="8,0,0,0" Visibility="{x:Bind SourcesFailed, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" IsEnabled="{x:Bind SourcesIdle, Mode=OneWay}" AutomationProperties.Name="重试猫源读取" />
   </StackPanel>
   <desktop:ManagementList x:Name="CatsList" Grid.Row="1" AutomationProperties.Name="猫源列表" />
  </Grid>
  <Grid x:Name="VideosPage" Grid.Row="1" Style="{StaticResource MeowFilm.SettingsBody}" Visibility="Collapsed">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition />
   </Grid.RowDefinitions>
   <StackPanel Style="{StaticResource MeowFilm.ManagementTitleRow}">
    <TextBlock Text="视频源管理" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
    <Button Content="检测所选" Style="{StaticResource Settings.PrimaryButton}" Margin="4,0,0,0" IsEnabled="{x:Bind CanDetectVideos, Mode=OneWay}" Click="DetectSelectedVideos_Click" AutomationProperties.Name="检测选中视频源" />
    <Button Content="删除所选" Style="{StaticResource MeowFilm.ManagementDeleteSelected}" IsEnabled="{x:Bind CanDeleteVideos, Mode=OneWay}" Click="DeleteSelectedVideos_Click" AutomationProperties.Name="删除选中视频源" />
    <Button Content="重试" Click="SourcesRetry_Click" Style="{StaticResource Settings.Button}" Margin="8,0,0,0" Visibility="{x:Bind SourcesFailed, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" IsEnabled="{x:Bind SourcesIdle, Mode=OneWay}" AutomationProperties.Name="重试视频源读取" />
   </StackPanel>
   <desktop:ManagementList x:Name="VideosList" Grid.Row="1" AutomationProperties.Name="视频源列表" />
  </Grid>
  <Grid x:Name="ModalStash" Visibility="Collapsed">
   <Border x:Name="PopupSurface" Width="380" Padding="20" CornerRadius="10" Style="{StaticResource Settings.PopupSurface}" TabFocusNavigation="Cycle">
    <ScrollViewer x:Name="PopupScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel KeyDown="ActionPopup_KeyDown">
      <TextBlock x:Name="PopupTitle" Style="{StaticResource Settings.PopupTitle}" TextWrapping="Wrap" />
      <TextBlock x:Name="PopupMessage" TextWrapping="Wrap" Margin="0,12,0,0" />
      <StackPanel x:Name="PopupFields" Margin="0,16,0,0" Visibility="Collapsed">
       <TextBlock Text="名称" Margin="0,0,0,8" />
       <TextBox x:Name="CatNameBox" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="猫源名称" />
       <StackPanel x:Name="CatTypeField" Margin="0,14,0,0" Visibility="Collapsed">
        <TextBlock Text="类型" Margin="0,0,0,8" />
        <ComboBox x:Name="CatTypeBox" Style="{StaticResource MeowFilm.SettingsComboBox}" SelectionChanged="CatType_Changed" SelectedValuePath="Tag" AutomationProperties.Name="猫源类型">
         <ComboBoxItem Content="本地源" Tag="local" />
         <ComboBoxItem Content="网络源" Tag="network" />
        </ComboBox>
       </StackPanel>
       <StackPanel x:Name="CatUrlField" Margin="0,14,0,0">
        <TextBlock Text="地址" Margin="0,0,0,8" />
        <TextBox x:Name="CatUrlBox" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="猫源网络地址" />
       </StackPanel>
       <StackPanel x:Name="CatFileField" Margin="0,14,0,0" Visibility="Collapsed">
        <TextBlock Text="文件" Margin="0,0,0,8" />
        <Button x:Name="CatFileButton" Content="选择文件" Click="CatFile_Click" Style="{StaticResource Settings.Button}" HorizontalAlignment="Left" AutomationProperties.Name="选择猫源文件" />
       </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
       <Button x:Name="PopupCancel" Content="取消" Style="{StaticResource Settings.QuietButton}" Click="PopupCancel_Click" MinWidth="64" />
       <Button x:Name="PopupAccept" Content="确定" Style="{StaticResource Settings.PrimaryButton}" Click="PopupAccept_Click" MinWidth="64" Margin="8,0,0,0" />
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</UserControl>
