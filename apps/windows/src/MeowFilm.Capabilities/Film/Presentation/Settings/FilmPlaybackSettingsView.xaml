<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:desktop="using:MeowFilm.Desktop" xmlns:local="using:MeowFilm.Capabilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MeowFilm.Capabilities.FilmPlaybackSettingsView" Loaded="View_Loaded" Unloaded="View_Unloaded">
 <UserControl.Resources>
  <ResourceDictionary>
   <Style x:Key="GroupSidebar" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource MeowFilm.Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="6,0,12,0" />
   </Style>
   <DataTemplate x:Key="GroupTemplate" x:DataType="local:FilmSettingGroup">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
     </Grid.ColumnDefinitions>
     <Border BorderBrush="{ThemeResource MeowFilm.Brush.Border}" BorderThickness=".5" CornerRadius="10" Padding="6,2" Margin="8,0,0,0" Grid.Column="1">
      <TextBlock Text="{x:Bind Rows.Count}" FontSize="{StaticResource MeowFilm.Font.Size.Caption}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
     </Border>
     <Grid Grid.Column="0">
      <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
     </Grid>
    </Grid>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition />
  </Grid.RowDefinitions>
  <Button Content="重试" Click="Retry_Click" Style="{StaticResource Settings.Button}" Margin="0,8,0,0" HorizontalAlignment="Left" IsEnabled="{x:Bind CanRetryRead, Mode=OneWay}" Visibility="{x:Bind HasReadFailure, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" AutomationProperties.Name="重新读取智能播放设置" />
  <ScrollViewer Grid.Row="1" Style="{StaticResource MeowFilm.SettingsScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <StackPanel x:Name="PreferencesForm" Visibility="Collapsed">
     <Border Style="{StaticResource Settings.Section}">
      <Grid local:SettingsLayout.Mode="Pair">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
       </Grid.ColumnDefinitions>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
       </Grid.RowDefinitions>
       <StackPanel Grid.Column="0">
        <Grid Margin="0,0,0,12">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>
         <Button Content="恢复默认" Tag="rule" Click="Restore_Click" IsEnabled="{x:Bind Idle, Mode=OneWay}" Style="{StaticResource Settings.QuietButton}" AutomationProperties.Name="恢复优先片源默认规则" Grid.Column="1" />
         <Grid Grid.Column="0">
          <TextBlock Text="优先片源规则" Style="{StaticResource Settings.SectionTitle}" />
         </Grid>
        </Grid>
        <local:SettingsPriorityList x:Name="RuleOrder" Title="优先片源规则" ShowTitle="False" Tag="rule" ShowToggle="False" CanEdit="{x:Bind Idle, Mode=OneWay}" MoveRequested="Order_Move" />
       </StackPanel>
       <StackPanel Grid.Column="2">
        <Grid Margin="0,0,0,12">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>
         <Button Content="恢复默认" Tag="pan" Click="Restore_Click" IsEnabled="{x:Bind Idle, Mode=OneWay}" Style="{StaticResource Settings.QuietButton}" AutomationProperties.Name="恢复网盘默认顺序" Grid.Column="1" />
         <Grid Grid.Column="0">
          <TextBlock Text="网盘匹配规则" Style="{StaticResource Settings.SectionTitle}" />
         </Grid>
        </Grid>
        <local:SettingsPriorityList x:Name="PanOrder" Title="网盘匹配规则" ShowTitle="False" Tag="pan" ShowToggle="False" CanEdit="{x:Bind Idle, Mode=OneWay}" MoveRequested="Order_Move" />
       </StackPanel>
      </Grid>
     </Border>
     <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
       <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Content="恢复默认" Tag="keywords" Click="Restore_Click" Style="{StaticResource Settings.QuietButton}" AutomationProperties.Name="恢复关键字默认偏好" Grid.Column="1" />
        <Grid Grid.Column="0">
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="关键字匹配规则" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center" />
          <Button Content="保存" Click="SavePreferences_Click" Margin="12,0,0,0" Style="{StaticResource Settings.PrimaryButton}" AutomationProperties.Name="保存关键字匹配规则" />
         </StackPanel>
        </Grid>
       </Grid>
       <TextBox x:Name="Keywords" Style="{StaticResource Settings.TextBox}" PlaceholderText="DDP,H.265" AutomationProperties.Name="关键字匹配规则" />
      </StackPanel>
     </Border>
     <ContentControl IsEnabled="{x:Bind CanEditLibrary, Mode=OneWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
      <Border Style="{StaticResource Settings.Section}">
       <StackPanel>
        <Grid Margin="0,0,0,12">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>
         <Button x:Name="AddManual" Content="添加" Click="AddManual_Click" Style="{StaticResource Settings.PrimaryButton}" AutomationProperties.Name="添加人工匹配" Grid.Column="1" />
         <Grid Grid.Column="0">
          <TextBlock Text="人工匹配源管理" Style="{StaticResource Settings.SectionTitle}" />
         </Grid>
        </Grid>
        <Border Style="{StaticResource Settings.ListSurface}">
         <Grid MinHeight="180" MaxHeight="340">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="200" />
           <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource GroupSidebar}">
           <Grid>
            <Grid.RowDefinitions>
             <RowDefinition Height="Auto" />
             <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="TMDB 数据" Style="{StaticResource Settings.ListHeader}" Margin="10,12,0,12" Grid.Row="0" />
            <Grid Grid.Row="1">
             <ListView x:Name="ManualTargets" ItemsSource="{x:Bind ManualGroups, Mode=OneWay}" SelectionChanged="ManualTargets_SelectionChanged" ItemTemplate="{StaticResource GroupTemplate}" ItemContainerStyle="{StaticResource Settings.ListItem}" Style="{StaticResource Settings.List}" AutomationProperties.Name="TMDB 数据" />
            </Grid>
           </Grid>
          </Border>
          <Grid Grid.Column="1" Margin="12,0,0,0">
           <ListView x:Name="ManualRows" ItemsSource="{x:Bind SelectedManualRows, Mode=OneWay}" AutomationProperties.Name="人工匹配源" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled" HorizontalContentAlignment="Stretch">
            <ListView.Header><Grid MinWidth="800" Padding="6,10"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="140" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="站源" /><TextBlock Grid.Column="1" Text="详情编号" /><TextBlock Grid.Column="2" Text="网盘标识" /><TextBlock Grid.Column="3" Text="季度补全" /><TextBlock Grid.Column="4" Text="自动失效" /><TextBlock Grid.Column="5" Text="状态" /></Grid></ListView.Header>
            <ListView.ItemTemplate><DataTemplate x:DataType="local:FilmSettingRow"><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid MinWidth="800" Padding="6,8"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="140" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{x:Bind Source}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{x:Bind DetailId}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{x:Bind Pan}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{x:Bind Season}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{x:Bind AutoDisable}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="{x:Bind State}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" /><StackPanel Grid.Column="6" Orientation="Horizontal"><Button Content="编辑" Style="{StaticResource Settings.Button}" Tag="{x:Bind}" Click="Edit_Click" AutomationProperties.Name="{x:Bind Title}" /><Button Content="删除" Style="{StaticResource Settings.DangerButton}" Margin="6,0,0,0" Tag="{x:Bind}" Click="Remove_Click" AutomationProperties.Name="{x:Bind Title}" /></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate>
           </ListView>
           <TextBlock Text="暂无人工匹配源" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource Settings.Subtitle}" Visibility="{x:Bind HasNoManualRows, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
        </TextBlock>
          </Grid>
         </Grid>
        </Border>
       </StackPanel>
      </Border>
     </ContentControl>
     <ContentControl IsEnabled="{x:Bind CanEditLibrary, Mode=OneWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
      <Border Style="{StaticResource Settings.Section}">
       <StackPanel>
        <Grid Margin="0,0,0,12">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>
         <Button x:Name="ClearRecords" Content="清空" Click="ClearRecords_Click" Style="{StaticResource Settings.DangerButton}" AutomationProperties.Name="清空匹配禁用记录" Grid.Column="1" />
         <Grid Grid.Column="0">
          <TextBlock Text="匹配禁用管理" Style="{StaticResource Settings.SectionTitle}" />
         </Grid>
        </Grid>
        <Border Style="{StaticResource Settings.ListSurface}">
         <Grid MinHeight="180" MaxHeight="340">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="200" />
           <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource GroupSidebar}">
           <Grid>
            <Grid.RowDefinitions>
             <RowDefinition Height="Auto" />
             <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="禁用数据" Style="{StaticResource Settings.ListHeader}" Margin="10,12,0,12" Grid.Row="0" />
            <Grid Grid.Row="1">
             <ListView x:Name="BlockTargets" ItemsSource="{x:Bind BlockGroups, Mode=OneWay}" SelectionChanged="BlockTargets_SelectionChanged" ItemTemplate="{StaticResource GroupTemplate}" ItemContainerStyle="{StaticResource Settings.ListItem}" Style="{StaticResource Settings.List}" AutomationProperties.Name="禁用关键词" />
            </Grid>
           </Grid>
          </Border>
          <Grid Grid.Column="1" Margin="12,0,0,0">
           <ListView x:Name="BlockRows" ItemsSource="{x:Bind SelectedBlockRows, Mode=OneWay}" AutomationProperties.Name="匹配禁用源" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled" HorizontalContentAlignment="Stretch">
            <ListView.Header><Grid MinWidth="670" Padding="6,10"><Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="站源" /><TextBlock Grid.Column="1" Text="网盘标识" /><TextBlock Grid.Column="2" Text="详情编号" /></Grid></ListView.Header>
            <ListView.ItemTemplate><DataTemplate x:DataType="local:FilmSettingRow"><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid MinWidth="670" Padding="6,8"><Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{x:Bind Source}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{x:Bind Pan}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{x:Bind DetailId}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" /><StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="删除" Style="{StaticResource Settings.DangerButton}" Margin="6,0,0,0" Tag="{x:Bind}" Click="Remove_Click" AutomationProperties.Name="{x:Bind Title}" /></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate>
           </ListView>
           <TextBlock Text="暂无禁用片源" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource Settings.Subtitle}" Visibility="{x:Bind HasNoBlockRows, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
        </TextBlock>
          </Grid>
         </Grid>
        </Border>
       </StackPanel>
      </Border>
     </ContentControl>
    </StackPanel>
    <Border x:Name="CleanForm" Style="{StaticResource Settings.Section}" Visibility="Collapsed">
     <StackPanel>
      <Grid Margin="0,0,0,12">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <Button Content="恢复默认" Tag="clean" Click="Restore_Click" Style="{StaticResource Settings.QuietButton}" Grid.Column="1" />
       <Grid Grid.Column="0">
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="站点净化设置" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center" />
         <Button Content="保存" Click="SavePreferences_Click" Margin="12,0,0,0" Style="{StaticResource Settings.PrimaryButton}" AutomationProperties.Name="保存站点净化" />
        </StackPanel>
       </Grid>
      </Grid>
      <TextBlock Text="关键字匹配规则" Margin="0,0,0,8" />
      <TextBox x:Name="CleanKeywords" Style="{StaticResource Settings.TextBox}" AutomationProperties.Name="站点净化关键词" />
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
