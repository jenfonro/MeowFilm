<ResourceDictionary xmlns:local="using:MeowFilm.Capabilities" xmlns:desktop="using:MeowFilm.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="Film.ShelfArrow" TargetType="Button">
  <Setter Property="Width" Value="48" />
  <Setter Property="Height" Value="48" />
  <Setter Property="Padding" Value="0" />
  <Setter Property="Margin" Value="8,0" />
  <Setter Property="CornerRadius" Value="24" />
  <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
  <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
 </Style>
</ResourceDictionary>
