<UserControl xmlns:desktop="using:MeowFilm.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="using:MeowFilm.Capabilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MeowFilm.Capabilities.FilmShelf" Background="Transparent">
 <UserControl.Resources>
  <ResourceDictionary>
   <local:FilmVisibilityConverter x:Key="Film.Visible" />
   <local:FilmEmptyConverter x:Key="Film.Empty" />
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <ProgressRing Width="28" Height="28" MinHeight="120" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                IsActive="{x:Bind Section.ShowSkeleton, Mode=OneWay, FallbackValue=False}" Visibility="{x:Bind Section.ShowSkeleton, Mode=OneWay, Converter={StaticResource Film.Visible}, FallbackValue=Collapsed}" />
  <local:Shelf x:Name="Cards" Margin="24,0" MinimumCardWidth="144" ItemsSource="{x:Bind Section.Items, Mode=OneWay}" HorizontalOffset="{x:Bind Section.HorizontalOffset, Mode=TwoWay}" NavigationButtonStyle="{StaticResource Film.ShelfArrow}" Visibility="{x:Bind Section.HasItems, Mode=OneWay, Converter={StaticResource Film.Visible}, FallbackValue=Collapsed}">
   <local:Shelf.CardTemplate>
    <DataTemplate x:DataType="local:FilmCardItem">
     <local:FilmCard MaxWidth="176" Margin="0,0,16,0" Activated="Card_Activated" />
    </DataTemplate>
   </local:Shelf.CardTemplate>
  </local:Shelf>
  <StackPanel MinHeight="294" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind Section.ShowStatus, Mode=OneWay, Converter={StaticResource Film.Visible}, FallbackValue=Collapsed}">
   <TextBlock Text="{x:Bind Section.StatusText, Mode=OneWay}" Foreground="{ThemeResource MeowFilm.Brush.Muted}" FontSize="15" TextAlignment="Center" />
   <Button Content="重试" Margin="0,12,0,0" Padding="14,6" Visibility="{x:Bind Section.CanRetry, Mode=OneWay, Converter={StaticResource Film.Visible}, FallbackValue=Collapsed}" Click="Retry_Click" AutomationProperties.Name="重试加载栏目" />
  </StackPanel>
 </Grid>
</UserControl>
