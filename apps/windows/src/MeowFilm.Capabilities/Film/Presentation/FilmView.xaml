<UserControl x:Class="MeowFilm.Capabilities.FilmView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 Background="Transparent"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <local:FilmGridColumnsConverter x:Key="Film.GridColumns"/>
   <Style x:Key="Film.MoreButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
    <Setter Property="Padding" Value="13,5,11,5"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
             CornerRadius="17">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
       <Path Grid.Column="1" Data="M 1,1 L 5,5 L 1,9" Width="5" Height="10"
             Margin="8,0,0,0" Stretch="Fill" Stroke="{TemplateBinding Foreground}"
             StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
             StrokeLineJoin="Round" VerticalAlignment="Center"/>
      </Grid>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="Film.PageButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
    <Setter Property="MinWidth" Value="128"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="20,0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
             CornerRadius="22">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="Film.FilterLabel" TargetType="TextBlock"
          BasedOn="{StaticResource MeowFilm.SectionHeading}">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   <Style x:Key="Film.FilterGroup" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Hover}"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="4"/>
    <Style.Triggers>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderThickness" Value="1"/>
     </Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Film.FilterChip" TargetType="Button"
          BasedOn="{StaticResource MeowFilm.QuietButton}">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="14,5"/>
    <Setter Property="Margin" Value="2,0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
             CornerRadius="16">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsSelected}" Value="True">
      <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
     </DataTrigger>
     <MultiDataTrigger>
      <MultiDataTrigger.Conditions>
       <Condition Binding="{Binding IsSelected}" Value="True"/>
       <Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=(desktop:DesktopTheme.IsHighContrast)}"
                  Value="True"/>
      </MultiDataTrigger.Conditions>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
     </MultiDataTrigger>
    </Style.Triggers>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Background="Transparent">
  <ScrollViewer x:Name="HomeScroll"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ScrollViewer.Style>
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource MeowFilm.OverlayScrollViewer}">
     <Setter Property="Visibility" Value="Visible"/>
     <Style.Triggers><DataTrigger Binding="{Binding IsHome}" Value="False">
      <Setter Property="Visibility" Value="Collapsed"/>
     </DataTrigger></Style.Triggers>
    </Style>
   </ScrollViewer.Style>
   <ItemsControl ItemsSource="{Binding Sections}" Margin="40,12,40,20">
    <ItemsControl.ItemsPanel>
     <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <StackPanel Margin="0,0,0,28">
       <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource MeowFilm.SectionHeading}"
                   Margin="0" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="查看更多" Tag="{Binding}"
                Click="More_Click" Style="{StaticResource Film.MoreButton}"
                AutomationProperties.Name="{Binding Title,StringFormat=查看更多 {0}}"/>
       </Grid>
       <local:FilmShelf ItemActivated="Shelf_ItemActivated"
                        RetryRequested="Shelf_RetryRequested"/>
      </StackPanel>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <ScrollViewer x:Name="FilmDataPage" Background="Transparent"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ScrollViewer.Style><Style TargetType="ScrollViewer" BasedOn="{StaticResource MeowFilm.OverlayScrollViewer}">
    <Setter Property="Visibility" Value="Collapsed"/>
     <Style.Triggers><DataTrigger Binding="{Binding IsData}" Value="True">
     <Setter Property="Visibility" Value="Visible"/>
    </DataTrigger></Style.Triggers>
   </Style></ScrollViewer.Style>
   <StackPanel Margin="40,12,40,36">
    <TextBlock x:Name="DataTitle" Text="{Binding ActiveData.Title}" Margin="0,0,0,16"
               Style="{StaticResource MeowFilm.SectionHeading}"/>
    <Border Margin="0,0,0,24" Padding="18,9" CornerRadius="16"
            Style="{StaticResource MeowFilm.Surface}">
     <ItemsControl x:Name="DataFilters" ItemsSource="{Binding ActiveData.FilterRows}">
      <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Grid Margin="0,5">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Label}" Style="{StaticResource Film.FilterLabel}"/>
         <Border Grid.Column="1" HorizontalAlignment="Left"
                 Style="{StaticResource Film.FilterGroup}">
          <ItemsControl ItemsSource="{Binding Options}">
           <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
           </ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Button Content="{Binding Label}" Tag="{Binding}"
                     Style="{StaticResource Film.FilterChip}"
                     Click="Filter_Click"
                     AutomationProperties.Name="{Binding AutomationName}"/>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </Border>
        </Grid>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </Border>
    <Grid MinHeight="260">
     <local:FilmLoadingCards IsGrid="True" Height="660"
         Visibility="{Binding ActiveData.ShowSkeleton,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
     <ItemsControl x:Name="DataItems" ItemsSource="{Binding ActiveData.Items}"
                   AutomationProperties.Name="影片列表">
      <ItemsControl.Style><Style TargetType="ItemsControl">
       <Setter Property="Visibility" Value="Visible"/>
       <Style.Triggers><DataTrigger Binding="{Binding ActiveData.HasItems}" Value="False">
        <Setter Property="Visibility" Value="Collapsed"/>
       </DataTrigger></Style.Triggers>
      </Style></ItemsControl.Style>
      <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate>
        <UniformGrid Columns="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=ItemsControl},Converter={StaticResource Film.GridColumns}}"/>
       </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border Margin="18,0,18,36" HorizontalAlignment="Center">
          <local:FilmCard Activated="DataCard_Activated"/>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding ActiveData.ShowStatus,Converter={StaticResource MeowFilm.BoolToVisibility}}">
      <TextBlock Text="{Binding ActiveData.StatusText}"
                 Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                 FontSize="15" TextAlignment="Center"/>
      <Button Content="重试" Margin="0,14,0,0"
              Style="{StaticResource Film.PageButton}"
              Visibility="{Binding ActiveData.CanRetry,Converter={StaticResource MeowFilm.BoolToVisibility}}"
              Click="DataRetry_Click" AutomationProperties.Name="重试加载影片数据"/>
     </StackPanel>
    </Grid>
    <Button x:Name="DataPageAction" HorizontalAlignment="Center"
            Content="{Binding ActiveData.PageActionText}"
            IsEnabled="{Binding ActiveData.CanPage}"
            Visibility="{Binding ActiveData.ShowPageAction,Converter={StaticResource MeowFilm.BoolToVisibility}}"
            Style="{StaticResource Film.PageButton}"
            Click="DataPageAction_Click" AutomationProperties.Name="加载更多影片"/>
   </StackPanel>
  </ScrollViewer>
   <Grid x:Name="DoubanPage" Background="Transparent">
    <Grid.Style><Style TargetType="Grid">
     <Setter Property="Visibility" Value="Collapsed"/>
     <Style.Triggers><DataTrigger Binding="{Binding IsDouban}" Value="True">
      <Setter Property="Visibility" Value="Visible"/>
     </DataTrigger></Style.Triggers>
    </Style></Grid.Style>
   </Grid>
 </Grid>
</UserControl>
