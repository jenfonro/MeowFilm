<UserControl x:Class="MeowFilm.Capabilities.FilmDirectoryDialogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 xmlns:desktop="using:MeowFilm.Desktop">
 <StackPanel Spacing="8" MinWidth="340">
  <Button Content="返回上级" MinHeight="32" HorizontalAlignment="Left" IsEnabled="{x:Bind CanBack, Mode=OneWay}" Click="Back_Click"/>
  <TextBlock Text="{x:Bind CurrentPath, Mode=OneWay}" TextWrapping="Wrap" Margin="0,8,0,12"/>
  <ListView x:Name="FileList" ItemsSource="{x:Bind Rows, Mode=OneWay}" MinHeight="220" MaxHeight="400" SelectionChanged="FileList_SelectionChanged" DoubleTapped="FileList_DoubleTapped" KeyDown="FileList_KeyDown" AutomationProperties.Name="原始目录与文件">
   <ListView.ItemTemplate>
    <DataTemplate x:DataType="local:FilmDirectoryRow">
     <TextBlock Text="{x:Bind Label}"/>
    </DataTemplate>
   </ListView.ItemTemplate>
  </ListView>
  <Button Content="播放所选文件" MinHeight="32" HorizontalAlignment="Left" IsEnabled="{x:Bind CanPlay, Mode=OneWay}" Click="Play_Click"/>
  <desktop:NoticeOutlet Message="{x:Bind ErrorMessage, Mode=OneWay}"/>
 </StackPanel>
</UserControl>
