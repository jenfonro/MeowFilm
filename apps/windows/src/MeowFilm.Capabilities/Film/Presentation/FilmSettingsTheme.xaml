<ResourceDictionary xmlns:local="using:MeowFilm.Capabilities" xmlns:desktop="using:MeowFilm.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="ms-appx:///MeowFilm.Capabilities/Settings/SettingsTheme.xaml" />
 </ResourceDictionary.MergedDictionaries>
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="Film.SettingsGround" Color="Transparent" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="Film.SettingsGround" Color="{ThemeResource SystemColorWindowColor}" />
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style x:Key="FilmSettings.Anchor" TargetType="RadioButton" BasedOn="{StaticResource MeowFilm.SettingsArea}" />
 <Style x:Key="FilmSettings.CellText" TargetType="TextBlock">
  <Setter Property="FontSize" Value="13" />
  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
 </Style>
 <Style x:Key="FilmSettings.AggregateBadge" TargetType="Border">
  <Setter Property="BorderBrush" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
 </Style>
 <Style x:Key="FilmSettings.AggregateText" TargetType="TextBlock" BasedOn="{StaticResource FilmSettings.CellText}">
  <Setter Property="Foreground" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
 </Style>
</ResourceDictionary>
