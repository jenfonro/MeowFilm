<UserControl xmlns:desktop="using:MeowFilm.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="using:MeowFilm.Capabilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MeowFilm.Capabilities.FilmShelf" Background="Transparent">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
<ResourceDictionary Source="ms-appx:///MeowFilm.Capabilities/Film/Presentation/FilmShelfStyles.xaml" />
   </ResourceDictionary.MergedDictionaries>
   <local:FilmVisibilityConverter x:Key="Film.Visible" />
   <local:FilmEmptyConverter x:Key="Film.Empty" />
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <ProgressRing Width="28" Height="28" MinHeight="120" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                IsActive="{Binding ShowSkeleton}" Visibility="{Binding ShowSkeleton,Converter={StaticResource Film.Visible}}" />
  <local:Shelf x:Name="Cards" Margin="24,0" MinimumCardWidth="144" ItemsSource="{Binding Items}" HorizontalOffset="{Binding HorizontalOffset,Mode=TwoWay}" NavigationButtonStyle="{StaticResource Film.ShelfArrow}" Visibility="{Binding HasItems,Converter={StaticResource Film.Visible}}">
   <local:Shelf.CardTemplate>
    <DataTemplate>
     <local:FilmCard MaxWidth="176" Margin="0,0,16,0" Activated="Card_Activated" />
    </DataTemplate>
   </local:Shelf.CardTemplate>
  </local:Shelf>
  <StackPanel MinHeight="294" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowStatus,Converter={StaticResource Film.Visible}}">
   <TextBlock Text="{Binding StatusText}" Foreground="{ThemeResource MeowFilm.Brush.Muted}" FontSize="15" TextAlignment="Center" />
   <Button Content="重试" Margin="0,12,0,0" Padding="14,6" Visibility="{Binding CanRetry,Converter={StaticResource Film.Visible}}" Click="Retry_Click" AutomationProperties.Name="重试加载栏目" />
  </StackPanel>
 </Grid>
</UserControl>
