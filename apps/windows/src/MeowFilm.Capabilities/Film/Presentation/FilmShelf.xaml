<UserControl x:Class="MeowFilm.Capabilities.FilmShelf" x:Name="ShelfRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 Height="294" Background="Transparent"
 PreviewMouseWheel="OnPreviewMouseWheel" PreviewKeyDown="OnPreviewKeyDown"
 SizeChanged="OnSizeChanged">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <local:FilmScaleConverter x:Key="Film.Scale"/>
   <Style x:Key="Film.ShelfArrow" TargetType="Button">
    <Setter Property="Width" Value="48"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Surface}"/>
    <Setter Property="Foreground" Value="#4B5563"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
    <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity=".12" Color="Black"/></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24"
             RenderTransformOrigin=".5,.5">
      <Border.RenderTransform><ScaleTransform
       ScaleX="{Binding Path=(local:CardMotion.Progress),RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource Film.Scale},ConverterParameter=0.05}"
       ScaleY="{Binding Path=(local:CardMotion.Progress),RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource Film.Scale},ConverterParameter=0.05}"/>
      </Border.RenderTransform>
      <Path Data="{TemplateBinding Tag}" Width="11" Height="20" Stretch="Fill"
            Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsMouseOver,ElementName=RailRoot}" Value="True">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="IsHitTestVisible" Value="True"/>
     </DataTrigger>
     <DataTrigger Binding="{Binding IsKeyboardFocusWithin,ElementName=RailRoot}" Value="True">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="IsHitTestVisible" Value="True"/>
     </DataTrigger>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="Effect" Value="{x:Null}"/>
     </Trigger>
    </Style.Triggers>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <local:FilmLoadingCards Margin="24,0" Height="294"
      Visibility="{Binding ShowSkeleton,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
  <Grid x:Name="RailRoot" Background="Transparent"
        Visibility="{Binding HasItems,Converter={StaticResource MeowFilm.BoolToVisibility}}">
   <ListBox x:Name="ItemsHost" Margin="24,0" Height="294"
            ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0"
            Focusable="False" IsTabStop="False" SelectionMode="Single"
            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            ScrollViewer.CanContentScroll="True" ScrollViewer.PanningMode="HorizontalOnly"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.CacheLength="1,1"
            VirtualizingPanel.CacheLengthUnit="Page">
    <ListBox.Template>
     <ControlTemplate TargetType="ListBox">
      <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" CanContentScroll="True"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled"
                    PanningMode="HorizontalOnly">
       <ItemsPresenter/>
      </ScrollViewer>
     </ControlTemplate>
    </ListBox.Template>
    <ListBox.ItemsPanel>
     <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem">
      <Setter Property="Width" Value="192"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </ControlTemplate></Setter.Value></Setter>
     </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
     <DataTemplate><local:FilmCard Activated="Card_Activated"/></DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
   <Button x:Name="Previous" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="0,88,0,0" Click="Previous_Click"
           Style="{StaticResource Film.ShelfArrow}" local:CardMotion.Enabled="True"
           AutomationProperties.Name="向左滚动">
    <Button.Tag><PathGeometry Figures="M 9,1 L 1,10 L 9,19"/></Button.Tag>
   </Button>
   <Button x:Name="Next" HorizontalAlignment="Right" VerticalAlignment="Top"
           Margin="0,88,0,0" Click="Next_Click"
           Style="{StaticResource Film.ShelfArrow}" local:CardMotion.Enabled="True"
           AutomationProperties.Name="向右滚动">
    <Button.Tag><PathGeometry Figures="M 1,1 L 9,10 L 1,19"/></Button.Tag>
   </Button>
  </Grid>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="{Binding ShowStatus,Converter={StaticResource MeowFilm.BoolToVisibility}}">
   <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MeowFilm.Brush.Muted}"
              FontSize="15" TextAlignment="Center"/>
   <Button Content="重试" Margin="0,12,0,0" Padding="14,6"
           Visibility="{Binding CanRetry,Converter={StaticResource MeowFilm.BoolToVisibility}}"
           Click="Retry_Click" AutomationProperties.Name="重试加载栏目"/>
  </StackPanel>
 </Grid>
</UserControl>
