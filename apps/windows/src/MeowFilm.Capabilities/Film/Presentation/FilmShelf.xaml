<UserControl x:Class="MeowFilm.Capabilities.FilmShelf"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities" Background="Transparent">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
  <ResourceDictionary Source="/MeowFilm.Capabilities;component/Film/Presentation/FilmShelfStyles.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid>
  <local:FilmLoadingCards Margin="24,0"
      Visibility="{Binding ShowSkeleton,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
  <local:Shelf x:Name="Cards" Margin="24,0" MinimumCardWidth="144"
               ItemsSource="{Binding Items}" HorizontalOffset="{Binding HorizontalOffset,Mode=TwoWay}"
               NavigationButtonStyle="{StaticResource Film.ShelfArrow}"
               Visibility="{Binding HasItems,Converter={StaticResource MeowFilm.BoolToVisibility}}">
   <local:Shelf.CardTemplate><DataTemplate>
    <local:FilmCard Margin="0,0,16,0" Activated="Card_Activated"/>
   </DataTemplate></local:Shelf.CardTemplate>
  </local:Shelf>
  <StackPanel MinHeight="294" HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="{Binding ShowStatus,Converter={StaticResource MeowFilm.BoolToVisibility}}">
   <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MeowFilm.Brush.Muted}"
              FontSize="15" TextAlignment="Center"/>
   <Button Content="重试" Margin="0,12,0,0" Padding="14,6"
           Visibility="{Binding CanRetry,Converter={StaticResource MeowFilm.BoolToVisibility}}"
           Click="Retry_Click" AutomationProperties.Name="重试加载栏目"/>
  </StackPanel>
 </Grid>
</UserControl>
