<UserControl x:Class="MeowFilm.Capabilities.FilmPlaybackView" x:Name="PlaybackRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 Background="Transparent" SizeChanged="OnSizeChanged"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <local:FilmPlayerHeightConverter x:Key="Film.PlayerHeight"/>
   <Style x:Key="Film.PlaybackAction" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Cursor" Value="Hand"/>
   </Style>
   <Style x:Key="Film.PlaybackArrow" TargetType="Button" BasedOn="{StaticResource Film.PlaybackAction}">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="{DynamicResource MeowFilm.Font.Icons}"/>
   </Style>
   <Style x:Key="Film.EpisodeButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Surface}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"
             Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsSelected}" Value="True">
      <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
     </DataTrigger>
     <MultiDataTrigger><MultiDataTrigger.Conditions>
      <Condition Binding="{Binding IsSelected}" Value="True"/>
      <Condition Binding="{Binding Path=(desktop:DesktopTheme.IsHighContrast),RelativeSource={RelativeSource Self}}" Value="True"/>
     </MultiDataTrigger.Conditions>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
     </MultiDataTrigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Film.DecorativeImage" TargetType="Image">
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Visibility" Value="Collapsed"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.VideoText" TargetType="TextBlock" BasedOn="{StaticResource Capability.Text}">
    <Setter Property="Foreground" Value="White"/>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.VideoOverlay" TargetType="Border">
    <Setter Property="Background" Value="#B8000000"/>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.OverviewToggle" TargetType="Button" BasedOn="{StaticResource Film.PlaybackAction}">
    <Setter Property="Content" Value="展开简介"/>
    <Setter Property="Padding" Value="0,4"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
    <Style.Triggers><DataTrigger Binding="{Binding OverviewExpanded}" Value="True">
     <Setter Property="Content" Value="收起简介"/>
    </DataTrigger></Style.Triggers>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <ScrollViewer x:Name="PageScroll" Background="Transparent"
               Style="{StaticResource MeowFilm.OverlayScrollViewer}"
               HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel x:Name="PageContent" Margin="32,12,32,32">
   <!-- Wide: player + 24px gutter + metadata fill the same content edges. -->
   <Grid x:Name="HeroGrid">
    <Grid.ColumnDefinitions>
     <ColumnDefinition x:Name="PlayerColumn" Width="1.85*"/>
     <ColumnDefinition x:Name="HeroGutter" Width="24"/>
     <ColumnDefinition x:Name="MetadataColumn" Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition x:Name="HeroRowGutter" Height="0"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid x:Name="PlayerFrame" VerticalAlignment="Top" SizeChanged="Player_SizeChanged"
          local:CardClip.Radius="16"
          Height="{Binding ActualWidth,RelativeSource={RelativeSource Self},Converter={StaticResource Film.PlayerHeight}}"
          AutomationProperties.Name="影片播放器">
     <Grid.Style><Style TargetType="Grid">
      <Setter Property="Background" Value="#151515"/>
      <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
       <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      </Trigger></Style.Triggers>
     </Style></Grid.Style>
     <Image Source="{Binding SelectedEpisode.Image}" Stretch="UniformToFill"
            Style="{StaticResource Film.DecorativeImage}" AutomationProperties.Name="当前集预览"/>
     <Border IsHitTestVisible="False">
      <Border.Style><Style TargetType="Border">
       <Setter Property="Background" Value="#40000000"/>
       <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
        <Setter Property="Visibility" Value="Collapsed"/>
       </Trigger></Style.Triggers>
      </Style></Border.Style>
     </Border>
     <Border Margin="16" Padding="10,5" Style="{StaticResource Film.VideoOverlay}" CornerRadius="6"
             HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="380">
      <TextBlock x:Name="PlayerEpisode" Text="{Binding SelectedEpisode.Label}"
                 Style="{StaticResource Film.VideoText}" FontSize="13" TextTrimming="CharacterEllipsis"/>
     </Border>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,42">
      <Button x:Name="PlayButton" IsEnabled="False" Width="64" Height="64"
              Margin="0,0,0,10" Padding="0" ToolTip="暂无片源"
              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="播放（暂无片源）">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
        <Setter Property="Background" Value="#A0000000"/>
        <Setter Property="BorderBrush" Value="#90FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
         <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
         <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
         <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
        </Trigger></Style.Triggers>
       </Style></Button.Style>
       <Path Data="M 0,0 L 19,12 L 0,24 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
             Width="19" Height="24" Margin="4,0,0,0" Stretch="Fill"/>
      </Button>
      <TextBlock x:Name="PlayerStatus" Text="暂无片源" Style="{StaticResource Film.VideoText}"
                 TextAlignment="Center" FontSize="14"/>
     </StackPanel>
     <Border VerticalAlignment="Bottom" Style="{StaticResource Film.VideoOverlay}" Padding="16,8">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        <ColumnDefinition/><ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <TextBlock Text="&#xE768;" FontFamily="{DynamicResource MeowFilm.Font.Icons}"
                  FontSize="15" Style="{StaticResource Film.VideoText}" Opacity=".7" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="— / —" FontSize="12" Style="{StaticResource Film.VideoText}" Opacity=".8"
                  Margin="12,0,16,0" VerticalAlignment="Center"/>
       <Border Grid.Column="2" Height="3" CornerRadius="1.5" Background="#40FFFFFF"
               VerticalAlignment="Center"/>
       <TextBlock Grid.Column="3" Text="{Binding SelectedEpisode.Duration}" FontSize="12"
                  Style="{StaticResource Film.VideoText}" Opacity=".8" Margin="16,0,0,0" VerticalAlignment="Center"/>
      </Grid>
     </Border>
    </Grid>
    <Grid x:Name="MetadataPanel" Grid.Column="2" local:CardClip.Radius="16">
     <Border Style="{StaticResource MeowFilm.Surface}"/>
     <local:FilmPlaybackPoster Address="{Binding Poster}" Opacity=".14" IsHitTestVisible="False">
      <local:FilmPlaybackPoster.Style><Style TargetType="local:FilmPlaybackPoster">
       <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
        <Setter Property="Visibility" Value="Collapsed"/>
       </Trigger></Style.Triggers>
      </Style></local:FilmPlaybackPoster.Style>
     </local:FilmPlaybackPoster>
     <ScrollViewer x:Name="MetadataScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   Style="{StaticResource MeowFilm.OverlayScrollViewer}">
      <StackPanel Margin="24,20">
      <TextBlock x:Name="FilmTitle" Text="{Binding Title}" FontSize="26" FontWeight="SemiBold"
                 TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
      <TextBlock Text="{Binding Metadata}" Margin="0,10,0,0" FontSize="13" LineHeight="21"
                 TextWrapping="Wrap" Style="{StaticResource Capability.Muted}"/>
      <TextBlock Text="{Binding Genres}" Margin="0,5,0,0" FontSize="13"
                 TextWrapping="Wrap" Style="{StaticResource Capability.Muted}"/>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                  Visibility="{Binding Item.HasScore,Converter={StaticResource MeowFilm.BoolToVisibility}}">
       <TextBlock Text="★" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Capability.Text}">
         <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
         <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
         </Trigger></Style.Triggers>
        </Style></TextBlock.Style>
       </TextBlock>
       <TextBlock Text="{Binding Item.Score}" FontSize="22" FontWeight="SemiBold"/>
       <TextBlock Text="豆瓣" FontSize="12" Margin="8,0,0,2" VerticalAlignment="Bottom"
                  Style="{StaticResource Capability.Muted}"/>
      </StackPanel>
      <Grid Margin="0,16,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="导演" FontSize="13" LineHeight="21" Style="{StaticResource Capability.Muted}"/>
       <TextBlock Grid.Column="1" Text="{Binding Directors}" FontSize="13" LineHeight="21" TextWrapping="Wrap"/>
       <TextBlock Grid.Row="1" Text="演员" FontSize="13" LineHeight="21" Margin="0,6,0,0"
                  Style="{StaticResource Capability.Muted}"/>
       <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Cast}" FontSize="13"
                  LineHeight="21" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </Grid>
      <TextBlock Text="简介" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>
      <TextBlock x:Name="OverviewText" Text="{Binding Overview}" TextWrapping="Wrap"
                 FontSize="13" LineHeight="22" TextTrimming="CharacterEllipsis">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Capability.Text}">
        <Setter Property="MaxHeight" Value="66"/>
        <Style.Triggers><DataTrigger Binding="{Binding OverviewExpanded}" Value="True">
         <Setter Property="MaxHeight" Value="Infinity"/>
        </DataTrigger></Style.Triggers>
       </Style></TextBlock.Style>
      </TextBlock>
      <Button x:Name="OverviewToggle" HorizontalAlignment="Left" Margin="0,5,0,0"
              Click="Overview_Click" Style="{StaticResource Film.OverviewToggle}"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
   <Grid Margin="0,28,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <WrapPanel VerticalAlignment="Center">
     <TextBlock Text="选集" Style="{StaticResource MeowFilm.SectionHeading}" Margin="0,0,12,0"/>
     <TextBlock Text="{Binding SeasonLabel}" FontSize="13" VerticalAlignment="Center"
                Style="{StaticResource Capability.Muted}" Margin="0,0,12,0"/>
     <TextBlock Text="{Binding EpisodeCountLabel}" FontSize="13" VerticalAlignment="Center"
                Style="{StaticResource Capability.Muted}"/>
    </WrapPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Border Background="{DynamicResource MeowFilm.Brush.Hover}" CornerRadius="8" Padding="3" Margin="0,0,10,0">
      <StackPanel Orientation="Horizontal">
       <Button x:Name="HorizontalLayout" Click="HorizontalLayout_Click"
               AutomationProperties.Name="横向选集" MinHeight="30" Padding="10,3">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Film.PlaybackAction}">
         <Style.Triggers><DataTrigger Binding="{Binding IsHorizontalLayout}" Value="True">
          <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Surface}"/>
          <Setter Property="AutomationProperties.ItemStatus" Value="已选"/>
         </DataTrigger></Style.Triggers>
        </Style></Button.Style>
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="&#xE8A0;" FontFamily="{DynamicResource MeowFilm.Font.Icons}" Margin="0,0,6,0" VerticalAlignment="Center"/>
         <TextBlock Text="横向"/>
        </StackPanel>
       </Button>
       <Button x:Name="ListLayout" Click="ListLayout_Click"
               AutomationProperties.Name="列表选集" MinHeight="30" Padding="10,3">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Film.PlaybackAction}">
         <Style.Triggers><DataTrigger Binding="{Binding IsListLayout}" Value="True">
          <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Surface}"/>
          <Setter Property="AutomationProperties.ItemStatus" Value="已选"/>
         </DataTrigger></Style.Triggers>
        </Style></Button.Style>
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource MeowFilm.Font.Icons}" Margin="0,0,6,0" VerticalAlignment="Center"/>
         <TextBlock Text="列表"/>
        </StackPanel>
       </Button>
      </StackPanel>
     </Border>
     <StackPanel Orientation="Horizontal"
                 Visibility="{Binding IsHorizontalLayout,Converter={StaticResource MeowFilm.BoolToVisibility}}">
      <Button x:Name="EpisodePrevious" Content="&#xE76B;" Click="EpisodePrevious_Click"
              Style="{StaticResource Film.PlaybackArrow}" AutomationProperties.Name="向左浏览选集"/>
      <Button x:Name="EpisodeNext" Content="&#xE76C;" Click="EpisodeNext_Click" Margin="6,0,0,0"
              Style="{StaticResource Film.PlaybackArrow}" AutomationProperties.Name="向右浏览选集"/>
     </StackPanel>
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="HorizontalEpisodes" HorizontalScrollBarVisibility="Hidden"
                 VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                 Visibility="{Binding IsHorizontalLayout,Converter={StaticResource MeowFilm.BoolToVisibility}}"
                 ScrollChanged="Rail_ScrollChanged" PreviewMouseWheel="Rail_MouseWheel"
                 PreviewKeyDown="Rail_KeyDown">
    <ItemsControl x:Name="EpisodeCards" ItemsSource="{Binding Episodes}" AutomationProperties.Name="横向选集列表">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Style="{StaticResource Film.EpisodeButton}" Width="260" Margin="0,0,16,4"
              Tag="{Binding}" Click="Episode_Click" AutomationProperties.Name="{Binding Label}">
       <StackPanel>
        <Grid Height="144" local:CardClip.Radius="10">
         <Image Source="{Binding Image}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Label}"/>
         <Border Background="#B8000000" CornerRadius="5" Padding="7,3" Margin="10"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Visibility="{Binding IsSelected,Converter={StaticResource MeowFilm.BoolToVisibility}}">
          <TextBlock Text="当前" Foreground="White" FontSize="12"/>
         </Border>
         <Border Background="#B8000000" CornerRadius="5" Padding="7,3" Margin="10"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="12"/>
         </Border>
        </Grid>
        <StackPanel Margin="12,12,12,14">
         <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
         <TextBlock Text="{Binding Overview}" FontSize="13" LineHeight="21" Height="42"
                    Margin="0,7,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                    Style="{StaticResource Capability.Muted}" ToolTip="{Binding Overview}"/>
        </StackPanel>
       </StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <ItemsControl x:Name="EpisodeList" ItemsSource="{Binding Episodes}" AutomationProperties.Name="逐集列表"
                 Visibility="{Binding IsListLayout,Converter={StaticResource MeowFilm.BoolToVisibility}}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Style="{StaticResource Film.EpisodeButton}" Tag="{Binding}" Click="Episode_Click"
             Margin="0,0,0,12" Padding="12" AutomationProperties.Name="{Binding Label}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid Height="99" local:CardClip.Radius="8" VerticalAlignment="Center">
        <Image Source="{Binding Image}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Label}"/>
        <Border Background="#B8000000" CornerRadius="5" Padding="7,3" Margin="8"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="{Binding IsSelected,Converter={StaticResource MeowFilm.BoolToVisibility}}">
         <TextBlock Text="当前" Foreground="White" FontSize="12"/>
        </Border>
       </Grid>
       <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Duration}" FontSize="12" Margin="0,5,0,0" Style="{StaticResource Capability.Muted}"/>
        <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" FontSize="13" LineHeight="21"
                   MaxHeight="63" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"
                   Style="{StaticResource Capability.Muted}" ToolTip="{Binding Overview}"/>
       </StackPanel>
      </Grid>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Grid Margin="0,28,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="相关推荐" Style="{StaticResource MeowFilm.SectionHeading}" Margin="0" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="RelatedPrevious" Content="&#xE76B;" Click="RelatedPrevious_Click"
             Style="{StaticResource Film.PlaybackArrow}" AutomationProperties.Name="向左浏览相关推荐"/>
     <Button x:Name="RelatedNext" Content="&#xE76C;" Click="RelatedNext_Click" Margin="6,0,0,0"
             Style="{StaticResource Film.PlaybackArrow}" AutomationProperties.Name="向右浏览相关推荐"/>
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="RelatedScroll" HorizontalScrollBarVisibility="Hidden"
                 VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                 ScrollChanged="Rail_ScrollChanged" PreviewMouseWheel="Rail_MouseWheel"
                 PreviewKeyDown="Rail_KeyDown">
    <ItemsControl x:Name="RelatedItems" ItemsSource="{Binding Recommendations}" AutomationProperties.Name="相关推荐">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Style="{StaticResource Film.EpisodeButton}" Tag="{Binding}" Click="Recommendation_Click"
              Width="156" Margin="0,0,16,4" Background="Transparent" AutomationProperties.Name="{Binding Title}">
       <StackPanel>
        <Grid Height="228" local:CardClip.Radius="10">
         <local:FilmPlaybackPoster Address="{Binding Poster}" AutomationProperties.Name="{Binding Title,StringFormat=影片海报 {0}}"/>
         <Border Background="#B8000000" CornerRadius="5" Padding="6,3" Margin="8"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Visibility="{Binding HasScore,Converter={StaticResource MeowFilm.BoolToVisibility}}">
          <TextBlock Text="{Binding Score}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
         </Border>
        </Grid>
        <TextBlock Text="{Binding Title}" FontSize="14" Margin="0,10,0,6"
                   TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
       </StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
  </StackPanel>
 </ScrollViewer>
</UserControl>
