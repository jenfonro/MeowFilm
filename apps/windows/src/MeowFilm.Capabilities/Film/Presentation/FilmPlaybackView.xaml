                    Style="{StaticResource Film.EpisodeLabel}"/>
         <TextBlock Text="{Binding Duration}" FontSize="{StaticResource MeowFilm.Font.Size.Caption}" Margin="0,5,0,0" Style="{StaticResource Capability.Muted}"/>
         <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" FontSize="{StaticResource MeowFilm.Font.Size.Compact}" LineHeight="21"
                    MaxHeight="63" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"
                    Style="{StaticResource Capability.Muted}"/>
        </StackPanel>
       </Grid>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Margin="0,28,0,14">
     <Grid.Style><Style TargetType="Grid">
      <Style.Triggers><DataTrigger Binding="{Binding Recommendations.Count}" Value="0">
       <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger></Style.Triggers>
     </Style></Grid.Style>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="相关推荐" Style="{StaticResource MeowFilm.SectionHeading}" Margin="0" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="RelatedPrevious" Content="&#xE76B;" Click="RelatedPrevious_Click"
              Style="{StaticResource Film.PlaybackArrow}" AutomationProperties.Name="向左浏览相关推荐"/>
      <Button x:Name="RelatedNext" Content="&#xE76C;" Click="RelatedNext_Click" Margin="6,0,0,0"
              Style="{StaticResource Film.PlaybackArrow}" AutomationProperties.Name="向右浏览相关推荐"/>
     </StackPanel>
    </Grid>
    <ScrollViewer x:Name="RelatedScroll" Margin="-8" HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                  ScrollChanged="Rail_ScrollChanged" PreviewMouseWheel="Rail_MouseWheel"
                  PreviewKeyDown="Rail_KeyDown">
     <ItemsControl x:Name="RelatedItems" Padding="8" ItemsSource="{Binding Recommendations}" AutomationProperties.Name="相关推荐">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button x:Name="Tile" Style="{StaticResource Film.Tile}" Width="156" Margin="0,0,16,0"
               local:CardMotion.Enabled="True" Tag="{Binding}" Click="Recommendation_Click"
               AutomationProperties.Name="{Binding Title}">
        <Button.RenderTransform><ScaleTransform
         ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.03}"
         ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.03}"/>
        </Button.RenderTransform>
        <StackPanel>
         <Grid Height="234" local:CardClip.Radius="10" Background="{DynamicResource MeowFilm.Brush.Hover}">
          <local:FilmPlaybackPoster Address="{Binding Poster}" AutomationProperties.Name="{Binding Title,StringFormat=影片海报 {0}}"
                                    RenderTransformOrigin=".5,.5">
           <local:FilmPlaybackPoster.RenderTransform><ScaleTransform
            ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.05}"
            ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.05}"/>
           </local:FilmPlaybackPoster.RenderTransform>
          </local:FilmPlaybackPoster>
          <local:FilmHoverShade Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Tile}"/>
          <local:FilmPlayMark Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Tile}"/>
          <Border Background="#B8000000" CornerRadius="5" Padding="6,3" Margin="8"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Visibility="{Binding HasScore,Converter={StaticResource MeowFilm.BoolToVisibility}}">
           <TextBlock Text="{Binding Score}" Foreground="White" FontSize="{StaticResource MeowFilm.Font.Size.Caption}" FontWeight="{StaticResource MeowFilm.Font.Weight.Strong}"/>
          </Border>
         </Grid>
         <TextBlock Text="{Binding Title}" FontSize="{StaticResource MeowFilm.Font.Size.Body}" Margin="0,10,0,0"
                    TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </StackPanel>
  </ScrollViewer>
  <desktop:NoticeOutlet Message="{Binding ReportErrorMessage}"/>
  <desktop:NoticeOutlet Message="{Binding MetadataAssociationErrorMessage}"/>
  <desktop:NoticeOutlet x:Name="Notices"/>
 </Grid>
</UserControl>
