                  FontSize="{StaticResource MeowFilm.Font.Size.Compact}" LineHeight="22" Margin="0,10,0,0"
                  Visibility="{Binding OverviewExpanded,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
       <Grid Margin="0,16,0,0">
