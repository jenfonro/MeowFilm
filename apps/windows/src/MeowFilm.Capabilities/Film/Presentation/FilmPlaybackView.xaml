<UserControl x:Class="MeowFilm.Capabilities.FilmPlaybackView" x:Name="PlaybackRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 SizeChanged="OnSizeChanged"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Film/Presentation/FilmShelfStyles.xaml"/>
    <ResourceDictionary Source="FilmPlayerStyles.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <Style x:Key="Film.PlayerMenu" TargetType="ContextMenu"
          BasedOn="{StaticResource MeowFilm.ContextMenu}">
    <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Caption}"/>
    <Setter Property="Background" Value="#EB121212"/><Setter Property="BorderBrush" Value="#1FFFFFFF"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8"/>
    <Setter Property="Foreground" Value="#E0FFFFFF"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource Film.PlayerMenuItem}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
     <Border CornerRadius="14" Background="{TemplateBinding Background}"
             BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
             Padding="{TemplateBinding Padding}">
      <ItemsPresenter/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
     <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
     </DataTrigger>
    </Style.Triggers>
   </Style>
   <!-- Playback owns the text/ambient contrast pair, independently of the application theme. -->
   <SolidColorBrush x:Key="MeowFilm.Brush.Text" Color="#303443"/>
   <SolidColorBrush x:Key="MeowFilm.Brush.Muted" Color="#616573"/>
   <local:FilmPlayerHeightConverter x:Key="Film.PlayerHeight"/>
   <local:FilmScaleConverter x:Key="Film.Scale"/>
   <local:FilmAmbientTintConverter x:Key="Film.AmbientTint"/>
   <Style x:Key="Film.PlaybackAction" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Cursor" Value="Hand"/>
   </Style>
   <Style x:Key="Film.PlaybackArrow" TargetType="Button" BasedOn="{StaticResource Film.PlaybackAction}">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="{DynamicResource MeowFilm.Font.Icons}"/>
   </Style>
   <Style x:Key="Film.SourcePicker" TargetType="ComboBox" BasedOn="{StaticResource MeowFilm.ComboBox}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
     <Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"
       Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <Grid IsHitTestVisible="False" Margin="{TemplateBinding Padding}">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
       <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center"/>
       <Path x:Name="Arrow" Grid.Column="1" Data="M 0,0 L 4.5,4.5 L 9,0" Width="9" Height="5" Stretch="None" StrokeThickness="1.4"
        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{TemplateBinding Foreground}"
        HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
      </Grid>
      <Popup x:Name="PART_Popup" Style="{StaticResource MeowFilm.Popup}" Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding IsDropDownOpen}"
       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
       <Border x:Name="DropDown" Margin="0,0,10,10" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"
        Background="{TemplateBinding Background}" BorderBrush="{DynamicResource MeowFilm.Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="4">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity=".12"/></Border.Effect>
        <DockPanel KeyboardNavigation.TabNavigation="Cycle">
         <Button x:Name="SearchMoreSourcesButton" DockPanel.Dock="Bottom" Content="加载更多" Click="SearchMoreSources_Click"
          Style="{StaticResource Film.PlaybackAction}" HorizontalContentAlignment="Left" Margin="0,4,0,0"
          IsEnabled="{Binding CanSearchMore}" AutomationProperties.Name="继续搜索未完成来源"/>
         <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
         </ScrollViewer>
        </DockPanel>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
      <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter TargetName="DropDown" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <!-- Flat tiles: no resting surface or border; CardMotion supplies the hover and focus lift. -->
   <Style x:Key="Film.Tile" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
    <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Body}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"
             Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderThickness" Value="2"/>
     </Trigger>
     <MultiTrigger><MultiTrigger.Conditions>
      <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/>
      <Condition Property="IsMouseOver" Value="True"/>
     </MultiTrigger.Conditions>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
     </MultiTrigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Film.EpisodeTile" TargetType="Button" BasedOn="{StaticResource Film.Tile}">
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsSelected}" Value="True">
      <Setter Property="AutomationProperties.ItemStatus" Value="当前"/>
     </DataTrigger>
     <MultiDataTrigger><MultiDataTrigger.Conditions>
      <Condition Binding="{Binding IsSelected}" Value="True"/>
      <Condition Binding="{Binding Path=(desktop:DesktopTheme.IsHighContrast),RelativeSource={RelativeSource Self}}" Value="True"/>
     </MultiDataTrigger.Conditions>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
     </MultiDataTrigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Film.EpisodeLabel" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Center"/>
    <Style.Triggers><DataTrigger Binding="{Binding HasEpisodeTitle}" Value="True">
     <Setter Property="TextAlignment" Value="Left"/>
    </DataTrigger></Style.Triggers>
   </Style>
   <!-- Current episode: one pill on the still instead of a selection border. -->
   <Style x:Key="Film.CurrentBadge" TargetType="Border">
    <Setter Property="Background" Value="#B8000000"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="8,3,10,3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsSelected}" Value="True">
      <Setter Property="Visibility" Value="Visible"/>
     </DataTrigger>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
     </Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Film.CurrentBadgeText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Caption}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.CurrentGlyph" TargetType="Path">
    <Setter Property="Data" Value="M 0,0 L 7,4.5 L 0,9 Z"/>
    <Setter Property="Width" Value="7"/>
    <Setter Property="Height" Value="9"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Fill" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.DecorativeImage" TargetType="Image">
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Visibility" Value="Collapsed"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.OptionalText" TargetType="TextBlock">
    <Style.Triggers><Trigger Property="Text" Value="">
     <Setter Property="Visibility" Value="Collapsed"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.VideoOverlay" TargetType="Border">
    <Setter Property="Background" Value="#B8000000"/>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.OverviewToggle" TargetType="Button" BasedOn="{StaticResource Film.PlaybackAction}">
    <Setter Property="Content" Value="简介"/>
    <Setter Property="Padding" Value="12,4"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="AutomationProperties.ItemStatus" Value="已收起"/>
    <Style.Triggers><DataTrigger Binding="{Binding OverviewExpanded}" Value="True">
     <Setter Property="Content" Value="收起简介"/>
     <Setter Property="AutomationProperties.ItemStatus" Value="已展开"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding Overview}" Value="">
     <Setter Property="Visibility" Value="Collapsed"/>
    </DataTrigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.HeroPlay" TargetType="Button" BasedOn="{StaticResource MeowFilm.PrimaryButton}">
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="24,0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" CornerRadius="22"
             BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
             Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="BorderThickness" Value="1"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.Favorite" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Width" Value="64"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Title,StringFormat=收藏 {0}}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
     <Border Background="{TemplateBinding Background}" CornerRadius="12"
             BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter Property="AutomationProperties.Name" Value="{Binding Title,StringFormat=取消收藏 {0}}"/>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Hover}"/>
     </Trigger>
     <Trigger Property="IsPressed" Value="True">
      <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Pressed}"/>
     </Trigger>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderThickness" Value="1"/>
     </Trigger>
     <MultiTrigger><MultiTrigger.Conditions>
      <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/>
      <Condition Property="IsMouseOver" Value="True"/>
     </MultiTrigger.Conditions>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
     </MultiTrigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Film.ShortVideo" TargetType="CheckBox">
    <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="16,0"/>
    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
    <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Hover}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
     <Border CornerRadius="22" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
             BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Pressed}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
     </Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
     </MultiTrigger>
    </Style.Triggers>
   </Style>
   <DataTemplate x:Key="Film.EpisodeCard">
    <Viewbox Stretch="Uniform" Margin="0,0,16,0">
     <Button x:Name="Tile" Style="{StaticResource Film.EpisodeTile}" Width="260"
             local:CardMotion.Enabled="True" Tag="{Binding}" Click="Episode_Click" IsEnabled="{Binding CanSelect}"
             AutomationProperties.Name="{Binding Label}">
      <Button.RenderTransform><ScaleTransform
       ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.03}"
       ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.03}"/>
      </Button.RenderTransform>
      <StackPanel>
       <Grid Height="144" local:CardClip.Radius="10">
        <local:FilmPlaybackPoster Address="{Binding Image}" AutomationProperties.Name="{Binding Label}"
               RenderTransformOrigin=".5,.5">
         <local:FilmPlaybackPoster.RenderTransform><ScaleTransform
          ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.05}"
          ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.05}"/>
         </local:FilmPlaybackPoster.RenderTransform>
        </local:FilmPlaybackPoster>
        <local:FilmHoverShade Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Tile}"/>
        <local:FilmPlayMark Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Tile}"/>
        <Border Style="{StaticResource Film.CurrentBadge}" Margin="10">
         <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource Film.CurrentGlyph}"/>
          <TextBlock Text="当前" Style="{StaticResource Film.CurrentBadgeText}"/>
         </StackPanel>
        </Border>
        <Border Background="#B8000000" CornerRadius="5" Padding="7,3" Margin="10"
                HorizontalAlignment="Right" VerticalAlignment="Bottom">
         <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="{StaticResource MeowFilm.Font.Size.Caption}"/>
        </Border>
       </Grid>
       <StackPanel Margin="2,10,2,0">
        <TextBlock Text="{Binding Label}" FontSize="{StaticResource MeowFilm.Font.Size.Body}" FontWeight="{StaticResource MeowFilm.Font.Weight.Strong}"
                   Style="{StaticResource Film.EpisodeLabel}"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Overview}" FontSize="{StaticResource MeowFilm.Font.Size.Compact}" LineHeight="21" Height="42"
                   Margin="0,7,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   Style="{StaticResource Capability.Muted}"/>
       </StackPanel>
      </StackPanel>
     </Button>
    </Viewbox>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <UserControl.Style><Style TargetType="UserControl">
  <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Window}"/>
  <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
  </Trigger></Style.Triggers>
 </Style></UserControl.Style>
 <Grid>
  <!-- Viewport-fixed ambience behind the scrolling page; it fades out where Shell chrome meets this view. -->
  <Border x:Name="AmbientLayer" IsHitTestVisible="False" Tag="{DynamicResource MeowFilm.Brush.Window}">
   <Border.Style><Style TargetType="Border">
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Visibility" Value="Collapsed"/>
    </Trigger></Style.Triggers>
   </Style></Border.Style>
   <Border.OpacityMask>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
     <GradientStop Color="#00000000" Offset="0"/>
     <GradientStop Color="#FF000000" Offset=".09"/>
     <GradientStop Color="#FF000000" Offset=".72"/>
     <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
   </Border.OpacityMask>
   <Border x:Name="AmbientTint">
    <Border.Background>
     <MultiBinding Converter="{StaticResource Film.AmbientTint}">
      <Binding Path="PaletteBrush" ElementName="Backdrop"/>
      <Binding Path="Tag" ElementName="AmbientLayer"/>
     </MultiBinding>
    </Border.Background>
    <Border.OpacityMask>
     <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="48,0">
      <GradientStop Color="#00000000" Offset="0"/>
      <GradientStop Color="#FF000000" Offset="1"/>
     </LinearGradientBrush>
    </Border.OpacityMask>
   </Border>
  </Border>
  <ScrollViewer x:Name="PageScroll" Background="Transparent" ScrollChanged="Page_ScrollChanged"
                Style="{StaticResource MeowFilm.OverlayScrollViewer}"
                HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel x:Name="PageContent" Margin="32,12,32,32">
    <!-- Wide: player + 24px gutter + metadata fill the same content edges. -->
    <Grid x:Name="HeroGrid">
     <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="PlayerColumn" Width="1.85*"/>
      <ColumnDefinition x:Name="HeroGutter" Width="24"/>
      <ColumnDefinition x:Name="MetadataColumn" Width="*"/>
     </Grid.ColumnDefinitions>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition x:Name="HeroRowGutter" Height="0"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid x:Name="PlayerFrame" VerticalAlignment="Top" SizeChanged="Player_SizeChanged" AutomationProperties.Name="影片播放器">
      <Grid x:Name="VideoPicture" Background="Black" Height="{Binding ActualWidth,RelativeSource={RelativeSource Self},Converter={StaticResource Film.PlayerHeight}}">
       <ContentControl x:Name="VideoHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
       <!-- Native video uses VideoView.Content so the controls share its supported foreground window. -->
       <Grid x:Name="PlayerOverlay" Background="#01000000" Loaded="Overlay_Loaded" Unloaded="Overlay_Unloaded" SizeChanged="Overlay_SizeChanged" Focusable="True" FocusVisualStyle="{x:Null}"
             MouseMove="Player_MouseMove" MouseEnter="Player_MouseEnter" MouseLeave="Player_MouseLeave"
             PreviewMouseLeftButtonDown="Picture_MouseDown" PreviewMouseDown="Menu_MouseDown" PreviewKeyDown="Player_KeyDown">
        <Border x:Name="ShortVideoGesture" Background="Transparent"
                Visibility="{Binding ShortVideo,Converter={StaticResource MeowFilm.BoolToVisibility}}"
                IsManipulationEnabled="True" ManipulationCompleted="Swipe_Completed"
                PreviewMouseWheel="ShortVideo_Wheel" PreviewMouseLeftButtonDown="Swipe_Begin"
                PreviewMouseLeftButtonUp="Swipe_End" AutomationProperties.Name="滑动切集"/>
        <StackPanel x:Name="PlayerStatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="24,0"
                    Visibility="{Binding PlayerStatusVisible,Converter={StaticResource MeowFilm.BoolToVisibility}}" IsHitTestVisible="False">
         <TextBlock x:Name="PlayerStatus" Text="{Binding PlayerStatusText}" Style="{StaticResource Film.PlayerStatus}"/>
         <ProgressBar Style="{StaticResource Film.PlayerStage}" Minimum="0" Maximum="1" Value="{Binding PlayerStageProgress,Mode=OneWay}" MaxWidth="520" Margin="0,12,0,0"
                      Visibility="{Binding PlayerBusy,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0">
         <Button Content="重连" Click="Reconnect_Click" Style="{StaticResource Film.PlayerTextButton}" Margin="4,0"
                 Visibility="{Binding ConnectionFailed,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
         <Button x:Name="RetryMediaRecoveryButton" Content="重新取址" Click="RetryMedia_Click" Margin="4,0" AutomationProperties.Name="重试当前媒体地址">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Film.PlayerTextButton}">
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers><MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding NoOutput}" Value="True"/>
             <Condition Binding="{Binding CanRetryMedia}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Visible"/>
           </MultiDataTrigger></Style.Triggers>
          </Style></Button.Style>
         </Button>
        </StackPanel>
        <Path x:Name="BufferSpinner" Width="62" Height="62" Data="M31,4 A27,27 0 1 1 4,31" Stroke="#F2FFFFFF" StrokeThickness="4"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin=".5,.5">
         <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
        </Path>
        <Grid x:Name="PlayerChrome" IsHitTestVisible="True">
         <StackPanel x:Name="ControlBar" VerticalAlignment="Bottom" Margin="0" Focusable="False" PreviewMouseDown="Controls_MouseDown" PreviewMouseUp="Controls_MouseUp" SizeChanged="ControlBar_SizeChanged">
          <StackPanel.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000"/><GradientStop Color="#8C000000" Offset="1"/></LinearGradientBrush></StackPanel.Background>
          <Slider x:Name="SeekSlider" Style="{StaticResource Film.PlayerSeek}" Margin="14,12,14,14" Minimum="0" Maximum="{Binding Duration}" IsEnabled="{Binding CanSeek}"
