<UserControl x:Class="MeowFilm.Capabilities.FilmPlaybackView" x:Name="PlaybackRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 SizeChanged="OnSizeChanged"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <!-- Playback owns the text/ambient contrast pair, independently of the application theme. -->
   <SolidColorBrush x:Key="MeowFilm.Brush.Text" Color="#303443"/>
   <SolidColorBrush x:Key="MeowFilm.Brush.Muted" Color="#616573"/>
   <local:FilmPlayerHeightConverter x:Key="Film.PlayerHeight"/>
   <local:FilmScaleConverter x:Key="Film.Scale"/>
   <local:FilmAmbientTintConverter x:Key="Film.AmbientTint"/>
   <Style x:Key="Film.PlaybackAction" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Cursor" Value="Hand"/>
   </Style>
   <Style x:Key="Film.PlaybackArrow" TargetType="Button" BasedOn="{StaticResource Film.PlaybackAction}">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="{DynamicResource MeowFilm.Font.Icons}"/>
   </Style>
   <!-- Flat tiles: no resting surface or border; CardMotion supplies the hover and focus lift. -->
   <Style x:Key="Film.Tile" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"
             Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderThickness" Value="2"/>
     </Trigger>
     <MultiTrigger><MultiTrigger.Conditions>
      <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/>
      <Condition Property="IsMouseOver" Value="True"/>
     </MultiTrigger.Conditions>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
     </MultiTrigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Film.EpisodeTile" TargetType="Button" BasedOn="{StaticResource Film.Tile}">
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsSelected}" Value="True">
      <Setter Property="AutomationProperties.ItemStatus" Value="当前"/>
     </DataTrigger>
     <MultiDataTrigger><MultiDataTrigger.Conditions>
      <Condition Binding="{Binding IsSelected}" Value="True"/>
      <Condition Binding="{Binding Path=(desktop:DesktopTheme.IsHighContrast),RelativeSource={RelativeSource Self}}" Value="True"/>
     </MultiDataTrigger.Conditions>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
     </MultiDataTrigger>
    </Style.Triggers>
   </Style>
   <!-- Current episode: one pill on the still instead of a selection border. -->
   <Style x:Key="Film.CurrentBadge" TargetType="Border">
    <Setter Property="Background" Value="#B8000000"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="8,3,10,3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsSelected}" Value="True">
      <Setter Property="Visibility" Value="Visible"/>
     </DataTrigger>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
     </Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Film.CurrentBadgeText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.CurrentGlyph" TargetType="Path">
    <Setter Property="Data" Value="M 0,0 L 7,4.5 L 0,9 Z"/>
    <Setter Property="Width" Value="7"/>
    <Setter Property="Height" Value="9"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Fill" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.DecorativeImage" TargetType="Image">
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Visibility" Value="Collapsed"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.VideoText" TargetType="TextBlock" BasedOn="{StaticResource Capability.Text}">
    <Setter Property="Foreground" Value="White"/>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.VideoOverlay" TargetType="Border">
    <Setter Property="Background" Value="#B8000000"/>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.OverviewToggle" TargetType="Button" BasedOn="{StaticResource Film.PlaybackAction}">
    <Setter Property="Content" Value="简介"/>
    <Setter Property="Padding" Value="12,4"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="AutomationProperties.ItemStatus" Value="已收起"/>
    <Style.Triggers><DataTrigger Binding="{Binding OverviewExpanded}" Value="True">
     <Setter Property="Content" Value="收起简介"/>
     <Setter Property="AutomationProperties.ItemStatus" Value="已展开"/>
    </DataTrigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.HeroPlay" TargetType="Button" BasedOn="{StaticResource MeowFilm.PrimaryButton}">
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="24,0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" CornerRadius="22"
             BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
             Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="BorderThickness" Value="1"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Film.Favorite" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Width" Value="64"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Title,StringFormat=收藏 {0}}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
     <Border Background="{TemplateBinding Background}" CornerRadius="12"
             BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter Property="AutomationProperties.Name" Value="{Binding Title,StringFormat=取消收藏 {0}}"/>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Hover}"/>
     </Trigger>
     <Trigger Property="IsPressed" Value="True">
      <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Pressed}"/>
     </Trigger>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      <Setter Property="BorderThickness" Value="1"/>
     </Trigger>
     <MultiTrigger><MultiTrigger.Conditions>
      <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/>
      <Condition Property="IsMouseOver" Value="True"/>
     </MultiTrigger.Conditions>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
     </MultiTrigger>
    </Style.Triggers>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <UserControl.Style><Style TargetType="UserControl">
  <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Window}"/>
  <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
  </Trigger></Style.Triggers>
 </Style></UserControl.Style>
 <Grid>
  <!-- Viewport-fixed ambience behind the scrolling page; it fades out where Shell chrome meets this view. -->
  <Border x:Name="AmbientLayer" IsHitTestVisible="False" Tag="{DynamicResource MeowFilm.Brush.Window}">
   <Border.Style><Style TargetType="Border">
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Visibility" Value="Collapsed"/>
    </Trigger></Style.Triggers>
   </Style></Border.Style>
   <Border.OpacityMask>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
     <GradientStop Color="#00000000" Offset="0"/>
     <GradientStop Color="#FF000000" Offset=".09"/>
     <GradientStop Color="#FF000000" Offset=".72"/>
     <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
   </Border.OpacityMask>
   <Border x:Name="AmbientTint">
    <Border.Background>
     <MultiBinding Converter="{StaticResource Film.AmbientTint}">
      <Binding Path="PaletteBrush" ElementName="Backdrop"/>
      <Binding Path="Tag" ElementName="AmbientLayer"/>
     </MultiBinding>
    </Border.Background>
    <Border.OpacityMask>
     <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="48,0">
      <GradientStop Color="#00000000" Offset="0"/>
      <GradientStop Color="#FF000000" Offset="1"/>
     </LinearGradientBrush>
    </Border.OpacityMask>
   </Border>
  </Border>
  <ScrollViewer x:Name="PageScroll" Background="Transparent"
                Style="{StaticResource MeowFilm.OverlayScrollViewer}"
                HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel x:Name="PageContent" Margin="32,12,32,32">
    <!-- Wide: player + 24px gutter + metadata fill the same content edges. -->
    <Grid x:Name="HeroGrid">
     <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="PlayerColumn" Width="1.85*"/>
      <ColumnDefinition x:Name="HeroGutter" Width="24"/>
      <ColumnDefinition x:Name="MetadataColumn" Width="*"/>
     </Grid.ColumnDefinitions>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition x:Name="HeroRowGutter" Height="0"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid x:Name="PlayerFrame" VerticalAlignment="Top" SizeChanged="Player_SizeChanged"
           local:CardClip.Radius="16"
           Height="{Binding ActualWidth,RelativeSource={RelativeSource Self},Converter={StaticResource Film.PlayerHeight}}"
           AutomationProperties.Name="影片播放器">
      <Grid.Style><Style TargetType="Grid">
       <Setter Property="Background" Value="#151515"/>
       <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
       </Trigger></Style.Triggers>
      </Style></Grid.Style>
      <Image Source="{Binding SelectedEpisode.Image}" Stretch="UniformToFill"
             Style="{StaticResource Film.DecorativeImage}" AutomationProperties.Name="当前集预览"/>
      <Border IsHitTestVisible="False">
       <Border.Style><Style TargetType="Border">
        <Setter Property="Background" Value="#40000000"/>
        <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
         <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger></Style.Triggers>
       </Style></Border.Style>
      </Border>
      <Border Margin="16" Padding="10,5" Style="{StaticResource Film.VideoOverlay}" CornerRadius="6"
              HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="380"
              Visibility="{Binding HasEpisodes,Converter={StaticResource MeowFilm.BoolToVisibility}}">
       <TextBlock x:Name="PlayerEpisode" Text="{Binding SelectedEpisode.Label}"
                  Style="{StaticResource Film.VideoText}" FontSize="13" TextTrimming="CharacterEllipsis"/>
      </Border>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,42">
       <Button x:Name="PlayButton" IsEnabled="False" Width="64" Height="64"
               Margin="0,0,0,10" Padding="0" AutomationProperties.Name="播放（暂无片源）">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
         <Setter Property="Background" Value="#A0000000"/>
         <Setter Property="BorderBrush" Value="#90FFFFFF"/>
         <Setter Property="Foreground" Value="White"/>
         <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
          <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
          <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
         </Trigger></Style.Triggers>
        </Style></Button.Style>
        <Path Data="M 0,0 L 19,12 L 0,24 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
              Width="19" Height="24" Margin="4,0,0,0" Stretch="Fill"/>
       </Button>
       <TextBlock x:Name="PlayerStatus" Text="暂无片源" Style="{StaticResource Film.VideoText}"
                  TextAlignment="Center" FontSize="14"/>
      </StackPanel>
      <Border VerticalAlignment="Bottom" Style="{StaticResource Film.VideoOverlay}" Padding="16,8">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
         <ColumnDefinition/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xE768;" FontFamily="{DynamicResource MeowFilm.Font.Icons}"
                   FontSize="15" Style="{StaticResource Film.VideoText}" Opacity=".7" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="— / —" FontSize="12" Style="{StaticResource Film.VideoText}" Opacity=".8"
                   Margin="12,0,16,0" VerticalAlignment="Center"/>
        <Border Grid.Column="2" Height="3" CornerRadius="1.5" Background="#40FFFFFF"
                VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="{Binding SelectedEpisode.Duration}" FontSize="12"
                   Style="{StaticResource Film.VideoText}" Opacity=".8" Margin="16,0,0,0" VerticalAlignment="Center"/>
       </Grid>
      </Border>
     </Grid>
     <Grid x:Name="MetadataPanel" Grid.Column="2" local:CardClip.Radius="16">
      <!-- The poster covers the entire information region; all content scrolls in front of it. -->
      <Grid x:Name="MetadataBackdrop" IsHitTestVisible="False">
       <Grid.Style><Style TargetType="Grid">
        <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
         <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger></Style.Triggers>
       </Style></Grid.Style>
       <local:FilmPlaybackPoster x:Name="Backdrop" Address="{Binding Poster}" IsBackdrop="True"
                                 IsHitTestVisible="False"/>
       <Border x:Name="MetadataWash" Background="{DynamicResource MeowFilm.Brush.Window}">
        <Border.OpacityMask>
         <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#BD000000" Offset="0"/>
          <GradientStop Color="#BD000000" Offset=".6"/>
          <GradientStop Color="#D6000000" Offset="1"/>
         </LinearGradientBrush>
        </Border.OpacityMask>
       </Border>
      </Grid>
      <ScrollViewer x:Name="MetadataScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Style="{StaticResource MeowFilm.OverlayScrollViewer}" ScrollChanged="Metadata_ScrollChanged">
       <Grid x:Name="MetadataOverlay">
       <StackPanel x:Name="MetadataContent" Margin="20,22,20,22" VerticalAlignment="Center">
       <TextBlock x:Name="FilmTitle" Text="{Binding Title}" FontSize="26" FontWeight="Bold"
                  TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
       <TextBlock x:Name="FilmMetadata" Text="{Binding Metadata}" Margin="0,6,0,0" FontSize="13" LineHeight="21"
                  TextWrapping="Wrap" TextAlignment="Center"/>
       <WrapPanel x:Name="FilmFacts" HorizontalAlignment="Center" Margin="0,6,0,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center"
                    Visibility="{Binding Item.HasScore,Converter={StaticResource MeowFilm.BoolToVisibility}}">
         <TextBlock Text="★" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
         <TextBlock Text="{Binding Item.Score}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
         <TextBlock Text="豆瓣" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{Binding Genres}" FontSize="13" LineHeight="21" TextWrapping="Wrap"
                   TextAlignment="Center"/>
       </WrapPanel>
       <StackPanel x:Name="HeroActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,16">
        <Button x:Name="HeroPlayButton" IsEnabled="False" Style="{StaticResource Film.HeroPlay}"
                AutomationProperties.Name="播放（暂无片源）" Margin="0,0,12,0">
         <StackPanel Orientation="Horizontal">
          <Path Data="M 0,0 L 11,7 L 0,14 Z" Width="11" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
          <TextBlock Text="暂无片源" FontSize="14" VerticalAlignment="Center"
                     Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
         </StackPanel>
        </Button>
        <ToggleButton x:Name="FavoriteButton" IsChecked="{Binding IsFavorite,Mode=TwoWay}"
                      Style="{StaticResource Film.Favorite}">
         <StackPanel>
          <TextBlock FontFamily="{DynamicResource MeowFilm.Font.Icons}" FontSize="19" HorizontalAlignment="Center">
           <TextBlock.Style><Style TargetType="TextBlock">
            <Setter Property="Text" Value="&#xEB51;"/>
            <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsFavorite}" Value="True">
              <Setter Property="Text" Value="&#xEB52;"/>
             </DataTrigger>
            </Style.Triggers>
           </Style></TextBlock.Style>
          </TextBlock>
          <TextBlock x:Name="FavoriteLabel" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"
                     Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ToggleButton}}">
           <TextBlock.Style><Style TargetType="TextBlock">
            <Setter Property="Text" Value="收藏"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True">
             <Setter Property="Text" Value="已收藏"/>
            </DataTrigger></Style.Triggers>
           </Style></TextBlock.Style>
          </TextBlock>
         </StackPanel>
        </ToggleButton>
       </StackPanel>
       <Button x:Name="OverviewToggle" HorizontalAlignment="Center"
               Click="Overview_Click" Style="{StaticResource Film.OverviewToggle}"
               Visibility="{Binding HasOverview,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
       <TextBlock x:Name="OverviewText" Text="{Binding Overview}" TextWrapping="Wrap"
                  FontSize="13" LineHeight="22" Margin="0,10,0,0"
                  Visibility="{Binding OverviewExpanded,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
       <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="导演" FontSize="13" LineHeight="21"
                   Visibility="{Binding HasDirectors,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
        <TextBlock Grid.Column="1" Text="{Binding Directors}" FontSize="13" LineHeight="21" TextWrapping="Wrap"
                   Visibility="{Binding HasDirectors,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
        <TextBlock Grid.Row="1" Text="演员" FontSize="13" LineHeight="21" Margin="0,6,0,0"
                   Visibility="{Binding HasCast,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Cast}" FontSize="13"
                   LineHeight="21" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="{Binding HasCast,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
       </Grid>
       </StackPanel>
       </Grid>
      </ScrollViewer>
     </Grid>
    </Grid>
    <Grid Margin="0,28,0,14">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <WrapPanel VerticalAlignment="Center">
      <TextBlock Text="选集" Style="{StaticResource MeowFilm.SectionHeading}" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding SeasonLabel}" FontSize="13" VerticalAlignment="Center"
                 Style="{StaticResource Capability.Muted}" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding EpisodeCountLabel}" FontSize="13" VerticalAlignment="Center"
                 Style="{StaticResource Capability.Muted}"/>
     </WrapPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal"
                 Visibility="{Binding HasEpisodes,Converter={StaticResource MeowFilm.BoolToVisibility}}">
      <Border Background="{DynamicResource MeowFilm.Brush.Hover}" CornerRadius="8" Padding="3" Margin="0,0,10,0">
       <StackPanel Orientation="Horizontal">
        <Button x:Name="HorizontalLayout" Click="HorizontalLayout_Click"
                AutomationProperties.Name="横向选集" MinHeight="30" Padding="10,3">
         <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Film.PlaybackAction}">
          <Style.Triggers><DataTrigger Binding="{Binding IsHorizontalLayout}" Value="True">
           <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Surface}"/>
           <Setter Property="AutomationProperties.ItemStatus" Value="已选"/>
          </DataTrigger></Style.Triggers>
         </Style></Button.Style>
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE8A0;" FontFamily="{DynamicResource MeowFilm.Font.Icons}" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="横向"/>
         </StackPanel>
        </Button>
        <Button x:Name="ListLayout" Click="ListLayout_Click"
                AutomationProperties.Name="列表选集" MinHeight="30" Padding="10,3">
         <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Film.PlaybackAction}">
          <Style.Triggers><DataTrigger Binding="{Binding IsListLayout}" Value="True">
           <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Surface}"/>
           <Setter Property="AutomationProperties.ItemStatus" Value="已选"/>
          </DataTrigger></Style.Triggers>
         </Style></Button.Style>
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource MeowFilm.Font.Icons}" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="列表"/>
         </StackPanel>
        </Button>
       </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal"
                  Visibility="{Binding IsHorizontalLayout,Converter={StaticResource MeowFilm.BoolToVisibility}}">
       <Button x:Name="EpisodePrevious" Content="&#xE76B;" Click="EpisodePrevious_Click"
               Style="{StaticResource Film.PlaybackArrow}" AutomationProperties.Name="向左浏览选集"/>
       <Button x:Name="EpisodeNext" Content="&#xE76C;" Click="EpisodeNext_Click" Margin="6,0,0,0"
               Style="{StaticResource Film.PlaybackArrow}" AutomationProperties.Name="向右浏览选集"/>
      </StackPanel>
     </StackPanel>
    </Grid>
    <!-- Rails trade an 8px negative margin for 8px padding so lifted tiles stay inside the viewport. -->
    <ScrollViewer x:Name="HorizontalEpisodes" Margin="-8" HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                  Visibility="{Binding IsHorizontalLayout,Converter={StaticResource MeowFilm.BoolToVisibility}}"
                  ScrollChanged="Rail_ScrollChanged" PreviewMouseWheel="Rail_MouseWheel"
                  PreviewKeyDown="Rail_KeyDown">
     <ItemsControl x:Name="EpisodeCards" Padding="8" ItemsSource="{Binding Episodes}" AutomationProperties.Name="横向选集列表">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button x:Name="Tile" Style="{StaticResource Film.EpisodeTile}" Width="260" Margin="0,0,16,0"
               local:CardMotion.Enabled="True" Tag="{Binding}" Click="Episode_Click"
               AutomationProperties.Name="{Binding Label}">
        <Button.RenderTransform><ScaleTransform
         ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.03}"
         ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.03}"/>
        </Button.RenderTransform>
        <StackPanel>
         <Grid Height="144" local:CardClip.Radius="10">
          <Image Source="{Binding Image}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Label}"
                 RenderTransformOrigin=".5,.5">
           <Image.RenderTransform><ScaleTransform
            ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.05}"
            ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.05}"/>
           </Image.RenderTransform>
          </Image>
          <local:FilmHoverShade Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Tile}"/>
          <local:FilmPlayMark Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Tile}"/>
          <Border Style="{StaticResource Film.CurrentBadge}" Margin="10">
           <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Film.CurrentGlyph}"/>
            <TextBlock Text="当前" Style="{StaticResource Film.CurrentBadgeText}"/>
           </StackPanel>
          </Border>
          <Border Background="#B8000000" CornerRadius="5" Padding="7,3" Margin="10"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom">
           <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="12"/>
          </Border>
         </Grid>
         <StackPanel Margin="2,10,2,0">
          <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Overview}" FontSize="13" LineHeight="21" Height="42"
                     Margin="0,7,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                     Style="{StaticResource Capability.Muted}"/>
         </StackPanel>
        </StackPanel>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <ItemsControl x:Name="EpisodeList" ItemsSource="{Binding Episodes}" AutomationProperties.Name="逐集列表"
                  Visibility="{Binding IsListLayout,Converter={StaticResource MeowFilm.BoolToVisibility}}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button x:Name="Tile" Style="{StaticResource Film.EpisodeTile}" Margin="0,0,0,16"
              local:CardMotion.Enabled="True" Tag="{Binding}" Click="Episode_Click"
              AutomationProperties.Name="{Binding Label}">
       <Button.RenderTransform><ScaleTransform
        ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.01}"
        ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.01}"/>
       </Button.RenderTransform>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <!-- Soft row lift on hover or focus; it reaches past the row without changing its layout. -->
        <Border x:Name="RowHover" Grid.ColumnSpan="3" Margin="-10" CornerRadius="14" IsHitTestVisible="False"
                Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Tile}">
         <Border.Style><Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Hover}"/>
          <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
           <Setter Property="Visibility" Value="Collapsed"/>
          </Trigger></Style.Triggers>
         </Style></Border.Style>
        </Border>
        <Grid Height="99" local:CardClip.Radius="8" VerticalAlignment="Center">
         <Image Source="{Binding Image}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Label}"
                RenderTransformOrigin=".5,.5">
          <Image.RenderTransform><ScaleTransform
           ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.05}"
           ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.05}"/>
          </Image.RenderTransform>
         </Image>
         <local:FilmHoverShade Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Tile}"/>
         <local:FilmPlayMark Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Tile}"/>
         <Border Style="{StaticResource Film.CurrentBadge}" Margin="8">
          <StackPanel Orientation="Horizontal">
           <Path Style="{StaticResource Film.CurrentGlyph}"/>
           <TextBlock Text="当前" Style="{StaticResource Film.CurrentBadgeText}"/>
          </StackPanel>
         </Border>
        </Grid>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
         <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Duration}" FontSize="12" Margin="0,5,0,0" Style="{StaticResource Capability.Muted}"/>
         <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" FontSize="13" LineHeight="21"
                    MaxHeight="63" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"
                    Style="{StaticResource Capability.Muted}"/>
        </StackPanel>
       </Grid>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Margin="0,28,0,14" Visibility="{Binding HasRecommendations,Converter={StaticResource MeowFilm.BoolToVisibility}}">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="相关推荐" Style="{StaticResource MeowFilm.SectionHeading}" Margin="0" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="RelatedPrevious" Content="&#xE76B;" Click="RelatedPrevious_Click"
              Style="{StaticResource Film.PlaybackArrow}" AutomationProperties.Name="向左浏览相关推荐"/>
      <Button x:Name="RelatedNext" Content="&#xE76C;" Click="RelatedNext_Click" Margin="6,0,0,0"
              Style="{StaticResource Film.PlaybackArrow}" AutomationProperties.Name="向右浏览相关推荐"/>
     </StackPanel>
    </Grid>
    <ScrollViewer x:Name="RelatedScroll" Margin="-8" HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                  ScrollChanged="Rail_ScrollChanged" PreviewMouseWheel="Rail_MouseWheel"
                  PreviewKeyDown="Rail_KeyDown">
     <ItemsControl x:Name="RelatedItems" Padding="8" ItemsSource="{Binding Recommendations}" AutomationProperties.Name="相关推荐">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button x:Name="Tile" Style="{StaticResource Film.Tile}" Width="156" Margin="0,0,16,0"
               local:CardMotion.Enabled="True" Tag="{Binding}" Click="Recommendation_Click"
               AutomationProperties.Name="{Binding Title}">
        <Button.RenderTransform><ScaleTransform
         ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.03}"
         ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.03}"/>
        </Button.RenderTransform>
        <StackPanel>
         <Grid Height="234" local:CardClip.Radius="10" Background="{DynamicResource MeowFilm.Brush.Hover}">
          <local:FilmPlaybackPoster Address="{Binding Poster}" AutomationProperties.Name="{Binding Title,StringFormat=影片海报 {0}}"
                                    RenderTransformOrigin=".5,.5">
           <local:FilmPlaybackPoster.RenderTransform><ScaleTransform
            ScaleX="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.05}"
            ScaleY="{Binding Path=(local:CardMotion.Progress),ElementName=Tile,Converter={StaticResource Film.Scale},ConverterParameter=0.05}"/>
           </local:FilmPlaybackPoster.RenderTransform>
          </local:FilmPlaybackPoster>
          <local:FilmHoverShade Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Tile}"/>
          <local:FilmPlayMark Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Tile}"/>
          <Border Background="#B8000000" CornerRadius="5" Padding="6,3" Margin="8"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Visibility="{Binding HasScore,Converter={StaticResource MeowFilm.BoolToVisibility}}">
           <TextBlock Text="{Binding Score}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
          </Border>
         </Grid>
         <TextBlock Text="{Binding Title}" FontSize="14" Margin="0,10,0,0"
                    TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
