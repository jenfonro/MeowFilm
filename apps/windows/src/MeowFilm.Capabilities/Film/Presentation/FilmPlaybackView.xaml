          <TextBlock FontFamily="{DynamicResource MeowFilm.Font.Icons}" FontSize="19" HorizontalAlignment="Center">
           <TextBlock.Style><Style TargetType="TextBlock">
            <Setter Property="Text" Value="&#xEB51;"/>
            <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsFavorite}" Value="True">
              <Setter Property="Text" Value="&#xEB52;"/>
             </DataTrigger>
            </Style.Triggers>
           </Style></TextBlock.Style>
          </TextBlock>
          <TextBlock x:Name="FavoriteLabel" FontSize="{StaticResource MeowFilm.Font.Size.Caption}" HorizontalAlignment="Center" Margin="0,3,0,0"
                     Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ToggleButton}}">
           <TextBlock.Style><Style TargetType="TextBlock">
            <Setter Property="Text" Value="收藏"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True">
             <Setter Property="Text" Value="已收藏"/>
            </DataTrigger></Style.Triggers>
           </Style></TextBlock.Style>
          </TextBlock>
         </StackPanel>
        </ToggleButton>
       </StackPanel>
       <Button x:Name="OverviewToggle" HorizontalAlignment="Center"
               Click="Overview_Click" Style="{StaticResource Film.OverviewToggle}"/>
