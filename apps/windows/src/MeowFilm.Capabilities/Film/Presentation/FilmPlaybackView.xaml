                   LineHeight="21" Margin="0,6,0,0" TextWrapping="Wrap"
                   Style="{StaticResource Film.OptionalText}"/>
       </Grid>
       </StackPanel>
       </Grid>
      </ScrollViewer>
     </Grid>
