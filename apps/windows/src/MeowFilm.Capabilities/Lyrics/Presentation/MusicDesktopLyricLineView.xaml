<UserControl x:Class="MeowFilm.Capabilities.MusicDesktopLyricLineView" x:Name="Root" IsHitTestVisible="False"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MeowFilm.Capabilities">
 <StackPanel Margin="2" VerticalAlignment="Center">
  <Viewbox Stretch="Uniform" MaxHeight="50" HorizontalAlignment="{Binding HorizontalContentAlignment,ElementName=Root}">
   <Grid><local:MusicDesktopLyricTextView x:Name="PlainText" Text="{Binding Row.Text,ElementName=Root}" FontSize="32" Foreground="{Binding Normal,ElementName=Root}"/>
    <StackPanel x:Name="Words" Orientation="Horizontal" Visibility="Collapsed"/>
   </Grid>
  </Viewbox>
  <Viewbox x:Name="TranslationFrame" Stretch="Uniform" MaxHeight="27" Margin="0,3,0,0" HorizontalAlignment="{Binding HorizontalContentAlignment,ElementName=Root}">
   <local:MusicDesktopLyricTextView x:Name="TranslationText" Text="{Binding Row.Translation,ElementName=Root}" FontSize="17" Foreground="{Binding Normal,ElementName=Root}"/>
  </Viewbox>
 </StackPanel>
</UserControl>
