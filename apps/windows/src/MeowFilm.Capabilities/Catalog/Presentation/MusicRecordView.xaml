<UserControl x:Class="MeowFilm.Capabilities.MusicRecordView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:art="clr-namespace:MeowFilm.Desktop.Artwork;assembly=MeowFilm.Desktop">
 <Grid Background="Transparent" ClipToBounds="True" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified">
  <Viewbox x:Name="RecordSurface" Stretch="Uniform" RenderTransformOrigin=".5,.5">
   <Viewbox.RenderTransform><TranslateTransform x:Name="SwipeTranslation"/></Viewbox.RenderTransform>
   <Grid Width="300" Height="300" RenderTransformOrigin=".5,.5">
    <Grid.RenderTransform><RotateTransform x:Name="Rotation"/></Grid.RenderTransform>
    <Ellipse x:Name="Grooves" Stroke="#0A0A0B" StrokeThickness="2"/>
    <Ellipse Margin="2" IsHitTestVisible="False">
     <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#06FFFFFF" Offset=".20"/>
      <GradientStop Color="#19FFFFFF" Offset=".34"/><GradientStop Color="#00FFFFFF" Offset=".49"/>
      <GradientStop Color="#00FFFFFF" Offset=".62"/><GradientStop Color="#14FFFFFF" Offset=".77"/>
      <GradientStop Color="#00FFFFFF" Offset="1"/>
     </LinearGradientBrush></Ellipse.Fill>
    </Ellipse>
    <art:ArtworkImage x:Name="Cover" Width="192" Height="192" RenderOptions.BitmapScalingMode="HighQuality">
     <art:ArtworkImage.Clip><EllipseGeometry Center="96,96" RadiusX="96" RadiusY="96"/></art:ArtworkImage.Clip>
    </art:ArtworkImage>
   </Grid>
  </Viewbox>
 </Grid>
</UserControl>
