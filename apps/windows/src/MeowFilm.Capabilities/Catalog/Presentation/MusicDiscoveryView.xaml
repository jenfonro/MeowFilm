<UserControl x:Class="MeowFilm.Capabilities.MusicDiscoveryView" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities" xmlns:desktop="using:MeowFilm.Desktop" xmlns:art="using:MeowFilm.Desktop.Artwork">
 <UserControl.Resources><ResourceDictionary>
  <local:MusicVisibilityConverter x:Key="DiscoveryVisible"/>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <StackPanel Orientation="Horizontal"><Button Content="换一组" Click="Rotate_Click" IsEnabled="{Binding CanRotateDiscovery}"/><Button Content="取消" Click="Cancel_Click" IsEnabled="{Binding CanCancelDiscovery}"/></StackPanel>
   <desktop:NoticeOutlet Message="{Binding DiscoveryStatus}"/><ItemsControl ItemsSource="{Binding DiscoveryFailures}"><ItemsControl.ItemTemplate><DataTemplate><desktop:NoticeOutlet Message="{Binding Text}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock Text="推荐搜索" Style="{StaticResource MeowFilm.SectionHeading}" Margin="0,12"/>
   <ItemsControl ItemsSource="{Binding DiscoveryRecommended}" IsEnabled="{Binding CanUseDiscovery}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><desktop:WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Text}" Tag="{Binding}" Click="Keyword_Click" MaxWidth="280"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="热搜" Style="{StaticResource MeowFilm.SectionHeading}" Margin="0,12"/>
   <ItemsControl ItemsSource="{Binding DiscoveryHot}" IsEnabled="{Binding CanUseDiscovery}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><desktop:WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Text}" Tag="{Binding}" Click="Keyword_Click" MaxWidth="280"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button Content="清空搜索历史" Click="ClearHistory_Click" HorizontalAlignment="Left" Margin="0,12,0,4" IsEnabled="{Binding CanEdit}" Visibility="{Binding HasSearchHistory,Converter={StaticResource DiscoveryVisible}}"/>
   <ItemsControl ItemsSource="{Binding DiscoveryCharts}" IsEnabled="{Binding CanUseDiscovery}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource MeowFilm.Surface}" Padding="16" Margin="0,12,0,4"><StackPanel>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="56" Height="56" Margin="0,0,12,0" Visibility="{Binding Cover,Converter={StaticResource DiscoveryVisible}}"><art:ArtworkImage Address="{Binding Cover}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Name}"/></Border>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Style="{StaticResource MeowFilm.SectionHeading}"/><TextBlock Text="{Binding Creator}" Style="{StaticResource Capability.Muted}" Margin="0,4,0,0"/><TextBlock Text="{Binding CountText}" Style="{StaticResource Capability.Muted}" Margin="0,6,0,0"/></StackPanel>
      <Button Grid.Column="2" Content="打开歌单" Tag="{Binding}" Click="Chart_Click"/>
     </Grid>
     <ItemsControl ItemsSource="{Binding Songs}"><ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Style="{StaticResource Capability.Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="播放" Tag="{Binding}" Click="Play_Click"/><Button Content="下一首播放" Tag="{Binding}" Click="Queue_Click"/></StackPanel>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
