<UserControl x:Class="MeowFilm.Capabilities.MusicDiscoveryView" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities" xmlns:desktop="using:MeowFilm.Desktop" xmlns:art="using:MeowFilm.Desktop.Artwork">
 <UserControl.Resources><ResourceDictionary>
  <local:MusicVisibilityConverter x:Key="DiscoveryVisible"/>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <StackPanel Orientation="Horizontal"><Button Content="换一组" Click="Rotate_Click" IsEnabled="{x:Bind Discovery.CanRotateDiscovery,Mode=OneWay,FallbackValue=False}"/><Button Content="取消" Click="Cancel_Click" IsEnabled="{x:Bind Discovery.CanCancelDiscovery,Mode=OneWay,FallbackValue=False}"/></StackPanel>
   <desktop:NoticeOutlet Message="{x:Bind Discovery.DiscoveryStatus,Mode=OneWay,TargetNullValue=''}"/><ItemsControl ItemsSource="{x:Bind Discovery.DiscoveryFailures,Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:MusicDiscoveryFailure"><desktop:NoticeOutlet Message="{x:Bind Text}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock Text="推荐搜索" Style="{StaticResource MeowFilm.SectionHeading}" Margin="0,12"/>
   <ItemsControl ItemsSource="{x:Bind Discovery.DiscoveryRecommended,Mode=OneWay}" IsEnabled="{x:Bind Discovery.CanUseDiscovery,Mode=OneWay,FallbackValue=False}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><desktop:WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:MusicDiscoveryKeyword"><Button Content="{x:Bind Text}" Tag="{x:Bind}" Click="Keyword_Click" MaxWidth="280"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="热搜" Style="{StaticResource MeowFilm.SectionHeading}" Margin="0,12"/>
   <ItemsControl ItemsSource="{x:Bind Discovery.DiscoveryHot,Mode=OneWay}" IsEnabled="{x:Bind Discovery.CanUseDiscovery,Mode=OneWay,FallbackValue=False}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><desktop:WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:MusicDiscoveryKeyword"><Button Content="{x:Bind Text}" Tag="{x:Bind}" Click="Keyword_Click" MaxWidth="280"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button Content="清空搜索历史" Click="ClearHistory_Click" HorizontalAlignment="Left" Margin="0,12,0,4" IsEnabled="{x:Bind Settings.CanEdit,Mode=OneWay,FallbackValue=False}" Visibility="{x:Bind Settings.HasSearchHistory,Mode=OneWay,Converter={StaticResource DiscoveryVisible},FallbackValue=Collapsed}"/>
   <ItemsControl ItemsSource="{x:Bind Discovery.DiscoveryCharts,Mode=OneWay}" IsEnabled="{x:Bind Discovery.CanUseDiscovery,Mode=OneWay,FallbackValue=False}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:MusicDiscoveryChart">
    <Border Style="{StaticResource MeowFilm.Surface}" Padding="16" Margin="0,12,0,4"><StackPanel>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="56" Height="56" Margin="0,0,12,0" Visibility="{x:Bind Cover,Converter={StaticResource DiscoveryVisible}}"><art:ArtworkImage Address="{x:Bind Cover}" Stretch="UniformToFill" AutomationProperties.Name="{x:Bind Name}"/></Border>
      <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Name}" Style="{StaticResource MeowFilm.SectionHeading}"/><TextBlock Text="{x:Bind Creator}" Style="{StaticResource Capability.Muted}" Margin="0,4,0,0"/><TextBlock Text="{x:Bind CountText}" Style="{StaticResource Capability.Muted}" Margin="0,6,0,0"/></StackPanel>
      <Button Grid.Column="2" Content="打开歌单" Tag="{x:Bind}" Click="Chart_Click"/>
     </Grid>
     <ItemsControl ItemsSource="{x:Bind Songs}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:MusicDiscoverySong">
      <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="{x:Bind Title,Mode=OneWay}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Artist,Mode=OneWay}" Style="{StaticResource Capability.Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="播放" Tag="{x:Bind}" Click="Play_Click"/><Button Content="下一首播放" Tag="{x:Bind}" Click="Queue_Click"/></StackPanel>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
