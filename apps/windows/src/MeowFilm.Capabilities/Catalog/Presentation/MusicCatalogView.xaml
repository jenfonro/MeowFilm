<UserControl x:Class="MeowFilm.Capabilities.MusicCatalogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 xmlns:art="clr-namespace:MeowFilm.Desktop.Artwork;assembly=MeowFilm.Desktop"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="14"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <SolidColorBrush x:Key="MeowFilm.Brush.Text" Color="#343845"/>
  <SolidColorBrush x:Key="MeowFilm.Brush.Muted" Color="#6C7280"/>
  <Style x:Key="Catalog.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Capability.Text}">
   <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"/>
   <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
   <Setter Property="LineHeight" Value="24"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
  </Style>
  <Style x:Key="Catalog.SectionLoading" TargetType="Grid">
   <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
   <Setter Property="Margin" Value="8,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Visibility" Value="Collapsed"/><Setter Property="IsHitTestVisible" Value="False"/>
   <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsLoading}" Value="True">
     <Setter Property="Visibility" Value="Visible"/>
    </DataTrigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions>
     <Condition Binding="{Binding (local:MusicCatalogSurface.IsOverview),RelativeSource={RelativeSource Self}}" Value="True"/>
     <Condition Binding="{Binding Title}" Value="单曲"/>
     <Condition Binding="{Binding DataContext.SearchSongsLoading,RelativeSource={RelativeSource AncestorType=local:MusicCatalogView}}" Value="True"/>
    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions>
     <Condition Binding="{Binding (local:MusicCatalogSurface.IsOverview),RelativeSource={RelativeSource Self}}" Value="True"/>
     <Condition Binding="{Binding Title}" Value="歌单"/>
     <Condition Binding="{Binding DataContext.SearchPlaylistsLoading,RelativeSource={RelativeSource AncestorType=local:MusicCatalogView}}" Value="True"/>
    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
    <Trigger Property="IsVisible" Value="True">
     <Trigger.EnterActions><BeginStoryboard x:Name="SectionLoadingSpin"><Storyboard RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                       From="0" To="360" Duration="0:0:0.8"/>
     </Storyboard></BeginStoryboard></Trigger.EnterActions>
     <Trigger.ExitActions><StopStoryboard BeginStoryboardName="SectionLoadingSpin"/></Trigger.ExitActions>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Catalog.SectionMore" TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
   <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="12,4"/>
   <Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
  </Style>
  <Style x:Key="Catalog.SongTitle" TargetType="TextBlock" BasedOn="{StaticResource Capability.Text}">
   <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="LineHeight" Value="20"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="Catalog.SongArtist" TargetType="TextBlock" BasedOn="{StaticResource Capability.Muted}">
   <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="LineHeight" Value="18"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Margin" Value="0,2,0,0"/>
  </Style>

  <Style x:Key="Catalog.Flat" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
   <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"/>
   <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Catalog.Refresh" TargetType="Button" BasedOn="{StaticResource Catalog.Flat}">
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="0"/>
   <Setter Property="Foreground" Value="#8B9096"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent">
    <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Path Data="M 16.5,6 A 7.5,7.5 0 1 0 17.2,12 M 16.5,1.5 L 16.5,6 L 12,6"
      Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
    </Canvas>
   </Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#555D68"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Catalog.PlaylistTitle" TargetType="TextBlock" BasedOn="{StaticResource Catalog.SongTitle}">
   <Setter Property="Foreground" Value="#4B4F58"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style x:Key="Catalog.SongButton" TargetType="Button" BasedOn="{StaticResource Catalog.Flat}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Catalog.ChannelTab" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
   <Setter Property="Foreground" Value="#70798A"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Margin" Value="0,0,24,0"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="Height" Value="36"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}">
     <Grid>
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4"/>
      <Border x:Name="SelectionUnderline" Width="16" Height="3" CornerRadius="1.5"
       Background="{TemplateBinding BorderBrush}" VerticalAlignment="Bottom"/>
     </Grid>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Catalog.ChannelMore" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
   <Setter Property="Foreground" Value="#70798A"/>
   <Setter Property="Margin" Value="0"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="Height" Value="36"/>
   <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style x:Key="Catalog.ChannelFilter" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
   <Setter Property="MinWidth" Value="62"/>
   <Setter Property="Height" Value="32"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="Margin" Value="0,0,12,0"/>
   <Setter Property="Padding" Value="14,2"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="#495164"/>
   <Setter Property="Background" Value="#F4F5F7"/>
   <Setter Property="BorderBrush" Value="#E3E5E9"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ChannelFilterPill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChannelFilterPill" Property="Background" Value="#EAECF0"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ChannelFilterPill" Property="Background" Value="#DFE2E7"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Catalog.ChannelTag" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
   <Setter Property="Width" Value="78"/>
   <Setter Property="Height" Value="31"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="Margin" Value="0,0,12,14"/>
   <Setter Property="Padding" Value="8,2"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="#495164"/>
   <Setter Property="Background" Value="#F4F5F7"/>
   <Setter Property="BorderBrush" Value="#E3E5E9"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Pill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#EAECF0"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pill" Property="Background" Value="#DFE2E7"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Catalog.CoverPlay" TargetType="Button" BasedOn="{StaticResource Catalog.Flat}">
   <Setter Property="MinHeight" Value="0"/><Setter Property="IsEnabled" Value="{Binding CanPlay}"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Title,StringFormat=播放 {0}}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="#38000000"><Path Data="M 2,1 Q 0,0 0,3 L 0,25 Q 0,28 3,26 L 23,15 Q 26,13 23,11 Z" Fill="White" Width="24" Height="28" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="Opacity" Value="0"><Setter Property="IsHitTestVisible" Value="False"/></Trigger>
    <DataTrigger Binding="{Binding CanPlay}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="Catalog.Entry">
   <local:EntryCard Margin="0,0,16,0" OpenRequested="Entry_Open" PlayRequested="CardPlay_Click" PreviewRequested="Entry_Preview"
                    ToolTip="{Binding ErrorText}" ToolTipService.ShowOnDisabled="True"/>
  </DataTemplate>
  <DataTemplate x:Key="Catalog.PlaylistCard">
   <Button x:Name="PlaylistHost" local:CardMotion.Enabled="True" Tag="{Binding}" Click="Card_Click" Style="{StaticResource Catalog.Flat}" Margin="0,0,16,0" IsEnabled="{Binding CanOpen}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding ErrorText}" ToolTipService.ShowOnDisabled="True">
    <StackPanel>
     <Grid Height="{Binding ActualWidth,RelativeSource={RelativeSource Self}}" Background="#E7EAF0" local:CardClip.Radius="8">
      <art:ArtworkImage Address="{Binding Cover}"/>
      <Button Click="CardPlay_Click" Style="{StaticResource Catalog.CoverPlay}" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=PlaylistHost}"/>
     </Grid>
     <TextBlock Text="{Binding Title}" Style="{StaticResource Catalog.PlaylistTitle}" Margin="0,8,0,0" Height="40" TextWrapping="Wrap"/>
    </StackPanel>
   </Button>
  </DataTemplate>
  <DataTemplate x:Key="Catalog.RankCoverCard">
   <Button x:Name="RankCoverHost" local:CardMotion.Enabled="True" Tag="{Binding}" Click="Card_Click" Style="{StaticResource Catalog.Flat}" Margin="0,0,16,0"
           IsEnabled="{Binding CanOpen}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding ErrorText}" ToolTipService.ShowOnDisabled="True">
    <Grid Height="{Binding ActualWidth,RelativeSource={RelativeSource Self}}" local:CardClip.Radius="4">
     <Grid.Style><Style TargetType="Grid"><Setter Property="Background" Value="#E7EAF0"/><Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></Trigger></Style.Triggers></Style></Grid.Style>
     <art:ArtworkImage Address="{Binding Cover}"/>
     <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"
                FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Capability.Text}"><Setter Property="Foreground" Value="#30394D"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Cover}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <Button Click="CardPlay_Click" Style="{StaticResource Catalog.CoverPlay}" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=RankCoverHost}"/>
    </Grid>
   </Button>
  </DataTemplate>
  <DataTemplate x:Key="Catalog.PlaylistRow">
   <Button Tag="{Binding}" Click="Card_Click" IsEnabled="{Binding CanOpen}" Style="{StaticResource Catalog.Flat}" Margin="0,0,0,8" AutomationProperties.Name="{Binding Title}">
    <Grid Height="64">
     <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <art:ArtworkImage Address="{Binding Cover}" Width="56" Height="56" HorizontalAlignment="Left" local:CardClip.Radius="4"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,16,0">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Catalog.SongTitle}"/>
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Catalog.SongArtist}"/>
     </StackPanel>
    </Grid>
   </Button>
  </DataTemplate>
  <local:MusicChannelSelectionConverter x:Key="Catalog.ChannelSelected"/>
  <local:ColumnsConverter x:Key="Catalog.Columns"/>
  <local:BannerHeightConverter x:Key="Catalog.BannerHeight"/>
  <DataTemplate x:Key="Catalog.Banner">
   <Button Tag="{Binding}" Click="Card_Click" Style="{StaticResource Catalog.Flat}" Margin="0,0,20,0" IsEnabled="{Binding CanOpen}" AutomationProperties.Name="{Binding Title}">
    <Grid Height="{Binding ActualWidth,RelativeSource={RelativeSource Self},Converter={StaticResource Catalog.BannerHeight}}" Background="#E7EAF0" local:CardClip.Radius="8">
     <art:ArtworkImage Address="{Binding Cover}"/>
     <TextBlock Text="{Binding Title}" VerticalAlignment="Bottom" Margin="12" FontWeight="SemiBold" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Cover}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
   </Button>
  </DataTemplate>
  <DataTemplate x:Key="Catalog.Ranking">
   <Button x:Name="RankingHost" local:CardMotion.Enabled="True" Tag="{Binding}" Click="Card_Click" Style="{StaticResource Catalog.Flat}" Margin="0,0,20,20" IsEnabled="{Binding CanOpen}" AutomationProperties.Name="{Binding Title}">
    <Border Background="{DynamicResource MeowFilm.Brush.Surface}" CornerRadius="12" Padding="20" Height="154">
     <StackPanel><DockPanel Margin="0,0,0,14"><TextBlock DockPanel.Dock="Right" Text="{Binding UpdateFrequency}" Style="{StaticResource Capability.Muted}" FontSize="11"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/></DockPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid Width="80" Height="80" HorizontalAlignment="Left"><Border Background="#E7E9EF" CornerRadius="4" Margin="12,12,-10,-4"/><Border Background="#D6DAE4" CornerRadius="4" Margin="6,6,-5,-2"/><art:ArtworkImage Address="{Binding Cover}" local:CardClip.Radius="4"/><Button Click="CardPlay_Click" Style="{StaticResource Catalog.CoverPlay}" local:CardClip.Radius="4" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=RankingHost}"/></Grid>
       <ItemsControl Grid.Column="1" ItemsSource="{Binding PreviewSongs}"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="27"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Rank}" Style="{StaticResource Capability.Muted}"/><TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis"><Run Text="{Binding Title}"/><Run Text=" − "/><Run Text="{Binding Artist}" Foreground="{DynamicResource MeowFilm.Brush.Muted}"/></TextBlock><TextBlock Grid.Column="2" Text="{Binding Movement}" Foreground="{DynamicResource MeowFilm.Brush.Accent}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </Grid>
     </StackPanel>
    </Border>
   </Button>
  </DataTemplate>
  <DataTemplate x:Key="Catalog.SongRow">
   <Border x:Name="SongRow" Height="84" Margin="0,0,16,0" CornerRadius="12" local:CardMotion.Enabled="True">
    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></Trigger></Style.Triggers></Style></Border.Style>
    <Grid>
    <Border CornerRadius="12" IsHitTestVisible="False" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=SongRow}">
     <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Surface}"/><Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></Trigger></Style.Triggers></Style></Border.Style>
    </Border>
    <Button Tag="{Binding}" Click="Card_Click" Style="{StaticResource Catalog.SongButton}" IsEnabled="{Binding CanOpen}" AutomationProperties.Name="{Binding Title}" Padding="8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="50" Height="50" HorizontalAlignment="Left" local:CardClip.Radius="8">
       <art:ArtworkImage Address="{Binding Cover}"/>
       <Border Background="#40000000" IsHitTestVisible="False" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=SongRow}">
        <Path Data="M 0,0 L 0,22 L 18,11 Z" Fill="White" Width="18" Height="22" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
      </Grid>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver,ElementName=SongRow}" Value="True"><Setter Property="Margin" Value="0,0,72,0"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin,ElementName=SongRow}" Value="True"><Setter Property="Margin" Value="0,0,72,0"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
       <TextBlock Text="{Binding Title}" Style="{StaticResource Catalog.SongTitle}"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Catalog.SongArtist}"/>
      </StackPanel>
     </Grid>
    </Button>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Background="{DynamicResource MeowFilm.Brush.Surface}" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=SongRow}">
     <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Path=(local:CardMotion.Progress),ElementName=SongRow}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <Button Content="&#xEB51;" Tag="{Binding}" Click="Favorite_Click" Style="{StaticResource MeowFilm.IconButton}" IsEnabled="{Binding CanFavorite}" AutomationProperties.Name="收藏"/>
     <Button Content="&#xE712;" Tag="{Binding}" Click="SongOptions_Click" Style="{StaticResource MeowFilm.IconButton}" AutomationProperties.Name="歌曲操作"/>
    </StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
   <DataTemplate x:Key="Catalog.SongColumn">
    <ItemsControl Height="252" VerticalAlignment="Top"
                  ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Catalog.SongRow}"/>
   </DataTemplate>
   <DataTemplate x:Key="Catalog.ArtistCard">
    <Button Tag="{Binding}" Click="Card_Click" Style="{StaticResource Catalog.Flat}" IsEnabled="{Binding CanOpen}"
            Width="184" Margin="0,0,0,48" HorizontalAlignment="Center"
            AutomationProperties.Name="{Binding Title}" ToolTip="{Binding ErrorText}" ToolTipService.ShowOnDisabled="True">
     <StackPanel Width="184">
      <Grid Width="184" Height="184" HorizontalAlignment="Center" Background="#E7EAF0" local:CardClip.Radius="92">
       <art:ArtworkImage Address="{Binding Cover}"/>
      </Grid>
      <TextBlock Text="{Binding Title}" Style="{StaticResource Catalog.SongTitle}" TextAlignment="Center"
                 HorizontalAlignment="Center" Margin="8,10,8,0"/>
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Catalog.SongArtist}" TextAlignment="Center"
                 HorizontalAlignment="Center" Margin="8,2,8,0"/>
     </StackPanel>
    </Button>
   </DataTemplate>
  <Style x:Key="Catalog.SearchPlaylistList" TargetType="ListBox">
   <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Window}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
   <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
   <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
   <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <ContentPresenter/>
    </ControlTemplate></Setter.Value></Setter>
   </Style></Setter.Value></Setter>
   <Setter Property="ItemTemplate"><Setter.Value>
    <DataTemplate>
     <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Left">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Catalog.PlaylistCard}" Width="168"
                       Margin="0,0,0,24" HorizontalAlignment="Left" VerticalAlignment="Top"/>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </DataTemplate>
   </Setter.Value></Setter>
  </Style>
   <DataTemplate x:Key="Catalog.Section.Shelf">
    <local:Shelf>
     <local:Shelf.Style><Style TargetType="local:Shelf">
      <Setter Property="CardTemplate" Value="{StaticResource Catalog.PlaylistCard}"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding (local:MusicCatalogSurface.IsHome),RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="MinimumCardWidth" Value="124"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding IsRankingCoverSection}" Value="True">
        <Setter Property="CardTemplate" Value="{StaticResource Catalog.RankCoverCard}"/>
        <Setter Property="MinimumCardWidth" Value="120"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding IsEntrySection}" Value="True">
        <Setter Property="CardTemplate" Value="{StaticResource Catalog.Entry}"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding IsBannerSection}" Value="True">
        <Setter Property="CardTemplate" Value="{StaticResource Catalog.Banner}"/>
       </DataTrigger>
      </Style.Triggers>
     </Style></local:Shelf.Style>
    </local:Shelf>
   </DataTemplate>
   <DataTemplate x:Key="Catalog.Section.PlaylistRows">
    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Catalog.PlaylistRow}"
                  AutomationProperties.Name="封面列表"/>
   </DataTemplate>
   <DataTemplate x:Key="Catalog.Section.Rankings">
    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Catalog.Ranking}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate>
      <UniformGrid Margin="0,0,-20,-20"
       Columns="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=ItemsControl},Converter={StaticResource Catalog.Columns}}"/>
     </ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
   </DataTemplate>
   <DataTemplate x:Key="Catalog.Section.SongShelf">
    <local:Shelf ItemsSource="{Binding SongColumns}" CardTemplate="{StaticResource Catalog.SongColumn}"
                 MinimumCardWidth="400"/>
   </DataTemplate>
   <DataTemplate x:Key="Catalog.Section.Songs">
    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Catalog.SongRow}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate>
      <UniformGrid Columns="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=ItemsControl},Converter={StaticResource Catalog.Columns}}"/>
     </ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
   </DataTemplate>
   <DataTemplate x:Key="Catalog.Section.Artists">
    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Catalog.ArtistCard}"
