<UserControl x:Class="MeowFilm.Capabilities.MusicCatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MeowFilm.Capabilities" xmlns:art="using:MeowFilm.Desktop.Artwork" xmlns:desktop="using:MeowFilm.Desktop">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///MeowFilm.Capabilities/Presentation/CapabilityTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <local:MusicVisibilityConverter x:Key="Visible"/>
  <Style TargetType="Button"><Setter Property="FontWeight" Value="Normal"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="Catalog.ChannelFlat" TargetType="Button">
   <Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="18"/><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{ThemeResource MeowFilm.Brush.Muted}"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Catalog.ChannelTab" TargetType="Button" BasedOn="{StaticResource Catalog.ChannelFlat}">
   <Setter Property="Margin" Value="0,0,24,0"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"><Grid><ContentPresenter Content="{TemplateBinding Content}" Margin="0,0,0,4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/><Border x:Name="SelectionUnderline" Width="16" Height="3" CornerRadius="1.5" Background="{TemplateBinding BorderBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center"/></Grid></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Catalog.ChannelTag" TargetType="Button" BasedOn="{StaticResource Music.FilterTag}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Catalog.ChannelFilter" TargetType="Button" BasedOn="{StaticResource Catalog.ChannelTag}">
   <Setter Property="MinWidth" Value="62"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Padding" Value="14,2"/>
  </Style>
  <DataTemplate x:Key="Section"><local:MusicCatalogSectionView/></DataTemplate>
  <Flyout x:Name="ChannelMorePopup" Placement="BottomEdgeAlignedRight" Opened="ChannelMore_Opened" Closed="ChannelMore_Closed">
   <Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="Padding" Value="14"/><Setter Property="CornerRadius" Value="10"/><Setter Property="MaxWidth" Value="570"/><Setter Property="Background" Value="{ThemeResource MeowFilm.Brush.Surface}"/><Setter Property="BorderBrush" Value="{ThemeResource MeowFilm.Brush.Border}"/></Style></Flyout.FlyoutPresenterStyle>
   <ScrollViewer x:Name="ChannelMoreContent" MaxHeight="308" Width="540" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding MoreChannelTabs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:MusicWrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><local:MusicCatalogButton Style="{StaticResource Catalog.ChannelTag}" Content="{Binding Title}" Tag="{Binding}" Click="Card_Click" IsEnabled="{Binding CanOpen}" Loaded="Channel_Loaded"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </Flyout>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <Grid x:Name="ChannelHeader" Margin="40,0,40,12" MaxWidth="1490" Height="36" Visibility="{Binding HasChannelTabs,Converter={StaticResource Visible}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding VisibleChannelTabs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><local:MusicCatalogButton IsTab="True" Content="{Binding Title}" Tag="{Binding}" Click="Card_Click" IsEnabled="{Binding CanOpen}" Loaded="Channel_Loaded" Style="{StaticResource Catalog.ChannelTab}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <Button x:Name="ChannelMoreButton" Grid.Column="1" Style="{StaticResource Catalog.ChannelFlat}" Click="ChannelMore_Click" Visibility="{Binding HasMoreChannelTabs,Converter={StaticResource Visible}}" AutomationProperties.Name="更多频道"><StackPanel Orientation="Horizontal"><TextBlock Text="更多" VerticalAlignment="Center"/><Path Width="8" Height="5" Margin="4,2,0,0" Data="M1,1 L4,4 L7,1" Stretch="Fill" Stroke="{ThemeResource MeowFilm.Brush.Muted}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"><Path.RenderTransform><RotateTransform x:Name="ChannelMoreChevron" CenterX="4" CenterY="2.5"/></Path.RenderTransform></Path></StackPanel></Button>
   </Grid>
   <local:MusicWrapPanel Visibility="{Binding IsCatalogUtilityPage,Converter={StaticResource Visible}}" Margin="0,0,0,12">
    <Button Content="返回搜索" Click="SearchBack_Click" Visibility="{Binding HasSearchSession,Converter={StaticResource Visible}}"/>
    <ComboBox ItemsSource="{Binding CatalogPlatformChoices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCatalogPlatform}" SelectionChanged="Platform_Changed" Width="150" Margin="0,0,12,8" IsEnabled="{Binding CanCatalogBrowse}" AutomationProperties.Name="内容平台"/>
    <TextBlock Text="{Binding CatalogAccountText}" VerticalAlignment="Center" Margin="0,0,8,8"/><Button Content="读取账号" Click="Account_Click" IsEnabled="{Binding CanCatalogBrowse}"/>
    <ComboBox ItemsSource="{Binding CatalogPersonalKinds}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding CatalogPersonalKind}" SelectionChanged="Options_Changed" Width="130" Margin="0,0,12,8" Visibility="{Binding IsCatalogPersonal,Converter={StaticResource Visible}}" IsEnabled="{Binding CanCatalogBrowse}" AutomationProperties.Name="个人歌单类型"/>
    <ComboBox ItemsSource="{Binding CatalogSearchKinds}" SelectedItem="{Binding CatalogSearchKind}" SelectionChanged="Kind_Changed" Width="96" Margin="0,0,12,8" IsEnabled="{Binding CanCatalogBrowse}" AutomationProperties.Name="搜索类型"/>
    <Button Content="上一页" Tag="-1" Click="Page_Click" IsEnabled="{Binding CanCatalogPrevious}"/><TextBlock Text="{Binding CatalogPageText}" Margin="8,0" VerticalAlignment="Center"/><Button Content="下一页" Tag="1" Click="Page_Click" IsEnabled="{Binding CanCatalogNext}"/>
    <Button Content="播放全部" Click="PlayAll_Click" Visibility="{Binding IsCatalogBatch,Converter={StaticResource Visible}}" IsEnabled="{Binding CanPlayCatalogPlaylist}"/><Button Content="保存到本地歌单" Click="Save_Click" Visibility="{Binding IsCatalogBatch,Converter={StaticResource Visible}}" IsEnabled="{Binding CanCatalogAction}"/>
    <Button Content="队列推荐" Click="QueueRecommendations_Click" IsEnabled="{Binding CanCatalogWy}"/><Button Content="取消" Click="Cancel_Click" IsEnabled="{Binding CanCancelCatalog}"/>
   </local:MusicWrapPanel>
   <StackPanel Orientation="Horizontal" Margin="24,0,24,12" Visibility="{Binding IsCatalogSalesChart,Converter={StaticResource Visible}}">
    <ComboBox Width="160" ItemsSource="{Binding CatalogChartKinds}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding CatalogChartKind,Mode=TwoWay}" SelectionChanged="Chart_Changed"/>
    <ComboBox Width="90" Margin="12,0,0,0" ItemsSource="{Binding CatalogChartPeriods}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding CatalogChartPeriod,Mode=TwoWay}" Visibility="{Binding CatalogChartHasPeriods,Converter={StaticResource Visible}}" SelectionChanged="Chart_Changed"/>
    <TextBox Width="74" Margin="12,0,0,0" Text="{Binding CatalogChartYear,Mode=TwoWay}" Visibility="{Binding CatalogChartIsYearly,Converter={StaticResource Visible}}" LostFocus="ChartYear_Changed" AutomationProperties.Name="榜单年份"/>
   </StackPanel>
   <ItemsControl x:Name="ChannelFilters" ItemsSource="{Binding CatalogTagGroups}" Visibility="{Binding HasCatalogTags,Converter={StaticResource Visible}}" Margin="40,0,40,16" MaxWidth="1490"><ItemsControl.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:MusicWrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><local:MusicCatalogButton Content="{Binding Name}" Tag="{Binding}" Click="Tag_Click" Style="{StaticResource Catalog.ChannelFilter}" Width="Auto"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
  <Grid Grid.Row="1">
   <ScrollViewer x:Name="HomeScroll" Visibility="{Binding IsCatalogHome,Converter={StaticResource Visible}}" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="HomeItems" ItemTemplate="{StaticResource Section}" Margin="40,0,40,24" MaxWidth="1490"/></ScrollViewer>
   <ScrollViewer x:Name="SearchOverviewScroll" Visibility="{Binding IsSearchOverview,Converter={StaticResource Visible}}" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="SearchOverviewItems" ItemTemplate="{StaticResource Section}"/></ScrollViewer>
   <ScrollViewer x:Name="UtilityScroll" Visibility="{Binding IsUtilityCatalogSurface,Converter={StaticResource Visible}}" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="UtilityItems" ItemTemplate="{StaticResource Section}"/></ScrollViewer>
   <GridView x:Name="SearchPlaylistList" SelectionMode="None" Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="CatalogScroll_Wheel" KeyDown="CatalogScroll_Key" ContainerContentChanging="SearchCard_Changing"><GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel><GridView.ItemTemplate><DataTemplate><local:MusicCatalogCardView Presentation="Playlist" MaxWidth="168" HorizontalAlignment="Stretch"/></DataTemplate></GridView.ItemTemplate></GridView>
   <ScrollViewer x:Name="CatalogScroll" HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="CatalogScroll_Wheel" KeyDown="CatalogScroll_Key" ViewChanged="CatalogScroll_Changed">
    <StackPanel>
     <Grid Width="960" Height="184" Margin="40,0,40,32" HorizontalAlignment="Left" Visibility="{Binding VipPage.HasCards,Converter={StaticResource Visible}}"><Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="16"/><ColumnDefinition Width="228"/><ColumnDefinition Width="16"/><ColumnDefinition Width="472"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" CornerRadius="8" Padding="12" Visibility="{Binding VipPage.ShowAccount,Converter={StaticResource Visible}}" AutomationProperties.Name="VIP 账号权益"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#211B1B"/><GradientStop Color="#5B3030" Offset="1"/></LinearGradientBrush></Border.Background>
       <Grid><StackPanel Margin="0,2,52,0"><TextBlock Text="{Binding VipPage.Account.DisplayName}" Foreground="White" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding VipPage.Account.Membership}" Foreground="#CFC1C2" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Grid Width="40" Height="40" CornerRadius="20" local:CardClip.Radius="20" HorizontalAlignment="Right" VerticalAlignment="Top"><art:ArtworkImage Address="{Binding VipPage.Account.Avatar}"/></Grid></Grid>
      </Border>
      <Grid Grid.Column="2" CornerRadius="8" local:CardClip.Radius="8" Background="#FFF0D9" Visibility="{Binding VipPage.ShowSign,Converter={StaticResource Visible}}" AutomationProperties.Name="黑胶乐签"><art:ArtworkImage Address="{Binding VipPage.Sign.Background}"/><Grid Margin="12,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
       <TextBlock Text="{Binding VipPage.Sign.Text}" Foreground="#312923" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Text="{Binding VipPage.Sign.SubText}" Foreground="#9B7D68" FontSize="11" Margin="0,3,0,0"/>
       <ItemsControl Grid.Row="2" ItemsSource="{Binding VipPage.Sign.Days}" Margin="0,7,0,4" Height="40"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Loaded="SignDay_Loaded" Width="34" Height="34" Margin="7,0" CornerRadius="17" BorderThickness="1" BorderBrush="#C9A88C"><TextBlock Text="{Binding DayText}" FontSize="10" Foreground="#A48770" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Button Grid.Row="3" Content="{Binding VipPage.SignButtonText}" Click="VipSign_Click" Width="68" Height="24" MinHeight="0" Padding="0" HorizontalAlignment="Left" IsEnabled="{Binding VipPage.CanSign}" Visibility="{Binding VipPage.ShowSignButton,Converter={StaticResource Visible}}" AutomationProperties.Name="黑胶乐签打卡"/>
      </Grid></Grid>
      <Button Grid.Column="4" Click="VipBanner_Click" Padding="0" IsEnabled="{Binding VipPage.CanOpenBanner}" Visibility="{Binding VipPage.ShowBanner,Converter={StaticResource Visible}}" AutomationProperties.Name="VIP 活动"><Grid CornerRadius="8" local:CardClip.Radius="8"><art:ArtworkImage Address="{Binding VipPage.Banner.ImageUrl}"/></Grid></Button>
     </Grid>
     <Grid x:Name="ChannelPages" Margin="40,0,40,24" MaxWidth="1490"/>
    </StackPanel>
   </ScrollViewer>
   <ProgressRing x:Name="CatalogLoading" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed"/>
  </Grid>
 </Grid>
</UserControl>
