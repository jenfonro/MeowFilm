          <Button.Template><ControlTemplate TargetType="Button">
           <Border x:Name="SignButtonPill" Background="#F8FFFFFF" CornerRadius="12">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SignButtonPill" Property="Background" Value="White"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="SignButtonPill" Property="Background" Value="#F2E7DD"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate></Button.Template>
         </Button>
        </Grid>
       </Grid>
      </Border>
      <Button x:Name="VipBannerButton" Grid.Column="4" Click="VipBanner_Click"
              Style="{StaticResource Catalog.Flat}"
              IsEnabled="{Binding VipPage.CanOpenBanner}"
              Visibility="{Binding VipPage.ShowBanner,Converter={StaticResource Visible}}"
              AutomationProperties.Name="VIP 活动">
       <Button.Template><ControlTemplate TargetType="Button">
        <Border Background="Transparent">
         <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Border>
       </ControlTemplate></Button.Template>
       <Border CornerRadius="8" local:CardClip.Radius="8" Background="#E7EAF0">
        <art:ArtworkImage Address="{Binding VipPage.Banner.ImageUrl}" Stretch="UniformToFill"/>
       </Border>
      </Button>
     </Grid>
    <ItemsControl ItemsSource="{Binding ChannelSections}" ItemTemplate="{StaticResource Catalog.SectionsTemplate}" Margin="40,0,40,24" MaxWidth="1490"/>

   </StackPanel>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</UserControl>
