<UserControl x:Class="MeowFilm.Capabilities.MusicCatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MeowFilm.Capabilities" xmlns:art="using:MeowFilm.Desktop.Artwork" xmlns:desktop="using:MeowFilm.Desktop">
 <UserControl.Resources>
  <local:MusicVisibilityConverter x:Key="Visible"/>
  <Style TargetType="Button"><Setter Property="FontWeight" Value="Normal"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="CornerRadius" Value="8"/></Style>
  <DataTemplate x:Key="Section"><local:MusicCatalogSectionView/></DataTemplate>
  <Flyout x:Name="ChannelMorePopup" Placement="Bottom"><ScrollViewer MaxHeight="308" Width="540"><ItemsControl ItemsSource="{Binding MoreChannelTabs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:MusicWrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding}" Click="Card_Click" IsEnabled="{Binding CanOpen}" Loaded="Channel_Loaded"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Flyout>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <Grid Margin="40,0,40,12" MaxWidth="1490" Height="36" Visibility="{Binding HasChannelTabs,Converter={StaticResource Visible}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding VisibleChannelTabs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding}" Click="Card_Click" IsEnabled="{Binding CanOpen}" Loaded="Channel_Loaded" Background="Transparent" BorderThickness="0,0,0,3" FontSize="18" Margin="0,0,24,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <Button x:Name="ChannelMoreButton" Grid.Column="1" Content="更多⌄" Click="ChannelMore_Click" Visibility="{Binding HasMoreChannelTabs,Converter={StaticResource Visible}}"/>
   </Grid>
   <local:MusicWrapPanel Visibility="{Binding IsCatalogUtilityPage,Converter={StaticResource Visible}}" Margin="0,0,0,12">
    <Button Content="返回搜索" Click="SearchBack_Click" Visibility="{Binding HasSearchSession,Converter={StaticResource Visible}}"/>
    <ComboBox ItemsSource="{Binding CatalogPlatformChoices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCatalogPlatform}" SelectionChanged="Platform_Changed" Width="150" Margin="0,0,12,8" IsEnabled="{Binding CanCatalogBrowse}" AutomationProperties.Name="内容平台"/>
    <TextBlock Text="{Binding CatalogAccountText}" VerticalAlignment="Center" Margin="0,0,8,8"/><Button Content="读取账号" Click="Account_Click" IsEnabled="{Binding CanCatalogBrowse}"/>
    <ComboBox ItemsSource="{Binding CatalogPersonalKinds}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding CatalogPersonalKind}" SelectionChanged="Options_Changed" Width="130" Margin="0,0,12,8" Visibility="{Binding IsCatalogPersonal,Converter={StaticResource Visible}}" IsEnabled="{Binding CanCatalogBrowse}" AutomationProperties.Name="个人歌单类型"/>
    <ComboBox ItemsSource="{Binding CatalogSearchKinds}" SelectedItem="{Binding CatalogSearchKind}" SelectionChanged="Kind_Changed" Width="96" Margin="0,0,12,8" IsEnabled="{Binding CanCatalogBrowse}" AutomationProperties.Name="搜索类型"/>
    <Button Content="上一页" Tag="-1" Click="Page_Click" IsEnabled="{Binding CanCatalogPrevious}"/><TextBlock Text="{Binding CatalogPageText}" Margin="8,0" VerticalAlignment="Center"/><Button Content="下一页" Tag="1" Click="Page_Click" IsEnabled="{Binding CanCatalogNext}"/>
    <Button Content="播放全部" Click="PlayAll_Click" Visibility="{Binding IsCatalogBatch,Converter={StaticResource Visible}}" IsEnabled="{Binding CanPlayCatalogPlaylist}"/><Button Content="保存到本地歌单" Click="Save_Click" Visibility="{Binding IsCatalogBatch,Converter={StaticResource Visible}}" IsEnabled="{Binding CanCatalogAction}"/>
    <Button Content="队列推荐" Click="QueueRecommendations_Click" IsEnabled="{Binding CanCatalogWy}"/><Button Content="取消" Click="Cancel_Click" IsEnabled="{Binding CanCancelCatalog}"/>
   </local:MusicWrapPanel>
   <StackPanel Orientation="Horizontal" Margin="24,0,24,12" Visibility="{Binding IsCatalogSalesChart,Converter={StaticResource Visible}}">
    <ComboBox Width="160" ItemsSource="{Binding CatalogChartKinds}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding CatalogChartKind,Mode=TwoWay}" SelectionChanged="Chart_Changed"/>
    <ComboBox Width="90" Margin="12,0,0,0" ItemsSource="{Binding CatalogChartPeriods}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding CatalogChartPeriod,Mode=TwoWay}" Visibility="{Binding CatalogChartHasPeriods,Converter={StaticResource Visible}}" SelectionChanged="Chart_Changed"/>
    <TextBox Width="74" Margin="12,0,0,0" Text="{Binding CatalogChartYear,Mode=TwoWay}" Visibility="{Binding CatalogChartIsYearly,Converter={StaticResource Visible}}" LostFocus="ChartYear_Changed" AutomationProperties.Name="榜单年份"/>
   </StackPanel>
   <ItemsControl ItemsSource="{Binding CatalogTagGroups}" Visibility="{Binding HasCatalogTags,Converter={StaticResource Visible}}" Margin="40,0,40,16" MaxWidth="1490"><ItemsControl.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:MusicWrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding}" Click="Tag_Click" Loaded="Tag_Loaded" CornerRadius="16" Padding="14,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
  <Grid Grid.Row="1">
   <ScrollViewer x:Name="HomeScroll" Visibility="{Binding IsCatalogHome,Converter={StaticResource Visible}}" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding HomeSections}" ItemTemplate="{StaticResource Section}" Margin="40,0,40,24" MaxWidth="1490"/></ScrollViewer>
   <Image x:Name="HomeRefreshOverlay" IsHitTestVisible="False" Stretch="Fill" Visibility="Collapsed"/>
   <ScrollViewer x:Name="SearchOverviewScroll" Visibility="{Binding IsSearchOverview,Converter={StaticResource Visible}}" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding CatalogSections}" ItemTemplate="{StaticResource Section}"/></ScrollViewer>
   <ScrollViewer x:Name="UtilityScroll" Visibility="{Binding IsUtilityCatalogSurface,Converter={StaticResource Visible}}" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding CatalogSections}" ItemTemplate="{StaticResource Section}"/></ScrollViewer>
   <GridView x:Name="SearchPlaylistList" SelectionMode="None" Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="CatalogScroll_Wheel" KeyDown="CatalogScroll_Key" ContainerContentChanging="SearchCard_Changing"><GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel><GridView.ItemTemplate><DataTemplate><local:MusicCatalogCardView Presentation="Playlist" MaxWidth="168" HorizontalAlignment="Left"/></DataTemplate></GridView.ItemTemplate></GridView>
   <ScrollViewer x:Name="CatalogScroll" HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="CatalogScroll_Wheel" KeyDown="CatalogScroll_Key" ViewChanged="CatalogScroll_Changed">
    <StackPanel>
     <Grid Width="960" Height="184" Margin="40,0,40,32" HorizontalAlignment="Left" Visibility="{Binding VipPage.HasCards,Converter={StaticResource Visible}}"><Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="16"/><ColumnDefinition Width="228"/><ColumnDefinition Width="16"/><ColumnDefinition Width="472"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" CornerRadius="8" Padding="12" Visibility="{Binding VipPage.ShowAccount,Converter={StaticResource Visible}}" AutomationProperties.Name="VIP 账号权益"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#211B1B"/><GradientStop Color="#5B3030" Offset="1"/></LinearGradientBrush></Border.Background>
       <Grid><StackPanel Margin="0,2,52,0"><TextBlock Text="{Binding VipPage.Account.DisplayName}" Foreground="White" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding VipPage.Account.Membership}" Foreground="#CFC1C2" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Grid Width="40" Height="40" CornerRadius="20" local:CardClip.Radius="20" HorizontalAlignment="Right" VerticalAlignment="Top"><art:ArtworkImage Address="{Binding VipPage.Account.Avatar}"/></Grid></Grid>
      </Border>
      <Grid Grid.Column="2" CornerRadius="8" local:CardClip.Radius="8" Background="#FFF0D9" Visibility="{Binding VipPage.ShowSign,Converter={StaticResource Visible}}" AutomationProperties.Name="黑胶乐签"><art:ArtworkImage Address="{Binding VipPage.Sign.Background}"/><Grid Margin="12,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
       <TextBlock Text="{Binding VipPage.Sign.Text}" Foreground="#312923" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Text="{Binding VipPage.Sign.SubText}" Foreground="#9B7D68" FontSize="11" Margin="0,3,0,0"/>
       <ItemsControl Grid.Row="2" ItemsSource="{Binding VipPage.Sign.Days}" Margin="0,7,0,4" Height="40"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Loaded="SignDay_Loaded" Width="34" Height="34" Margin="7,0" CornerRadius="17" BorderThickness="1" BorderBrush="#C9A88C"><TextBlock Text="{Binding DayText}" FontSize="10" Foreground="#A48770" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Button Grid.Row="3" Content="{Binding VipPage.SignButtonText}" Click="VipSign_Click" Width="68" Height="24" MinHeight="0" Padding="0" HorizontalAlignment="Left" IsEnabled="{Binding VipPage.CanSign}" Visibility="{Binding VipPage.ShowSignButton,Converter={StaticResource Visible}}" AutomationProperties.Name="黑胶乐签打卡"/>
      </Grid></Grid>
      <Button Grid.Column="4" Click="VipBanner_Click" Padding="0" IsEnabled="{Binding VipPage.CanOpenBanner}" Visibility="{Binding VipPage.ShowBanner,Converter={StaticResource Visible}}" AutomationProperties.Name="VIP 活动"><Grid CornerRadius="8" local:CardClip.Radius="8"><art:ArtworkImage Address="{Binding VipPage.Banner.ImageUrl}"/></Grid></Button>
     </Grid>
     <ItemsControl ItemsSource="{Binding ChannelSections}" ItemTemplate="{StaticResource Section}" Margin="40,0,40,24" MaxWidth="1490"/>
    </StackPanel>
   </ScrollViewer>
   <local:MusicCatalogSkeleton x:Name="Skeleton" Margin="40,0,40,24" IsHome="{Binding IsCatalogHome}" VerticalAlignment="Top"/>
  </Grid>
 </Grid>
</UserControl>
