<UserControl x:Class="MeowFilm.Capabilities.NovelHistoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 AutomationProperties.Name="小说阅读历史">
 <Grid Padding="32,16,32,20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
    <TextBlock Text="阅读历史" Style="{StaticResource Capability.Text}" FontSize="20" Margin="0"/>
    <TextBlock x:Name="CountText" Style="{StaticResource Capability.Muted}" FontSize="13"
               VerticalAlignment="Bottom" Margin="0,0,0,2"/>
   </StackPanel>
   <Button x:Name="ClearAllButton" Content="清空历史" HorizontalAlignment="Right"
           Style="{StaticResource MeowFilm.GhostButton}" MinHeight="32" Padding="12,5"
           Visibility="Collapsed" AutomationProperties.Name="清空历史" Click="ClearAll_Click"/>
  </Grid>
  <ListView x:Name="HistoryList" Grid.Row="1" SelectionMode="None"
            HorizontalContentAlignment="Stretch"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            AutomationProperties.Name="阅读历史列表">
   <ListView.ItemContainerStyle>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource MeowFilm.BareListViewItem}">
     <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
   </ListView.ItemContainerStyle>
   <ListView.ItemTemplate>
    <DataTemplate x:DataType="local:NovelHistoryItem">
     <Border Style="{StaticResource Novel.Discovery.Surface}" Padding="14,12">
      <Grid ColumnSpacing="16">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <Border CornerRadius="4" VerticalAlignment="Center">
        <local:NovelImage Sources="{x:Bind Sources}" Book="{x:Bind Book, Mode=OneWay}"
                          ShowPlaceholder="True" Width="54" Height="74"/>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource Capability.Text}" FontSize="15"
                   Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource Capability.Muted}" FontSize="12"
                   Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{x:Bind Progress, Mode=OneWay}" Style="{StaticResource Capability.Muted}" FontSize="12"
                   Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="详情" Style="{StaticResource MeowFilm.Button}" MinHeight="32" Padding="12,5"
                AutomationProperties.Name="书籍详情" Click="OpenDetail_Click"/>
        <Button Content="继续阅读" Style="{StaticResource MeowFilm.PrimaryButton}" MinHeight="32" Padding="12,5"
                AutomationProperties.Name="继续阅读" Click="ContinueReading_Click"/>
        <Button Content="删除" Style="{StaticResource MeowFilm.GhostButton}" MinHeight="32" Padding="10,5"
                AutomationProperties.Name="删除历史记录" Click="DeleteHistory_Click"/>
       </StackPanel>
      </Grid>
     </Border>
    </DataTemplate>
   </ListView.ItemTemplate>
  </ListView>
  <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
              Spacing="12" Visibility="Collapsed">
   <TextBlock Text="暂无阅读历史" Style="{StaticResource Capability.Muted}" FontSize="14"
              HorizontalAlignment="Center"/>
  </StackPanel>
 </Grid>
</UserControl>
