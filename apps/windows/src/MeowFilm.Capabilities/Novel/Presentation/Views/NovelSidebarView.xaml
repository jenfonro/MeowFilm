<UserControl x:Class="MeowFilm.Capabilities.NovelSidebarView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities">
 <StackPanel Margin="15,6,15,14" AutomationProperties.Name="小说书源">
  <Grid Height="28">
   <TextBlock Text="已启用书源" Style="{StaticResource Capability.Muted}" FontSize="12" Margin="0"
              TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <Button x:Name="ManageButton" Style="{StaticResource Novel.Action}" Width="26" Height="26"
           HorizontalAlignment="Right" AutomationProperties.Name="书源管理"
           Click="Manage_Click">
    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
     <Canvas Width="24" Height="24">
      <Path Style="{StaticResource Novel.Icon}" StrokeThickness="1.4"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Data="M9,3 L8,6 5,7 3,11 5,13 6,17 9,18 10,21 14,21 15,18 18,17 19,13 21,11 19,7 16,6 15,3 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12"/>
     </Canvas>
    </Viewbox>
   </Button>
  </Grid>
  <ItemsControl x:Name="SourceRows">
   <ItemsControl.ItemTemplate>
    <DataTemplate x:DataType="local:NovelSidebarSourceItem">
     <Button Style="{StaticResource Novel.Action}"
             Height="34" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
             IsEnabled="{x:Bind CanExplore, Mode=OneWay}"
             AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
             Click="Source_Click">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
       </Grid.ColumnDefinitions>
       <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                Fill="{ThemeResource MeowFilm.Brush.AccentText}"/>
       <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource Capability.Muted}"
                  FontSize="12" Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                  VerticalAlignment="Center"/>
       <Viewbox Grid.Column="2" Width="12" Height="12" VerticalAlignment="Center"
                Visibility="{x:Bind SelectedVisibility, Mode=OneWay}">
        <Canvas Width="24" Height="24">
         <Path Style="{StaticResource Novel.Icon}" StrokeThickness="1.4"
               StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
               Data="M5,12 L9,16 19,6"/>
        </Canvas>
       </Viewbox>
      </Grid>
     </Button>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
  <Button x:Name="ImportButton" Content="＋  导入书源" Style="{StaticResource Novel.Action}"
          Height="32" Padding="12,0" Margin="0,12,0,0" BorderThickness="1" BorderBrush="{ThemeResource MeowFilm.Brush.Border}"
          AutomationProperties.Name="导入书源" Click="Import_Click"/>
 </StackPanel>
</UserControl>
