<UserControl x:Class="MeowFilm.Capabilities.NovelDiscoveryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 xmlns:desktop="using:MeowFilm.Desktop">
 <ScrollViewer x:Name="Scroller" Style="{StaticResource MeowFilm.OverlayScrollViewer}"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               HorizontalContentAlignment="Stretch">
  <Grid Margin="32,12,32,16">
   <StackPanel x:Name="RootPanel" MaxWidth="1100">
    <!-- Top channel bar + source picker + refresh -->
    <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource MeowFilm.Brush.SidebarBorder}"
            Margin="0,0,0,16" Canvas.ZIndex="1">
     <Grid MinHeight="44">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <local:NovelDiscoveryChannelBar x:Name="ChannelBar"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Height="44" VerticalAlignment="Top">
       <ComboBox x:Name="SourceBox" Width="154" MaxDropDownHeight="300" Margin="0,0,16,0"
                 VerticalAlignment="Center"
                 Style="{StaticResource Novel.Discovery.Source}"
                 desktop:DropdownPlacement.Enabled="True"
                 AutomationProperties.Name="发现书源"
                 AutomationProperties.AutomationId="novel.discovery.source"
                 SelectionChanged="SourceBox_SelectionChanged">
        <ComboBox.ItemTemplate>
         <DataTemplate x:DataType="local:NovelSource">
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition/>
           </Grid.ColumnDefinitions>
           <Viewbox Width="14" Height="14">
            <Canvas Width="24" Height="24">
             <Path Data="M3,7 L12,3 21,7 12,11 Z M3,12 L12,16 21,12 M3,17 L12,21 21,17"
                   Stroke="{ThemeResource MeowFilm.Brush.Text}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
            </Canvas>
           </Viewbox>
           <TextBlock Grid.Column="2" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Grid>
         </DataTemplate>
        </ComboBox.ItemTemplate>
       </ComboBox>
       <Button x:Name="RefreshButton" Style="{StaticResource Novel.Discovery.Action}" Width="30"
               AutomationProperties.Name="刷新"
               Click="Refresh_Click">
        <Grid>
         <Viewbox x:Name="RefreshIcon" Width="18" Height="18" VerticalAlignment="Center">
          <Canvas Width="24" Height="24">
           <Path Style="{StaticResource Novel.Discovery.Icon}" StrokeThickness="1.4"
                 StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                 Data="M20,7 A9,9 0 1 0 21,15 M20,2 L20,7 15,7"/>
          </Canvas>
         </Viewbox>
         <Viewbox x:Name="CancelIcon" Width="18" Height="18" VerticalAlignment="Center" Visibility="Collapsed">
          <Canvas Width="24" Height="24">
           <Path Style="{StaticResource Novel.Discovery.Icon}" StrokeThickness="1.4"
                 StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                 Data="M6,6 L18,18 M6,18 L18,6"/>
          </Canvas>
         </Viewbox>
        </Grid>
       </Button>
      </StackPanel>
     </Grid>
    </Border>

    <!-- Category filter pills -->
    <Grid x:Name="FilterRow" MinHeight="36" Margin="0,0,0,18" Visibility="Collapsed"
          AutomationProperties.Name="当前频道筛选">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <Grid Height="36" VerticalAlignment="Top" Margin="0,0,14,0">
      <TextBlock x:Name="FilterLabel" Style="{StaticResource MeowFilm.FilterLabel}"
                 MaxWidth="150" TextTrimming="CharacterEllipsis"/>
     </Grid>
     <Border Grid.Column="1" Style="{StaticResource MeowFilm.FilterGroup}" HorizontalAlignment="Left">
      <ScrollViewer Style="{StaticResource MeowFilm.SettingsScrollViewer}"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                    HorizontalContentAlignment="Left">
       <ItemsControl x:Name="FilterChoices">
        <ItemsControl.ItemsPanel>
         <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal"/>
         </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate x:DataType="local:NovelFilterChoiceItem">
          <RadioButton Content="{x:Bind Title}"
                       IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                       GroupName="novel.discovery.kinds"
                       Style="{StaticResource Novel.Discovery.Choice}"
                       AutomationProperties.Name="{x:Bind Title}"
                       AutomationProperties.AutomationId="{x:Bind AutomationId}"
                       Click="FilterChoice_Click"
                       KeyDown="FilterChoice_KeyDown"
                       Loaded="FilterChoice_Loaded"/>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
     </Border>
    </Grid>

    <!-- Home-only 9:3 Featured Book + Continue Reading row -->
    <Grid x:Name="FeatureRow" Visibility="Collapsed" SizeChanged="FeatureRow_SizeChanged">
     <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="FeatureCol0" Width="9*"/>
      <ColumnDefinition x:Name="FeatureColGap" Width="16"/>
      <ColumnDefinition x:Name="FeatureCol2" Width="3*"/>
     </Grid.ColumnDefinitions>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition x:Name="FeatureRowGap" Height="0"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <!-- Featured book card -->
     <Border x:Name="FeaturedCard" Height="216" Padding="30,22,30,22"
             Style="{StaticResource Novel.Discovery.Feature}"
             AutomationProperties.Name="选读"
             SizeChanged="FeaturedCard_SizeChanged">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="FeaturedCoverCol" Width="149"/>
       </Grid.ColumnDefinitions>
       <desktop:DockPanel>
        <desktop:WrapPanel desktop:DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
         <Button x:Name="FeaturedReadButton" Content="开始阅读  →"
                 Style="{StaticResource Novel.Discovery.Primary}"
                 AutomationProperties.Name="开始阅读"
                 Click="FeaturedRead_Click"/>
         <Button x:Name="FeaturedShelfButton" Content="＋  加入书架" Margin="16,0,0,0"
                 Style="{StaticResource Novel.Discovery.Action}"
                 AutomationProperties.Name="加入书架"
                 Click="FeaturedShelf_Click"/>
        </desktop:WrapPanel>
        <StackPanel>
         <TextBlock x:Name="FeaturedSourceText" Style="{StaticResource Capability.Muted}" FontSize="11"
                    Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
         <Button x:Name="FeaturedTitleButton" Style="{StaticResource Novel.Discovery.Action}"
                 Height="43" HorizontalContentAlignment="Left" Click="FeaturedOpen_Click">
          <TextBlock x:Name="FeaturedTitleText" Style="{StaticResource Capability.Text}" FontSize="28"
                     Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
         </Button>
         <TextBlock x:Name="FeaturedMetaText" Style="{StaticResource Capability.Muted}" FontSize="12"
                    Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
         <TextBlock x:Name="FeaturedIntroText" Style="{StaticResource Capability.Muted}" FontSize="13"
                    Margin="0,12,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                    LineHeight="23" MaxHeight="46"/>
        </StackPanel>
       </desktop:DockPanel>
       <Border x:Name="FeaturedCoverBorder" Grid.Column="1" CornerRadius="3" HorizontalAlignment="Right">
        <local:NovelImage x:Name="FeaturedCover" Width="121" Height="168" ShowPlaceholder="True"/>
       </Border>
      </Grid>
     </Border>

     <!-- Continue reading card -->
     <Border x:Name="ContinuationCard" Grid.Column="2" Height="216" Padding="20"
             Style="{StaticResource Novel.Discovery.Surface}"
             AutomationProperties.Name="继续阅读">
      <desktop:DockPanel>
       <Grid desktop:DockPanel.Dock="Top">
        <TextBlock Text="继续阅读" Style="{StaticResource Capability.Text}" FontSize="13" Margin="0"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="ContinuationDateText" Style="{StaticResource Capability.Muted}" FontSize="11" Margin="0"
                   HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Visibility="Collapsed"/>
       </Grid>
       <Grid x:Name="ContinuationFooter" desktop:DockPanel.Dock="Bottom" Margin="0,12,0,0" Visibility="Collapsed">
        <Button x:Name="ContinuationResumeButton" Content="接着读 →" HorizontalAlignment="Left"
                Style="{StaticResource Novel.Discovery.Action}"
                Foreground="{ThemeResource MeowFilm.Brush.AccentText}"
                AutomationProperties.Name="接着读"
                Click="ContinuationResume_Click"/>
        <TextBlock x:Name="ContinuationPercentText" Style="{StaticResource Capability.Muted}" FontSize="11" Margin="0"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
       </Grid>
       <Grid>
        <StackPanel x:Name="ContinuationContent" Margin="0,17,0,0" Visibility="Collapsed">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="57"/>
           <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border CornerRadius="3" HorizontalAlignment="Left">
           <local:NovelImage x:Name="ContinuationCover" Width="45" Height="61" ShowPlaceholder="True"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
           <TextBlock x:Name="ContinuationNameText" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0"
                      TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
           <TextBlock x:Name="ContinuationAuthorText" Style="{StaticResource Capability.Muted}" FontSize="11"
                      Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
         </Grid>
         <TextBlock x:Name="ContinuationChapterText" Style="{StaticResource Capability.Muted}" FontSize="11"
                    Margin="0,15,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock x:Name="ContinuationEmptyText" Text="暂无阅读历史" Style="{StaticResource Capability.Muted}"
                   FontSize="12" Margin="0,20,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
       </Grid>
      </desktop:DockPanel>
     </Border>
    </Grid>

    <!-- Home-only All Categories button -->
    <Button x:Name="AllCategoriesButton" Style="{StaticResource Novel.Discovery.Action}"
            HorizontalAlignment="Right" Margin="0,25,0,16" Visibility="Collapsed"
            AutomationProperties.Name="全部分类" Click="AllCategories_Click">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="全部分类" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <Viewbox Width="14" Height="14" VerticalAlignment="Center">
       <Canvas Width="24" Height="24">
        <Path Style="{StaticResource Novel.Discovery.Icon}" StrokeThickness="1.4"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Data="M10,6 L16,12 10,18"/>
       </Canvas>
      </Viewbox>
     </StackPanel>
    </Button>

    <!-- Vertical book tiles (Home) -->
    <ItemsControl x:Name="HomeBooksList" Visibility="Collapsed" AutomationProperties.Name="发现书籍">
     <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
       <local:NovelBookGrid MaximumColumns="6" MinimumWidth="138" ColumnGap="16" RowGap="22"/>
      </ItemsPanelTemplate>
     </ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="local:NovelDiscoveryBookItem">
       <Button Style="{StaticResource Novel.Discovery.OpenBook}"
               AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
               Click="BookOpen_Click">
        <StackPanel>
         <Viewbox Stretch="Uniform">
          <Border CornerRadius="3">
           <local:NovelImage Sources="{x:Bind Sources}" Book="{x:Bind Book, Mode=OneWay}"
                             ShowPlaceholder="True" Width="170" Height="227"/>
          </Border>
         </Viewbox>
         <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource Capability.Text}" FontSize="14"
                    Margin="0,10,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{x:Bind AuthorAndKind, Mode=OneWay}" Style="{StaticResource Capability.Muted}" FontSize="11"
                    Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
         <Grid Margin="0,7,0,0">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="14"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind SourceName, Mode=OneWay}" Style="{StaticResource Capability.Muted}" FontSize="11"
                     Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          <Viewbox Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center">
           <Canvas Width="24" Height="24">
            <Path Style="{StaticResource Novel.Discovery.Icon}" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="M3,7 L12,3 21,7 12,11 Z M3,12 L12,16 21,12 M3,17 L12,21 21,17"/>
           </Canvas>
          </Viewbox>
         </Grid>
        </StackPanel>
       </Button>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Horizontal catalog cards (Categories) -->
    <ItemsControl x:Name="CategoryBooksList" Visibility="Collapsed" AutomationProperties.Name="分类结果">
     <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
       <local:NovelBookGrid MaximumColumns="3" MinimumWidth="310" ColumnGap="24" RowGap="22"/>
      </ItemsPanelTemplate>
     </ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="local:NovelDiscoveryBookItem">
       <Border Padding="0,0,0,22" BorderThickness="0,0,0,1"
               BorderBrush="{ThemeResource MeowFilm.Brush.SidebarBorder}">
        <Grid>
         <Button Style="{StaticResource Novel.Discovery.OpenBook}"
                 AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                 Click="BookOpen_Click">
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="126"/>
            <ColumnDefinition Width="*"/>
           </Grid.ColumnDefinitions>
           <Border CornerRadius="3" HorizontalAlignment="Left">
            <local:NovelImage Sources="{x:Bind Sources}" Book="{x:Bind Book, Mode=OneWay}"
                              ShowPlaceholder="True" Width="111" Height="156"/>
           </Border>
           <desktop:DockPanel Grid.Column="1" Height="156">
            <TextBlock desktop:DockPanel.Dock="Bottom" Text="{x:Bind SourceName, Mode=OneWay}"
                       Style="{StaticResource Capability.Muted}" FontSize="11" Margin="0"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <StackPanel>
             <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource Capability.Text}" FontSize="15"
                        Margin="0,0,26,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{x:Bind Author, Mode=OneWay}" Style="{StaticResource Capability.Muted}" FontSize="11"
                        Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{x:Bind Metadata, Mode=OneWay}" Style="{StaticResource Capability.Muted}" FontSize="11"
                        Margin="0,7,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{x:Bind Intro, Mode=OneWay}" Style="{StaticResource Capability.Muted}" FontSize="12"
                        Margin="0,9,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                        LineHeight="21" MaxHeight="42"/>
            </StackPanel>
           </desktop:DockPanel>
          </Grid>
         </Button>
         <Button Style="{StaticResource Novel.Discovery.Action}"
                 Width="24" Height="24"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 AutomationProperties.Name="{x:Bind ShelfLabel, Mode=OneWay}"
                 Click="BookShelf_Click">
          <Grid>
           <Viewbox Width="14" Height="14" Visibility="{x:Bind AddIconVisibility, Mode=OneWay}">
            <Canvas Width="24" Height="24">
             <Path Style="{StaticResource Novel.Discovery.Icon}" StrokeThickness="1.4"
                   StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                   Data="M12,5 L12,19 M5,12 L19,12"/>
            </Canvas>
           </Viewbox>
           <Viewbox Width="14" Height="14" Visibility="{x:Bind CheckedIconVisibility, Mode=OneWay}">
            <Canvas Width="24" Height="24">
             <Path Style="{StaticResource Novel.Discovery.Icon}" StrokeThickness="1.4"
                   StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                   Data="M5,12 L9,16 19,6"/>
            </Canvas>
           </Viewbox>
          </Grid>
         </Button>
        </Grid>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Status / Retry / Import / Load more -->
    <TextBlock x:Name="StatusText" Style="{StaticResource Capability.Muted}" FontSize="12"
               Margin="0,18,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
               AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
    <Button x:Name="RetryButton" Content="重试" Style="{StaticResource Novel.Discovery.Action}"
            HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"
            AutomationProperties.Name="重试" Click="Retry_Click"/>
    <Button x:Name="ImportButton" Content="导入书源" Style="{StaticResource Novel.Discovery.Action}"
            HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"
            AutomationProperties.Name="导入书源" Click="Import_Click"/>
    <Button x:Name="MoreButton" Content="加载更多" Style="{StaticResource Novel.Discovery.Action}"
            HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed"
            AutomationProperties.Name="加载更多" Click="More_Click"/>
   </StackPanel>
  </Grid>
 </ScrollViewer>
</UserControl>
