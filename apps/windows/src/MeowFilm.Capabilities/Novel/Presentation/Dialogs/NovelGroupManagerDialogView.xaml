<UserControl x:Class="MeowFilm.Capabilities.NovelGroupManagerDialogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="using:MeowFilm.Desktop"
 AutomationProperties.Name="分组管理">
 <Border Style="{StaticResource MeowFilm.FloatingSurface}" CornerRadius="12" Padding="20"
         Width="480" MaxHeight="600" TabFocusNavigation="Cycle">
  <Grid RowSpacing="12">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Grid>
    <TextBlock Text="分组管理" Style="{StaticResource MeowFilm.SectionHeading}" FontSize="18"
               Margin="0" VerticalAlignment="Center"/>
    <Button x:Name="AddGroupButton" Content="新增分组" HorizontalAlignment="Right"
            Style="{StaticResource MeowFilm.Button}" MinHeight="32" Padding="12,5"
            AutomationProperties.Name="新增分组" Click="AddGroup_Click"/>
   </Grid>
   <desktop:NoticeStack x:Name="Notices" Grid.Row="1"/>
   <Grid Grid.Row="2" MinHeight="120" MaxHeight="380">
    <ListView x:Name="GroupList" SelectionMode="None" HorizontalContentAlignment="Stretch"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto">
     <ListView.ItemContainerStyle>
      <Style TargetType="ListViewItem" BasedOn="{StaticResource MeowFilm.BareListViewItem}"/>
     </ListView.ItemContainerStyle>
     <ListView.ItemTemplate>
      <DataTemplate x:DataType="x:String">
       <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource MeowFilm.Brush.Border}" Padding="0,8">
        <Grid ColumnSpacing="8">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <TextBlock Text="{x:Bind}" Style="{StaticResource Capability.Text}" FontSize="14"
                    Margin="0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
         <Button Grid.Column="1" Content="编辑" Style="{StaticResource MeowFilm.GhostButton}"
                 MinHeight="30" Padding="10,4" AutomationProperties.Name="编辑分组" Click="EditGroup_Click"/>
         <Button Grid.Column="2" Content="删除" Style="{StaticResource MeowFilm.GhostButton}"
                 MinHeight="30" Padding="10,4" AutomationProperties.Name="删除分组" Click="DeleteGroup_Click"/>
        </Grid>
       </Border>
      </DataTemplate>
     </ListView.ItemTemplate>
    </ListView>
    <TextBlock x:Name="EmptyText" Text="暂无分组" Style="{StaticResource Capability.Muted}" FontSize="14"
               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
   </Grid>
   <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="DoneButton" Content="完成" Style="{StaticResource MeowFilm.PrimaryButton}" MinWidth="72"
            AutomationProperties.Name="完成" Click="Done_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
