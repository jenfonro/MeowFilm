<UserControl x:Class="MeowFilm.Capabilities.NovelSwitchSourceDialogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 xmlns:desktop="using:MeowFilm.Desktop"
 AutomationProperties.Name="换源">
 <Border Style="{StaticResource MeowFilm.FloatingSurface}" CornerRadius="12" Padding="20"
         Width="580" MaxHeight="660" TabFocusNavigation="Cycle">
  <Grid RowSpacing="12">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Grid>
    <TextBlock Text="换源" Style="{StaticResource MeowFilm.SectionHeading}" FontSize="18"
               Margin="0" VerticalAlignment="Center"/>
    <Button x:Name="CloseButton" Content="&#xE711;" Style="{StaticResource MeowFilm.IconButton}"
            Width="32" Height="32" HorizontalAlignment="Right"
            AutomationProperties.Name="关闭" ToolTipService.ToolTip="关闭"
            Click="Cancel_Click"/>
   </Grid>
   <desktop:NoticeStack x:Name="Notices" Grid.Row="1"/>
   <desktop:WrapPanel Grid.Row="2">
    <ComboBox x:Name="GroupBox" Width="180" Margin="0,0,10,4"
              Style="{StaticResource MeowFilm.ComboBox}"
              desktop:DropdownPlacement.Enabled="True"
              AutomationProperties.Name="书源分组"
              SelectionChanged="GroupBox_SelectionChanged"/>
    <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource MeowFilm.QuietButton}"
            Margin="0,0,8,4" Padding="12,6" MinHeight="34"
            AutomationProperties.Name="刷新" Click="Refresh_Click"/>
    <Button x:Name="LoadMoreButton" Content="加载更多" Style="{StaticResource MeowFilm.QuietButton}"
            Margin="0,0,8,4" Padding="12,6" MinHeight="34"
            AutomationProperties.Name="加载更多" Click="LoadMore_Click"/>
   </desktop:WrapPanel>
   <ListView x:Name="CandidateList" Grid.Row="3" MinHeight="220" MaxHeight="420"
             SelectionMode="Single" HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             SelectionChanged="CandidateList_SelectionChanged"
             AutomationProperties.Name="候选书源列表">
    <ListView.ItemTemplate>
     <DataTemplate x:DataType="local:NovelSwitchCandidateItem">
      <StackPanel Spacing="2" Padding="4,6">
       <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{x:Bind SourceName}" Style="{StaticResource Capability.Text}" FontSize="14"
                   Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <Border Visibility="{x:Bind CurrentBadgeVisibility}" CornerRadius="6" Padding="6,1"
                Background="{ThemeResource MeowFilm.Brush.AccentSoft}" VerticalAlignment="Center">
         <TextBlock Text="当前" Style="{StaticResource MeowFilm.AccentText}" FontSize="11" Margin="0"/>
        </Border>
       </StackPanel>
       <TextBlock Text="{x:Bind BookSummary}" Style="{StaticResource Capability.Muted}" FontSize="12"
                  Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </DataTemplate>
    </ListView.ItemTemplate>
   </ListView>
   <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource MeowFilm.GhostButton}" MinWidth="72"
            AutomationProperties.Name="取消" Click="Cancel_Click"/>
    <Button x:Name="SwitchButton" Content="切换书源" Style="{StaticResource MeowFilm.PrimaryButton}" MinWidth="88"
            IsEnabled="False" AutomationProperties.Name="切换书源" Click="Switch_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
