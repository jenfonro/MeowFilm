<UserControl x:Class="MeowFilm.Capabilities.NovelWebInteractionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="using:MeowFilm.Desktop">
 <Border Style="{StaticResource MeowFilm.FloatingSurface}" CornerRadius="12" Padding="20"
         Width="640" MaxHeight="700" TabFocusNavigation="Cycle">
  <Grid RowSpacing="12">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Grid>
    <TextBlock x:Name="TitleText" Style="{StaticResource MeowFilm.SectionHeading}" FontSize="18"
               Margin="0" VerticalAlignment="Center"/>
    <Button x:Name="CloseButton" Content="&#xE711;" Style="{StaticResource MeowFilm.IconButton}"
            Width="32" Height="32" HorizontalAlignment="Right"
            AutomationProperties.Name="关闭"
            Click="Cancel_Click"/>
   </Grid>
   <desktop:NoticeStack x:Name="Notices" Grid.Row="1"/>
   <WebView2 x:Name="Web" Grid.Row="2" MinHeight="320" Visibility="Collapsed"/>
   <Border x:Name="CodeSection" Grid.Row="3" Style="{StaticResource Novel.Row}" Visibility="Collapsed" Margin="0">
    <StackPanel Spacing="8">
     <TextBlock Text="验证码" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0"/>
     <TextBox x:Name="CodeBox" Style="{StaticResource Novel.Input}" HorizontalAlignment="Stretch"
              AutomationProperties.Name="验证码"/>
    </StackPanel>
   </Border>
   <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource MeowFilm.GhostButton}" MinWidth="72"
            AutomationProperties.Name="取消" Click="Cancel_Click"/>
    <Button x:Name="SubmitButton" Content="完成" Style="{StaticResource MeowFilm.PrimaryButton}" MinWidth="72"
            AutomationProperties.Name="完成" Click="Submit_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
