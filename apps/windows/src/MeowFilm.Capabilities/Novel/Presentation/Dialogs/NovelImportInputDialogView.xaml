<UserControl x:Class="MeowFilm.Capabilities.NovelImportInputDialogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="using:MeowFilm.Desktop">
 <StackPanel Spacing="10">
  <desktop:NoticeStack x:Name="Notices"/>
  <TextBlock x:Name="LabelText" Style="{StaticResource MeowFilm.MutedText}"
             FontSize="{StaticResource MeowFilm.Font.Size.Compact}" Margin="0"/>
  <TextBox x:Name="InputBox" Style="{StaticResource MeowFilm.ManagementInput}"
           HorizontalAlignment="Stretch" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
