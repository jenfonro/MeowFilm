<UserControl x:Class="MeowFilm.Capabilities.NovelRuleEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="using:MeowFilm.Desktop">
 <StackPanel Spacing="10">
  <desktop:NoticeStack x:Name="Notices"/>
  <desktop:WrapPanel>
   <Button Content="复制规则" Style="{StaticResource MeowFilm.QuietButton}" Margin="0,0,10,4" Padding="12,7"
           AutomationProperties.Name="复制规则" Click="Copy_Click"/>
   <Button Content="粘贴规则" Style="{StaticResource MeowFilm.QuietButton}" Margin="0,0,10,4" Padding="12,7"
           AutomationProperties.Name="粘贴规则" Click="Paste_Click"/>
  </desktop:WrapPanel>
  <Border Style="{StaticResource MeowFilm.FloatingSurface}" CornerRadius="16" BorderThickness="1" Padding="16,16,16,4">
   <StackPanel>
    <StackPanel Margin="0,0,0,14">
     <TextBlock Text="替换规则名称（name）" Style="{StaticResource MeowFilm.MutedText}" FontSize="{StaticResource MeowFilm.Font.Size.Compact}" Margin="0,0,0,8"/>
     <TextBox x:Name="NameBox" Style="{StaticResource MeowFilm.ManagementInput}" Height="40"
              AutomationProperties.Name="替换规则名称（name）" AutomationProperties.AutomationId="novel.rule.field.name"/>
    </StackPanel>
    <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="0,0,0,14"/>

    <StackPanel Margin="0,0,0,14">
     <TextBlock Text="分组（group）" Style="{StaticResource MeowFilm.MutedText}" FontSize="{StaticResource MeowFilm.Font.Size.Compact}" Margin="0,0,0,8"/>
     <TextBox x:Name="GroupBox" Style="{StaticResource MeowFilm.ManagementInput}" Height="40"
              AutomationProperties.Name="分组（group）" AutomationProperties.AutomationId="novel.rule.field.group"/>
    </StackPanel>
    <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="0,0,0,14"/>

    <StackPanel Margin="0,0,0,14">
     <TextBlock Text="替换规则（pattern）" Style="{StaticResource MeowFilm.MutedText}" FontSize="{StaticResource MeowFilm.Font.Size.Compact}" Margin="0,0,0,8"/>
     <TextBox x:Name="PatternBox" Style="{StaticResource MeowFilm.ManagementInput}" Height="116"
              AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              KeyDown="Multiline_KeyDown"
              AutomationProperties.Name="替换规则（pattern）" AutomationProperties.AutomationId="novel.rule.field.pattern"/>
    </StackPanel>
    <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="0,0,0,14"/>

    <CheckBox x:Name="RegexCheck" Content="使用正则表达式" Style="{StaticResource MeowFilm.ManagementCheck}"
              Margin="0,0,0,14" MinHeight="32" VerticalContentAlignment="Center"
              AutomationProperties.Name="使用正则表达式"/>
    <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="0,0,0,14"/>

    <StackPanel Margin="0,0,0,14">
     <TextBlock Text="替换为（replacement）" Style="{StaticResource MeowFilm.MutedText}" FontSize="{StaticResource MeowFilm.Font.Size.Compact}" Margin="0,0,0,8"/>
     <TextBox x:Name="ReplacementBox" Style="{StaticResource MeowFilm.ManagementInput}" Height="96"
              AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              KeyDown="Multiline_KeyDown"
              AutomationProperties.Name="替换为（replacement）" AutomationProperties.AutomationId="novel.rule.field.replacement"/>
    </StackPanel>
    <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="0,0,0,14"/>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
     <CheckBox x:Name="TitleCheck" Content="作用于标题" Style="{StaticResource MeowFilm.ManagementCheck}"
               Margin="0,0,14,0" MinHeight="32" VerticalContentAlignment="Center"
               AutomationProperties.Name="作用于标题"/>
     <CheckBox x:Name="ContentCheck" Content="作用于正文" Style="{StaticResource MeowFilm.ManagementCheck}"
               MinHeight="32" VerticalContentAlignment="Center"
               AutomationProperties.Name="作用于正文"/>
    </StackPanel>
    <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="0,0,0,14"/>

    <StackPanel Margin="0,0,0,14">
     <TextBlock Text="替换范围，选填书名或者书源 URL（scope）" Style="{StaticResource MeowFilm.MutedText}" FontSize="{StaticResource MeowFilm.Font.Size.Compact}" Margin="0,0,0,8"/>
     <TextBox x:Name="ScopeBox" Style="{StaticResource MeowFilm.ManagementInput}" Height="40"
              AutomationProperties.Name="替换范围，选填书名或者书源 URL（scope）" AutomationProperties.AutomationId="novel.rule.field.scope"/>
    </StackPanel>
    <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="0,0,0,14"/>

    <StackPanel Margin="0,0,0,14">
     <TextBlock Text="排除范围，选填书名或者书源 URL（excludeScope）" Style="{StaticResource MeowFilm.MutedText}" FontSize="{StaticResource MeowFilm.Font.Size.Compact}" Margin="0,0,0,8"/>
     <TextBox x:Name="ExcludeBox" Style="{StaticResource MeowFilm.ManagementInput}" Height="40"
              AutomationProperties.Name="排除范围，选填书名或者书源 URL（excludeScope）" AutomationProperties.AutomationId="novel.rule.field.excludeScope"/>
    </StackPanel>
    <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="0,0,0,14"/>

    <StackPanel Margin="0,0,0,12">
     <TextBlock Text="超时毫秒数（timeoutMillisecond）" Style="{StaticResource MeowFilm.MutedText}" FontSize="{StaticResource MeowFilm.Font.Size.Compact}" Margin="0,0,0,8"/>
     <TextBox x:Name="TimeoutBox" Style="{StaticResource MeowFilm.ManagementInput}" Height="40"
              AutomationProperties.Name="超时毫秒数（timeoutMillisecond）" AutomationProperties.AutomationId="novel.rule.field.timeoutMillisecond"/>
    </StackPanel>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
