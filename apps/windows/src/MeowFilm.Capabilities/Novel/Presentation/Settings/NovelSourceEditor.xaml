<UserControl x:Class="MeowFilm.Capabilities.NovelSourceEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 xmlns:desktop="using:MeowFilm.Desktop"
 AutomationProperties.AutomationId="novel.source.editor">
 <Border Style="{StaticResource MeowFilm.FloatingSurface}" CornerRadius="22" BorderThickness="1">
  <TabView x:Name="Tabs" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">
   <TabView.TabItemTemplate>
    <DataTemplate x:DataType="local:NovelSourceTabItem">
     <TabViewItem Header="{x:Bind Title}" IsClosable="False" FontWeight="Normal">
      <ScrollViewer Style="{StaticResource MeowFilm.OverlayScrollViewer}"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <Border Style="{StaticResource MeowFilm.FloatingSurface}" CornerRadius="18" BorderThickness="1">
        <StackPanel>
         <StackPanel Visibility="{x:Bind BasicVisibility}">
          <StackPanel Margin="14,11,14,10">
           <TextBlock Text="内容类型" Style="{StaticResource Capability.Muted}" FontSize="13" Margin="0,0,0,8"/>
           <ComboBox ItemsSource="{x:Bind ContentTypes}" SelectedIndex="{x:Bind ContentTypeIndex}"
                     MinWidth="100" Height="32" MinHeight="32" HorizontalAlignment="Left"
                     Style="{StaticResource MeowFilm.ComboBox}"
                     desktop:DropdownPlacement.Enabled="True"
                     AutomationProperties.Name="内容类型"
                     AutomationProperties.AutomationId="novel.source.contentType"
                     SelectionChanged="ContentType_SelectionChanged"/>
          </StackPanel>
          <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}"/>
          <CheckBox Content="启用" IsChecked="{x:Bind Enabled}" Tag="enabled"
                    Style="{StaticResource MeowFilm.ManagementCheck}" Margin="14,6,14,6" MinHeight="32"
                    VerticalContentAlignment="Center" AutomationProperties.Name="启用" Click="BasicCheck_Click"/>
          <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}"/>
          <CheckBox Content="发现" IsChecked="{x:Bind EnabledExplore}" Tag="enabledExplore"
                    Style="{StaticResource MeowFilm.ManagementCheck}" Margin="14,6,14,6" MinHeight="32"
                    VerticalContentAlignment="Center" AutomationProperties.Name="发现" Click="BasicCheck_Click"/>
          <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}"/>
          <CheckBox Content="CookieJar" IsChecked="{x:Bind EnabledCookieJar}" Tag="enabledCookieJar"
                    Style="{StaticResource MeowFilm.ManagementCheck}" Margin="14,6,14,6" MinHeight="32"
                    VerticalContentAlignment="Center" AutomationProperties.Name="CookieJar" Click="BasicCheck_Click"/>
          <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}"/>
         </StackPanel>
         <ItemsControl ItemsSource="{x:Bind Fields}">
          <ItemsControl.ItemTemplate>
           <DataTemplate x:DataType="local:NovelSourceFieldItem">
            <StackPanel>
             <CheckBox Visibility="{x:Bind BoolVisibility}"
                       Content="{x:Bind Label}"
                       IsChecked="{x:Bind BoolValue}"
                       Style="{StaticResource MeowFilm.ManagementCheck}"
                       Margin="14,6,14,6" MinHeight="32" VerticalContentAlignment="Center"
                       AutomationProperties.Name="{x:Bind Label}"
                       Click="BoolField_Click"/>
             <StackPanel Visibility="{x:Bind TextVisibility}" Margin="14,11,14,10">
              <TextBlock Text="{x:Bind Label}" Style="{StaticResource MeowFilm.MutedText}"
                         FontSize="{StaticResource MeowFilm.Font.Size.Caption}"
                         Margin="0,0,0,5" TextWrapping="Wrap"/>
              <TextBox Text="{x:Bind TextValue}"
                       AcceptsReturn="{x:Bind IsMultiline}"
                       TextWrapping="Wrap"
                       Height="{x:Bind InputHeight}"
                       MinHeight="0"
                       VerticalContentAlignment="{x:Bind ContentAlignment}"
                       BorderThickness="0" Padding="0" Background="Transparent"
                       FontSize="{StaticResource MeowFilm.Font.Size.Body}"
                       ScrollViewer.VerticalScrollBarVisibility="{x:Bind ScrollVisibility}"
                       AutomationProperties.Name="{x:Bind Label}"
                       AutomationProperties.AutomationId="{x:Bind AutomationId}"
                       TextChanged="TextField_TextChanged"
                       KeyDown="TextField_KeyDown"/>
             </StackPanel>
             <Border Height="0.5" Opacity="0.5" Background="{ThemeResource MeowFilm.Brush.Border}"/>
            </StackPanel>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Border>
      </ScrollViewer>
     </TabViewItem>
    </DataTemplate>
   </TabView.TabItemTemplate>
  </TabView>
 </Border>
</UserControl>
