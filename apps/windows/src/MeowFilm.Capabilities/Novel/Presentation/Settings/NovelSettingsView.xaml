<UserControl x:Class="MeowFilm.Capabilities.NovelSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="using:MeowFilm.Desktop">
 <Grid>
  <Grid Style="{StaticResource MeowFilm.SettingsPage}">
   <Grid.RowDefinitions>
    <RowDefinition Height="36"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <Border Style="{StaticResource MeowFilm.SettingsNavigationBar}">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="SourcesTab" Content="书源管理" GroupName="novel-settings-area" IsChecked="True"
                   Style="{StaticResource MeowFilm.SettingsArea}" AutomationProperties.Name="书源管理"
                   Tag="sources" Checked="Tab_Checked"/>
      <RadioButton x:Name="RulesTab" Content="替换净化" GroupName="novel-settings-area"
                   Style="{StaticResource MeowFilm.SettingsArea}" AutomationProperties.Name="替换净化"
                   Tag="rules" Checked="Tab_Checked"/>
     </StackPanel>
     <Button x:Name="AppearanceButton" Grid.Column="1" Content="阅读排版" Style="{StaticResource MeowFilm.QuietButton}"
             Margin="0" Height="32" MinHeight="32" Padding="12,0"
             AutomationProperties.Name="阅读排版" Click="Appearance_Click"/>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Margin="0,8,12,0">
    <desktop:ManagementList x:Name="SourceList" AutomationProperties.Name="书源列表"/>
    <desktop:ManagementList x:Name="RuleList" Visibility="Collapsed" AutomationProperties.Name="替换规则列表"/>
   </Grid>
  </Grid>
  <desktop:NoticeOutlet x:Name="NoticeHost"/>
 </Grid>
</UserControl>
