<UserControl x:Class="MeowFilm.Capabilities.NovelAppearanceEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="using:MeowFilm.Desktop">
 <StackPanel>
  <desktop:NoticeStack x:Name="Notices"/>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="阅读模式" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <ComboBox x:Name="ModeBox" Style="{StaticResource MeowFilm.ComboBox}" AutomationProperties.Name="阅读模式" SelectionChanged="Mode_Changed"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="简繁转换" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <ComboBox x:Name="ConversionBox" Style="{StaticResource MeowFilm.ComboBox}" AutomationProperties.Name="简繁转换" SelectionChanged="Conversion_Changed"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="字体" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <ComboBox x:Name="FontsBox" IsEditable="True" Style="{StaticResource MeowFilm.ComboBox}" AutomationProperties.Name="字体"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <CheckBox x:Name="BoldCheck" Content="加粗" Style="{StaticResource Novel.CheckBox}" Margin="0"/>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="字号" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <TextBox x:Name="FontSizeBox" Style="{StaticResource Novel.Input}" MinWidth="90" MaxWidth="520" HorizontalAlignment="Stretch" Margin="0" AutomationProperties.Name="字号" ToolTipService.ToolTip="字号"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="行距倍数" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <TextBox x:Name="LineHeightBox" Style="{StaticResource Novel.Input}" MinWidth="90" MaxWidth="520" HorizontalAlignment="Stretch" Margin="0" AutomationProperties.Name="行距倍数" ToolTipService.ToolTip="行距倍数"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="段距" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <TextBox x:Name="ParagraphSpacingBox" Style="{StaticResource Novel.Input}" MinWidth="90" MaxWidth="520" HorizontalAlignment="Stretch" Margin="0" AutomationProperties.Name="段距" ToolTipService.ToolTip="段距"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="页边距" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <TextBox x:Name="MarginBox" Style="{StaticResource Novel.Input}" MinWidth="90" MaxWidth="520" HorizontalAlignment="Stretch" Margin="0" AutomationProperties.Name="页边距" ToolTipService.ToolTip="页边距"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="正文宽度" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <TextBox x:Name="ContentWidthBox" Style="{StaticResource Novel.Input}" MinWidth="90" MaxWidth="520" HorizontalAlignment="Stretch" Margin="0" AutomationProperties.Name="正文宽度" ToolTipService.ToolTip="正文宽度"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="自动阅读速度（1–10）" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <TextBox x:Name="AutoSpeedBox" Style="{StaticResource Novel.Input}" MinWidth="90" MaxWidth="520" HorizontalAlignment="Stretch" Margin="0" AutomationProperties.Name="自动阅读速度（1–10）" ToolTipService.ToolTip="自动阅读速度（1–10）"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="主题" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <ComboBox x:Name="ThemeBox" Style="{StaticResource MeowFilm.ComboBox}" AutomationProperties.Name="主题" SelectionChanged="Theme_Changed"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="背景颜色" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <TextBox x:Name="BackgroundBox" Style="{StaticResource Novel.Input}" MinWidth="90" MaxWidth="520" HorizontalAlignment="Stretch" Margin="0" AutomationProperties.Name="背景颜色" ToolTipService.ToolTip="背景颜色"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="文字颜色" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <TextBox x:Name="ForegroundBox" Style="{StaticResource Novel.Input}" MinWidth="90" MaxWidth="520" HorizontalAlignment="Stretch" Margin="0" AutomationProperties.Name="文字颜色" ToolTipService.ToolTip="文字颜色"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Novel.Row}">
   <StackPanel>
    <TextBlock Text="背景图片" Style="{StaticResource Capability.Text}" FontSize="14" Margin="0,0,0,8"/>
    <TextBox x:Name="BackgroundImageBox" Style="{StaticResource Novel.Input}" MinWidth="90" MaxWidth="520" HorizontalAlignment="Stretch" Margin="0" AutomationProperties.Name="背景图片" ToolTipService.ToolTip="背景图片"/>
   </StackPanel>
  </Border>
  <desktop:WrapPanel>
   <Button Content="选择背景图" Style="{StaticResource MeowFilm.QuietButton}" Margin="0,0,10,8" Padding="12,7"
           AutomationProperties.Name="选择背景图" Click="PickBackground_Click"/>
   <Button Content="移除背景图" Style="{StaticResource MeowFilm.QuietButton}" Margin="0,0,10,8" Padding="12,7"
           AutomationProperties.Name="移除背景图" Click="RemoveBackground_Click"/>
  </desktop:WrapPanel>
 </StackPanel>
</UserControl>
