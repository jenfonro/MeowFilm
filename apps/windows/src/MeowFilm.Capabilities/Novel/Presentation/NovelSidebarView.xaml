<UserControl x:Class="MeowFilm.Capabilities.NovelSidebarView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="15,27,15,14" AutomationProperties.Name="小说书源">
  <Border Height="1" Margin="0,0,0,14" Background="{ThemeResource MeowFilm.Brush.SidebarBorder}"/>
  <Grid Height="28">
   <TextBlock Text="已启用书源" Style="{StaticResource Capability.Muted}" FontSize="12" Margin="0"
              TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <Button x:Name="ManageButton" Style="{StaticResource Novel.Discovery.Action}" Width="26" Height="26"
           HorizontalAlignment="Right" AutomationProperties.Name="书源管理" ToolTipService.ToolTip="书源管理"
           Click="Manage_Click">
    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
     <Canvas Width="24" Height="24">
      <Path Style="{StaticResource Novel.Discovery.Icon}" StrokeThickness="1.4"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Data="M9,3 L8,6 5,7 3,11 5,13 6,17 9,18 10,21 14,21 15,18 18,17 19,13 21,11 19,7 16,6 15,3 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12"/>
     </Canvas>
    </Viewbox>
   </Button>
  </Grid>
  <StackPanel x:Name="SourceRows"/>
  <Button x:Name="ImportButton" Content="＋  导入书源" Style="{StaticResource Novel.Discovery.Action}"
          Height="32" Margin="0,12,0,0" BorderThickness="1" BorderBrush="{ThemeResource MeowFilm.Brush.Border}"
          AutomationProperties.Name="导入书源" Click="Import_Click"/>
 </StackPanel>
</UserControl>
