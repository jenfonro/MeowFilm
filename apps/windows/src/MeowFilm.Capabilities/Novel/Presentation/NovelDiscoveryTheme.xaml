<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <Style x:Key="Novel.Discovery.Icon" TargetType="Path">
  <Setter Property="Stroke" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
  <Style.Triggers>
   <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
    <Setter Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Novel.Discovery.Action" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
  <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Caption}"/>
  <Setter Property="MinHeight" Value="30"/><Setter Property="Height" Value="30"/>
  <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Style.Triggers>
   <MultiTrigger><MultiTrigger.Conditions>
    <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsMouseOver" Value="True"/>
   </MultiTrigger.Conditions>
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
   </MultiTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Novel.Discovery.OpenBook" TargetType="Button" BasedOn="{StaticResource Novel.Discovery.Action}">
  <Setter Property="Height" Value="Auto"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="VerticalContentAlignment" Value="Top"/>
 </Style>
 <Style x:Key="Novel.Discovery.Primary" TargetType="Button" BasedOn="{StaticResource Novel.Discovery.Action}">
  <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="15,0"/>
  <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Text}"/>
  <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Surface}"/>
  <Style.Triggers>
   <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Novel.Discovery.Tab" TargetType="RadioButton">
  <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
  <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Compact}"/>
  <Setter Property="Height" Value="55"/><Setter Property="Margin" Value="0,0,30,0"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Grid Background="Transparent">
    <ContentPresenter VerticalAlignment="Center"/>
    <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="Transparent"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
     <Setter Property="FontWeight" Value="{StaticResource MeowFilm.Font.Weight.Strong}"/>
     <Setter TargetName="Underline" Property="Background" Value="{DynamicResource MeowFilm.Brush.AccentText}"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/></Trigger>
    <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
    </Trigger>
    <MultiTrigger><MultiTrigger.Conditions>
     <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsChecked" Value="True"/>
    </MultiTrigger.Conditions>
     <Setter TargetName="Underline" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
    </MultiTrigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Novel.Discovery.Choice" TargetType="RadioButton">
  <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
  <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Caption}"/><Setter Property="MinHeight" Value="24"/>
  <Setter Property="Padding" Value="10,3"/><Setter Property="Margin" Value="0,3,12,3"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
    <ContentPresenter VerticalAlignment="Center"/>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.ItemHover}"/></Trigger>
   <Trigger Property="IsChecked" Value="True">
    <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.ItemSelected}"/>
    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
    <Setter Property="FontWeight" Value="{StaticResource MeowFilm.Font.Weight.Strong}"/>
   </Trigger>
   <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
   </Trigger>
   <MultiTrigger><MultiTrigger.Conditions>
    <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsChecked" Value="True"/>
   </MultiTrigger.Conditions>
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
   </MultiTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Novel.Discovery.Source" TargetType="ComboBox" BasedOn="{StaticResource Novel.ComboBox}">
  <Setter Property="MinHeight" Value="32"/><Setter Property="Height" Value="32"/>
  <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Caption}"/><Setter Property="Padding" Value="10,4"/>
  <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Viewbox Width="14" Height="14">
     <Canvas Width="24" Height="24">
      <Path Data="M3,7 L12,3 21,7 12,11 Z M3,12 L12,16 21,12 M3,17 L12,21 21,17"
       Stroke="{Binding (TextElement.Foreground),RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
       StrokeThickness="1.4" StrokeLineJoin="Round"/>
     </Canvas>
    </Viewbox>
    <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
     Foreground="{Binding (TextElement.Foreground),RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
   </Grid>
  </DataTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Novel.Discovery.Surface" TargetType="Border">
  <Setter Property="CornerRadius" Value="8"/>
  <Setter Property="Background" Value="#F6F7F6"/>
  <Style.Triggers>
   <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
    <Setter Property="BorderThickness" Value="1"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Novel.Discovery.Feature" TargetType="Border" BasedOn="{StaticResource Novel.Discovery.Surface}">
  <Setter Property="Background" Value="#F0F4F0"/>
 </Style>
</ResourceDictionary>
