<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="Novel.SurfaceBorder" Color="Transparent"/>
   <Thickness x:Key="Novel.SurfaceBorderThickness">0</Thickness>
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="Novel.SurfaceBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <Thickness x:Key="Novel.SurfaceBorderThickness">1</Thickness>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style x:Key="Novel.Icon" TargetType="Path">
  <Setter Property="Stroke" Value="{ThemeResource MeowFilm.Brush.Muted}"/>
 </Style>
 <Style x:Key="Novel.Action" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
  <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Caption}"/>
  <Setter Property="MinHeight" Value="30"/><Setter Property="Height" Value="30"/>
  <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
  <Setter Property="BorderThickness" Value="0"/>
 </Style>
 <Style x:Key="Novel.Surface" TargetType="Border">
  <Setter Property="CornerRadius" Value="8"/>
  <Setter Property="Background" Value="{ThemeResource MeowFilm.Brush.InputSurface}"/>
  <Setter Property="BorderBrush" Value="{ThemeResource Novel.SurfaceBorder}"/>
  <Setter Property="BorderThickness" Value="{ThemeResource Novel.SurfaceBorderThickness}"/>
 </Style>
 <Style x:Key="Novel.Input" TargetType="TextBox" BasedOn="{StaticResource MeowFilm.TextBox}">
  <Setter Property="Background" Value="{ThemeResource MeowFilm.Brush.InputSurface}"/>
 </Style>
 <Style x:Key="Novel.Row" TargetType="Border">
  <Setter Property="BorderBrush" Value="{ThemeResource MeowFilm.Brush.Border}"/>
  <Setter Property="BorderThickness" Value="0,0,0,1"/>
  <Setter Property="Padding" Value="0,0,0,12"/>
  <Setter Property="Margin" Value="0,0,0,12"/>
 </Style>
</ResourceDictionary>
