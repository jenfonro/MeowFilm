<UserControl x:Class="MeowFilm.Capabilities.NovelBookView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="using:MeowFilm.Desktop">
 <ScrollViewer x:Name="Scroller" Style="{StaticResource MeowFilm.OverlayScrollViewer}"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <Grid Margin="0,0,0,24">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <ContentControl x:Name="CoverHost" Width="132" Height="190" Margin="0,0,24,0" VerticalAlignment="Top"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <StackPanel Grid.Column="1">
     <TextBlock x:Name="NameText" Style="{StaticResource Capability.Text}" FontSize="26" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock x:Name="AuthorText" Style="{StaticResource Capability.Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock x:Name="SourceText" Style="{StaticResource Capability.Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock x:Name="LatestText" Style="{StaticResource Capability.Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <desktop:WrapPanel>
      <Button x:Name="ReadButton" Content="开始阅读" Style="{StaticResource MeowFilm.QuietButton}" Margin="0,0,10,8" Padding="12,7"
              AutomationProperties.Name="开始阅读" Click="Read_Click"/>
      <Button x:Name="ShelfButton" Content="加入书架" Style="{StaticResource MeowFilm.QuietButton}" Margin="0,0,10,8" Padding="12,7"
              AutomationProperties.Name="加入书架" Click="Shelf_Click"/>
      <Button Content="换源" Style="{StaticResource MeowFilm.QuietButton}" Margin="0,0,10,8" Padding="12,7"
              AutomationProperties.Name="换源" Click="SwitchSource_Click"/>
     </desktop:WrapPanel>
    </StackPanel>
   </Grid>
   <TextBlock x:Name="IntroText" Style="{StaticResource Capability.Text}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <TextBlock Text="目录" Style="{StaticResource Capability.Text}" FontSize="19" Margin="0,0,0,8"/>
   <desktop:WrapPanel>
    <Button Content="打开目录" Style="{StaticResource MeowFilm.QuietButton}" Margin="0,0,10,8" Padding="12,7"
            AutomationProperties.Name="打开目录" Click="Catalog_Click"/>
    <Button Content="刷新目录" Style="{StaticResource MeowFilm.QuietButton}" Margin="0,0,10,8" Padding="12,7"
            AutomationProperties.Name="刷新目录" Click="RefreshCatalog_Click"/>
    <Button x:Name="CancelButton" Content="取消加载" Style="{StaticResource MeowFilm.QuietButton}" Margin="0,0,10,8" Padding="12,7"
            AutomationProperties.Name="取消加载" Click="Cancel_Click"/>
   </desktop:WrapPanel>
   <ProgressRing x:Name="LoadingRing" IsActive="True" Width="28" Height="28" HorizontalAlignment="Left"
                 Margin="0,0,0,10" Visibility="Collapsed"/>
   <StackPanel x:Name="ChaptersPanel"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
