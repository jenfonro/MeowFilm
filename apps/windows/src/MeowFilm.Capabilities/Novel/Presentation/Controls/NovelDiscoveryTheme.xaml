<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="Novel.Discovery.SelectedText" Color="#15803D"/>
   <SolidColorBrush x:Key="Novel.Discovery.PrimaryBackground" Color="#374151"/>
   <SolidColorBrush x:Key="Novel.Discovery.PrimaryText" Color="#FFFFFF"/>
   <SolidColorBrush x:Key="Novel.Discovery.SurfaceBorder" Color="Transparent"/>
   <Thickness x:Key="Novel.Discovery.SurfaceBorderThickness">0</Thickness>
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="Novel.Discovery.SelectedText" Color="{ThemeResource SystemColorHighlightTextColor}"/>
   <SolidColorBrush x:Key="Novel.Discovery.PrimaryBackground" Color="{ThemeResource SystemColorHighlightColor}"/>
   <SolidColorBrush x:Key="Novel.Discovery.PrimaryText" Color="{ThemeResource SystemColorHighlightTextColor}"/>
   <SolidColorBrush x:Key="Novel.Discovery.SurfaceBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <Thickness x:Key="Novel.Discovery.SurfaceBorderThickness">1</Thickness>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style x:Key="Novel.Discovery.Icon" TargetType="Path">
  <Setter Property="Stroke" Value="{ThemeResource MeowFilm.Brush.Muted}"/>
 </Style>
 <Style x:Key="Novel.Discovery.Action" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
  <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Caption}"/>
  <Setter Property="MinHeight" Value="30"/><Setter Property="Height" Value="30"/>
  <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
  <Setter Property="BorderThickness" Value="0"/>
 </Style>
 <Style x:Key="Novel.Discovery.OpenBook" TargetType="Button" BasedOn="{StaticResource Novel.Discovery.Action}">
  <Setter Property="Height" Value="Auto"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="VerticalContentAlignment" Value="Top"/>
 </Style>
 <Style x:Key="Novel.Discovery.Primary" TargetType="Button" BasedOn="{StaticResource Novel.Discovery.Action}">
  <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="15,0"/>
  <Setter Property="Background" Value="{ThemeResource Novel.Discovery.PrimaryBackground}"/>
  <Setter Property="Foreground" Value="{ThemeResource Novel.Discovery.PrimaryText}"/>
 </Style>
 <Style x:Key="Novel.Discovery.Tab" TargetType="RadioButton" BasedOn="{StaticResource MeowFilm.SettingsArea}">
  <Setter Property="Margin" Value="0,0,28,0"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Grid Background="Transparent">
    <VisualStateManager.VisualStateGroups>
     <VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/>
      <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Label.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
     </VisualStateGroup>
     <VisualStateGroup x:Name="CheckStates">
      <VisualState x:Name="Unchecked"/>
      <VisualState x:Name="Checked"><VisualState.Setters>
       <Setter Target="Indicator.Visibility" Value="Visible"/>
       <Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Text}"/>
      </VisualState.Setters></VisualState>
      <VisualState x:Name="Indeterminate"/>
     </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
     Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
    <Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom" Background="{ThemeResource MeowFilm.Brush.Accent}" Visibility="Collapsed"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Novel.Discovery.Choice" TargetType="RadioButton" BasedOn="{StaticResource MeowFilm.FilterChip}">
  <Setter Property="UseSystemFocusVisuals" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
    <VisualStateManager.VisualStateGroups>
     <VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/>
      <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Label.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
     </VisualStateGroup>
     <VisualStateGroup x:Name="CheckStates">
      <VisualState x:Name="Unchecked"/>
      <VisualState x:Name="Checked"><VisualState.Setters>
       <Setter Target="Surface.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}"/>
       <Setter Target="Label.Foreground" Value="{ThemeResource Novel.Discovery.SelectedText}"/>
      </VisualState.Setters></VisualState>
      <VisualState x:Name="Indeterminate"/>
     </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
     Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Novel.Discovery.Source" TargetType="ComboBox" BasedOn="{StaticResource MeowFilm.ComboBox}">
  <Setter Property="MinHeight" Value="32"/><Setter Property="Height" Value="32"/>
  <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Caption}"/><Setter Property="Padding" Value="10,4"/>
 </Style>
 <Style x:Key="Novel.Discovery.Surface" TargetType="Border">
  <Setter Property="CornerRadius" Value="8"/>
  <Setter Property="Background" Value="{ThemeResource MeowFilm.Brush.InputSurface}"/>
  <Setter Property="BorderBrush" Value="{ThemeResource Novel.Discovery.SurfaceBorder}"/>
  <Setter Property="BorderThickness" Value="{ThemeResource Novel.Discovery.SurfaceBorderThickness}"/>
 </Style>
 <Style x:Key="Novel.Discovery.Feature" TargetType="Border" BasedOn="{StaticResource Novel.Discovery.Surface}">
  <Setter Property="Background" Value="{ThemeResource MeowFilm.Brush.ItemHover}"/>
 </Style>
 <Style x:Key="Novel.Input" TargetType="TextBox" BasedOn="{StaticResource MeowFilm.TextBox}">
  <Setter Property="Background" Value="{ThemeResource MeowFilm.Brush.InputSurface}"/>
 </Style>
 <Style x:Key="Novel.Row" TargetType="Border">
  <Setter Property="BorderBrush" Value="{ThemeResource MeowFilm.Brush.Border}"/>
  <Setter Property="BorderThickness" Value="0,0,0,1"/>
  <Setter Property="Padding" Value="0,0,0,12"/>
  <Setter Property="Margin" Value="0,0,0,12"/>
 </Style>
</ResourceDictionary>
