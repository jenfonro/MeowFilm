<UserControl x:Class="MeowFilm.Capabilities.NovelRuleEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="using:MeowFilm.Desktop">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <desktop:WrapPanel>
   <Button Content="复制规则" Style="{StaticResource MeowFilm.QuietButton}" Margin="0,0,10,8" Padding="12,7"
           AutomationProperties.Name="复制规则" Click="Copy_Click"/>
   <Button Content="粘贴规则" Style="{StaticResource MeowFilm.QuietButton}" Margin="0,0,10,8" Padding="12,7"
           AutomationProperties.Name="粘贴规则" Click="Paste_Click"/>
  </desktop:WrapPanel>
  <ContentControl x:Name="FormHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </Grid>
</UserControl>
