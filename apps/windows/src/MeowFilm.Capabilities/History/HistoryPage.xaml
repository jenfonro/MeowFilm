<UserControl x:Class="MeowFilm.Capabilities.HistoryPageView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 xmlns:desktop="using:MeowFilm.Desktop"
 Background="Transparent"
 UseLayoutRounding="True">
 <Grid Background="Transparent">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="40,12,40,4">
   <ItemsControl ItemsSource="{x:Bind Page.Tabs}">
    <ItemsControl.ItemsPanel>
     <ItemsPanelTemplate>
      <StackPanel Orientation="Horizontal"/>
     </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate x:DataType="local:HistoryTab">
      <Grid Margin="0,0,28,0">
       <RadioButton GroupName="HistoryDomainTabs" Content="{x:Bind Label}" Tag="{x:Bind Id}" IsChecked="{x:Bind Selected, Mode=OneWay}" Style="{StaticResource Capability.UnderlineTab}" FontSize="16" AutomationProperties.Name="{x:Bind AccessibleName}" Click="Tab_Click"/>
       <Border Width="20" Height="3" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False" Background="{ThemeResource MeowFilm.Brush.Accent}" Visibility="{x:Bind Selected, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}"/>
      </Grid>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <desktop:NoticeOutlet x:Name="Notices"/>
  </StackPanel>
  <ContentControl x:Name="FilmBrowseHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{x:Bind Page.IsFilmSelected, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}"/>
  <ContentControl x:Name="NovelBrowseHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{x:Bind Page.IsNovelSelected, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}"/>
 </Grid>
</UserControl>
