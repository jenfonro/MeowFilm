<UserControl x:Class="MeowFilm.Capabilities.SettingsPriorityList"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 xmlns:desktop="using:MeowFilm.Desktop"
 x:Name="Root" IsTabStop="True">
 <StackPanel>
  <TextBlock Text="{Binding Title,ElementName=Root}" FontSize="14" Margin="0,0,0,12"
             Visibility="{Binding ShowTitle,ElementName=Root,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
  <Border x:Name="ListSurface" Style="{StaticResource Settings.ListSurface}">
   <Grid>
    <ListView x:Name="PriorityItems" Style="{StaticResource Settings.List}" ItemContainerStyle="{StaticResource Settings.ListItem}"
              ItemsSource="{Binding ItemsSource,ElementName=Root}" IsEnabled="{Binding CanEdit,ElementName=Root}"
              AutomationProperties.Name="{Binding Title,ElementName=Root}">
     <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
     <ListView.ItemTemplate><DataTemplate>
      <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource MeowFilm.Brush.Border}"><Grid Height="50">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
       <Thumb Grid.Column="3" Style="{StaticResource Settings.Grip}" DragStarted="Grip_Started" DragDelta="Grip_Delta" DragCompleted="Grip_Completed"
              KeyDown="Grip_KeyDown" AutomationProperties.Name="{Binding Label}"/>
       <Image Grid.Column="0" Source="{Binding Platform,Converter={StaticResource Settings.PlatformLogo}}" Width="22" Height="22" Margin="0,0,10,0"
              Visibility="{Binding ShowLogos,ElementName=Root,Converter={StaticResource MeowFilm.BoolToVisibility}}" AutomationProperties.Name="{Binding Label}"/>
       <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       <CheckBox Grid.Column="2" Style="{StaticResource Settings.Switch}" Margin="8,0" Tag="{Binding}" Click="Enabled_Click"
                 IsChecked="{Binding Enabled,Mode=OneWay}" Visibility="{Binding ShowToggle,ElementName=Root,Converter={StaticResource MeowFilm.BoolToVisibility}}"
                 AutomationProperties.Name="{Binding Label}"/>
      </Grid></Border>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <Canvas x:Name="DragOverlay" IsHitTestVisible="False"/>
   </Grid>
  </Border>
 </StackPanel>
</UserControl>
