<UserControl x:Class="MeowFilm.Capabilities.SettingsPriorityList"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 x:Name="Root" Focusable="True" IsTabStop="False">
 <UserControl.CommandBindings>
  <CommandBinding Command="ComponentCommands.MoveUp" CanExecute="Move_CanExecute" Executed="Move_Executed"/>
  <CommandBinding Command="ComponentCommands.MoveDown" CanExecute="Move_CanExecute" Executed="Move_Executed"/>
 </UserControl.CommandBindings>
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Settings/SettingsTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <StackPanel>
  <TextBlock Text="{Binding Title,ElementName=Root}" FontSize="{StaticResource MeowFilm.Font.Size.Body}" Margin="0,0,0,12"
             Visibility="{Binding ShowTitle,ElementName=Root,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
  <Border x:Name="ListSurface" Style="{StaticResource Settings.ListSurface}">
   <AdornerDecorator>
     <ListBox x:Name="PriorityItems" Style="{StaticResource Settings.List}" ItemContainerStyle="{StaticResource Settings.ListItem}"
              ItemsSource="{Binding ItemsSource,ElementName=Root}" IsEnabled="{Binding CanEdit,ElementName=Root}"
              AutomationProperties.Name="{Binding Title,ElementName=Root}">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Grid Height="50">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/>
         </Grid.ColumnDefinitions>
         <Thumb Grid.Column="3" Style="{StaticResource Settings.Grip}" DragStarted="Grip_Started" DragDelta="Grip_Delta" DragCompleted="Grip_Completed"
                PreviewKeyDown="Grip_KeyDown" AutomationProperties.Name="{Binding Label,StringFormat={}{0}排序}">
          <Thumb.InputBindings>
           <KeyBinding Key="Up" Modifiers="Alt" Command="ComponentCommands.MoveUp"/>
           <KeyBinding Key="Down" Modifiers="Alt" Command="ComponentCommands.MoveDown"/>
          </Thumb.InputBindings>
         </Thumb>
         <Image Grid.Column="0" Style="{StaticResource Settings.PlatformLogo}" Margin="0,0,10,0"
                Visibility="{Binding ShowLogos,ElementName=Root,Converter={StaticResource MeowFilm.BoolToVisibility}}"
                AutomationProperties.Name="{Binding Label,StringFormat={}{0}标志}"/>
         <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Settings.Text}">
           <Style.Triggers><DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
            <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
           </DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
         </TextBlock>
         <CheckBox Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"
                   Tag="{Binding}" Click="Enabled_Click" AutomationProperties.Name="{Binding Label,StringFormat={}{0}启用}">
          <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource Settings.Switch}">
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers><DataTrigger Binding="{Binding ShowToggle,ElementName=Root}" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="IsChecked" Value="{Binding Enabled,Mode=OneWay}"/>
           </DataTrigger></Style.Triggers>
          </Style></CheckBox.Style>
         </CheckBox>
        </Grid>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
   </AdornerDecorator>
  </Border>
 </StackPanel>
</UserControl>
