<UserControl x:Class="MeowFilm.Capabilities.MusicSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 FontFamily="{DynamicResource MeowFilm.Font.Body}" FontSize="14">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <Style TargetType="TabItem">
    <Setter Property="Padding" Value="0,6,0,4"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HeaderTemplate">
     <Setter.Value>
      <DataTemplate>
       <TextBlock Text="{Binding}"
                  Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/>
      </DataTemplate>
     </Setter.Value>
    </Setter>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="TabItem">
       <Grid Margin="0,0,20,0" HorizontalAlignment="Left">
        <Border x:Name="Underline" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
         <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
        </Border>
        <Border x:Name="KeyboardFocus" BorderBrush="Transparent" BorderThickness="0,2,0,0"
                IsHitTestVisible="False"/>
       </Grid>
       <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True">
         <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
         <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
         <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
         <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Hover}"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
         <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.AccentSoft}"/>
         <Setter TargetName="KeyboardFocus" Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Focus}"/>
        </Trigger>
        <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
         <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
         <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
        </Trigger>
        <MultiTrigger><MultiTrigger.Conditions>
         <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/>
         <Condition Property="IsSelected" Value="True"/>
        </MultiTrigger.Conditions>
         <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
         <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
         <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        </MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions>
         <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/>
         <Condition Property="IsMouseOver" Value="True"/>
        </MultiTrigger.Conditions>
         <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
         <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
        </MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions>
         <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/>
         <Condition Property="IsKeyboardFocused" Value="True"/>
        </MultiTrigger.Conditions>
         <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
         <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
         <Setter TargetName="KeyboardFocus" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        </MultiTrigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <Style x:Key="Settings.Card" TargetType="Border" BasedOn="{StaticResource MeowFilm.Surface}">
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="Margin" Value="0,0,0,18"/>
   </Style>
   <Style x:Key="Settings.List" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="SelectionMode" Value="Single"/>
   </Style>
   <Style TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="ListBoxItem">
       <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,9"
               Margin="0,2">
        <ContentPresenter/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
         <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Hover}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
         <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.AccentSoft}"/>
        </Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <TabControl Margin="30,0,26,20" Background="Transparent" BorderThickness="0"
             FocusVisualStyle="{x:Null}" AutomationProperties.Name="设置分类">
  <TabItem Header="平台">
   <ScrollViewer Style="{StaticResource Capability.OverlayScrollViewer}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="2,24,18,24" MaxWidth="980">
     <local:MusicAccountsView/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <TabItem Header="搜索">
   <ScrollViewer Style="{StaticResource Capability.OverlayScrollViewer}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="2,24,18,24" MaxWidth="900">
     <TextBlock Text="歌曲搜索" Style="{StaticResource MeowFilm.SectionHeading}"/>
     <Border Style="{StaticResource Settings.Card}">
      <StackPanel>
       <ComboBox Tag="songs" ItemsSource="{Binding SearchModes}" DisplayMemberPath="Name"
                 SelectedValuePath="Key" SelectedValue="{Binding SongSearch.Mode,Mode=OneWay}"
                 SelectionChanged="SearchMode_Changed" IsEnabled="{Binding CanEditSearchPreferences}"
                 AutomationProperties.Name="歌曲搜索模式"/>
       <ComboBox Tag="songs" Margin="0,12,0,0" ItemsSource="{Binding SearchPlatformChoices}"
                 DisplayMemberPath="Name" SelectedValuePath="Key"
                 SelectedValue="{Binding SongSearch.Platform,Mode=OneWay}"
                 SelectionChanged="SearchPlatform_Changed" IsEnabled="{Binding CanEditSearchPreferences}"
                 AutomationProperties.Name="歌曲单平台搜索">
        <ComboBox.Style>
         <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
          <Style.Triggers>
           <DataTrigger Binding="{Binding SongSearch.IsAggregate}" Value="True">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </ComboBox.Style>
       </ComboBox>
       <ListBox Tag="songs" ItemsSource="{Binding SongSearch.Platforms}"
                Margin="0,12,0,0" AllowDrop="True"
                IsEnabled="{Binding CanEditSearchPreferences}"
                PreviewMouseLeftButtonDown="SearchList_MouseDown"
                PreviewMouseMove="SearchList_MouseMove" Drop="SearchList_Drop">
        <ListBox.Style>
         <Style TargetType="ListBox" BasedOn="{StaticResource Settings.List}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding SongSearch.IsAggregate}" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </ListBox.Style>
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="≡" Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
           <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
           <CheckBox Grid.Column="2" Style="{StaticResource Capability.Switch}"
                     IsChecked="{Binding Enabled,Mode=OneWay}" Tag="{Binding}"
                     Click="SearchPlatformEnabled_Click"
                     AutomationProperties.Name="{Binding Label,StringFormat={}{0}歌曲搜索}"/>
          </Grid>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </Border>

     <TextBlock Text="歌单搜索" Style="{StaticResource MeowFilm.SectionHeading}"/>
     <Border Style="{StaticResource Settings.Card}">
      <StackPanel>
       <ComboBox Tag="playlists" ItemsSource="{Binding SearchModes}" DisplayMemberPath="Name"
                 SelectedValuePath="Key" SelectedValue="{Binding PlaylistSearch.Mode,Mode=OneWay}"
                 SelectionChanged="SearchMode_Changed" IsEnabled="{Binding CanEditSearchPreferences}"
                 AutomationProperties.Name="歌单搜索模式"/>
       <ComboBox Tag="playlists" Margin="0,12,0,0" ItemsSource="{Binding SearchPlatformChoices}"
                 DisplayMemberPath="Name" SelectedValuePath="Key"
                 SelectedValue="{Binding PlaylistSearch.Platform,Mode=OneWay}"
                 SelectionChanged="SearchPlatform_Changed" IsEnabled="{Binding CanEditSearchPreferences}"
                 AutomationProperties.Name="歌单单平台搜索">
        <ComboBox.Style>
         <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
          <Style.Triggers>
           <DataTrigger Binding="{Binding PlaylistSearch.IsAggregate}" Value="True">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </ComboBox.Style>
       </ComboBox>
       <ListBox Tag="playlists" ItemsSource="{Binding PlaylistSearch.Platforms}"
                Margin="0,12,0,0" AllowDrop="True"
                IsEnabled="{Binding CanEditSearchPreferences}"
                PreviewMouseLeftButtonDown="SearchList_MouseDown"
                PreviewMouseMove="SearchList_MouseMove" Drop="SearchList_Drop">
        <ListBox.Style>
         <Style TargetType="ListBox" BasedOn="{StaticResource Settings.List}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding PlaylistSearch.IsAggregate}" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </ListBox.Style>
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="≡" Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
           <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
           <CheckBox Grid.Column="2" Style="{StaticResource Capability.Switch}"
                     IsChecked="{Binding Enabled,Mode=OneWay}" Tag="{Binding}"
                     Click="SearchPlatformEnabled_Click"
                     AutomationProperties.Name="{Binding Label,StringFormat={}{0}歌单搜索}"/>
          </Grid>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </Border>
     <Button Content="清空搜索历史" Click="SearchHistoryClear_Click"
             IsEnabled="{Binding HasSearchHistory}" HorizontalAlignment="Left"/>
     <desktop:NoticeOutlet Message="{Binding SearchPreferenceStatus}"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <TabItem Header="音质与缓存">
   <ScrollViewer Style="{StaticResource Capability.OverlayScrollViewer}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="2,24,18,24" MaxWidth="900">
     <TextBlock Text="播放缓存" Style="{StaticResource MeowFilm.SectionHeading}"/>
     <Border Style="{StaticResource Settings.Card}">
      <Button Content="清空播放缓存" Click="ClearPlaybackCache_Click"
              IsEnabled="{Binding CanClearPlaybackCache}" HorizontalAlignment="Left"/>
     </Border>
     <TextBlock Text="播放音质" Style="{StaticResource MeowFilm.SectionHeading}"/>
     <Border Style="{StaticResource Settings.Card}">
      <StackPanel>
       <ComboBox ItemsSource="{Binding PlaybackQualityOptions}"
                 SelectedItem="{Binding PlaybackQualityRequest,Mode=OneWay}"
                 SelectionChanged="PlaybackQuality_Changed"
                 IsEnabled="{Binding CanEditQuality}" AutomationProperties.Name="播放请求音质"/>
       <ListBox Tag="quality" ItemsSource="{Binding QualityCategories}"
                Style="{StaticResource Settings.List}" Margin="0,12,0,0" AllowDrop="True"
                IsEnabled="{Binding CanEditQuality}" PreviewMouseLeftButtonDown="QualityList_MouseDown"
                PreviewMouseMove="QualityList_MouseMove" Drop="QualityList_Drop">
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="≡" Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
           <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
           <CheckBox Grid.Column="2" Style="{StaticResource Capability.Switch}"
                     IsChecked="{Binding Enabled,Mode=OneWay}" Tag="{Binding}"
                     Click="QualityEnabled_Click"/>
          </Grid>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </Border>
     <TextBlock Text="空间音频" Style="{StaticResource MeowFilm.SectionHeading}"/>
     <Border Style="{StaticResource Settings.Card}">
      <ListBox Tag="spatial" ItemsSource="{Binding SpatialQualities}"
               Style="{StaticResource Settings.List}" AllowDrop="True"
               IsEnabled="{Binding CanEditQuality}" PreviewMouseLeftButtonDown="QualityList_MouseDown"
               PreviewMouseMove="QualityList_MouseMove" Drop="QualityList_Drop">
       <ListBox.ItemTemplate>
        <DataTemplate>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="≡" Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
          <CheckBox Grid.Column="2" Style="{StaticResource Capability.Switch}"
                    IsChecked="{Binding Enabled,Mode=OneWay}" Tag="{Binding}"
                    Click="QualityEnabled_Click"/>
         </Grid>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </Border>
     <desktop:NoticeOutlet Message="{Binding QualityStatus}"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <TabItem Header="外观">
   <ScrollViewer Style="{StaticResource Capability.OverlayScrollViewer}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="2,24,18,24" MaxWidth="900">
     <Border Style="{StaticResource Settings.Card}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="歌单样式" VerticalAlignment="Center" Margin="0,0,16,12"/>
       <ComboBox Grid.Column="1" Margin="0,0,0,12" Tag="playlistView"
                 ItemsSource="{Binding PlaylistViews}" DisplayMemberPath="Name" SelectedValuePath="Key"
                 SelectedValue="{Binding AppearancePlaylistView,Mode=OneWay}"
                 SelectionChanged="Appearance_Changed" IsEnabled="{Binding CanEditAppearance}"
                 AutomationProperties.Name="歌单样式"/>
       <TextBlock Grid.Row="1" Text="播放器配色" VerticalAlignment="Center" Margin="0,0,16,12"/>
       <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Tag="colorMode"
                 ItemsSource="{Binding ColorModes}" DisplayMemberPath="Name" SelectedValuePath="Key"
                 SelectedValue="{Binding AppearanceColorMode,Mode=OneWay}"
                 SelectionChanged="Appearance_Changed" IsEnabled="{Binding CanEditAppearance}"
                 AutomationProperties.Name="播放器配色"/>
       <TextBlock Grid.Row="2" Text="固定配色" VerticalAlignment="Center" Margin="0,0,16,0"/>
       <ComboBox Grid.Row="2" Grid.Column="1" Tag="colorPalette"
                 ItemsSource="{Binding ColorPalettes}" DisplayMemberPath="Name" SelectedValuePath="Key"
                 SelectedValue="{Binding AppearanceColorPalette,Mode=OneWay}"
                 SelectionChanged="Appearance_Changed"
                 AutomationProperties.Name="固定配色">
        <ComboBox.Style>
         <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
          <Setter Property="IsEnabled" Value="False"/>
          <Style.Triggers>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding CanEditAppearance}" Value="True"/>
             <Condition Binding="{Binding AppearanceColorMode}" Value="fixed"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="IsEnabled" Value="True"/>
           </MultiDataTrigger>
          </Style.Triggers>
         </Style>
        </ComboBox.Style>
       </ComboBox>
      </Grid>
     </Border>
     <desktop:NoticeOutlet Message="{Binding AppearanceStatus}"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <TabItem Header="歌词与封面">
   <ScrollViewer Style="{StaticResource Capability.OverlayScrollViewer}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="2,24,18,24" MaxWidth="900">
     <TextBlock Text="平台优先顺序" Style="{StaticResource MeowFilm.SectionHeading}"/>
     <Border Style="{StaticResource Settings.Card}">
      <ListBox ItemsSource="{Binding MetadataPlatforms}" Style="{StaticResource Settings.List}"
               AllowDrop="True" IsEnabled="{Binding CanEditMetadata}"
               PreviewMouseLeftButtonDown="MetadataList_MouseDown"
               PreviewMouseMove="MetadataList_MouseMove" Drop="MetadataList_Drop">
       <ListBox.ItemTemplate>
        <DataTemplate>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="≡" Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
          <CheckBox Grid.Column="2" Style="{StaticResource Capability.Switch}"
                    IsChecked="{Binding Enabled,Mode=OneWay}" Tag="{Binding}"
                    Click="MetadataEnabled_Click"/>
         </Grid>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </TabItem>
  <TabItem Header="音源">
   <local:MusicSourcesSettingsView/>
  </TabItem>
 </TabControl>
</UserControl>
