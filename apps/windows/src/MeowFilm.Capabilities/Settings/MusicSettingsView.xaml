<UserControl x:Class="MeowFilm.Capabilities.MusicSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 x:Name="Root" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="14"
 TextOptions.TextRenderingMode="Grayscale"
 SizeChanged="View_SizeChanged">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MeowFilm.Capabilities;component/Settings/SettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="Settings.Anchor" TargetType="RadioButton">
    <Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,32,0"/>
    <Setter Property="Height" Value="44"/><Setter Property="Foreground" Value="{DynamicResource Settings.Brush.Muted}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
     <Border x:Name="Underline" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="0,0,0,2">
      <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Settings.Brush.Text}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Settings.Brush.Accent}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Settings.Brush.Text}"/></Trigger>
      <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></MultiTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="Appearance.Field" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,16,0"/>
    <Style.Triggers><Trigger Property="local:SettingsLayout.IsNarrow" Value="True"><Setter Property="Margin" Value="0,0,0,16"/></Trigger></Style.Triggers>
   </Style>
   <DataTemplate x:Key="Quality.Name">
    <TextBlock>
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Settings.Text}">
      <Setter Property="Text" Value="{Binding}"/><Setter Property="FontSize" Value="13"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding}" Value="auto"><Setter Property="Text" Value="自动"/></DataTrigger>
       <DataTrigger Binding="{Binding}" Value="128k"><Setter Property="Text" Value="128 kbps"/></DataTrigger>
       <DataTrigger Binding="{Binding}" Value="192k"><Setter Property="Text" Value="192 kbps"/></DataTrigger>
       <DataTrigger Binding="{Binding}" Value="320k"><Setter Property="Text" Value="320 kbps"/></DataTrigger>
       <DataTrigger Binding="{Binding}" Value="flac"><Setter Property="Text" Value="无损"/></DataTrigger>
       <DataTrigger Binding="{Binding}" Value="flac24bit"><Setter Property="Text" Value="高解析度"/></DataTrigger>
       <DataTrigger Binding="{Binding}" Value="master"><Setter Property="Text" Value="母带"/></DataTrigger>
      </Style.Triggers>
     </Style></TextBlock.Style>
    </TextBlock>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <UserControl.Style>
  <Style TargetType="UserControl">
   <Setter Property="Background" Value="{DynamicResource Settings.Brush.Ground}"/>
   <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Style>
 <Grid x:Name="MusicContent" Margin="32,0,32,12">
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions>
  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Settings.Brush.Border}">
   <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden">
    <StackPanel x:Name="SettingsNavigation" Orientation="Horizontal" AutomationProperties.Name="设置分类">
     <RadioButton Content="账号与平台" Tag="AccountsSection" GroupName="SettingsSection" Style="{StaticResource Settings.Anchor}" IsChecked="True" Checked="Section_Checked" Click="Section_Checked" PreviewKeyDown="Anchor_KeyDown"/>
     <RadioButton Content="搜索" Tag="SearchSection" GroupName="SettingsSection" Style="{StaticResource Settings.Anchor}" Checked="Section_Checked" Click="Section_Checked" PreviewKeyDown="Anchor_KeyDown"/>
     <RadioButton Content="音质与缓存" Tag="QualitySection" GroupName="SettingsSection" Style="{StaticResource Settings.Anchor}" Checked="Section_Checked" Click="Section_Checked" PreviewKeyDown="Anchor_KeyDown"/>
     <RadioButton Content="外观" Tag="AppearanceSection" GroupName="SettingsSection" Style="{StaticResource Settings.Anchor}" Checked="Section_Checked" Click="Section_Checked" PreviewKeyDown="Anchor_KeyDown"/>
     <RadioButton Content="歌词与封面" Tag="MetadataSection" GroupName="SettingsSection" Style="{StaticResource Settings.Anchor}" Checked="Section_Checked" Click="Section_Checked" PreviewKeyDown="Anchor_KeyDown"/>
     <RadioButton Content="音源" Tag="sources" GroupName="SettingsSection" Style="{StaticResource Settings.Anchor}" Checked="Section_Checked" Click="Section_Checked" PreviewKeyDown="Anchor_KeyDown"/>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" Style="{StaticResource Capability.OverlayScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="Settings_ScrollChanged" PreviewMouseWheel="Settings_PreviewMouseWheel" AutomationProperties.Name="全部音乐设置">
   <StackPanel x:Name="SectionsStack" MaxWidth="1248" Margin="0,0,12,0" HorizontalAlignment="Left">
    <Border x:Name="AccountsSection" Style="{StaticResource Settings.Section}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Style="{StaticResource Settings.LabelColumn}"/><ColumnDefinition Style="{StaticResource Settings.GapColumn}"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="账号" Style="{StaticResource Settings.SectionLabel}"/>
      <local:MusicAccountsView x:Name="AccountsPanel" Style="{StaticResource Settings.SectionContent}"/>
     </Grid>
    </Border>
    <Border x:Name="SearchSection" Style="{StaticResource Settings.Section}">
     <StackPanel>
      <TextBlock Text="搜索" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,12"/>
       <Grid x:Name="SearchPanels" SizeChanged="Pair_SizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Style="{StaticResource Settings.PairGap}"/><ColumnDefinition Style="{StaticResource Settings.PairColumn}"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="SongSearchPanel">
         <TextBlock Text="歌曲搜索" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
         <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="搜索模式" VerticalAlignment="Center"/>
          <ComboBox Grid.Column="1" Tag="songs" Width="156" Style="{StaticResource Settings.ComboBox}" ItemsSource="{Binding SearchModes}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding SongSearch.Mode,Mode=OneWay}" SelectionChanged="SearchMode_Changed" IsEnabled="{Binding CanEditSearchPreferences}" AutomationProperties.Name="歌曲搜索模式"/>
         </Grid>
         <ComboBox Tag="songs" Margin="0,0,0,14" ItemsSource="{Binding SearchPlatformChoices}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding SongSearch.Platform,Mode=OneWay}" SelectionChanged="SearchPlatform_Changed" IsEnabled="{Binding CanEditSearchPreferences}" AutomationProperties.Name="歌曲单平台搜索">
          <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource Settings.ComboBox}"><Style.Triggers><DataTrigger Binding="{Binding SongSearch.IsAggregate}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
         </ComboBox>
         <local:SettingsPriorityList x:Name="SongPriorities" Title="平台优先顺序" Tag="songs" ShowLogos="True" ItemsSource="{Binding SongSearch.Platforms}" CanEdit="{Binding CanEditSearchPreferences}" MoveRequested="Priority_Move" ToggleRequested="Priority_Toggle"/>
        </StackPanel>
        <StackPanel x:Name="PlaylistSearchPanel" Style="{StaticResource Settings.PairRight}">
         <TextBlock Text="歌单搜索" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
         <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="搜索模式" VerticalAlignment="Center"/>
          <ComboBox Grid.Column="1" Tag="playlists" Width="156" Style="{StaticResource Settings.ComboBox}" ItemsSource="{Binding SearchModes}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding PlaylistSearch.Mode,Mode=OneWay}" SelectionChanged="SearchMode_Changed" IsEnabled="{Binding CanEditSearchPreferences}" AutomationProperties.Name="歌单搜索模式"/>
         </Grid>
         <ComboBox Tag="playlists" Margin="0,0,0,14" ItemsSource="{Binding SearchPlatformChoices}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding PlaylistSearch.Platform,Mode=OneWay}" SelectionChanged="SearchPlatform_Changed" IsEnabled="{Binding CanEditSearchPreferences}" AutomationProperties.Name="歌单单平台搜索">
          <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource Settings.ComboBox}"><Style.Triggers><DataTrigger Binding="{Binding PlaylistSearch.IsAggregate}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
         </ComboBox>
         <local:SettingsPriorityList x:Name="PlaylistPriorities" Title="平台优先顺序" Tag="playlists" ShowLogos="True" ItemsSource="{Binding PlaylistSearch.Platforms}" CanEdit="{Binding CanEditSearchPreferences}" MoveRequested="Priority_Move" ToggleRequested="Priority_Toggle"/>
        </StackPanel>
       </Grid>
       <Button Content="清空搜索历史" Click="SearchHistoryClear_Click" Style="{StaticResource Settings.Button}" IsEnabled="{Binding HasSearchHistory}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
       <desktop:NoticeOutlet Message="{Binding SearchPreferenceStatus}"/>
     </StackPanel>
    </Border>
    <Border x:Name="QualitySection" Style="{StaticResource Settings.Section}">
     <StackPanel>
      <TextBlock Text="播放音质" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,12"/>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <TextBlock Text="请求音质" VerticalAlignment="Center" Margin="0,0,22,0"/>
        <ComboBox Width="190" Style="{StaticResource Settings.ComboBox}" ItemsSource="{Binding PlaybackQualityOptions}" SelectedItem="{Binding PlaybackQualityRequest,Mode=OneWay}" ItemTemplate="{StaticResource Quality.Name}" SelectionChanged="PlaybackQuality_Changed" IsEnabled="{Binding CanEditQuality}" AutomationProperties.Name="播放请求音质"/>
       </StackPanel>
       <Grid x:Name="QualityPanels" SizeChanged="Pair_SizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Style="{StaticResource Settings.PairGap}"/><ColumnDefinition Style="{StaticResource Settings.PairColumn}"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <local:SettingsPriorityList x:Name="QualityPriorities" Title="音质优先顺序" Tag="quality" ItemsSource="{Binding QualityCategories}" CanEdit="{Binding CanEditQuality}" MoveRequested="Priority_Move" ToggleRequested="Priority_Toggle"/>
        <local:SettingsPriorityList x:Name="SpatialPriorities" Title="空间音频优先顺序" Tag="spatial" Style="{StaticResource Settings.PairRight}" ItemsSource="{Binding SpatialQualities}" CanEdit="{Binding CanEditQuality}" MoveRequested="Priority_Move" ToggleRequested="Priority_Toggle"/>
       </Grid>
       <desktop:NoticeOutlet Message="{Binding QualityStatus}"/>
     </StackPanel>
    </Border>
    <Border x:Name="CacheSection" Style="{StaticResource Settings.Section}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Style="{StaticResource Settings.LabelColumn}"/><ColumnDefinition Style="{StaticResource Settings.GapColumn}"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="播放缓存" Style="{StaticResource Settings.SectionLabel}"/>
      <StackPanel Style="{StaticResource Settings.SectionContent}">
       <Button Style="{StaticResource Settings.Button}" Content="清空播放缓存" Click="ClearPlaybackCache_Click" IsEnabled="{Binding CanClearPlaybackCache}" HorizontalAlignment="Left"/>
      </StackPanel>
     </Grid>
    </Border>
    <Border x:Name="AppearanceSection" Style="{StaticResource Settings.Section}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Style="{StaticResource Settings.LabelColumn}"/><ColumnDefinition Style="{StaticResource Settings.GapColumn}"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="外观" Style="{StaticResource Settings.SectionLabel}"/>
      <UniformGrid x:Name="AppearanceFields" Style="{StaticResource Settings.SectionContent}" Columns="3">
       <StackPanel Style="{StaticResource Appearance.Field}"><TextBlock Text="歌单样式" FontSize="13" Margin="0,0,0,10"/>
        <ComboBox Tag="playlistView" Style="{StaticResource Settings.ComboBox}" ItemsSource="{Binding PlaylistViews}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding AppearancePlaylistView,Mode=OneWay}" SelectionChanged="Appearance_Changed" IsEnabled="{Binding CanEditAppearance}" AutomationProperties.Name="歌单样式"/>
       </StackPanel>
       <StackPanel Style="{StaticResource Appearance.Field}"><TextBlock Text="播放器配色" FontSize="13" Margin="0,0,0,10"/>
        <ComboBox Tag="colorMode" Style="{StaticResource Settings.ComboBox}" ItemsSource="{Binding ColorModes}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding AppearanceColorMode,Mode=OneWay}" SelectionChanged="Appearance_Changed" IsEnabled="{Binding CanEditAppearance}" AutomationProperties.Name="播放器配色"/>
       </StackPanel>
       <StackPanel><TextBlock Text="固定配色" FontSize="13" Margin="0,0,0,10"/>
        <ComboBox Tag="colorPalette" ItemsSource="{Binding ColorPalettes}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding AppearanceColorPalette,Mode=OneWay}" SelectionChanged="Appearance_Changed" AutomationProperties.Name="固定配色">
         <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource Settings.ComboBox}"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CanEditAppearance}" Value="True"/><Condition Binding="{Binding AppearanceColorMode}" Value="fixed"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></ComboBox.Style>
        </ComboBox>
       </StackPanel>
      </UniformGrid>
      <desktop:NoticeOutlet Message="{Binding AppearanceStatus}"/>
     </Grid>
    </Border>
    <Border x:Name="MetadataSection" Style="{StaticResource Settings.Section}">
     <StackPanel>
      <TextBlock Text="歌词与封面" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,12"/>
      <Grid x:Name="MetadataPanels" SizeChanged="Pair_SizeChanged">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Style="{StaticResource Settings.PairGap}"/><ColumnDefinition Style="{StaticResource Settings.PairColumn}"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <local:SettingsPriorityList x:Name="MetadataPriorities" Title="歌词平台优先顺序" Tag="metadata" ShowLogos="True" ItemsSource="{Binding MetadataPlatforms}" CanEdit="{Binding CanEditMetadata}" MoveRequested="Priority_Move" ToggleRequested="Priority_Toggle"/>
       <local:SettingsPriorityList x:Name="ArtworkPriorities" Title="封面平台优先顺序" Tag="metadata" Style="{StaticResource Settings.PairRight}" ShowLogos="True" ItemsSource="{Binding MetadataPlatforms}" CanEdit="{Binding CanEditMetadata}" MoveRequested="Priority_Move" ToggleRequested="Priority_Toggle"/>
      </Grid>
     </StackPanel>
    </Border>
    <Border x:Name="EndSpace" Height="0"/>
   </StackPanel>
  </ScrollViewer>
  <local:MusicSourcesSettingsView x:Name="SourcesPage" Grid.Row="1" Visibility="Collapsed"/>
 </Grid>
</UserControl>
