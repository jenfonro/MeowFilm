<UserControl x:Class="MeowFilm.Capabilities.MusicSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 x:Name="Root"
 UseLayoutRounding="True" SnapsToDevicePixels="True"
 SizeChanged="View_SizeChanged">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MeowFilm.Capabilities;component/Settings/SettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="Settings.Anchor" TargetType="RadioButton">
    <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Body}"/><Setter Property="Margin" Value="0,0,32,0"/>
    <Setter Property="Height" Value="44"/><Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
     <Border x:Name="Underline" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="0,0,0,2">
      <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/><Setter Property="FontWeight" Value="{StaticResource MeowFilm.Font.Weight.Strong}"/><Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Accent}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/></Trigger>
      <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></MultiTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <DataTemplate x:Key="Quality.Name">
    <TextBlock Foreground="{Binding (TextElement.Foreground),RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Settings.Text}">
      <Setter Property="Text" Value="{Binding}"/><Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Compact}"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding}" Value="auto"><Setter Property="Text" Value="自动"/></DataTrigger>
       <DataTrigger Binding="{Binding}" Value="128k"><Setter Property="Text" Value="128 kbps"/></DataTrigger>
       <DataTrigger Binding="{Binding}" Value="192k"><Setter Property="Text" Value="192 kbps"/></DataTrigger>
       <DataTrigger Binding="{Binding}" Value="320k"><Setter Property="Text" Value="320 kbps"/></DataTrigger>
       <DataTrigger Binding="{Binding}" Value="flac"><Setter Property="Text" Value="无损"/></DataTrigger>
       <DataTrigger Binding="{Binding}" Value="flac24bit"><Setter Property="Text" Value="高解析度"/></DataTrigger>
       <DataTrigger Binding="{Binding}" Value="master"><Setter Property="Text" Value="母带"/></DataTrigger>
      </Style.Triggers>
     </Style></TextBlock.Style>
    </TextBlock>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <UserControl.Style>
  <Style TargetType="UserControl">
   <Setter Property="Background" Value="{DynamicResource Settings.Brush.Ground}"/>
   <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Style>
 <Grid x:Name="MusicContent" Margin="32,0,32,12">
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions>
  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MeowFilm.Brush.Border}">
   <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden">
    <StackPanel x:Name="SettingsNavigation" Orientation="Horizontal" AutomationProperties.Name="设置分类">
     <RadioButton Content="账号与平台" Tag="AccountsSection" GroupName="SettingsSection" Style="{StaticResource Settings.Anchor}" IsChecked="True" Checked="Section_Checked" Click="Section_Checked" PreviewKeyDown="Anchor_KeyDown"/>
     <RadioButton Content="搜索" Tag="SearchSection" GroupName="SettingsSection" Style="{StaticResource Settings.Anchor}" Checked="Section_Checked" Click="Section_Checked" PreviewKeyDown="Anchor_KeyDown"/>
     <RadioButton Content="音质" Tag="QualitySection" GroupName="SettingsSection" Style="{StaticResource Settings.Anchor}" Checked="Section_Checked" Click="Section_Checked" PreviewKeyDown="Anchor_KeyDown"/>
     <RadioButton Content="歌词与封面" Tag="MetadataSection" GroupName="SettingsSection" Style="{StaticResource Settings.Anchor}" Checked="Section_Checked" Click="Section_Checked" PreviewKeyDown="Anchor_KeyDown"/>
     <RadioButton Content="音源" Tag="sources" GroupName="SettingsSection" Style="{StaticResource Settings.Anchor}" Checked="Section_Checked" Click="Section_Checked" PreviewKeyDown="Anchor_KeyDown"/>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" Style="{StaticResource MeowFilm.SettingsScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="Settings_ScrollChanged" PreviewMouseWheel="Settings_PreviewMouseWheel" AutomationProperties.Name="全部音乐设置">
   <StackPanel x:Name="SectionsStack" MaxWidth="1248" Margin="0,0,12,0" HorizontalAlignment="Left">
    <Border x:Name="AccountsSection" Style="{StaticResource Settings.Section}">
     <StackPanel>
      <Grid Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="账号" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center"/>
       <Button x:Name="AccountTransferButton" Grid.Column="1" Content="导入导出" Style="{StaticResource Settings.QuietButton}"
               IsEnabled="{Binding CanTransferAccounts}" Click="AccountTransfer_Click" AutomationProperties.Name="导入导出">
        <Button.ContextMenu><ContextMenu>
         <MenuItem Header="导入账号" Click="AccountImport_Click" AutomationProperties.Name="导入账号"/>
         <MenuItem Header="导出账号" Click="AccountExport_Click" AutomationProperties.Name="导出账号"/>
        </ContextMenu></Button.ContextMenu>
       </Button>
      </Grid>
      <local:MusicAccountsView x:Name="AccountsPanel"/>
     </StackPanel>
    </Border>
    <Border x:Name="SearchSection" Style="{StaticResource Settings.Section}">
     <StackPanel>
      <TextBlock Text="搜索" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,8"/>
       <Grid x:Name="SearchPanels" local:SettingsLayout.Mode="Pair">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Style="{StaticResource Settings.PairGap}"/><ColumnDefinition Style="{StaticResource Settings.PairColumn}"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="SongSearchPanel">
         <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="歌曲搜索" FontSize="15" FontWeight="{StaticResource MeowFilm.Font.Weight.Strong}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="高级设置" Tag="songs" Click="SearchAdvanced_Click" Style="{StaticResource Settings.QuietButton}" IsEnabled="{Binding CanEditSearchPreferences}" AutomationProperties.Name="歌曲搜索高级设置"/>
         </Grid>
         <local:SettingsPriorityList x:Name="SongPriorities" Title="平台优先顺序" Tag="songs" ShowLogos="True" ItemsSource="{Binding SongSearch.Platforms}" CanEdit="{Binding CanEditSearchPreferences}" MoveRequested="Priority_Move" ToggleRequested="Priority_Toggle"/>
        </StackPanel>
        <StackPanel x:Name="PlaylistSearchPanel" Style="{StaticResource Settings.PairRight}">
         <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="歌单搜索" FontSize="15" FontWeight="{StaticResource MeowFilm.Font.Weight.Strong}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="高级设置" Tag="playlists" Click="SearchAdvanced_Click" Style="{StaticResource Settings.QuietButton}" IsEnabled="{Binding CanEditSearchPreferences}" AutomationProperties.Name="歌单搜索高级设置"/>
         </Grid>
         <local:SettingsPriorityList x:Name="PlaylistPriorities" Title="平台优先顺序" Tag="playlists" ShowLogos="True" ItemsSource="{Binding PlaylistSearch.Platforms}" CanEdit="{Binding CanEditSearchPreferences}" MoveRequested="Priority_Move" ToggleRequested="Priority_Toggle"/>
        </StackPanel>
       </Grid>
       <Button Content="清空搜索历史" Click="SearchHistoryClear_Click" Style="{StaticResource Settings.Button}" IsEnabled="{Binding HasSearchHistory}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
       <desktop:NoticeOutlet Message="{Binding SearchPreferenceStatus}"/>
     </StackPanel>
    </Border>
    <Border x:Name="QualitySection" Style="{StaticResource Settings.Section}">
     <StackPanel>
      <TextBlock Text="播放音质" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,8"/>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <TextBlock Text="起播目标音质" VerticalAlignment="Center" Margin="0,0,22,0"/>
        <ComboBox Width="190" Style="{StaticResource Settings.ComboBox}" ItemsSource="{Binding PlaybackQualityOptions}" SelectedItem="{Binding PlaybackQualityRequest,Mode=OneWay}" ItemTemplate="{StaticResource Quality.Name}" SelectionChanged="PlaybackQuality_Changed" IsEnabled="{Binding CanEditQuality}" AutomationProperties.Name="起播目标音质"/>
       </StackPanel>
       <Grid x:Name="QualityPanels" local:SettingsLayout.Mode="Pair">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Style="{StaticResource Settings.PairGap}"/><ColumnDefinition Style="{StaticResource Settings.PairColumn}"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <local:SettingsPriorityList x:Name="QualityPriorities" Title="音质优先顺序" Tag="quality" ItemsSource="{Binding QualityCategories}" CanEdit="{Binding CanEditQuality}" MoveRequested="Priority_Move" ToggleRequested="Priority_Toggle"/>
        <local:SettingsPriorityList x:Name="SpatialPriorities" Title="空间音频优先顺序" Tag="spatial" Style="{StaticResource Settings.PairRight}" ItemsSource="{Binding SpatialQualities}" CanEdit="{Binding CanEditQuality}" MoveRequested="Priority_Move" ToggleRequested="Priority_Toggle"/>
       </Grid>
       <desktop:NoticeOutlet Message="{Binding QualityStatus}"/>
     </StackPanel>
    </Border>
    <Border x:Name="ExclusionSection" Style="{StaticResource Settings.Section}">
     <StackPanel>
      <Grid Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="错源管理" Style="{StaticResource Settings.SectionTitle}" VerticalAlignment="Center"/>
       <Button x:Name="ExclusionAddButton" Grid.Column="1" Content="添加" Style="{StaticResource Settings.Button}" Click="ExclusionAdd_Click"
               IsEnabled="{Binding CanEdit}" AutomationProperties.Name="添加错源记录"/>
      </Grid>
      <Border Style="{StaticResource Settings.ListSurface}">
       <Grid Height="264">
       <ItemsControl x:Name="ExclusionList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemsSource="{Binding SourceExclusions}" AutomationProperties.Name="错源记录">
        <ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding HasSourceExclusions}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.Template><ControlTemplate TargetType="ItemsControl">
         <ScrollViewer Style="{StaticResource MeowFilm.SettingsScrollViewer}" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
        </ControlTemplate></ItemsControl.Template>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Style="{StaticResource Settings.RowDivider}"><Grid Height="44" Margin="8,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding SongText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="1" Text="{Binding ProviderName}" Style="{StaticResource Settings.Subtitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="2" Text="{Binding PlatformName}" Style="{StaticResource Settings.Subtitle}" VerticalAlignment="Center"/>
          <Button Grid.Column="3" Content="恢复" Style="{StaticResource Settings.QuietButton}" Click="ExclusionRestore_Click" Tag="{Binding}"
                  IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  AutomationProperties.Name="{Binding SongText,StringFormat='恢复{0}的音源'}"/>
         </Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <TextBlock Text="暂无错源记录" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Settings.Subtitle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSourceExclusions}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       </Grid>
      </Border>
     </StackPanel>
    </Border>
    <Border x:Name="MetadataSection" Style="{StaticResource Settings.Section}">
     <StackPanel>
      <TextBlock Text="歌词与封面" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,8"/>
      <Grid x:Name="MetadataPanels" local:SettingsLayout.Mode="Pair">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Style="{StaticResource Settings.PairGap}"/><ColumnDefinition Style="{StaticResource Settings.PairColumn}"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <local:SettingsPriorityList x:Name="MetadataPriorities" Title="歌词平台优先顺序" Tag="metadata" ShowLogos="True" ItemsSource="{Binding MetadataPlatforms}" CanEdit="{Binding CanEditMetadata}" MoveRequested="Priority_Move" ToggleRequested="Priority_Toggle"/>
       <local:SettingsPriorityList x:Name="ArtworkPriorities" Title="封面平台优先顺序" Tag="metadata" Style="{StaticResource Settings.PairRight}" ShowLogos="True" ItemsSource="{Binding MetadataPlatforms}" CanEdit="{Binding CanEditMetadata}" MoveRequested="Priority_Move" ToggleRequested="Priority_Toggle"/>
      </Grid>
     </StackPanel>
    </Border>
    <Border x:Name="EndSpace" Height="0"/>
   </StackPanel>
  </ScrollViewer>
  <local:MusicSourcesSettingsView x:Name="SourcesPage" Grid.Row="1" Visibility="Collapsed"/>
  <Popup x:Name="ExclusionPopup" PlacementTarget="{Binding ElementName=ExclusionAddButton}" desktop:DialogPlacement.Centered="True" StaysOpen="False" AllowsTransparency="True">
   <Border Style="{StaticResource Settings.PopupSurface}" CornerRadius="8" Padding="16" Width="360" KeyboardNavigation.TabNavigation="Cycle">
    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity=".13"/></Border.Effect>
    <StackPanel>
     <TextBlock Text="添加错源" Style="{StaticResource Settings.PopupTitle}" Margin="0,0,0,12"/>
     <TextBlock Text="歌曲" Style="{StaticResource Settings.Subtitle}" Margin="0,0,0,6"/>
     <ComboBox x:Name="ExclusionSong" Style="{StaticResource Settings.ComboBox}" ItemsSource="{Binding ExclusionSongs}" AutomationProperties.Name="歌曲">
      <ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis" Foreground="{Binding (TextElement.Foreground),RelativeSource={RelativeSource AncestorType=ContentPresenter}}"><Run Text="{Binding Name,Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Detail,Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <TextBlock Text="音源" Style="{StaticResource Settings.Subtitle}" Margin="0,12,0,6"/>
     <ComboBox x:Name="ExclusionProvider" Style="{StaticResource Settings.ComboBox}" ItemsSource="{Binding ExclusionProviders}" DisplayMemberPath="Name" AutomationProperties.Name="音源"/>
     <TextBlock Text="平台" Style="{StaticResource Settings.Subtitle}" Margin="0,12,0,6"/>
     <ComboBox x:Name="ExclusionPlatform" Style="{StaticResource Settings.ComboBox}" ItemsSource="{Binding ExclusionPlatforms}" DisplayMemberPath="Name" AutomationProperties.Name="平台"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="取消" Style="{StaticResource Settings.Button32}" Click="ExclusionCancel_Click" Margin="0,0,8,0"/>
      <Button Content="添加" Style="{StaticResource Settings.PrimaryButton}" Click="ExclusionConfirm_Click"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Popup>
  <Popup x:Name="SearchAdvancedPopup" desktop:DialogPlacement.Centered="True" StaysOpen="False" AllowsTransparency="True"
         Opened="SearchAdvancedPopup_Opened" Closed="SearchAdvancedPopup_Closed">
   <Grid Width="264" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="SearchAdvancedPopup_KeyDown">
    <Border x:Name="SearchAdvancedSurface" Style="{StaticResource Settings.PopupSurface}" CornerRadius="8" Padding="16">
     <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity=".13"/></Border.Effect>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="单次请求页数" VerticalAlignment="Center"/>
      <TextBox x:Name="SearchPagesBox" Grid.Column="1" Style="{StaticResource Settings.TextBox}" Height="32" Padding="8,4" HorizontalContentAlignment="Right"
               MaxLength="10" LostKeyboardFocus="SearchAdvancedBox_LostFocus" AutomationProperties.Name="单次请求页数"/>
      <TextBlock Grid.Row="1" Text="平台并发数" VerticalAlignment="Center" Margin="0,10,0,0"/>
      <TextBox x:Name="SearchConcurrencyBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Settings.TextBox}" Height="32" Padding="8,4" Margin="0,10,0,0" HorizontalContentAlignment="Right"
               MaxLength="10" LostKeyboardFocus="SearchAdvancedBox_LostFocus" AutomationProperties.Name="平台并发数"/>
      <TextBlock Grid.Row="2" Text="缓存时长（分钟）" VerticalAlignment="Center" Margin="0,10,0,0"/>
      <TextBox x:Name="SearchCacheBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Settings.TextBox}" Height="32" Padding="8,4" Margin="0,10,0,0" HorizontalContentAlignment="Right"
               MaxLength="4" LostKeyboardFocus="SearchAdvancedBox_LostFocus" AutomationProperties.Name="缓存时长（分钟）"/>
     </Grid>
    </Border>
   </Grid>
  </Popup>
 </Grid>
</UserControl>
