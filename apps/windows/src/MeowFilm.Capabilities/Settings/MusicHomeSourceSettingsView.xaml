<UserControl x:Class="MeowFilm.Capabilities.MusicHomeSourceSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="/MeowFilm.Capabilities;component/Settings/SettingsTheme.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </UserControl.Resources>
 <Border x:Name="HomeSourceSection" Style="{StaticResource Settings.Section}">
  <StackPanel>
   <TextBlock Text="音乐数据源" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,8"/>
   <StackPanel Orientation="Horizontal">
    <ComboBox x:Name="CatalogSourcePicker" Width="190" Style="{StaticResource Settings.ComboBox}"
              ItemsSource="{Binding CatalogSourceChoices}" DisplayMemberPath="Name" SelectedValuePath="Key"
              SelectedValue="{Binding CatalogSourcePlatform,Mode=OneWay}" SelectionChanged="CatalogSource_Changed"
              IsEnabled="{Binding CanEditCatalogSource}" AutomationProperties.Name="音乐数据源"/>
    <Button x:Name="CatalogSourceRetry" Content="重试" Style="{StaticResource Settings.Button}" Margin="12,0,0,0"
            Visibility="{Binding HasCatalogSourceError,Converter={StaticResource MeowFilm.BoolToVisibility}}"
            IsEnabled="{Binding CanReadCatalogSource}" Click="CatalogSourceRetry_Click"/>
   </StackPanel>
   <desktop:NoticeOutlet Message="{Binding CatalogSourceStatus}"/>
  </StackPanel>
 </Border>
</UserControl>
