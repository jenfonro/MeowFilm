<UserControl x:Class="MeowFilm.Capabilities.MusicSourcesSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 Loaded="View_Loaded" Unloaded="View_Unloaded" SizeChanged="View_SizeChanged"
 IsVisibleChanged="View_IsVisibleChanged" DataContextChanged="View_DataContextChanged"
 PreviewKeyDown="View_PreviewKeyDown"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="14"
 TextOptions.TextRenderingMode="Grayscale"
 Foreground="{DynamicResource Settings.Brush.Text}" ClipToBounds="True">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Settings/SettingsTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="Source.Brush.CurrentText" Color="#C62B47"/>
   <Style TargetType="TextBlock" BasedOn="{StaticResource Settings.Text}"/>
   <Style x:Key="Source.Muted" TargetType="TextBlock" BasedOn="{StaticResource Settings.Subtitle}">
    <Setter Property="Foreground" Value="{DynamicResource Settings.Brush.Muted}"/>
   </Style>
   <Style x:Key="Source.Quiet" TargetType="Button" BasedOn="{StaticResource Settings.QuietButton}"/>
   <Style x:Key="Source.Current" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Settings.Brush.PaleAccent}"/>
    <Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="8,3"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Source.CurrentText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Source.Brush.CurrentText}"/>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
    </Trigger></Style.Triggers>
   </Style>
   <Style x:Key="Source.Platforms" TargetType="ItemsControl">
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
     <TextBlock Text="{Binding}" Style="{StaticResource Source.Muted}" FontSize="13" Margin="0,0,8,0" LineHeight="18"/>
    </DataTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="Source.Row" TargetType="Border">
    <Setter Property="Height" Value="76"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsNarrow,RelativeSource={RelativeSource AncestorType=local:MusicSourcesSettingsView}}" Value="True">
      <Setter Property="Height" Value="84"/>
     </DataTrigger>
     <DataTrigger Binding="{Binding IsSelected}" Value="True">
      <Setter Property="Background" Value="{DynamicResource Settings.Brush.Selected}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Settings.Brush.SelectedBorder}"/>
      <Setter Property="CornerRadius" Value="6"/>
     </DataTrigger>
     <DataTrigger Binding="{Binding IsDragging}" Value="True">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
     </DataTrigger>
     <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
     </Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Source.List" TargetType="ItemsControl">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    <Setter Property="VirtualizingPanel.CacheLength" Value="1,1"/>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ItemsControl">
     <ScrollViewer x:Name="ItemsScroll" CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0">
      <ItemsPresenter/>
     </ScrollViewer>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="Source.SelectAll" TargetType="CheckBox" BasedOn="{StaticResource Settings.CheckBox}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
     <Grid Background="Transparent">
      <Border x:Name="Box" Width="16" Height="16" Background="White" BorderBrush="#B7BCC7" BorderThickness="1" CornerRadius="3"/>
      <Path x:Name="Check" Data="M 1,4 L 4,7 L 10,0" Width="11" Height="8" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/>
      <Path x:Name="Mixed" Data="M 0,0 L 8,0" Width="8" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Box" Property="Background" Value="{DynamicResource Settings.Brush.Text}"/>
       <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Settings.Brush.Text}"/>
       <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="{x:Null}">
       <Setter TargetName="Box" Property="Background" Value="{DynamicResource Settings.Brush.Text}"/>
       <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Settings.Brush.Text}"/>
       <Setter TargetName="Mixed" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
       <Setter TargetName="Box" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
       <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
       <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
       <Setter TargetName="Mixed" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid x:Name="SourceLayout" MaxWidth="1248" ClipToBounds="True">
  <Grid.Style><Style TargetType="Grid">
   <Setter Property="Background" Value="{DynamicResource Settings.Brush.Ground}"/>
   <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></Trigger></Style.Triggers>
  </Style></Grid.Style>
  <Grid x:Name="ManagementContent" Margin="0,28,0,20">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="36"/><RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <Grid x:Name="ManagementTitleRow" Height="36" Margin="0,0,0,20">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="SourceTitle" Text="音源管理" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock Text="{Binding CustomCountText}" Style="{StaticResource Source.Muted}" Margin="14,0,0,0" VerticalAlignment="Center"/>
     <TextBlock Text="演示数据" Style="{StaticResource Source.Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button Content="导出" Style="{StaticResource Settings.Button32}" Click="Export_Click" AutomationProperties.Name="演示导出音源"/>
     <Button Content="导入音源" Style="{StaticResource Settings.PrimaryButton}" Click="Import_Click" IsEnabled="{Binding CanImport}"
             Margin="10,0,0,0" AutomationProperties.Name="导入演示音源"/>
    </StackPanel>
   </Grid>
   <Border x:Name="OfficialRow" Grid.Row="1" Height="64" CornerRadius="8" Padding="20,0"
           Style="{StaticResource Settings.PopupSurface}" Margin="0,0,0,24">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Path Width="16" Height="20" Stretch="Uniform" Stroke="{DynamicResource Settings.Brush.Muted}" StrokeThickness="1.4"
           Data="M 4,8 V 5 A 4,4 0 0 1 12,5 V 8 M 3,8 H 13 V 18 H 3 Z M 8,11 V 14" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="2" VerticalAlignment="Center">
      <TextBlock Text="官方音源" FontSize="14" FontWeight="Medium"/>
      <TextBlock Text="网易云   QQ   酷狗   酷我   咪咕" Style="{StaticResource Source.Muted}" FontSize="13" Margin="0,4,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
      <Border x:Name="OfficialCurrent" Margin="0,0,12,0">
       <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Source.Current}">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers><DataTrigger Binding="{Binding UsesOfficialSources}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
       </Border.Style>
       <TextBlock Text="当前使用" Style="{StaticResource Source.CurrentText}"/>
      </Border>
      <Button Content="切换" Style="{StaticResource Source.Quiet}" Click="Official_Click" AutomationProperties.Name="演示切换至官方音源"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid x:Name="SourceToolbar" Grid.Row="2" Margin="0,0,0,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding SelectedCountText}" Style="{StaticResource Source.Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <StackPanel Orientation="Horizontal">
      <Button x:Name="MoveUp" Content="↑ 上移" Style="{StaticResource Settings.Button32}" Click="MoveUp_Click" IsEnabled="{Binding CanMoveUp}"
              Padding="10,5" AutomationProperties.Name="演示音源上移"/>
      <Button x:Name="MoveDown" Content="↓ 下移" Style="{StaticResource Settings.Button32}" Click="MoveDown_Click" IsEnabled="{Binding CanMoveDown}"
              Padding="10,5" Margin="-1,0,0,0" AutomationProperties.Name="演示音源下移"/>
     </StackPanel>
     <Border x:Name="ToolbarRule" Width="1" Height="18" Background="{DynamicResource Settings.Brush.Border}" Margin="13,0"/>
     <Button Content="启用" Style="{StaticResource Source.Quiet}" Click="EnableSelected_Click" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="启用选中演示音源"/>
     <Button Content="停用" Style="{StaticResource Source.Quiet}" Click="DisableSelected_Click" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="停用选中演示音源"/>
     <Button Content="检测" Style="{StaticResource Source.Quiet}" Click="Detect_Click" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="检测选中演示音源"/>
    </StackPanel>
    <StackPanel x:Name="SourceFilters" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <ComboBox x:Name="PlatformFilter" Style="{StaticResource Settings.ComboBox}" Width="114" SelectedIndex="0"
               SelectionChanged="Filter_Changed" AutomationProperties.Name="音源支持平台筛选">
      <ComboBoxItem Content="全部平台"/><ComboBoxItem Content="网易云"/><ComboBoxItem Content="QQ"/>
      <ComboBoxItem Content="酷狗"/><ComboBoxItem Content="酷我"/><ComboBoxItem Content="咪咕"/>
     </ComboBox>
     <ComboBox x:Name="StateFilter" Style="{StaticResource Settings.ComboBox}" Width="114" SelectedIndex="0" Margin="12,0,0,0"
               SelectionChanged="Filter_Changed" AutomationProperties.Name="音源状态筛选">
      <ComboBoxItem Content="全部状态"/><ComboBoxItem Content="可用"/><ComboBoxItem Content="待加载"/>
      <ComboBoxItem Content="加载失败"/><ComboBoxItem Content="已停用"/>
     </ComboBox>
    </StackPanel>
   </Grid>
   <Grid x:Name="SourceHeader" Grid.Row="3" Margin="12,0" Height="36">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="40"/><ColumnDefinition Width="48"/>
     <ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width=".9*"/>
     <ColumnDefinition Width="94"/><ColumnDefinition Width="68"/><ColumnDefinition Width="112"/>
    </Grid.ColumnDefinitions>
    <CheckBox x:Name="SelectAll" Style="{StaticResource Source.SelectAll}" IsThreeState="True"
              IsChecked="{Binding AllVisibleSelected,Mode=OneWay}" Click="SelectAll_Click" IsEnabled="{Binding HasVisibleSources}"
              HorizontalAlignment="Center" AutomationProperties.Name="选择全部可见演示音源"/>
    <TextBlock Grid.Column="2" Text="音源名称" Style="{StaticResource Source.Muted}" Margin="4,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="AddressHeading" Grid.Column="3" Text="地址／文件" Style="{StaticResource Source.Muted}" Margin="4,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="PlatformHeading" Grid.Column="4" Text="支持平台" Style="{StaticResource Source.Muted}" Margin="4,0" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="5" Text="状态" Style="{StaticResource Source.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="6" Text="启用" Style="{StaticResource Source.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="7" Text="操作" Style="{StaticResource Source.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>
   <Border x:Name="SourceTableBody" Grid.Row="4" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top"
           Style="{StaticResource Settings.PopupSurface}">
    <AdornerDecorator x:Name="SourceAdornerHost">
     <ItemsControl x:Name="SourceList" Style="{StaticResource Source.List}" ItemsSource="{Binding VisibleSources}"
                   AutomationProperties.Name="演示自定义音源列表">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border x:Name="SourceRow" Style="{StaticResource Source.Row}" Loaded="SourceRow_Loaded">
         <Grid>
          <Grid x:Name="RowGrid" Margin="11,0">
           <Grid.Style><Style TargetType="Grid"><Style.Triggers>
            <DataTrigger Binding="{Binding IsDragging}" Value="True"><Setter Property="Opacity" Value="0"/></DataTrigger>
           </Style.Triggers></Style></Grid.Style>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/><ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width=".9*"/>
            <ColumnDefinition Width="94"/><ColumnDefinition Width="68"/><ColumnDefinition Width="112"/>
           </Grid.ColumnDefinitions>
           <CheckBox Style="{StaticResource Settings.CheckBox}" IsChecked="{Binding IsSelected,Mode=OneWay}" Click="SourceSelected_Click"
                     HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name,StringFormat='选择演示音源{0}'}"/>
           <Thumb Grid.Column="1" DragStarted="Grip_DragStarted" DragDelta="Grip_DragDelta"
                  DragCompleted="Grip_DragCompleted" LostMouseCapture="Grip_LostMouseCapture" PreviewKeyDown="Grip_PreviewKeyDown"
                  HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name,StringFormat='拖动演示音源{0}排序'}">
            <Thumb.Style><Style TargetType="Thumb" BasedOn="{StaticResource Settings.Grip}">
             <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource Settings.Brush.GripSelected}"/></DataTrigger></Style.Triggers>
            </Style></Thumb.Style>
           </Thumb>
           <StackPanel Grid.Column="2" Margin="4,0" VerticalAlignment="Center">
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" LineHeight="20"/>
             <Border Grid.Column="1" Margin="4,0,0,0">
              <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Source.Current}">
               <Setter Property="Visibility" Value="Collapsed"/>
               <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style></Border.Style>
              <TextBlock Text="当前使用" Style="{StaticResource Source.CurrentText}"/>
             </Border>
            </Grid>
            <TextBlock Text="{Binding Metadata}" Style="{StaticResource Source.Muted}" LineHeight="18"/>
            <TextBlock x:Name="MobileAddress" Text="{Binding Address}" Style="{StaticResource Source.Muted}" FontSize="13"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Address}" LineHeight="18" Visibility="Collapsed"/>
            <ItemsControl x:Name="MobilePlatforms" ItemsSource="{Binding DisplayPlatforms}" Style="{StaticResource Source.Platforms}"
                          ToolTip="{Binding PlatformsText}" Visibility="Collapsed"/>
           </StackPanel>
           <TextBlock x:Name="RowAddress" Grid.Column="3" Text="{Binding Address}" Style="{StaticResource Source.Muted}" FontSize="13"
                      TextTrimming="CharacterEllipsis" ToolTip="{Binding Address}" VerticalAlignment="Center" Margin="4,0"/>
           <ItemsControl x:Name="RowPlatforms" Grid.Column="4" ItemsSource="{Binding DisplayPlatforms}" Style="{StaticResource Source.Platforms}"
                         ToolTip="{Binding PlatformsText}" VerticalAlignment="Center" Margin="4,0"/>
           <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding StateText}" FontSize="13" LineHeight="20" HorizontalAlignment="Center">
             <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Settings.Text}">
              <Setter Property="Foreground" Value="{DynamicResource Settings.Brush.Muted}"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding StateText}" Value="加载失败"><Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Error}"/></DataTrigger>
               <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></Trigger>
              </Style.Triggers>
             </Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Error}" FontSize="11" HorizontalAlignment="Center">
             <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Source.Muted}">
              <Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
             </Style></TextBlock.Style>
            </TextBlock>
           </StackPanel>
           <CheckBox Grid.Column="6" Style="{StaticResource Settings.Switch}" IsChecked="{Binding Enabled,Mode=OneWay}" Click="SourceEnabled_Click"
                     HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name,StringFormat='演示音源{0}启用状态'}"/>
           <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="编辑" Style="{StaticResource Source.Quiet}" Click="Edit_Click" Padding="8,5" AutomationProperties.Name="{Binding Name,StringFormat='编辑演示音源{0}'}"/>
            <Button Style="{StaticResource Source.Quiet}" Click="More_Click" Width="32" Padding="0" Margin="4,0,0,0"
                    AutomationProperties.Name="{Binding Name,StringFormat='演示音源{0}更多操作'}">
             <Path Data="M 2,8 A 1,1 0 1 1 4,8 A 1,1 0 1 1 2,8 M 7,8 A 1,1 0 1 1 9,8 A 1,1 0 1 1 7,8 M 12,8 A 1,1 0 1 1 14,8 A 1,1 0 1 1 12,8"
                   Width="16" Height="4" Stretch="Uniform" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
           </StackPanel>
          </Grid>
          <Border Height="1" Background="{DynamicResource Settings.Brush.Rule}" VerticalAlignment="Bottom" Margin="102,0,16,0">
           <Border.Style><Style TargetType="Border"><Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
           </Style.Triggers></Style></Border.Style>
          </Border>
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </AdornerDecorator>
   </Border>
  </Grid>
  <Grid x:Name="MenuLayer" Visibility="Collapsed" Background="Transparent" MouseDown="MenuLayer_MouseDown"
        KeyboardNavigation.TabNavigation="Cycle" Panel.ZIndex="1">
   <Border x:Name="SourceMenuSurface" Style="{StaticResource Settings.PopupSurface}" Width="168" HorizontalAlignment="Left"
           VerticalAlignment="Top" Padding="5"/>
  </Grid>
  <Grid x:Name="ModalLayer" Visibility="Collapsed" Background="#29262B38" MouseDown="ModalLayer_MouseDown"
        KeyboardNavigation.TabNavigation="Cycle" Panel.ZIndex="2">
   <Border x:Name="ModalSurface" Style="{StaticResource Settings.PopupSurface}" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ContentControl x:Name="ModalHeader" HorizontalContentAlignment="Stretch"/>
     <ScrollViewer x:Name="ModalScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ContentControl x:Name="ModalBody" HorizontalContentAlignment="Stretch"/>
     </ScrollViewer>
     <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Settings.Brush.Rule}" Padding="26,18">
      <StackPanel x:Name="ModalFooter" Orientation="Horizontal" HorizontalAlignment="Right"/>
     </Border>
    </Grid>
   </Border>
  </Grid>
  <desktop:NoticeOutlet Message="{Binding Status}"/>
 </Grid>
</UserControl>
