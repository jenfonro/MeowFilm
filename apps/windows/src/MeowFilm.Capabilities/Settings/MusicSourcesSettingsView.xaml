<UserControl x:Class="MeowFilm.Capabilities.MusicSourcesSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 Loaded="View_Loaded"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="14"
 TextOptions.TextRenderingMode="Grayscale">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <Style x:Key="Source.Card" TargetType="Border" BasedOn="{StaticResource MeowFilm.Surface}">
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="14"/>
   </Style>
   <Style x:Key="Source.List" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
   </Style>
   <Style x:Key="Source.ListItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="ListBoxItem">
       <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="12,10" Margin="0,2">
        <ContentPresenter/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
         <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Hover}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
         <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.AccentSoft}"/>
        </Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="2,24,18,24" MaxWidth="980">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding PlaybackTarget}" FontSize="15" FontWeight="SemiBold"
              VerticalAlignment="Center" AutomationProperties.Name="当前播放音源"/>
   <Button Grid.Column="1" Content="导入音源" Click="Import_Click"
           IsEnabled="{Binding CanEdit}" AutomationProperties.Name="导入 LX 音源"/>
  </Grid>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="360"/>
    <ColumnDefinition Width="16"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <Border Style="{StaticResource Source.Card}">
    <DockPanel>
     <Button DockPanel.Dock="Top" Click="Official_Click" Margin="0,0,0,8"
             AutomationProperties.Name="官方音源">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="官方音源" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="当前使用" Foreground="{DynamicResource MeowFilm.Brush.Accent}"
                  VerticalAlignment="Center">
        <TextBlock.Style>
         <Style TargetType="TextBlock" BasedOn="{StaticResource Capability.Text}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding UsesOfficialSources}" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
      </Grid>
     </Button>
     <ListBox x:Name="SourceList" ItemsSource="{Binding Sources}"
              SelectedItem="{Binding SelectedSource,Mode=OneWay}"
              SelectionChanged="SourceList_SelectionChanged"
              Style="{StaticResource Source.List}" AutomationProperties.Name="LX 音源列表">
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem" BasedOn="{StaticResource Source.ListItem}"/>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
           <TextBlock Text="{Binding Version}" Style="{StaticResource Capability.Muted}"/>
           <TextBlock Text=" · " Style="{StaticResource Capability.Muted}"/>
           <TextBlock Text="{Binding StateText}" Style="{StaticResource Capability.Muted}"/>
          </StackPanel>
         </StackPanel>
         <CheckBox Grid.Column="1" Style="{StaticResource Capability.Switch}" Margin="12,0,0,0"
                   IsChecked="{Binding Enabled,Mode=OneWay}" Tag="{Binding}"
                   IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Click="SourceEnabled_Click"
                   AutomationProperties.Name="{Binding Name,StringFormat={}{0}启用状态}"/>
        </Grid>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>

   <Border Grid.Column="2">
    <Border.Style>
     <Style TargetType="Border" BasedOn="{StaticResource Source.Card}">
      <Setter Property="Visibility" Value="Visible"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding HasSource}" Value="False">
        <Setter Property="Visibility" Value="Collapsed"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </Border.Style>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="4">
      <TextBlock Text="{Binding SelectedSource.Name}" FontSize="20" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis"/>
      <StackPanel Orientation="Horizontal" Margin="0,5,0,18">
       <TextBlock Text="{Binding SelectedSource.Version}" Style="{StaticResource Capability.Muted}"/>
       <TextBlock Text=" · " Style="{StaticResource Capability.Muted}"/>
       <TextBlock Text="{Binding SelectedSource.StateText}" Style="{StaticResource Capability.Muted}"/>
      </StackPanel>

      <TextBlock Text="支持平台" Style="{StaticResource MeowFilm.SectionHeading}"/>
      <ItemsControl ItemsSource="{Binding SourcePlatformRows}" Margin="0,0,0,14">
       <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
       </ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Button Content="{Binding Name}" Tag="{Binding Key}" Click="Platform_Click"
                 IsEnabled="{Binding DataContext.CanUseSelectedSource,RelativeSource={RelativeSource AncestorType=UserControl}}">
          <Button.Style>
           <Style TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Selected}" Value="True">
              <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
              <Setter Property="Foreground" Value="White"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </Button.Style>
         </Button>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>

      <WrapPanel Margin="0,0,0,8">
       <Button Content="加载" Tag="enable" Click="Action_Click" IsEnabled="{Binding CanLoadSource}"/>
       <Button Content="更新" Click="Update_Click" IsEnabled="{Binding CanEditSource}"/>
       <Button Content="回退" Tag="rollback" Click="Action_Click" IsEnabled="{Binding CanRollbackSource}"/>
       <Button Content="删除" Tag="remove" Click="Action_Click" IsEnabled="{Binding CanEditSource}"/>
      </WrapPanel>

      <Expander Header="{Binding SourceOriginCountText}" AutomationProperties.Name="网络权限">
       <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding SourceNetworkOrigins}" Margin="0,8,0,0">
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <TextBlock Text="{Binding}" Style="{StaticResource Capability.Muted}"
                      TextTrimming="CharacterEllipsis" Margin="0,3"/>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </ScrollViewer>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <desktop:NoticeOutlet Grid.Row="2" Grid.ColumnSpan="3" Message="{Binding Status}" Margin="0,14,0,0"/>
 </Grid>
</UserControl>
