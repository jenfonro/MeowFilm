<UserControl x:Class="MeowFilm.Capabilities.MusicSourcesSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 Loaded="View_Loaded" Unloaded="View_Unloaded" IsVisibleChanged="View_IsVisibleChanged"
 DataContextChanged="View_DataContextChanged" SizeChanged="View_SizeChanged"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="14"
 Foreground="{DynamicResource Settings.Brush.Text}" ClipToBounds="True">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Settings/SettingsTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <Style TargetType="TextBlock" BasedOn="{StaticResource Settings.Text}"/>
   <Style x:Key="Source.Muted" TargetType="TextBlock" BasedOn="{StaticResource Settings.Subtitle}"/>
   <Style x:Key="Source.Row" TargetType="Border">
    <Setter Property="Height" Value="76"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Settings.Brush.Rule}"/>
    <Setter Property="Padding" Value="14,0"/>
   </Style>
   <DataTemplate DataType="{x:Type local:MusicOfficialSourceRow}">
    <Border Style="{StaticResource Source.Row}">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="56"/><ColumnDefinition Width="80"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="内置" Style="{StaticResource Source.Muted}" Margin="0,4,0,0"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding StateText}" Style="{StaticResource Source.Muted}"
                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
      <CheckBox Grid.Column="2" Style="{StaticResource Settings.Switch}" IsChecked="{Binding Enabled,Mode=OneWay}"
                Click="OfficialSource_Click" HorizontalAlignment="Center"
                IsEnabled="{Binding DataContext.CanEditOfficialSources,RelativeSource={RelativeSource AncestorType=local:MusicSourcesSettingsView}}"
                AutomationProperties.Name="{Binding Name,StringFormat='启用{0}音源'}"/>
     </Grid>
    </Border>
   </DataTemplate>
   <DataTemplate DataType="{x:Type local:MusicSourceRow}">
    <Border Style="{StaticResource Source.Row}">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="56"/><ColumnDefinition Width="80"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
       <TextBlock Text="{Binding Metadata}" Style="{StaticResource Source.Muted}" Margin="0,4,0,0"
                  TextTrimming="CharacterEllipsis" ToolTip="{Binding Capabilities}"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding StateText}" Style="{StaticResource Source.Muted}"
                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
      <CheckBox Grid.Column="2" Style="{StaticResource Settings.Switch}" IsChecked="{Binding Enabled,Mode=OneWay}"
                Click="SourceEnabled_Click" HorizontalAlignment="Center"
                IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=local:MusicSourcesSettingsView}}"
                AutomationProperties.Name="{Binding Name,StringFormat='启用音源{0}'}"/>
      <Button Grid.Column="3" Content="更多" Style="{StaticResource Settings.QuietButton}" Click="More_Click"
              IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=local:MusicSourcesSettingsView}}"
              AutomationProperties.Name="{Binding Name,StringFormat='音源{0}更多操作'}"/>
     </Grid>
    </Border>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid x:Name="ManagementContent" MaxWidth="1248" Margin="28,24,28,20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <Grid x:Name="SourceTitleRow" Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="音源管理" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="刷新" Style="{StaticResource Settings.Button32}" Click="Refresh_Click"
           IsEnabled="{Binding CanEdit}" Margin="0,0,10,0"/>
   <Button Grid.Column="2" Content="导入音源" Style="{StaticResource Settings.PrimaryButton}" Click="ImportLocal_Click"
           IsEnabled="{Binding CanEdit}" AutomationProperties.Name="从本地文件导入音源"/>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,14">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <TextBlock Text="网络地址" Style="{StaticResource Source.Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <TextBox x:Name="NetworkAddress" Grid.Column="1" Style="{StaticResource Settings.TextBox}" Height="36"
            VerticalContentAlignment="Center" AutomationProperties.Name="HTTPS 音源脚本地址" IsEnabled="{Binding CanEdit}"/>
   <Button Grid.Column="2" Content="下载导入" Style="{StaticResource Settings.Button32}"
           Margin="10,0,0,0" Click="Download_Click" IsEnabled="{Binding CanEdit}"/>
   <Button Grid.Column="3" Content="取消" Style="{StaticResource Settings.Button32}"
           Margin="8,0,0,0" Click="Cancel_Click" IsEnabled="{Binding CanCancelOnline}"/>
  </Grid>
  <Grid Grid.Row="2" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding PlaybackTarget,StringFormat='当前使用：{0}'}" Style="{StaticResource Source.Muted}"
              VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <Button Grid.Column="1" Content="使用内置音源" Style="{StaticResource Settings.QuietButton}" Click="UseOfficial_Click"
           IsEnabled="{Binding CanEdit}"/>
  </Grid>
  <Grid Grid.Row="3" Height="36" Margin="14,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="56"/><ColumnDefinition Width="80"/>
   </Grid.ColumnDefinitions>
   <TextBlock Text="音源名称" Style="{StaticResource Source.Muted}" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="1" Text="状态" Style="{StaticResource Source.Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
   <TextBlock Grid.Column="2" Text="启用" Style="{StaticResource Source.Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
   <TextBlock Grid.Column="3" Text="操作" Style="{StaticResource Source.Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
  </Grid>
  <Border Grid.Row="4" ClipToBounds="True" Style="{StaticResource Settings.PopupSurface}">
   <ItemsControl x:Name="SourceList" AutomationProperties.Name="音源列表">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.Style><Style TargetType="ItemsControl">
     <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
     <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
     <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style></ItemsControl.Style>
    <ItemsControl.Template>
     <ControlTemplate TargetType="ItemsControl">
      <ScrollViewer x:Name="ItemsScroll" CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Focusable="False">
       <ItemsPresenter/>
      </ScrollViewer>
     </ControlTemplate>
    </ItemsControl.Template>
   </ItemsControl>
  </Border>
  <desktop:NoticeOutlet Message="{Binding Status}"/>
 </Grid>
</UserControl>
