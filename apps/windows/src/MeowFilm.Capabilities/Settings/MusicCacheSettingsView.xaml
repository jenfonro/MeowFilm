<UserControl x:Class="MeowFilm.Capabilities.MusicCacheSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="/MeowFilm.Capabilities;component/Settings/SettingsTheme.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </UserControl.Resources>
 <Border x:Name="CacheSection" Style="{StaticResource Settings.Section}">
  <StackPanel>
   <TextBlock Text="播放缓存" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,8"/>
   <Button Style="{StaticResource Settings.Button}" Content="清空播放缓存" Click="ClearPlaybackCache_Click"
           IsEnabled="{Binding CanClearPlaybackCache}" HorizontalAlignment="Left"/>
   <desktop:NoticeOutlet Message="{Binding Status}"/>
  </StackPanel>
 </Border>
</UserControl>
