<UserControl x:Class="MeowFilm.Capabilities.MusicHomeSourceSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="using:MeowFilm.Desktop"
 UseLayoutRounding="True">
 <Border x:Name="HomeSourceSection" Style="{StaticResource Settings.Section}">
  <StackPanel>
   <TextBlock Text="音乐数据源" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,8"/>
   <StackPanel Orientation="Horizontal">
    <ComboBox x:Name="CatalogSourcePicker" Width="190" Style="{StaticResource MeowFilm.SettingsComboBox}"
              ItemsSource="{x:Bind Settings.CatalogSourceChoices}" DisplayMemberPath="Name" SelectedValuePath="Key"
              SelectedValue="{x:Bind Settings.CatalogSourcePlatform,Mode=OneWay}" SelectionChanged="CatalogSource_Changed"
              IsEnabled="{x:Bind Settings.CanEditCatalogSource,Mode=OneWay}" AutomationProperties.Name="音乐数据源"/>
    <Button x:Name="CatalogSourceRetry" Content="重试" Style="{StaticResource Settings.Button}" Margin="12,0,0,0"
            Visibility="{x:Bind Settings.HasCatalogSourceError,Mode=OneWay,Converter={StaticResource MeowFilm.BoolToVisibility}}"
            IsEnabled="{x:Bind Settings.CanReadCatalogSource,Mode=OneWay}" Click="CatalogSourceRetry_Click"/>
   </StackPanel>
   <desktop:NoticeOutlet Message="{x:Bind Settings.CatalogSourceStatus,Mode=OneWay}"/>
  </StackPanel>
 </Border>
</UserControl>
