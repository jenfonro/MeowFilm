<UserControl x:Class="MeowFilm.Capabilities.PanAccountsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="14"
 Foreground="{DynamicResource MeowFilm.Brush.Text}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/AccountSettingsTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid x:Name="Root" Margin="0,12,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,8">
   <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsLoading,Converter={StaticResource MeowFilm.BoolToVisibility}}"
                AutomationProperties.Name="正在读取网盘账号"/>
   <Button Content="重试" Click="Reload_Click" HorizontalAlignment="Left" Style="{StaticResource Settings.Button}"
           Visibility="{Binding LoadFailed,Converter={StaticResource MeowFilm.BoolToVisibility}}"
           AutomationProperties.Name="重新读取网盘账号"/>
  </StackPanel>
  <ScrollViewer x:Name="TableScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                Style="{StaticResource MeowFilm.SettingsScrollViewer}" CanContentScroll="False"
                AutomationProperties.Name="网盘账号表">
   <Grid x:Name="AccountTable" MinWidth="448" Width="{Binding ViewportWidth,ElementName=TableScroll}" VerticalAlignment="Top">
    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="AccountTableHeader" Margin="7,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="192"/></Grid.ColumnDefinitions>
     <TextBlock Text="平台" Style="{StaticResource Account.Header}"/>
     <TextBlock Grid.Column="1" Text="状态" Style="{StaticResource Account.Header}"/>
     <TextBlock Grid.Column="2" Text="操作" Style="{StaticResource Account.Header}" HorizontalAlignment="Center"/>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Settings.ListSurface}">
     <ItemsControl x:Name="AccountRows" ItemsSource="{Binding Rows}" AlternationCount="2147483647">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Style="{StaticResource Account.Row}">
        <Grid x:Name="AccountCells">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="192"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Name}" Style="{StaticResource Settings.Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
         <Grid Grid.Column="1">
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource Settings.Subtitle}" VerticalAlignment="Center"
                     Visibility="{Binding HasSnapshot,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
          <ProgressBar Height="3" Width="48" IsIndeterminate="True" HorizontalAlignment="Left"
                       Visibility="{Binding IsBusy,Converter={StaticResource MeowFilm.BoolToVisibility}}"
                       VerticalAlignment="Bottom" Margin="0,0,0,14" AutomationProperties.Name="{Binding Name,StringFormat={}{0}正在处理}"/>
         </Grid>
         <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Content="{Binding LoginText}" Click="Login_Click"
                  IsEnabled="{Binding CanLogin}" AutomationProperties.Name="{Binding Name,StringFormat={}{0}登录}">
           <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Settings.PrimaryButton}">
            <Style.Triggers>
             <DataTrigger Binding="{Binding Status}" Value="signedIn"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
             <DataTrigger Binding="{Binding HasSnapshot}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
           </Style></Button.Style>
          </Button>
          <Button Content="刷新" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}"
                  AutomationProperties.Name="{Binding Name,StringFormat={}{0}刷新}">
           <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Settings.QuietButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="signedIn"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
           </Style></Button.Style>
          </Button>
          <Button Content="退出登录" Click="Logout_Click" Margin="8,0,0,0" IsEnabled="{Binding CanLogout}"
                  AutomationProperties.Name="{Binding Name,StringFormat={}{0}退出登录}">
           <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Settings.QuietButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Status}" Value="signedIn"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
             <DataTrigger Binding="{Binding Status}" Value="expired"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
           </Style></Button.Style>
          </Button>
         </StackPanel>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </Border>
   </Grid>
  </ScrollViewer>
  <desktop:NoticeOutlet Message="{Binding Notice}"/>
  <Popup x:Name="LoginPopup" PlacementTarget="{Binding ElementName=Root}" desktop:DialogPlacement.Centered="True"
         StaysOpen="False" AllowsTransparency="True" Opened="LoginPopup_Opened" Closed="LoginPopup_Closed" DataContext="{Binding}">
   <local:AccountLoginSurface x:Name="LoginSurface" Title="{Binding LoginTitle}"
          Style="{StaticResource Account.LoginSurface}" CloseRequested="CloseLogin_Click">
    <StackPanel>
     <Border x:Name="MethodBar" Background="{DynamicResource Settings.Brush.Active}" CornerRadius="6" Padding="2" Margin="0,0,0,16"
             Visibility="{Binding LoginRow.SupportsQr,Converter={StaticResource MeowFilm.BoolToVisibility}}">
      <UniformGrid Columns="2" IsEnabled="{Binding CanChangeMethod}">
       <Button x:Name="QrModeButton" Content="二维码登录" Style="{StaticResource Login.Segment}" Click="QrMode_Click"
               Tag="{Binding Visibility,ElementName=QrPanel}"/>
       <Button x:Name="ManualModeButton" Content="手动填写 Cookie" Style="{StaticResource Login.Segment}" Click="ManualMode_Click"
               Tag="{Binding Visibility,ElementName=ManualPanel}"/>
      </UniformGrid>
     </Border>
     <StackPanel x:Name="QrPanel" HorizontalAlignment="Center">
      <Border Style="{StaticResource Account.QrFrame}">
       <Grid>
        <Image Source="{Binding QrImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
               AutomationProperties.Name="{Binding QrAccessibleName}"/>
        <ProgressBar Height="3" IsIndeterminate="True" VerticalAlignment="Center"
                     Visibility="{Binding LoginBusy,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
       </Grid>
      </Border>
      <Button Content="刷新二维码" Click="RetryQr_Click" Style="{StaticResource Settings.QuietButton}"
              IsEnabled="{Binding CanRetryQr}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
      <TextBlock Text="{Binding LoginStatus}" Style="{StaticResource Settings.Subtitle}"
                 HorizontalAlignment="Center" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
     <StackPanel x:Name="ManualPanel" Visibility="Collapsed">
      <StackPanel x:Name="CredentialInputs" IsEnabled="{Binding CanSave}"/>
      <Button x:Name="SaveCredentials" Content="保存" Style="{StaticResource Settings.PrimaryButton}" Click="Save_Click"
              IsEnabled="{Binding CanSave}" HorizontalAlignment="Right" Margin="0,4,0,0" AutomationProperties.Name="保存网盘凭据"/>
      <ProgressBar Height="3" IsIndeterminate="True" Margin="0,12,0,0"
                   Visibility="{Binding LoginBusy,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
     </StackPanel>
    </StackPanel>
   </local:AccountLoginSurface>
  </Popup>
  <Popup x:Name="LogoutPopup" desktop:DialogPlacement.Centered="True" StaysOpen="False" AllowsTransparency="True"
         Opened="LogoutPopup_Opened" Closed="LogoutPopup_Closed">
   <Border Width="216" Padding="16" Style="{StaticResource Settings.PopupSurface}">
    <StackPanel KeyboardNavigation.TabNavigation="Cycle">
     <TextBlock Text="退出此账号？" Margin="0,0,0,14"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelLogout" Content="取消" Click="CancelLogout_Click" MinWidth="64" Style="{StaticResource Settings.QuietButton}"/>
      <Button Content="确定" Click="ConfirmLogout_Click" MinWidth="64" Margin="8,0,0,0" Style="{StaticResource Settings.PrimaryButton}"
              AutomationProperties.Name="确定退出网盘账号"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
