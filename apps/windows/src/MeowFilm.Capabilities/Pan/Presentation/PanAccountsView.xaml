<UserControl x:Class="MeowFilm.Capabilities.PanAccountsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 xmlns:desktop="using:MeowFilm.Desktop"
 Foreground="{ThemeResource MeowFilm.Brush.Text}">
 <Grid x:Name="Root" Margin="0,12,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,8" Visibility="{x:Bind Accounts.LoadFailed, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}, FallbackValue=Collapsed}">
   <Button Content="重试" Click="Reload_Click" HorizontalAlignment="Left" Style="{StaticResource Settings.Button}"
           AutomationProperties.Name="重新读取网盘账号"/>
  </StackPanel>
  <ScrollViewer x:Name="TableScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                Style="{StaticResource MeowFilm.SettingsScrollViewer}"
                AutomationProperties.Name="网盘账号表">
   <Grid x:Name="AccountTable" MinWidth="448" Width="{x:Bind TableScroll.ViewportWidth, Mode=OneWay}" VerticalAlignment="Top">
    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="AccountTableHeader" Margin="7,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="192"/></Grid.ColumnDefinitions>
     <TextBlock Text="平台" Style="{StaticResource Account.Header}"/>
     <TextBlock Grid.Column="1" Text="状态" Style="{StaticResource Account.Header}"/>
     <TextBlock Grid.Column="2" Text="操作" Style="{StaticResource Account.Header}" HorizontalAlignment="Center"/>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Settings.ListSurface}">
     <ItemsControl x:Name="AccountRows" ItemsSource="{x:Bind Accounts.Rows, Mode=OneWay}">
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:PanAccountRow">
       <Border Style="{StaticResource Account.Row}">
        <Grid x:Name="AccountCells">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="192"/></Grid.ColumnDefinitions>
         <TextBlock Text="{x:Bind Name}" Style="{StaticResource Settings.Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
         <Grid Grid.Column="1">
          <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource Settings.Subtitle}" VerticalAlignment="Center"
                     Visibility="{x:Bind HasSnapshot, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}"/>
          <ProgressBar Height="3" Width="48" IsIndeterminate="True" HorizontalAlignment="Left"
                       Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}"
                       VerticalAlignment="Bottom" Margin="0,0,0,14" AutomationProperties.Name="{x:Bind Name, Converter={StaticResource Account.AccessibleName}, ConverterParameter=正在处理}"/>
         </Grid>
         <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Content="{x:Bind LoginText, Mode=OneWay}" Click="Login_Click" Style="{StaticResource Settings.PrimaryButton}" Visibility="{x:Bind ShowLogin, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}"
                  IsEnabled="{x:Bind CanLogin, Mode=OneWay}" AutomationProperties.Name="{x:Bind Name, Converter={StaticResource Account.AccessibleName}, ConverterParameter=登录}"/>
          <Button Content="编辑" Click="EditCredentials_Click" Style="{StaticResource Settings.QuietButton}" Visibility="{x:Bind ShowEdit, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind Name, Converter={StaticResource Account.AccessibleName}, ConverterParameter=编辑凭据}"/>
          <Button Content="退出登录" Click="Logout_Click" Style="{StaticResource Settings.QuietButton}" Visibility="{x:Bind ShowLogout, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" Margin="8,0,0,0" IsEnabled="{x:Bind CanLogout, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind Name, Converter={StaticResource Account.AccessibleName}, ConverterParameter=退出登录}"/>
         </StackPanel>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </Border>
   </Grid>
  </ScrollViewer>
  <desktop:NoticeOutlet Message="{x:Bind Accounts.Notice, Mode=OneWay}"/>
  <Grid x:Name="ModalStash" Visibility="Collapsed">
   <local:AccountLoginSurface x:Name="LoginSurface" Title="{x:Bind Accounts.LoginTitle, Mode=OneWay}"
          Style="{StaticResource Account.LoginSurface}" CloseRequested="CloseLogin_Click">
    <StackPanel>
     <Border x:Name="MethodBar" Background="{ThemeResource Settings.Brush.Active}" CornerRadius="6" Padding="2" Margin="0,0,0,16"
             Visibility="{x:Bind Accounts.LoginRow.SupportsQr, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}, FallbackValue=Collapsed}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <RadioButton x:Name="QrModeButton" GroupName="PanLoginMode" Content="二维码登录" Style="{StaticResource Login.Segment}" Click="QrMode_Click"
               IsEnabled="{x:Bind Accounts.CanChangeMethod, Mode=OneWay, FallbackValue=False}"/>
       <RadioButton Grid.Column="1" x:Name="ManualModeButton" GroupName="PanLoginMode" Content="手动填写 Cookie" Style="{StaticResource Login.Segment}" Click="ManualMode_Click"
               IsEnabled="{x:Bind Accounts.CanChangeMethod, Mode=OneWay, FallbackValue=False}"/>
      </Grid>
     </Border>
     <StackPanel x:Name="QrPanel" HorizontalAlignment="Center">
      <Border Style="{StaticResource Account.QrFrame}">
       <Grid>
        <Image Source="{x:Bind Accounts.QrImage, Mode=OneWay}" Stretch="Uniform"
               AutomationProperties.Name="{x:Bind Accounts.QrAccessibleName, Mode=OneWay}"/>
        <ProgressBar Height="3" IsIndeterminate="True" VerticalAlignment="Center"
                     Visibility="{x:Bind Accounts.LoginBusy, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}, FallbackValue=Collapsed}"/>
       </Grid>
      </Border>
      <Button Content="刷新二维码" Click="RetryQr_Click" Style="{StaticResource Settings.QuietButton}"
              IsEnabled="{x:Bind Accounts.CanRetryQr, Mode=OneWay, FallbackValue=False}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
      <TextBlock Text="{x:Bind Accounts.LoginStatus, Mode=OneWay}" Style="{StaticResource Settings.Subtitle}"
                 HorizontalAlignment="Center" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
     <StackPanel x:Name="ManualPanel" Visibility="Collapsed">
      <ContentControl IsEnabled="{x:Bind Accounts.CanSave, Mode=OneWay, FallbackValue=False}"
                      IsTabStop="False" HorizontalContentAlignment="Stretch">
       <ItemsControl x:Name="CredentialInputs" ItemsSource="{x:Bind CredentialFields}" IsTabStop="False">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:PanCredentialField">
         <StackPanel>
          <TextBlock Text="{x:Bind Label}" Margin="0,0,0,8" Style="{StaticResource Settings.Text}"/>
          <PasswordBox Style="{StaticResource Account.Password}" Margin="0,0,0,14" Tag="{x:Bind}"
                       Visibility="{x:Bind IsSecret, Converter={StaticResource MeowFilm.Visible}}"
                       AutomationProperties.Name="{x:Bind Label}" Loaded="CredentialInput_Loaded"/>
          <TextBox Style="{StaticResource Settings.TextBox}" Margin="0,0,0,14" Tag="{x:Bind}"
                   Visibility="{x:Bind IsSecret, Converter={StaticResource MeowFilm.Visible}, ConverterParameter=Not}"
                   AutomationProperties.Name="{x:Bind Label}" Loaded="CredentialInput_Loaded"/>
         </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ContentControl>
      <Button x:Name="SaveCredentials" Content="保存" Style="{StaticResource Settings.PrimaryButton}" Click="Save_Click"
              IsEnabled="{x:Bind Accounts.CanSave, Mode=OneWay, FallbackValue=False}" HorizontalAlignment="Right" Margin="0,4,0,0" AutomationProperties.Name="保存网盘凭据"/>
      <ProgressBar Height="3" IsIndeterminate="True" Margin="0,12,0,0"
                   Visibility="{x:Bind Accounts.LoginBusy, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}, FallbackValue=Collapsed}"/>
     </StackPanel>
    </StackPanel>
   </local:AccountLoginSurface>
  </Grid>
 </Grid>
</UserControl>
