<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="ms-appx:///MeowFilm.Desktop/Theme.xaml"/>
  <ResourceDictionary Source="ms-appx:///MeowFilm.Capabilities/Presentation/Controls/CardBrushes.xaml"/>
  <ResourceDictionary Source="ms-appx:///MeowFilm.Capabilities/Presentation/Controls/OverlayScrollChrome.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <ResourceDictionary.ThemeDictionaries><ResourceDictionary x:Key="HighContrast">
  <SolidColorBrush x:Key="Capability.Player.Foreground" Color="{ThemeResource SystemColorWindowTextColor}"/>
  <SolidColorBrush x:Key="Capability.Player.Text" Color="{ThemeResource SystemColorWindowTextColor}"/>
  <SolidColorBrush x:Key="Capability.Player.Muted" Color="{ThemeResource SystemColorWindowTextColor}"/>
  <SolidColorBrush x:Key="Capability.Player.Hover" Color="{ThemeResource SystemColorHighlightColor}"/>
  <SolidColorBrush x:Key="Capability.Player.Pressed" Color="{ThemeResource SystemColorHighlightColor}"/>
  <SolidColorBrush x:Key="Capability.Player.Rail" Color="{ThemeResource SystemColorWindowTextColor}"/>
 </ResourceDictionary></ResourceDictionary.ThemeDictionaries>
 <SolidColorBrush x:Key="Capability.Player.Foreground" Color="#777E90"/>
 <SolidColorBrush x:Key="Capability.Player.Text" Color="#374151"/>
 <SolidColorBrush x:Key="Capability.Player.Muted" Color="#6B7280"/>
 <SolidColorBrush x:Key="Capability.Player.Hover" Color="#0B000000"/>
 <SolidColorBrush x:Key="Capability.Player.Pressed" Color="#12000000"/>
 <SolidColorBrush x:Key="Capability.Player.Rail" Color="#0D000000"/>
 <Style x:Key="Capability.SeekPreview" TargetType="ToolTip" BasedOn="{StaticResource MeowFilm.ToolTip}"><Setter Property="CornerRadius" Value="16"/><Setter Property="FontWeight" Value="Normal"/></Style>
 <Style x:Key="Capability.Text" TargetType="TextBlock" BasedOn="{StaticResource MeowFilm.Text}"/>
 <Style TargetType="TextBlock" BasedOn="{StaticResource Capability.Text}"/>
 <Style x:Key="Capability.Muted" TargetType="TextBlock" BasedOn="{StaticResource MeowFilm.MutedText}"/>
 <Style x:Key="Capability.Error" TargetType="TextBlock" BasedOn="{StaticResource MeowFilm.ErrorText}"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}"><Setter Property="Margin" Value="0,0,8,8"/></Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource MeowFilm.ComboBox}"/>
 <Style x:Key="Novel.Input" TargetType="TextBox" BasedOn="{StaticResource MeowFilm.TextBox}"><Setter Property="Background" Value="{ThemeResource MeowFilm.Brush.InputSurface}"/></Style>
 <Style x:Key="Novel.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource MeowFilm.ComboBox}"><Setter Property="Background" Value="{ThemeResource MeowFilm.Brush.InputSurface}"/></Style>
 <Style x:Key="Novel.CheckBox" TargetType="CheckBox"><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{ThemeResource MeowFilm.Brush.Text}"/></Style>
 <Style x:Key="Novel.Row" TargetType="Border"><Setter Property="BorderBrush" Value="{ThemeResource MeowFilm.Brush.Border}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="0,0,0,12"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
 <Style x:Key="Capability.CellText" TargetType="TextBlock" BasedOn="{StaticResource Capability.Text}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
 <Style x:Key="Music.FilterTag" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
  <Setter Property="Width" Value="78"/><Setter Property="Height" Value="31"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="0,0,12,14"/><Setter Property="Padding" Value="8,2"/>
  <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Compact}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="{ThemeResource MeowFilm.Brush.InputSurface}"/><Setter Property="BorderBrush" Value="{ThemeResource MeowFilm.Brush.Border}"/><Setter Property="BorderThickness" Value="1"/>
 </Style>
</ResourceDictionary>
