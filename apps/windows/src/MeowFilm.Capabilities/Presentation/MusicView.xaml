<UserControl x:Class="MeowFilm.Capabilities.MusicView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 xmlns:art="clr-namespace:MeowFilm.Desktop.Artwork;assembly=MeowFilm.Desktop"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <local:MusicPlayingSongConverter x:Key="PlayingSong"/>
  <Style x:Key="Playlist.SongTitle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
   <Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource PlayingSong}"><Binding Path="Id"/><Binding Path="DataContext.CurrentSongId" RelativeSource="{RelativeSource AncestorType=local:MusicView}"/></MultiBinding></DataTrigger.Binding><Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Accent}"/></DataTrigger>
    <DataTrigger Binding="{Binding Path=(desktop:DesktopTheme.IsHighContrast),RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=DataGridRow}}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Playlist.Grid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="RowHeight" Value="50"/>
   <Setter Property="ColumnHeaderHeight" Value="32"/>
   <Setter Property="GridLinesVisibility" Value="None"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="RowHeaderWidth" Value="0"/>
   <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style x:Key="Playlist.Header" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="Padding" Value="8,0"/>
   <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Caption}"/>
   <Setter Property="FontWeight" Value="{StaticResource MeowFilm.Font.Weight.Normal}"/>
  </Style>
  <Style x:Key="Playlist.Row" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Margin" Value="0,1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow">
    <Border x:Name="RowSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
     <DataGridCellsPresenter/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="White"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E9F0F6"/><Setter Property="BorderBrush" Value="#9AAEBF"/><Setter Property="BorderThickness" Value="1"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Text}"/><Setter Property="BorderThickness" Value="1"/></Trigger>
    <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsSelected" Value="True"/></MultiTrigger.Conditions><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></MultiTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Playlist.Cell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
   <Setter Property="Padding" Value="8,0"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="Playlist.ActionButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.IconButton}">
   <Setter Property="Width" Value="32"/>
   <Setter Property="Height" Value="32"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="Margin" Value="0"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
  </Style>
  <Style x:Key="Playlist.HoverActionButton" TargetType="Button" BasedOn="{StaticResource Playlist.ActionButton}">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
     <Setter Property="Visibility" Value="Visible"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding IsKeyboardFocusWithin,RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
     <Setter Property="Visibility" Value="Visible"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Search.Tab" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
   <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Margin" Value="0,0,28,0"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="Height" Value="34"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="Transparent">
     <Grid>
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>
      <Border Width="18" Height="3" CornerRadius="1.5" Background="{TemplateBinding BorderBrush}"
              VerticalAlignment="Bottom"/>
     </Grid>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Playlist.PlayAllButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
   <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
   <Setter Property="Padding" Value="16,7"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.AccentSoft}"/>
    </Trigger>
    <Trigger Property="IsPressed" Value="True">
     <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
     <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.OnAccent}"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Disabled}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Border}"/>
    </Trigger>
    <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
     <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
    </Trigger>
    <MultiTrigger><MultiTrigger.Conditions>
     <Condition Property="desktop:DesktopTheme.IsHighContrast" Value="True"/>
     <Condition Property="IsMouseOver" Value="True"/>
    </MultiTrigger.Conditions>
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
     <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
    </MultiTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Playlist.DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.PrimaryButton}">
   <Setter Property="Width" Value="96"/>
   <Setter Property="MinHeight" Value="40"/>
   <Setter Property="Padding" Value="20,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20"
            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Playlist.DialogTextBox" TargetType="TextBox" BasedOn="{StaticResource MeowFilm.TextBox}">
   <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Window}"/>
  </Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid>
  <Grid x:Name="PageContent">
  <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="40,16,24,20"/><Setter Property="MaxWidth" Value="1490"/><Style.Triggers><DataTrigger Binding="{Binding IsCatalogLanding}" Value="True"><Setter Property="Margin" Value="0,12,0,0"/><Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
     <StackPanel x:Name="SearchHeading" Visibility="{Binding IsSearchPage,Converter={StaticResource Visible}}" Margin="0,4,0,24">
      <TextBlock Text="{Binding Heading}" FontSize="23"
                 Foreground="{DynamicResource MeowFilm.Brush.Text}" TextTrimming="CharacterEllipsis"/>
      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
       <Button Content="综合" Tag="overview" Click="SearchTab_Click" AutomationProperties.Name="综合搜索结果">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Search.Tab}">
         <Style.Triggers><DataTrigger Binding="{Binding IsSearchOverview}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
         </DataTrigger></Style.Triggers>
        </Style></Button.Style>
       </Button>
       <Button Content="单曲" Tag="songs" Click="SearchTab_Click" AutomationProperties.Name="单曲搜索结果">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Search.Tab}">
         <Style.Triggers><DataTrigger Binding="{Binding IsSearchSongs}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
         </DataTrigger></Style.Triggers>
        </Style></Button.Style>
       </Button>
       <Button Content="歌单" Tag="playlists" Click="SearchTab_Click" AutomationProperties.Name="歌单搜索结果">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Search.Tab}">
         <Style.Triggers><DataTrigger Binding="{Binding IsSearchPlaylists}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
         </DataTrigger></Style.Triggers>
        </Style></Button.Style>
       </Button>
      </StackPanel>
     </StackPanel>
    <Grid Visibility="{Binding IsContentDetailPage,Converter={StaticResource Visible}}" Margin="0,4,0,28">
     <Grid.ColumnDefinitions><ColumnDefinition Width="152"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="DetailArtworkFrame" Width="152" Height="152" ClipToBounds="True"
             Background="{DynamicResource MeowFilm.Brush.Surface}"
             BorderBrush="{DynamicResource MeowFilm.Brush.Border}" BorderThickness="1">
      <Border.Style><Style TargetType="Border">
       <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="local:CardClip.Radius" Value="18"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsCatalogArtist}" Value="True">
        <Setter Property="CornerRadius" Value="76"/>
         <Setter Property="local:CardClip.Radius" Value="76"/>
       </DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <Grid>
       <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource MeowFilm.Font.Icons}" FontSize="54"
                  Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <art:ArtworkImage Address="{Binding DetailArtwork}" Stretch="UniformToFill"
                         AutomationProperties.Name="{Binding DetailArtworkName}"/>
      </Grid>
     </Border>
     <Grid Grid.Column="1" Margin="22,2,0,2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding Heading}" FontSize="23"
                 Foreground="{DynamicResource MeowFilm.Brush.Text}" TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Row="1" Text="{Binding DetailSubtitle}" Margin="0,14,0,0" Style="{StaticResource Capability.Muted}" TextTrimming="CharacterEllipsis"/>
      <WrapPanel Grid.Row="2">
       <Button x:Name="PlayAllButton" Click="PlayContentDetail_Click" IsEnabled="{Binding CanPlayContentDetail}"
               Style="{StaticResource Playlist.PlayAllButton}"
               AutomationProperties.Name="播放全部">
        <StackPanel Orientation="Horizontal">
         <Path Data="M 0,0 L 0,12 L 10,6 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
               Width="10" Height="12" Stretch="Fill" VerticalAlignment="Center"/>
         <TextBlock Text="播放全部" Margin="7,0,0,0"/>
        </StackPanel>
       </Button>
       <StackPanel Orientation="Horizontal" Visibility="{Binding IsCatalogDaily,Converter={StaticResource Visible}}">
        <Button x:Name="DailyBranchButton" Content="{Binding DailyOtherBranchTitle}" Tag="{Binding DailyOtherBranch}" Click="DailyBranch_Click" Margin="8,0,0,0"/>
        <Button Content="···" Click="DailyMore_Click" Margin="8,0,0,0" AutomationProperties.Name="每日推荐更多操作"/>
       </StackPanel>
       <Button x:Name="NetworkPlaylistButton" Content="{Binding NetworkPlaylistActionText}"
               Click="NetworkPlaylist_Click" Margin="10,0,0,0"
               Visibility="{Binding ShowsNetworkPlaylistAction,Converter={StaticResource Visible}}"
               IsEnabled="{Binding CanToggleNetworkPlaylist}"
               AutomationProperties.Name="{Binding NetworkPlaylistActionText}"/>
      </WrapPanel>
     </Grid>
    </Grid>
    <StackPanel Visibility="{Binding IsHistory,Converter={StaticResource Visible}}" HorizontalAlignment="Left">
     <ComboBox x:Name="HistoryPicker" ItemsSource="{Binding HistoryDates}" SelectionChanged="HistoryDate_Changed" IsEnabled="{Binding CanEdit}"
      MinWidth="160" Margin="0,0,8,8" AutomationProperties.Name="播放日期"/>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="1">
    <StackPanel Visibility="{Binding IsDailyStyle,Converter={StaticResource Visible}}" Margin="0,0,0,16">
     <Button x:Name="DailyStyleButton" Content="{Binding DailyStyleSelectionText}" Click="DailyStyleOpen_Click" HorizontalAlignment="Left" IsEnabled="{Binding CanEditDailyStyle}">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Music.FilterTag}"><Setter Property="Width" Value="Auto"/><Setter Property="MaxWidth" Value="500"/><Setter Property="Padding" Value="14,2"/><Setter Property="Margin" Value="0"/></Style></Button.Style>
     </Button>
     <Popup x:Name="DailyStylePopup" PlacementTarget="{Binding ElementName=DailyStyleButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsDailyStyleEditorOpen,Mode=OneWay}" Opened="DailyStylePopup_Opened" Closed="DailyStylePopup_Closed">
     <Border x:Name="DailyStylePanel" Focusable="True" Style="{StaticResource MeowFilm.Surface}" Width="540" Padding="16" Margin="0,6,0,0" PreviewKeyDown="DailyStylePanel_KeyDown">
      <StackPanel>
       <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding DailyStyleGroups}"><ItemsControl.ItemTemplate><DataTemplate>
         <StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Id}" Margin="0,0,0,8"/>
          <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding}" Click="DailyStyleTag_Click">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Music.FilterTag}"><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style>
           </Button></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </ScrollViewer>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Click="DailyStyleCancel_Click" IsEnabled="{Binding CanEditDailyStyle}"/><Button Content="确认" Click="DailyStyleConfirm_Click" IsEnabled="{Binding CanConfirmDailyStyle}"/></StackPanel>
      </StackPanel>
     </Border>
     </Popup>
    </StackPanel>
    <StackPanel Visibility="{Binding ShowDetailSkeleton,Converter={StaticResource Visible}}" IsHitTestVisible="False">
     <desktop:LoadingSkeleton Height="34" Margin="0,8" CornerRadius="8" IsActive="True"/>
     <desktop:LoadingSkeleton Height="34" Margin="0,8" CornerRadius="8" IsActive="True"/>
     <desktop:LoadingSkeleton Height="34" Margin="0,8" CornerRadius="8" IsActive="True"/>
    </StackPanel>
   <DockPanel Margin="0,0,0,10" Visibility="{Binding IsContentDetailPage,Converter={StaticResource Visible}}">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="{Binding DetailSectionTitle}" FontSize="{StaticResource MeowFilm.Font.Size.SectionHeading}"/>
     <TextBlock Text="{Binding DetailCountText}" FontSize="11" Margin="3,1,0,0"
                Foreground="{DynamicResource MeowFilm.Brush.Muted}" VerticalAlignment="Top"/>
    </StackPanel>
   </DockPanel>
   <desktop:NoticeOutlet Message="{Binding Status}"/>
    <desktop:NoticeOutlet Message="{Binding SearchStatus}"/>
  </StackPanel>
   <Grid x:Name="BodyPages" Grid.Row="2">
   <local:MusicCatalogView x:Name="CatalogView"/>
   <local:MusicDiscoveryView x:Name="DiscoveryView"/>
   <ScrollViewer x:Name="ArchiveScroll" VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding Archives}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource MeowFilm.Surface}" Margin="0,0,0,12">
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
       <Button Content="恢复队列" Tag="{Binding Id}" Click="RestoreArchive_Click" IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
       <Button Content="删除" Tag="{Binding Id}" Click="DeleteArchive_Click" IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
      </StackPanel><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="17"/>
       <TextBlock Text="{Binding CountText}" Style="{StaticResource Capability.Muted}" Margin="0,7,0,0"/></StackPanel></DockPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <DataGrid x:Name="SongsGrid" ItemsSource="{Binding CatalogSongsSource}" SelectedItem="{Binding CatalogSelectedSong}" MouseDoubleClick="Song_DoubleClick"
    Tag="{Binding}"
    ContextMenuOpening="SongMenu_Opening" PreviewMouseRightButtonDown="Song_RightClick" PreviewKeyDown="Song_KeyDown"
     PreviewMouseWheel="SongsGrid_MouseWheel"
    PreviewMouseLeftButtonDown="SongsGrid_MouseDown" PreviewMouseMove="SongsGrid_MouseMove"
    DragOver="SongsGrid_DragOver" DragLeave="SongsGrid_DragLeave" Drop="SongsGrid_Drop"
    QueryContinueDrag="SongsGrid_QueryContinueDrag" ScrollViewer.ScrollChanged="SongsGrid_ScrollChanged" AllowDrop="True"
    SelectionMode="Single" SelectionUnit="FullRow"
    EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
    VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
    ColumnHeaderStyle="{StaticResource Playlist.Header}" RowStyle="{StaticResource Playlist.Row}"
    CellStyle="{StaticResource Playlist.Cell}" AutomationProperties.Name="歌曲列表">
    <DataGrid.Resources>
     <Style TargetType="ScrollViewer">
      <Setter Property="desktop:OverlayScrollChrome.Enabled" Value="True"/>
      <EventSetter Event="Loaded" Handler="SongsGridScroll_Loaded"/>
     </Style>
    </DataGrid.Resources>
    <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource Playlist.Grid}"/></DataGrid.Style>
    <DataGrid.ContextMenu><ContextMenu Style="{DynamicResource MeowFilm.ContextMenu}" DataContext="{Binding PlacementTarget.Tag,RelativeSource={RelativeSource Self}}"/></DataGrid.ContextMenu>
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="歌曲 / 歌手" Width="3*" MinWidth="240">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="34" Height="34" CornerRadius="4" ClipToBounds="True"
                Background="{DynamicResource MeowFilm.Brush.Surface}">
         <Grid>
          <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource MeowFilm.Font.Icons}" FontSize="17"
                     Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <art:ArtworkImage Address="{Binding Cover}" Stretch="UniformToFill"/>
         </Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
         <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource MeowFilm.Font.Size.Body}" Style="{StaticResource Playlist.SongTitle}"/>
         <TextBlock Text="{Binding Artist}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource MeowFilm.Font.Size.Caption}"
                    Foreground="{DynamicResource MeowFilm.Brush.Muted}" Margin="0,2,0,0"/>
        </StackPanel>
       </Grid>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn Header="专辑" Binding="{Binding Album}" ElementStyle="{StaticResource Capability.CellText}" Width="2*" MinWidth="140"/>
     <DataGridTextColumn Header="时长" Binding="{Binding Duration}" ElementStyle="{StaticResource Capability.CellText}" Width="68"/>
     <DataGridTemplateColumn Header="操作" Width="120">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Style="{StaticResource Playlist.ActionButton}" Click="Favorite_Click"
                Tag="{Binding DataContext,RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"
                AutomationProperties.Name="收藏">
         <Path Style="{StaticResource Capability.FavoriteIcon}"/>
        </Button>
        <Button Style="{StaticResource Playlist.HoverActionButton}" Click="NextInQueue_Click"
                Tag="{Binding DataContext,RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"
                AutomationProperties.Name="下一首播放">
         <Grid Width="20" Height="20">
          <Path Data="M3,2 L3,15 L14,8.5 Z" Fill="Transparent"
                Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.5" StrokeLineJoin="Round"/>
          <Path Data="M16,13 L16,19 M13,16 L19,16"
                Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
         </Grid>
        </Button>
        <Button Style="{StaticResource Playlist.HoverActionButton}" Click="SongMore_Click"
                Tag="{Binding DataContext,RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"
                AutomationProperties.Name="更多">
         <StackPanel Orientation="Horizontal">
          <Ellipse Width="2.5" Height="2.5" Margin="0,0,3,0" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
          <Ellipse Width="2.5" Height="2.5" Margin="0,0,3,0" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
          <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
         </StackPanel>
        </Button>
       </StackPanel>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <Grid x:Name="SearchSongsPage">
   <StackPanel Panel.ZIndex="3" IsHitTestVisible="False" VerticalAlignment="Top">
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShowSearchSkeleton}" Value="True"/><Condition Binding="{Binding IsSearchSongs}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
    <desktop:LoadingSkeleton Height="34" Margin="0,8,0,8" CornerRadius="4" IsActive="True"/>
    <desktop:LoadingSkeleton Height="34" Margin="0,8,0,8" CornerRadius="4" IsActive="True"/>
    <desktop:LoadingSkeleton Height="34" Margin="0,8,0,8" CornerRadius="4" IsActive="True"/>
    <desktop:LoadingSkeleton Height="34" Margin="0,8,0,8" CornerRadius="4" IsActive="True"/>
    <desktop:LoadingSkeleton Height="34" Margin="0,8,0,8" CornerRadius="4" IsActive="True"/>
    <desktop:LoadingSkeleton Height="34" Margin="0,8,0,8" CornerRadius="4" IsActive="True"/>
    <desktop:LoadingSkeleton Height="34" Margin="0,8,0,8" CornerRadius="4" IsActive="True"/>
    <desktop:LoadingSkeleton Height="34" Margin="0,8,0,8" CornerRadius="4" IsActive="True"/>
    <desktop:LoadingSkeleton Height="34" Margin="0,8,0,8" CornerRadius="4" IsActive="True"/>
    <desktop:LoadingSkeleton Height="34" Margin="0,8,0,8" CornerRadius="4" IsActive="True"/>
   </StackPanel>
   <DataGrid x:Name="SearchSongsGrid" ItemsSource="{Binding SearchSongsSource}" SelectedItem="{Binding SearchSelectedSong}" MouseDoubleClick="Song_DoubleClick"
    Tag="{Binding}"
    ContextMenuOpening="SongMenu_Opening" PreviewMouseRightButtonDown="Song_RightClick" PreviewKeyDown="Song_KeyDown"
     PreviewMouseWheel="SongsGrid_MouseWheel"
    PreviewMouseLeftButtonDown="SongsGrid_MouseDown" PreviewMouseMove="SongsGrid_MouseMove"
    DragOver="SongsGrid_DragOver" DragLeave="SongsGrid_DragLeave" Drop="SongsGrid_Drop"
    QueryContinueDrag="SongsGrid_QueryContinueDrag" ScrollViewer.ScrollChanged="SongsGrid_ScrollChanged" AllowDrop="True"
    SelectionMode="Single" SelectionUnit="FullRow"
    EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
    VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
    ColumnHeaderStyle="{StaticResource Playlist.Header}" RowStyle="{StaticResource Playlist.Row}"
    CellStyle="{StaticResource Playlist.Cell}" AutomationProperties.Name="歌曲列表">
    <DataGrid.Resources>
     <Style TargetType="ScrollViewer">
      <Setter Property="desktop:OverlayScrollChrome.Enabled" Value="True"/>
      <EventSetter Event="Loaded" Handler="SongsGridScroll_Loaded"/>
     </Style>
    </DataGrid.Resources>
    <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource Playlist.Grid}"/></DataGrid.Style>
    <DataGrid.ContextMenu><ContextMenu Style="{DynamicResource MeowFilm.ContextMenu}" DataContext="{Binding PlacementTarget.Tag,RelativeSource={RelativeSource Self}}"/></DataGrid.ContextMenu>
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="歌曲 / 歌手" Width="3*" MinWidth="240">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="34" Height="34" CornerRadius="4" ClipToBounds="True"
                Background="{DynamicResource MeowFilm.Brush.Surface}">
         <Grid>
          <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource MeowFilm.Font.Icons}" FontSize="17"
                     Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <art:ArtworkImage Address="{Binding Cover}" Stretch="UniformToFill"/>
         </Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
         <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource MeowFilm.Font.Size.Body}" Style="{StaticResource Playlist.SongTitle}"/>
         <TextBlock Text="{Binding Artist}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource MeowFilm.Font.Size.Caption}"
                    Foreground="{DynamicResource MeowFilm.Brush.Muted}" Margin="0,2,0,0"/>
        </StackPanel>
       </Grid>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn Header="专辑" Binding="{Binding Album}" ElementStyle="{StaticResource Capability.CellText}" Width="2*" MinWidth="140"/>
     <DataGridTextColumn Header="时长" Binding="{Binding Duration}" ElementStyle="{StaticResource Capability.CellText}" Width="68"/>
     <DataGridTemplateColumn Header="操作" Width="120">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Style="{StaticResource Playlist.ActionButton}" Click="Favorite_Click"
                Tag="{Binding DataContext,RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"
                AutomationProperties.Name="收藏">
         <Path Style="{StaticResource Capability.FavoriteIcon}"/>
        </Button>
        <Button Style="{StaticResource Playlist.HoverActionButton}" Click="NextInQueue_Click"
                Tag="{Binding DataContext,RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"
                AutomationProperties.Name="下一首播放">
         <Grid Width="20" Height="20">
          <Path Data="M3,2 L3,15 L14,8.5 Z" Fill="Transparent"
                Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.5" StrokeLineJoin="Round"/>
          <Path Data="M16,13 L16,19 M13,16 L19,16"
                Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
         </Grid>
        </Button>
        <Button Style="{StaticResource Playlist.HoverActionButton}" Click="SongMore_Click"
                Tag="{Binding DataContext,RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"
                AutomationProperties.Name="更多">
         <StackPanel Orientation="Horizontal">
          <Ellipse Width="2.5" Height="2.5" Margin="0,0,3,0" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
          <Ellipse Width="2.5" Height="2.5" Margin="0,0,3,0" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
          <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
         </StackPanel>
        </Button>
       </StackPanel>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   </Grid>
  </Grid>
   <DockPanel Grid.Row="3" Margin="0,16,0,0" Visibility="{Binding ShowSongPager,Converter={StaticResource Visible}}">
    <TextBlock Text="{Binding PageText}" Style="{StaticResource Capability.Muted}" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="上一页" IsEnabled="{Binding CanPreviousPage}" Click="PreviousPage_Click"/>
     <Button Content="下一页" IsEnabled="{Binding CanNextPage}" Click="NextPage_Click"/>
    </StackPanel>
   </DockPanel>
 </Grid>
  <Grid x:Name="PlaylistDialogOverlay" Panel.ZIndex="50" Visibility="Collapsed"
        Background="#52000000" Focusable="False"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="PlaylistDialog_PreviewKeyDown"
        AutomationProperties.Name="创建歌单浮层">
   <Border x:Name="PlaylistDialogPanel" Width="420" MinHeight="252"
           HorizontalAlignment="Center" VerticalAlignment="Center"
           Background="{DynamicResource MeowFilm.Brush.Surface}"
           BorderBrush="{DynamicResource MeowFilm.Brush.Border}" BorderThickness="1"
           CornerRadius="18" Padding="28">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity=".2"/></Border.Effect>
    <Grid KeyboardNavigation.TabNavigation="Cycle">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="创建歌单" HorizontalAlignment="Center" VerticalAlignment="Center"
                FontSize="{StaticResource MeowFilm.Font.Size.Title}"/>
     <Button x:Name="ClosePlaylistDialogButton" Content="&#xE711;"
             Style="{StaticResource MeowFilm.IconButton}" Width="32" Height="32" MinHeight="32"
             HorizontalAlignment="Right" VerticalAlignment="Center"
             Click="ClosePlaylistDialog_Click"
             AutomationProperties.Name="关闭创建歌单"/>
     <Grid Grid.Row="1" Margin="0,24,0,0">
      <TextBox x:Name="PlaylistNameInput" Height="82" MaxLength="200"
               Style="{StaticResource Playlist.DialogTextBox}"
               Padding="14,12,14,28" VerticalContentAlignment="Top"
               TextChanged="PlaylistName_Changed"
               AutomationProperties.Name="歌单名称"/>
      <TextBlock x:Name="PlaylistNamePlaceholder" Text="输入歌单标题"
                 Margin="15,12,15,0" VerticalAlignment="Top"
                 Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                 IsHitTestVisible="False"/>
      <TextBlock x:Name="PlaylistNameCount" Text="0 / 200"
                 Margin="15,0,15,10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 FontSize="{StaticResource MeowFilm.Font.Size.Caption}" Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                 IsHitTestVisible="False"/>
     </Grid>
     <Button x:Name="CreatePlaylistButton" Grid.Row="2" Content="创建"
             Style="{StaticResource Playlist.DialogPrimaryButton}"
             HorizontalAlignment="Center" Margin="0,24,0,0"
             IsDefault="True" IsEnabled="False"
             Click="CreatePlaylist_Click"
             AutomationProperties.Name="创建歌单"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
