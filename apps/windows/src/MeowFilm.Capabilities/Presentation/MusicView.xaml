<UserControl x:Class="MeowFilm.Capabilities.MusicView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 xmlns:art="clr-namespace:MeowFilm.Desktop.Artwork;assembly=MeowFilm.Desktop"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <local:PlaylistIndexConverter x:Key="PlaylistIndex"/>
  <Style x:Key="Playlist.Grid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="RowHeight" Value="50"/>
   <Setter Property="ColumnHeaderHeight" Value="32"/>
   <Setter Property="GridLinesVisibility" Value="None"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="RowHeaderWidth" Value="0"/>
   <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style x:Key="Playlist.Header" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="Padding" Value="8,0"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style x:Key="Playlist.Row" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Margin" Value="0,1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow">
    <Border x:Name="RowSurface" Background="{TemplateBinding Background}" CornerRadius="8">
     <DataGridCellsPresenter/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Hover}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.AccentSoft}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Playlist.Cell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
   <Setter Property="Padding" Value="8,0"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
 </ResourceDictionary></UserControl.Resources>
  <Grid>
  <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="40,16,24,20"/><Setter Property="MaxWidth" Value="1490"/><Style.Triggers><DataTrigger Binding="{Binding IsCatalogLanding}" Value="True"><Setter Property="Margin" Value="0,12,0,0"/><Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid Visibility="{Binding IsContentDetailPage,Converter={StaticResource Visible}}" Margin="0,4,0,28">
     <Grid.ColumnDefinitions><ColumnDefinition Width="152"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="DetailArtworkFrame" Width="152" Height="152" ClipToBounds="True"
             Background="{DynamicResource MeowFilm.Brush.Surface}"
             BorderBrush="{DynamicResource MeowFilm.Brush.Border}" BorderThickness="1">
      <Border.Style><Style TargetType="Border">
       <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="local:CardClip.Radius" Value="8"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsCatalogArtist}" Value="True">
        <Setter Property="CornerRadius" Value="76"/>
         <Setter Property="local:CardClip.Radius" Value="76"/>
       </DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <Grid>
       <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource MeowFilm.Font.Icons}" FontSize="54"
                  Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <art:ArtworkImage Address="{Binding DetailArtwork}" Stretch="UniformToFill"
                         AutomationProperties.Name="{Binding DetailArtworkName}"/>
      </Grid>
     </Border>
     <StackPanel Grid.Column="1" Margin="22,2,0,0">
      <TextBlock Text="{Binding Heading}" FontSize="23" FontWeight="SemiBold"
                 Foreground="{DynamicResource MeowFilm.Brush.Text}" TextTrimming="CharacterEllipsis"/>
      <StackPanel Orientation="Horizontal" Margin="0,82,0,0">
       <Button Click="PlayContentDetail_Click" IsEnabled="{Binding CanPlayContentDetail}"
               Style="{StaticResource MeowFilm.PrimaryButton}" Padding="16,7"
               AutomationProperties.Name="播放全部">
        <StackPanel Orientation="Horizontal">
         <Path Data="M 0,0 L 0,12 L 10,6 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
               Width="10" Height="12" Stretch="Fill" VerticalAlignment="Center"/>
         <TextBlock Text="播放全部" Margin="7,0,0,0"/>
        </StackPanel>
       </Button>
      </StackPanel>
     </StackPanel>
    </Grid>
    <StackPanel Visibility="{Binding IsSongList,Converter={StaticResource Visible}}" HorizontalAlignment="Left">
     <ComboBox x:Name="HistoryPicker" ItemsSource="{Binding HistoryDates}" SelectionChanged="HistoryDate_Changed" IsEnabled="{Binding CanEdit}"
      MinWidth="160" Margin="0,0,8,8" Visibility="{Binding IsHistory,Converter={StaticResource Visible}}" AutomationProperties.Name="播放日期"/>
     <ComboBox ItemsSource="{Binding RecordingCandidates}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedRecording}"
      MinWidth="160" MaxWidth="280" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"
      Visibility="{Binding HasRecordingCandidates,Converter={StaticResource Visible}}" AutomationProperties.Name="指定歌曲录音"/>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="1">
   <DockPanel Margin="0,0,0,10" Visibility="{Binding IsContentDetailPage,Converter={StaticResource Visible}}">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="{Binding DetailSectionTitle}" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding DetailCountText}" FontSize="11" Margin="3,1,0,0"
                Foreground="{DynamicResource MeowFilm.Brush.Muted}" VerticalAlignment="Top"/>
    </StackPanel>
   </DockPanel>
   <local:MusicRecommendationView/>
   <desktop:NoticeOutlet Message="{Binding Status}"/>
  </StackPanel>
   <Grid Grid.Row="2">
   <local:MusicCatalogView x:Name="CatalogView" Visibility="{Binding IsCatalogContent,Converter={StaticResource Visible}}"/>
   <local:MusicDiscoveryView x:Name="DiscoveryView" Visibility="{Binding IsDiscovery,Converter={StaticResource Visible}}"/>
   <ScrollViewer x:Name="ArchiveScroll" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsArchives,Converter={StaticResource Visible}}">
    <ItemsControl ItemsSource="{Binding Archives}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource MeowFilm.Surface}" Margin="0,0,0,12">
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
       <Button Content="恢复队列" Tag="{Binding Id}" Click="RestoreArchive_Click" IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
       <Button Content="删除" Tag="{Binding Id}" Click="DeleteArchive_Click" IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
      </StackPanel><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="17"/>
       <TextBlock Text="{Binding CountText}" Style="{StaticResource Capability.Muted}" Margin="0,7,0,0"/></StackPanel></DockPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <DataGrid x:Name="SongsGrid" ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSong}" MouseDoubleClick="Song_DoubleClick"
    PreviewMouseRightButtonDown="Song_RightClick" PreviewKeyDown="Song_KeyDown"
     PreviewMouseWheel="SongsGrid_MouseWheel"
    PreviewMouseLeftButtonDown="SongsGrid_MouseDown" PreviewMouseMove="SongsGrid_MouseMove"
    DragOver="SongsGrid_DragOver" DragLeave="SongsGrid_DragLeave" Drop="SongsGrid_Drop"
    QueryContinueDrag="SongsGrid_QueryContinueDrag" ScrollViewer.ScrollChanged="SongsGrid_ScrollChanged" AllowDrop="True"
    SelectionMode="Single" SelectionUnit="FullRow" AlternationCount="100000"
    EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
    VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
    ColumnHeaderStyle="{StaticResource Playlist.Header}" RowStyle="{StaticResource Playlist.Row}"
    CellStyle="{StaticResource Playlist.Cell}" AutomationProperties.Name="歌曲列表">
    <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource Playlist.Grid}">
     <Style.Triggers><DataTrigger Binding="{Binding ShowsSongTable}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style></DataGrid.Style>
    <DataGrid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
     <MenuItem Header="播放" Click="Play_Click" IsEnabled="{Binding HasSelection}"/><MenuItem Header="下一首播放" Click="NextInQueue_Click" IsEnabled="{Binding HasSelection}"/>
     <MenuItem Header="添加到收藏" Click="Favorite_Click" IsEnabled="{Binding HasSelection}"/>
     <MenuItem Header="添加到歌单" ItemsSource="{Binding Playlists}" IsEnabled="{Binding HasSelection}">
      <MenuItem.ItemContainerStyle><Style TargetType="MenuItem">
       <Setter Property="Header" Value="{Binding Name}"/><Setter Property="Tag" Value="{Binding Id}"/>
       <EventSetter Event="Click" Handler="AddToPlaylist_Click"/>
      </Style></MenuItem.ItemContainerStyle>
     </MenuItem>
     <Separator/><MenuItem Header="移除" Click="Remove_Click" IsEnabled="{Binding CanRemoveSelection}"/>
    </ContextMenu></DataGrid.ContextMenu>
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="#" Width="44">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},Path=(ItemsControl.AlternationIndex),Converter={StaticResource PlaylistIndex}}"
                  FontSize="12" Foreground="{DynamicResource MeowFilm.Brush.Muted}" HorizontalAlignment="Center"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTemplateColumn Header="标题" Width="2*" MinWidth="220">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="34" Height="34" CornerRadius="4" ClipToBounds="True"
                Background="{DynamicResource MeowFilm.Brush.Surface}">
         <Grid>
          <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource MeowFilm.Font.Icons}" FontSize="17"
                     Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <art:ArtworkImage Address="{Binding Cover}" Stretch="UniformToFill"/>
         </Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
         <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14"/>
         <TextBlock Text="{Binding Artist}" TextTrimming="CharacterEllipsis" FontSize="12"
                    Foreground="{DynamicResource MeowFilm.Brush.Muted}" Margin="0,2,0,0"/>
        </StackPanel>
       </Grid>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn Header="专辑" Binding="{Binding Album}" ElementStyle="{StaticResource Capability.CellText}" Width="*" MinWidth="120"/>
     <DataGridTextColumn Header="时长" Binding="{Binding Duration}" ElementStyle="{StaticResource Capability.CellText}" Width="72"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
   <DockPanel Grid.Row="3" Margin="0,16,0,0" Visibility="{Binding ShowSongPager,Converter={StaticResource Visible}}">
    <TextBlock Text="{Binding PageText}" Style="{StaticResource Capability.Muted}" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="上一页" IsEnabled="{Binding CanPreviousPage}" Click="PreviousPage_Click"/>
     <Button Content="下一页" IsEnabled="{Binding CanNextPage}" Click="NextPage_Click"/>
    </StackPanel>
   </DockPanel>
 </Grid>
</UserControl>
