<UserControl x:Class="MeowFilm.Capabilities.EntryCard" x:Name="Entry"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 xmlns:art="clr-namespace:MeowFilm.Desktop.Artwork;assembly=MeowFilm.Desktop"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="/MeowFilm.Desktop;component/Typography.xaml"/>
   <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/Controls/CardBrushes.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <local:MusicCatalogPaletteConverter x:Key="EntryPalette"/>
  <local:MusicEntryTitlePaletteConverter x:Key="EntryTitleShade"/>
  <local:EntryContentOffset x:Key="ContentOffset"/>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style x:Key="HitButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/>
   <Setter Property="FocusVisualStyle" Value="{DynamicResource MeowFilm.FocusVisual}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary></UserControl.Resources>
 <UserControl.Style><Style TargetType="UserControl">
  <Setter Property="Foreground" Value="White"/>
  <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
  </Trigger></Style.Triggers>
 </Style></UserControl.Style>
 <Grid x:Name="Surface" local:CardMotion.Enabled="True" local:CardClip.Radius="8">
  <Grid.Style><Style TargetType="Grid">
   <Setter Property="Background" Value="{Binding Source,ElementName=Cover,Converter={StaticResource EntryPalette}}"/>
   <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
   </Trigger></Style.Triggers>
  </Style></Grid.Style>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <Grid x:Name="ArtworkFrame" Height="{Binding ActualWidth,ElementName=Surface}">
   <art:ArtworkImage x:Name="Cover" Address="{Binding Cover}"/>
   <Grid Height="64" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
    <Grid.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="White" Offset=".45"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Grid.OpacityMask>
    <art:ArtworkImage x:Name="DecorationLayer" Address="{Binding Decoration}" ShowRetry="False" Height="{Binding ActualHeight,ElementName=ArtworkFrame}" VerticalAlignment="Top"/>
   </Grid>
  </Grid>
  <Border x:Name="CoverShade" Background="{StaticResource Card.CoverHover}" IsHitTestVisible="False"
          Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}">
   <Border.Style><Style TargetType="Border">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
     <Condition Binding="{Binding CanPlay}" Value="True"/>
     <Condition Binding="{Binding Visibility,ElementName=PreviewBlock}" Value="Collapsed"/>
    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
   </Style></Border.Style>
  </Border>
  <Border x:Name="ExpansionShade" Grid.RowSpan="2" Background="{Binding Background,ElementName=Surface}" IsHitTestVisible="False">
   <Border.Style><Style TargetType="Border">
    <Setter Property="Visibility" Value="{Binding Visibility,ElementName=PreviewBlock}"/>
    <Setter Property="Opacity" Value="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}"/>
    <Setter Property="OpacityMask"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
     <GradientStop Color="#00FFFFFF"/><GradientStop Color="#BFFFFFFF" Offset=".32"/><GradientStop Color="White" Offset=".6"/>
    </LinearGradientBrush></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Visibility" Value="Visible"/>
     <Setter Property="Opacity" Value="1"/><Setter Property="OpacityMask" Value="{x:Null}"/>
    </Trigger></Style.Triggers>
   </Style></Border.Style>
  </Border>
  <Border x:Name="TitleShade" Height="64" VerticalAlignment="Top" IsHitTestVisible="False">
   <Border.Style><Style TargetType="Border">
    <Setter Property="Background"><Setter.Value><MultiBinding Converter="{StaticResource EntryTitleShade}">
     <Binding Path="HasTopPalette" ElementName="DecorationLayer"/><Binding Path="TopPaletteBrush" ElementName="DecorationLayer"/>
     <Binding Path="TopPaletteBrush" ElementName="Cover"/>
    </MultiBinding></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    </Trigger></Style.Triggers>
   </Style></Border.Style>
  </Border>
   <Grid x:Name="TitleHeader" Panel.ZIndex="1" Margin="10,10,10,0" VerticalAlignment="Top" IsHitTestVisible="False">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid Width="17" Height="18" Margin="0,2,6,0" VerticalAlignment="Top" Visibility="{Binding HasCalendarDay,Converter={StaticResource Visible}}">
     <Border BorderBrush="{Binding Foreground,ElementName=Entry}" BorderThickness="1" CornerRadius="2" Margin="0,3,0,0"/>
     <Path Data="M 0,7 L 17,7 M 4,0 L 4,5 M 13,0 L 13,5" Stroke="{Binding Foreground,ElementName=Entry}" StrokeThickness="1"/>
     <TextBlock Text="{Binding DayOfMonth}" Foreground="{Binding Foreground,ElementName=Entry}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
    </Grid>
    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding Foreground,ElementName=Entry}" FontSize="17" LineHeight="24" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
   </Grid>
  <Canvas x:Name="CaptionHost" Grid.Row="1" Margin="10,6" IsHitTestVisible="False">
   <StackPanel x:Name="ContentBlock" Width="{Binding ActualWidth,ElementName=CaptionHost}">
    <StackPanel.RenderTransform><TranslateTransform><TranslateTransform.Y><MultiBinding Converter="{StaticResource ContentOffset}">
     <Binding Path="ActualHeight" ElementName="ContentBlock"/><Binding Path="ActualHeight" ElementName="CaptionSlot"/>
     <Binding Path="(local:CardMotion.Progress)" ElementName="Surface"/>
    </MultiBinding></TranslateTransform.Y></TranslateTransform></StackPanel.RenderTransform>
    <Grid x:Name="CaptionSlot" Height="36">
     <TextBlock x:Name="Caption" Text="{Binding Subtitle}" Foreground="{Binding Foreground,ElementName=Entry}" FontSize="{StaticResource MeowFilm.Font.Size.Caption}" LineHeight="18" LineStackingStrategy="BlockLineHeight"
      VerticalAlignment="Bottom" MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
    </Grid>
    <Border x:Name="PreviewBlock" Padding="0,8,40,0" MinHeight="44" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
      <MultiDataTrigger><MultiDataTrigger.Conditions>
       <Condition Binding="{Binding IsPreviewEntry}" Value="True"/><Condition Binding="{Binding HasPreview}" Value="True"/>
      </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
     </Style.Triggers></Style></Border.Style>
     <ItemsControl ItemsSource="{Binding PreviewTitles}" VerticalAlignment="Bottom"><ItemsControl.ItemTemplate><DataTemplate>
      <TextBlock Text="{Binding}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type local:EntryCard}}}" FontSize="{StaticResource MeowFilm.Font.Size.Compact}" Height="25" TextTrimming="CharacterEllipsis"/>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </Border>
   </StackPanel>
  </Canvas>
  <Button x:Name="OpenButton" Grid.RowSpan="2" Tag="{Binding}" Click="Open_Click" IsEnabled="{Binding CanOpen}" Style="{StaticResource HitButton}" AutomationProperties.Name="{Binding Title}"/>
  <Button x:Name="PlayButton" Width="36" Height="36" Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
   Click="Play_Click" IsEnabled="{Binding CanPlay}" AutomationProperties.Name="{Binding Title,StringFormat=播放 {0}}"
   Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}">
   <Button.Style><Style TargetType="Button" BasedOn="{StaticResource HitButton}"><Style.Triggers>
    <MultiDataTrigger><MultiDataTrigger.Conditions>
     <Condition Binding="{Binding IsPreviewEntry}" Value="True"/><Condition Binding="{Binding HasPreview}" Value="True"/>
    </MultiDataTrigger.Conditions><Setter Property="Grid.RowSpan" Value="2"/></MultiDataTrigger>
    <DataTrigger Binding="{Binding CanPlay}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    <DataTrigger Binding="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}" Value="0"><Setter Property="IsHitTestVisible" Value="False"/></DataTrigger>
   </Style.Triggers></Style></Button.Style>
   <local:CardPlayGlyph IsBusy="{Binding IsPreparing}" Foreground="{Binding Foreground,ElementName=Entry}"/>
  </Button>
 </Grid>
</UserControl>
