<UserControl x:Class="MeowFilm.Capabilities.EntryCard" x:Name="Entry" Foreground="White"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities" xmlns:art="using:MeowFilm.Desktop.Artwork">
 <UserControl.Resources><local:MusicVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <Grid x:Name="Surface" CornerRadius="8" local:CardClip.Radius="8" local:CardMotion.Enabled="True">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <Grid x:Name="ArtworkFrame" Height="{Binding ActualWidth,ElementName=Surface}">
   <art:ArtworkImage x:Name="Cover" Address="{Binding Cover}" DisplayIdentity="{Binding Song.Id}"/>
   <Grid Height="64" VerticalAlignment="Top" IsHitTestVisible="False">
    <Grid><Grid.Clip><RectangleGeometry Rect="0,0,0,0"/></Grid.Clip><art:ArtworkImage x:Name="DecorationLayer" Address="{Binding Decoration}" ShowRetry="False" Height="{Binding ActualHeight,ElementName=ArtworkFrame}" VerticalAlignment="Top"/></Grid>
    <local:MusicArtworkFade Source="{Binding ElementName=DecorationLayer}" Decoration="True"/>
   </Grid>
  </Grid>
  <Border x:Name="BottomShade" IsHitTestVisible="False"/>
  <Border x:Name="CoverShade" Background="#40000000" IsHitTestVisible="False" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}"/>
  <Border x:Name="ExpansionShade" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}"/>
  <Border x:Name="TitleShade" Visibility="{Binding HasLabel,Converter={StaticResource Visible}}" Height="64" VerticalAlignment="Top" IsHitTestVisible="False"/>
  <Grid x:Name="TitleHeader" Visibility="{Binding HasLabel,Converter={StaticResource Visible}}" Canvas.ZIndex="1" Margin="10,10,10,0" VerticalAlignment="Top" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Width="17" Height="18" Margin="0,2,6,0" VerticalAlignment="Top" Visibility="{Binding HasCalendarDay,Converter={StaticResource Visible}}">
    <Border BorderBrush="{Binding Foreground,ElementName=Entry}" BorderThickness="1" CornerRadius="2" Margin="0,3,0,0"/><Path Data="M 0,7 L 17,7 M 4,0 L 4,5 M 13,0 L 13,5" Stroke="{Binding Foreground,ElementName=Entry}" StrokeThickness="1"/>
    <TextBlock Text="{Binding DayOfMonth}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
   </Grid>
   <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="17" LineHeight="24" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
  </Grid>
  <Canvas x:Name="CaptionHost" Grid.Row="1" Margin="10,6" IsHitTestVisible="False">
   <StackPanel x:Name="ContentBlock" Width="{Binding ActualWidth,ElementName=CaptionHost}">
    <StackPanel.RenderTransform><TranslateTransform x:Name="ContentTranslation"/></StackPanel.RenderTransform>
    <Grid x:Name="CaptionSlot" Height="36"><TextBlock x:Name="Caption" Text="{Binding Caption}" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Bottom" MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/></Grid>
    <Border x:Name="PreviewBlock" Padding="0,8,40,0" MinHeight="44" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}">
     <ItemsControl ItemsSource="{Binding PreviewTitles}" VerticalAlignment="Bottom"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="13" Height="25" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground,ElementName=Entry}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </Border>
   </StackPanel>
  </Canvas>
  <Button x:Name="OpenButton" Grid.RowSpan="2" Tag="{Binding}" Click="Open_Click" IsEnabled="{Binding CanOpen}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding Title}"/>
  <Button x:Name="PlayButton" Width="36" Height="36" Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Play_Click" IsEnabled="{Binding CanPlay}" AutomationProperties.Name="{Binding Title}" Background="Transparent" BorderThickness="0" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}">
   <local:CardPlayGlyph IsBusy="{Binding IsPreparing}" Foreground="{Binding Foreground,ElementName=Entry}"/>
  </Button>
 </Grid>
</UserControl>
