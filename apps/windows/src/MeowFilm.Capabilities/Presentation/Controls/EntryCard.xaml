<UserControl x:Class="MeowFilm.Capabilities.EntryCard" x:Name="Entry"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:art="clr-namespace:MeowFilm.Desktop.Artwork;assembly=MeowFilm.Desktop"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <local:MusicCatalogPaletteConverter x:Key="EntryPalette"/>
  <local:MusicEntryTitlePaletteConverter x:Key="EntryTitleShade"/>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style x:Key="HitButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/>
   <Setter Property="FocusVisualStyle" Value="{DynamicResource MeowFilm.FocusVisual}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="Surface" local:CardMotion.Enabled="True" local:CardClip.Radius="8">
  <Grid.Background><Binding Path="RawPaletteBrush" ElementName="Cover" Converter="{StaticResource EntryPalette}"/></Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="ArtworkFrame" Height="{Binding ActualWidth,ElementName=Surface}">
   <art:ArtworkImage x:Name="Cover" Address="{Binding Cover}"/>
   <Grid Height="64" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
    <Grid.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="White" Offset=".45"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Grid.OpacityMask>
    <art:ArtworkImage x:Name="DecorationLayer" Address="{Binding Decoration}" ShowRetry="False" Height="{Binding ActualHeight,ElementName=ArtworkFrame}" VerticalAlignment="Top"/>
   </Grid>
   <Border x:Name="TitleShade" Height="80" VerticalAlignment="Top" IsHitTestVisible="False">
    <Border.Background><MultiBinding Converter="{StaticResource EntryTitleShade}">
     <Binding Path="HasTopPalette" ElementName="DecorationLayer"/><Binding Path="TopPaletteBrush" ElementName="DecorationLayer"/><Binding Path="TopPaletteBrush" ElementName="Cover"/>
    </MultiBinding></Border.Background>
   </Border>
   <Grid Margin="10,10,10,0" VerticalAlignment="Top" IsHitTestVisible="False">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid Width="17" Height="18" Margin="0,2,6,0" VerticalAlignment="Top" Visibility="{Binding HasCalendarDay,Converter={StaticResource Visible}}">
     <Border BorderBrush="White" BorderThickness="1" CornerRadius="2" Margin="0,3,0,0"/>
     <Path Data="M 0,7 L 17,7 M 4,0 L 4,5 M 13,0 L 13,5" Stroke="White" StrokeThickness="1"/>
     <TextBlock Text="{Binding DayOfMonth}" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
    </Grid>
    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontSize="17" FontWeight="SemiBold" LineHeight="24" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
   </Grid>
   <Border VerticalAlignment="Bottom" MinHeight="80" Padding="10,28,52,12" IsHitTestVisible="False"
     Visibility="{Binding CanPlay,Converter={StaticResource Visible}}" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000"/><GradientStop Color="#B0000000" Offset=".4"/><GradientStop Color="#DA000000" Offset="1"/></LinearGradientBrush></Border.Background>
    <ItemsControl ItemsSource="{Binding PreviewTitles}" Visibility="{Binding IsPreviewEntry,Converter={StaticResource Visible}}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="White" FontSize="13" Height="25" TextTrimming="CharacterEllipsis"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </Border>
  </Grid>
  <TextBlock x:Name="Caption" Grid.Row="1" Margin="10,8" Text="{Binding Subtitle}" Foreground="White" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
   <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
    <DataTrigger Binding="{Binding Subtitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
   </Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  <Button x:Name="OpenButton" Grid.RowSpan="2" Tag="{Binding}" Click="Open_Click" IsEnabled="{Binding CanOpen}" Style="{StaticResource HitButton}" AutomationProperties.Name="{Binding Title}"/>
  <Button x:Name="PlayButton" Width="36" Height="36" Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
   Click="Play_Click" IsEnabled="{Binding CanPlay}" AutomationProperties.Name="{Binding Title,StringFormat=播放 {0}}"
   Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}">
   <Button.Style><Style TargetType="Button" BasedOn="{StaticResource HitButton}"><Style.Triggers>
    <DataTrigger Binding="{Binding CanPlay}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    <DataTrigger Binding="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}" Value="0"><Setter Property="IsHitTestVisible" Value="False"/></DataTrigger>
   </Style.Triggers></Style></Button.Style>
   <local:CardPlayGlyph IsBusy="{Binding IsPreparing}" Foreground="White"/>
  </Button>
 </Grid>
</UserControl>
