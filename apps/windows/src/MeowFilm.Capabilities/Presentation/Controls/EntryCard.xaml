<UserControl x:Class="MeowFilm.Capabilities.EntryCard" x:Name="Entry"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:art="clr-namespace:MeowFilm.Desktop.Artwork;assembly=MeowFilm.Desktop"
 FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}">
 <UserControl.Resources>
  <local:MusicEntryOffsetConverter x:Key="Offset"/>
  <local:MusicCatalogPaletteConverter x:Key="EntryPalette" Role="Entry"/>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style x:Key="HitButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="Surface" local:CardMotion.Enabled="True" local:CardClip.Radius="4">
  <Grid.Background><MultiBinding Converter="{StaticResource EntryPalette}">
   <Binding Path="RawPaletteBrush" ElementName="Cover"/><Binding Path="Presentation"/>
  </MultiBinding></Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <Grid Height="{Binding ActualWidth,ElementName=Surface}">
   <art:ArtworkImage x:Name="Cover" Address="{Binding Cover}"/>
    <Border Background="#48000000" Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}" IsHitTestVisible="False">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
      <DataTrigger Binding="{Binding IsOverlayEntry}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding IsAnimatedEntry}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     </Style.Triggers></Style></Border.Style>
    </Border>
  </Grid>
   <Border Grid.RowSpan="2"
   Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}"
   Visibility="{Binding IsPreviewEntry,Converter={StaticResource Visible}}" IsHitTestVisible="False">
   <Border.Background><MultiBinding Converter="{StaticResource EntryPalette}">
    <Binding Path="RawPaletteBrush" ElementName="Cover"/><Binding Path="Presentation"/>
   </MultiBinding></Border.Background>
   <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000"/><GradientStop Color="#BFFFFFFF" Offset=".32"/><GradientStop Color="White" Offset=".6"/></LinearGradientBrush></Border.OpacityMask>
  </Border>
  <Button x:Name="OpenButton" Grid.RowSpan="2" Tag="{Binding}" Click="Open_Click" IsEnabled="{Binding CanOpen}" Style="{StaticResource HitButton}" AutomationProperties.Name="{Binding Title}"/>
  <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" FontWeight="Bold" LineHeight="24" LineStackingStrategy="BlockLineHeight"
   Margin="10,9,8,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
  <StackPanel Grid.RowSpan="2" Margin="10,6,10,0" VerticalAlignment="Top" IsHitTestVisible="False">
   <StackPanel.RenderTransform><TranslateTransform><TranslateTransform.Y><MultiBinding Converter="{StaticResource Offset}"><Binding Path="ActualWidth" ElementName="Surface"/><Binding Path="(local:CardMotion.Progress)" ElementName="Surface"/><Binding Path="IsPreviewEntry"/></MultiBinding></TranslateTransform.Y></TranslateTransform></StackPanel.RenderTransform>
   <TextBlock Text="{Binding Subtitle}" Foreground="White" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" Height="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
   <ItemsControl ItemsSource="{Binding PreviewTitles,ElementName=Entry}" Margin="0,8,32,0"
    Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}" Visibility="{Binding IsPreviewEntry,Converter={StaticResource Visible}}">
    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#DCFFFFFF" FontSize="13" Height="25" TextTrimming="CharacterEllipsis"/></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel>
  <Button x:Name="PlayButton" Grid.RowSpan="2" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Bottom"
   Click="Play_Click" IsEnabled="{Binding CanPlay}" AutomationProperties.Name="{Binding Title,StringFormat=播放 {0}}"
   Opacity="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}">
   <Button.Style><Style TargetType="Button" BasedOn="{StaticResource HitButton}">
     <Setter Property="Margin" Value="0,0,6,10"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsPreviewEntry}" Value="True"/><Condition Binding="{Binding CanPlay}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsOverlayEntry}" Value="True"/><Condition Binding="{Binding CanPlay}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/><Setter Property="Margin" Value="0,0,6,58"/></MultiDataTrigger>
      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsAnimatedEntry}" Value="True"/><Condition Binding="{Binding CanPlay}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/><Setter Property="Margin" Value="0,0,6,58"/></MultiDataTrigger>
     <DataTrigger Binding="{Binding Path=(local:CardMotion.Progress),ElementName=Surface}" Value="0"><Setter Property="IsHitTestVisible" Value="False"/></DataTrigger>
    </Style.Triggers></Style></Button.Style>
   <Path Data="M 2,1 Q 0,0 0,3 L 0,25 Q 0,28 3,26 L 23,15 Q 26,13 23,11 Z" Fill="White" Width="24" Height="28" Stretch="Fill"/>
  </Button>
 </Grid>
</UserControl>
