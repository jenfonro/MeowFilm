<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MeowFilm.Threading/MeowFilm.Threading.csproj" />
    <EmbeddedResource Include="Film/Rules/FilmRuleDefaults.json" LogicalName="MeowFilm.FilmRuleDefaults.json" />
    <Content Include="Music/Accounts/Presentation/Assets/*.png" />
    <Content Include="Film/Presentation/Assets/*.jpg" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="[10.0.15]" />
    <PackageReference Include="ZXing.Net" Version="[0.16.11]" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="[3.2.1]" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.4314.35]" />
    <ProjectReference Include="../MeowFilm.Desktop/MeowFilm.Desktop.csproj" />
    <ProjectReference Include="../MeowFilm.Platform/MeowFilm.Platform.csproj" />
    <ProjectReference Include="../MeowFilm.Media/MeowFilm.Media.csproj" />
    <ProjectReference Include="../MeowFilm.Audio/MeowFilm.Audio.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[1.8.260921001]" />
  </ItemGroup>
</Project>
