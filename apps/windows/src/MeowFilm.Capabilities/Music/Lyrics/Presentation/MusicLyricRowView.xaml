<UserControl x:Class="MeowFilm.Capabilities.MusicLyricRowView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="using:MeowFilm.Desktop"
 IsTabStop="False" IsHitTestVisible="False">
 <Border Padding="76,11,16,11" MinHeight="47">
  <StackPanel>
   <TextBlock x:Name="PlainText" FontSize="20" TextWrapping="Wrap"/>
   <desktop:WrapPanel x:Name="WordsPanel"/>
   <TextBlock x:Name="LyricTranslation" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed"/>
   <TextBlock x:Name="RomanizationText" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed"/>
  </StackPanel>
 </Border>
</UserControl>
