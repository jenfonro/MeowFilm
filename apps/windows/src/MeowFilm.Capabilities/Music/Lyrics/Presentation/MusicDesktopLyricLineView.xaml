<UserControl x:Class="MeowFilm.Capabilities.MusicDesktopLyricLineView" x:Name="Root" IsHitTestVisible="False"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MeowFilm.Capabilities">
 <StackPanel Margin="2" VerticalAlignment="Center">
  <Viewbox Stretch="Uniform" MaxHeight="50" HorizontalAlignment="{x:Bind HorizontalContentAlignment,Mode=OneWay}">
   <Grid><local:MusicDesktopLyricTextView x:Name="PlainText" Text="{x:Bind Row.Text,Mode=OneWay,TargetNullValue='',FallbackValue=''}" FontSize="32" Foreground="{x:Bind Normal,Mode=OneWay}"/>
    <StackPanel x:Name="Words" Orientation="Horizontal" Visibility="Collapsed"/>
   </Grid>
  </Viewbox>
  <Viewbox x:Name="TranslationFrame" Stretch="Uniform" MaxHeight="27" Margin="0,3,0,0" HorizontalAlignment="{x:Bind HorizontalContentAlignment,Mode=OneWay}">
   <local:MusicDesktopLyricTextView x:Name="TranslationText" Text="{x:Bind Row.Translation,Mode=OneWay,TargetNullValue='',FallbackValue=''}" FontSize="17" Foreground="{x:Bind Normal,Mode=OneWay}"/>
  </Viewbox>
 </StackPanel>
</UserControl>
