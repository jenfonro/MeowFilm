<UserControl x:Class="MeowFilm.Capabilities.MusicDesktopLyricLineView" x:Name="Root" IsHitTestVisible="False"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MeowFilm.Capabilities">
 <StackPanel Margin="2" VerticalAlignment="Center" HorizontalAlignment="Stretch">
  <Grid x:Name="MainLineSurface" HorizontalAlignment="{x:Bind HorizontalContentAlignment,Mode=OneWay}">
   <Image x:Name="StrokeImage" Stretch="None" IsHitTestVisible="False"/>
   <Image x:Name="NormalImage" Stretch="None" IsHitTestVisible="False"/>
   <Image x:Name="HighlightImage" Stretch="None" IsHitTestVisible="False"/>
  </Grid>
  <local:MusicDesktopLyricTextView x:Name="TranslationText" Margin="0,3,0,0"
   HorizontalAlignment="{x:Bind HorizontalContentAlignment,Mode=OneWay}"
   Text="{x:Bind Row.Translation,Mode=OneWay,TargetNullValue='',FallbackValue=''}" FontSize="17"
   Foreground="{x:Bind Normal,Mode=OneWay}"/>
 </StackPanel>
</UserControl>
