<Window x:Class="MeowFilm.Capabilities.MusicDesktopLyricsWindow" Title="meowfilm 桌面歌词"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MeowFilm.Capabilities">
 <Border x:Name="LyricsFrame" Background="Transparent" PointerPressed="Lyrics_PointerPressed" PointerEntered="Lyrics_PointerEntered" AutomationProperties.Name="桌面歌词">
  <Border.Resources><Style TargetType="Button" BasedOn="{StaticResource MeowFilm.GhostButton}"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="0"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Foreground" Value="#F5F5F5"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="15"/><Setter Property="CornerRadius" Value="5"/></Style></Border.Resources>
  <Grid RequestedTheme="Dark">
   <Border x:Name="HoverSurface" Visibility="Collapsed" CornerRadius="8" Background="#B3212121"/>
   <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel x:Name="Toolbar" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,4">
     <Button x:Name="ActivateButton" Content="&#xE8D6;" Click="Activate_Click" AutomationProperties.Name="打开 meowfilm"/>
     <Button x:Name="DelayButton" Click="Delay_Click" IsEnabled="{x:Bind Lyrics.CanAdjustLyricOffset,Mode=OneWay}" AutomationProperties.Name="歌词延后 0.5 秒">
      <Grid Width="26" Height="26" IsHitTestVisible="False">
       <Path Data="M4,9 A9.85,9.85 0 1 1 4,17 M4,4.5 L4,9 8.5,9" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{x:Bind DelayButton.Foreground,Mode=OneWay}"/>
       <TextBlock Text="5" FontFamily="XamlAutoFontFamily" FontSize="10" Margin="0,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{x:Bind DelayButton.Foreground,Mode=OneWay}"/>
      </Grid>
     </Button>
     <Button x:Name="AdvanceButton" Click="Advance_Click" IsEnabled="{x:Bind Lyrics.CanAdjustLyricOffset,Mode=OneWay}" AutomationProperties.Name="歌词提前 0.5 秒">
      <Grid Width="26" Height="26" IsHitTestVisible="False">
       <Path Data="M22,9 A9.85,9.85 0 1 0 22,17 M22,4.5 L22,9 17.5,9" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{x:Bind AdvanceButton.Foreground,Mode=OneWay}"/>
       <TextBlock Text="5" FontFamily="XamlAutoFontFamily" FontSize="10" Margin="0,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{x:Bind AdvanceButton.Foreground,Mode=OneWay}"/>
      </Grid>
     </Button>
     <Button x:Name="PreviousButton" Content="&#xE892;" Click="Previous_Click" IsEnabled="{x:Bind Playback.CanStep,Mode=OneWay}" AutomationProperties.Name="上一首"/>
     <Button x:Name="PlaybackButton" Content="&#xE768;" Click="Playback_Click" IsEnabled="{x:Bind Playback.CanTogglePlayback,Mode=OneWay}" AutomationProperties.Name="播放或暂停"/>
     <Button x:Name="NextButton" Content="&#xE893;" Click="Next_Click" IsEnabled="{x:Bind Playback.CanStep,Mode=OneWay}" AutomationProperties.Name="下一首"/>
     <Button x:Name="SettingsButton" Content="&#xE713;" Click="Settings_Click" AutomationProperties.Name="桌面歌词设置"/>
     <Button x:Name="LockButton" Content="&#xE72E;" Click="Lock_Click" AutomationProperties.Name="锁定桌面歌词"/>
     <Button x:Name="CloseButton" Content="&#xE711;" Click="Close_Click" AutomationProperties.Name="关闭桌面歌词"/>
    </StackPanel>
    <local:MusicLyricList x:Name="LyricPresenter" Grid.Row="1" Margin="22,0,22,12" Position="{x:Bind Lyrics.LyricPositionSeconds,Mode=OneWay}" IsPlaying="{x:Bind Playback.IsPlaying,Mode=OneWay}" PlaybackRate="{x:Bind Playback.AcceptedPlaybackRate,Mode=OneWay}" PresentationKey="{x:Bind Playback.PlaybackPresentationKey,Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="0" IsTabStop="False" IsHitTestVisible="False" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource MeowFilm.BareListViewItem}"><Setter Property="IsTabStop" Value="False"/></Style></ListView.ItemContainerStyle>
     <Grid x:Name="LineSurface">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="BottomTrack" Height="0"/></Grid.RowDefinitions>
       <local:MusicDesktopLyricLineView x:Name="TopLine" Row="{x:Bind Lyrics.DesktopLyricTopRow,Mode=OneWay}" ShowTranslation="{x:Bind Lyrics.ShowLyricTranslation,Mode=OneWay}"/>
       <local:MusicDesktopLyricLineView x:Name="BottomLine" Grid.Row="1" Row="{x:Bind Lyrics.DesktopLyricBottomRow,Mode=OneWay}" Margin="0,8,0,0" HorizontalContentAlignment="Right" ShowTranslation="{x:Bind Lyrics.ShowLyricTranslation,Mode=OneWay}"/>
      </Grid>
      <Viewbox x:Name="Status" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" MaxHeight="50" Margin="2"><local:MusicDesktopLyricTextView x:Name="StatusText" Text="{x:Bind Lyrics.DesktopLyricText,Mode=OneWay}" FontSize="30"/></Viewbox>
     </Grid>
    </local:MusicLyricList>
   </Grid>
  </Grid>
 </Border>
</Window>
