<Window x:Class="MeowFilm.Capabilities.MusicDesktopLyricColorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="RootSurface" Padding="20" Background="{ThemeResource MeowFilm.Brush.FloatingSurface}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock x:Name="ColorLabel" Style="{StaticResource MeowFilm.SectionHeading}" Margin="0,0,0,12"/>
  <ColorPicker x:Name="Selection" Grid.Row="1" IsAlphaEnabled="False" IsMoreButtonVisible="False"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
   <Button Content="取消" Style="{StaticResource MeowFilm.GhostButton}" MinWidth="72" Click="Cancel_Click"/>
   <Button x:Name="SaveButton" Content="确定" Style="{StaticResource MeowFilm.PrimaryButton}" MinWidth="72" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
