<UserControl x:Class="MeowFilm.Capabilities.MusicCatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MeowFilm.Capabilities" xmlns:art="using:MeowFilm.Desktop.Artwork" xmlns:desktop="using:MeowFilm.Desktop">
 <UserControl.Resources><ResourceDictionary>
  <Style TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}"><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="Catalog.ChannelFlat" TargetType="Button">
   <Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="18"/><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{ThemeResource MeowFilm.Brush.Muted}"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Catalog.ChannelTab" TargetType="ToggleButton">
   <Setter Property="FontWeight" Value="Normal"/><Setter Property="FontFamily" Value="XamlAutoFontFamily"/><Setter Property="FontSize" Value="18"/>
   <Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,0,24,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Foreground" Value="{ThemeResource MeowFilm.Brush.Muted}"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Grid Background="Transparent">
     <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/>
      <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Text}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Text}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Disabled}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Text}"/><Setter Target="SelectionUnderline.Background" Value="{ThemeResource MeowFilm.Brush.Accent}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Text}"/><Setter Target="SelectionUnderline.Background" Value="{ThemeResource MeowFilm.Brush.Accent}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Text}"/><Setter Target="SelectionUnderline.Background" Value="{ThemeResource MeowFilm.Brush.Accent}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Disabled}"/><Setter Target="SelectionUnderline.Background" Value="{ThemeResource MeowFilm.Brush.Accent}"/></VisualState.Setters></VisualState>
     </VisualStateGroup></VisualStateManager.VisualStateGroups>
     <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Margin="0,0,0,4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="Normal"/>
     <Border x:Name="SelectionUnderline" Width="16" Height="3" CornerRadius="1.5" Background="{TemplateBinding BorderBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Catalog.ChannelTag" TargetType="ToggleButton">
   <Setter Property="Width" Value="78"/><Setter Property="Height" Value="31"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
   <Setter Property="Margin" Value="0,0,12,14"/><Setter Property="Padding" Value="8,2"/>
   <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Compact}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FontFamily" Value="XamlAutoFontFamily"/>
   <Setter Property="CornerRadius" Value="16"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Foreground" Value="{ThemeResource MeowFilm.Brush.Muted}"/><Setter Property="Background" Value="{ThemeResource MeowFilm.Brush.InputSurface}"/><Setter Property="BorderBrush" Value="{ThemeResource MeowFilm.Brush.Border}"/>
   <Setter Property="UseSystemFocusVisuals" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Grid>
     <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/>
      <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource MeowFilm.Brush.Hover}"/><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Text}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource MeowFilm.Brush.Pressed}"/><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Text}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Disabled}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}"/><Setter Target="Surface.BorderBrush" Value="{ThemeResource MeowFilm.Brush.Accent}"/><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Accent}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}"/><Setter Target="Surface.BorderBrush" Value="{ThemeResource MeowFilm.Brush.Accent}"/><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Accent}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}"/><Setter Target="Surface.BorderBrush" Value="{ThemeResource MeowFilm.Brush.Accent}"/><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Accent}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}"/><Setter Target="Surface.BorderBrush" Value="{ThemeResource MeowFilm.Brush.Accent}"/><Setter Target="Label.Foreground" Value="{ThemeResource MeowFilm.Brush.Disabled}"/></VisualState.Setters></VisualState>
     </VisualStateGroup></VisualStateManager.VisualStateGroups>
     <Border x:Name="Surface" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="Normal"/>
     </Border>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Catalog.ChannelFilter" TargetType="ToggleButton" BasedOn="{StaticResource Catalog.ChannelTag}">
   <Setter Property="MinWidth" Value="62"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Padding" Value="14,2"/>
  </Style>
  <DataTemplate x:Key="Section"><local:MusicCatalogSectionView/></DataTemplate>
  <Flyout x:Name="ChannelMorePopup" Placement="BottomEdgeAlignedRight" Opened="ChannelMore_Opened" Closed="ChannelMore_Closed">
   <Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter" BasedOn="{StaticResource MeowFilm.FlyoutPresenter}"><Setter Property="Padding" Value="14"/><Setter Property="CornerRadius" Value="10"/><Setter Property="MaxWidth" Value="570"/></Style></Flyout.FlyoutPresenterStyle>
   <ScrollViewer x:Name="ChannelMoreContent" MaxHeight="308" Width="540" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{x:Bind Catalog.MoreChannelTabs,Mode=OneWay}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><desktop:WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:MusicCatalogCard"><ToggleButton Style="{StaticResource Catalog.ChannelTag}" Content="{x:Bind Title,Mode=OneWay}" Tag="{x:Bind}" Click="Card_Click" IsEnabled="{x:Bind CanOpen,Mode=OneWay}" IsChecked="{x:Bind IsSelected,Mode=OneWay}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </Flyout>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <Grid x:Name="ChannelHeader" Margin="40,0,40,12" MaxWidth="1490" Height="36" Visibility="{x:Bind Catalog.HasChannelTabs,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{x:Bind Catalog.VisibleChannelTabs,Mode=OneWay}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:MusicCatalogCard"><ToggleButton Content="{x:Bind Title,Mode=OneWay}" Tag="{x:Bind}" Click="Card_Click" IsEnabled="{x:Bind CanOpen,Mode=OneWay}" IsChecked="{x:Bind IsSelected,Mode=OneWay}" Style="{StaticResource Catalog.ChannelTab}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <Button x:Name="ChannelMoreButton" Grid.Column="1" Style="{StaticResource Catalog.ChannelFlat}" Click="ChannelMore_Click" Visibility="{x:Bind Catalog.HasMoreChannelTabs,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" AutomationProperties.Name="更多频道"><StackPanel Orientation="Horizontal"><TextBlock Text="更多" VerticalAlignment="Center"/><Path Width="8" Height="5" Margin="4,2,0,0" Data="M1,1 L4,4 L7,1" Stretch="Fill" Stroke="{ThemeResource MeowFilm.Brush.Muted}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"><Path.RenderTransform><RotateTransform x:Name="ChannelMoreChevron" CenterX="4" CenterY="2.5"/></Path.RenderTransform></Path></StackPanel></Button>
   </Grid>
   <desktop:WrapPanel Visibility="{x:Bind Catalog.IsCatalogUtilityPage,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" Margin="0,0,0,12">
    <Button Content="返回搜索" Click="SearchBack_Click" Visibility="{x:Bind Search.HasSearchSession,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}"/>
    <ComboBox ItemsSource="{x:Bind Catalog.CatalogPlatformChoices,Mode=OneWay}" DisplayMemberPath="Name" SelectedItem="{x:Bind Catalog.SelectedCatalogPlatform,Mode=OneWay}" SelectionChanged="Platform_Changed" Width="150" Margin="0,0,12,8" IsEnabled="{x:Bind Catalog.CanCatalogBrowse,Mode=OneWay,FallbackValue=False}" AutomationProperties.Name="内容平台"/>
    <TextBlock Text="{x:Bind Catalog.CatalogAccountText,Mode=OneWay,TargetNullValue=''}" VerticalAlignment="Center" Margin="0,0,8,8"/><Button Content="读取账号" Click="Account_Click" IsEnabled="{x:Bind Catalog.CanCatalogBrowse,Mode=OneWay,FallbackValue=False}"/>
    <ComboBox ItemsSource="{x:Bind Catalog.CatalogPersonalKinds,Mode=OneWay}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{x:Bind Catalog.CatalogPersonalKind,Mode=OneWay}" SelectionChanged="Options_Changed" Width="130" Margin="0,0,12,8" Visibility="{x:Bind Catalog.IsCatalogPersonal,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" IsEnabled="{x:Bind Catalog.CanCatalogBrowse,Mode=OneWay,FallbackValue=False}" AutomationProperties.Name="个人歌单类型"/>
    <ComboBox ItemsSource="{x:Bind Catalog.CatalogSearchKinds,Mode=OneWay}" SelectedItem="{x:Bind Catalog.CatalogSearchKind,Mode=OneWay}" SelectionChanged="Kind_Changed" Width="96" Margin="0,0,12,8" IsEnabled="{x:Bind Catalog.CanCatalogBrowse,Mode=OneWay,FallbackValue=False}" AutomationProperties.Name="搜索类型"/>
    <Button Content="上一页" Tag="-1" Click="Page_Click" IsEnabled="{x:Bind Catalog.CanCatalogPrevious,Mode=OneWay,FallbackValue=False}"/><TextBlock Text="{x:Bind Catalog.CatalogPageText,Mode=OneWay,TargetNullValue=''}" Margin="8,0" VerticalAlignment="Center"/><Button Content="下一页" Tag="1" Click="Page_Click" IsEnabled="{x:Bind Catalog.CanCatalogNext,Mode=OneWay,FallbackValue=False}"/>
    <Button Content="播放全部" Click="PlayAll_Click" Visibility="{x:Bind Catalog.IsCatalogBatch,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" IsEnabled="{x:Bind Catalog.CanPlayCatalogPlaylist,Mode=OneWay,FallbackValue=False}"/><Button Content="保存到本地歌单" Click="Save_Click" Visibility="{x:Bind Catalog.IsCatalogBatch,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" IsEnabled="{x:Bind Catalog.CanCatalogAction,Mode=OneWay,FallbackValue=False}"/>
    <Button Content="队列推荐" Click="QueueRecommendations_Click" IsEnabled="{x:Bind Catalog.CanCatalogWy,Mode=OneWay,FallbackValue=False}"/><Button Content="取消" Click="Cancel_Click" IsEnabled="{x:Bind Catalog.CanCancelCatalog,Mode=OneWay,FallbackValue=False}"/>
   </desktop:WrapPanel>
   <StackPanel Orientation="Horizontal" Margin="24,0,24,12" Visibility="{x:Bind Catalog.IsCatalogSalesChart,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}">
    <ComboBox x:Name="ChartKindPicker" Width="160" ItemsSource="{x:Bind Catalog.CatalogChartKinds,Mode=OneWay}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{x:Bind Catalog.CatalogChartKind,Mode=OneWay}" SelectionChanged="Chart_Changed"/>
    <ComboBox x:Name="ChartPeriodPicker" Width="90" Margin="12,0,0,0" ItemsSource="{x:Bind Catalog.CatalogChartPeriods,Mode=OneWay}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{x:Bind Catalog.CatalogChartPeriod,Mode=OneWay}" Visibility="{x:Bind Catalog.CatalogChartHasPeriods,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" SelectionChanged="Chart_Changed"/>
    <TextBox x:Name="ChartYearBox" Width="74" Margin="12,0,0,0" Text="{x:Bind Catalog.CatalogChartYear,Mode=OneWay,FallbackValue=''}" Visibility="{x:Bind Catalog.CatalogChartIsYearly,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" LostFocus="ChartYear_Changed" AutomationProperties.Name="榜单年份"/>
   </StackPanel>
   <ItemsControl x:Name="ChannelFilters" ItemsSource="{x:Bind Catalog.CatalogTagGroups,Mode=OneWay}" Visibility="{x:Bind Catalog.HasCatalogTags,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" Margin="40,0,40,16" MaxWidth="1490"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:MusicCatalogTagGroup"><ItemsControl ItemsSource="{x:Bind Items}" Margin="0,0,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><desktop:WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:MusicCatalogTag"><ToggleButton Content="{x:Bind Name}" Tag="{x:Bind}" IsChecked="{x:Bind Selected}" Click="Tag_Click" Style="{StaticResource Catalog.ChannelFilter}" Width="Auto"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
  <Grid Grid.Row="1">
   <ScrollViewer x:Name="HomeScroll" Visibility="{x:Bind Catalog.IsCatalogHome,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="HomeItems" ItemTemplate="{StaticResource Section}" Margin="40,0,40,24" MaxWidth="1490"/></ScrollViewer>
   <ScrollViewer x:Name="SearchOverviewScroll" Visibility="{x:Bind Search.IsSearchOverview,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="SearchOverviewItems" ItemTemplate="{StaticResource Section}"/></ScrollViewer>
   <ScrollViewer x:Name="UtilityScroll" Visibility="{x:Bind Catalog.IsUtilityCatalogSurface,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="UtilityItems" ItemTemplate="{StaticResource Section}"/></ScrollViewer>
   <GridView x:Name="SearchPlaylistList" SelectionMode="None" Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="CatalogScroll_Wheel" KeyDown="CatalogScroll_Key" ContainerContentChanging="SearchCard_Changing"><GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel><GridView.ItemTemplate><DataTemplate><local:MusicCatalogCardView Presentation="Playlist" MaxWidth="168" HorizontalAlignment="Stretch" Loaded="SearchCardView_Loaded"/></DataTemplate></GridView.ItemTemplate></GridView>
   <ScrollViewer x:Name="CatalogScroll" HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="CatalogScroll_Wheel" KeyDown="CatalogScroll_Key" ViewChanged="CatalogScroll_Changed">
    <StackPanel>
     <Grid Width="960" Height="184" Margin="40,0,40,32" HorizontalAlignment="Left" Visibility="{x:Bind Catalog.VipPage.HasCards,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}"><Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="16"/><ColumnDefinition Width="228"/><ColumnDefinition Width="16"/><ColumnDefinition Width="472"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" CornerRadius="8" Padding="12" Visibility="{x:Bind Catalog.VipPage.ShowAccount,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" AutomationProperties.Name="VIP 账号权益"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#211B1B"/><GradientStop Color="#5B3030" Offset="1"/></LinearGradientBrush></Border.Background>
       <Grid><StackPanel Margin="0,2,52,0"><TextBlock Text="{x:Bind Catalog.VipPage.Account.DisplayName,Mode=OneWay,TargetNullValue=''}" Foreground="White" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Catalog.VipPage.Account.Membership,Mode=OneWay,TargetNullValue=''}" Foreground="#CFC1C2" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Grid Width="40" Height="40" CornerRadius="20" local:CardClip.Radius="20" HorizontalAlignment="Right" VerticalAlignment="Top"><art:ArtworkImage Address="{x:Bind Catalog.VipPage.Account.Avatar,Mode=OneWay,TargetNullValue=''}"/></Grid></Grid>
      </Border>
      <Grid Grid.Column="2" CornerRadius="8" local:CardClip.Radius="8" Background="#FFF0D9" Visibility="{x:Bind Catalog.VipPage.ShowSign,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" AutomationProperties.Name="黑胶乐签"><art:ArtworkImage Address="{x:Bind Catalog.VipPage.Sign.Background,Mode=OneWay,TargetNullValue=''}"/><Grid Margin="12,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
       <TextBlock Text="{x:Bind Catalog.VipPage.Sign.Text,Mode=OneWay,TargetNullValue=''}" Foreground="#312923" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Text="{x:Bind Catalog.VipPage.Sign.SubText,Mode=OneWay,TargetNullValue=''}" Foreground="#9B7D68" FontSize="11" Margin="0,3,0,0"/>
       <ItemsControl Grid.Row="2" ItemsSource="{x:Bind Catalog.VipPage.Sign.Days,Mode=OneWay}" Margin="0,7,0,4" Height="40"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:MusicVipSignDay"><Border Loaded="SignDay_Loaded" Width="34" Height="34" Margin="7,0" CornerRadius="17" BorderThickness="1" BorderBrush="#C9A88C"><TextBlock Text="{x:Bind DayText}" FontSize="10" Foreground="#A48770" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Button Grid.Row="3" Content="{x:Bind Catalog.VipPage.SignButtonText,Mode=OneWay,TargetNullValue=''}" Click="VipSign_Click" Width="68" Height="24" MinHeight="0" Padding="0" HorizontalAlignment="Left" IsEnabled="{x:Bind Catalog.VipPage.CanSign,Mode=OneWay,FallbackValue=False}" Visibility="{x:Bind Catalog.VipPage.ShowSignButton,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" AutomationProperties.Name="黑胶乐签打卡"/>
      </Grid></Grid>
      <Button Grid.Column="4" Click="VipBanner_Click" Padding="0" IsEnabled="{x:Bind Catalog.VipPage.CanOpenBanner,Mode=OneWay,FallbackValue=False}" Visibility="{x:Bind Catalog.VipPage.ShowBanner,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" AutomationProperties.Name="VIP 活动"><Grid CornerRadius="8" local:CardClip.Radius="8"><art:ArtworkImage Address="{x:Bind Catalog.VipPage.Banner.ImageUrl,Mode=OneWay,TargetNullValue=''}"/></Grid></Button>
     </Grid>
     <Grid x:Name="ChannelPages" Margin="40,0,40,24" MaxWidth="1490"/>
    </StackPanel>
   </ScrollViewer>
   <ProgressRing x:Name="CatalogLoading" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed"/>
  </Grid>
 </Grid>
</UserControl>
