<UserControl x:Class="MeowFilm.Capabilities.EntryCard" x:Name="Entry" Foreground="White"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities" xmlns:art="using:MeowFilm.Desktop.Artwork">
 <Grid x:Name="Surface" CornerRadius="8" local:CardClip.Radius="8" local:CardMotion.Enabled="True">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <local:AspectRatioDecorator AspectRatio="1,1"><Grid x:Name="ArtworkFrame">
   <art:ArtworkImage x:Name="Cover" Address="{x:Bind Card.Cover,Mode=OneWay,FallbackValue='',TargetNullValue=''}" DisplayIdentity="{x:Bind Card.Song.Id,Mode=OneWay,FallbackValue='',TargetNullValue=''}"/>
   <Grid Height="64" VerticalAlignment="Top" IsHitTestVisible="False">
    <Grid><Grid.Clip><RectangleGeometry Rect="0,0,0,0"/></Grid.Clip><art:ArtworkImage x:Name="DecorationLayer" ResourceSlot="decoration" Address="{x:Bind Card.Decoration,Mode=OneWay,FallbackValue='',TargetNullValue=''}" ShowRetry="False" VerticalAlignment="Top"/></Grid>
    <local:MusicArtworkFade Source="{x:Bind DecorationLayer}" Decoration="True"/>
   </Grid>
  </Grid></local:AspectRatioDecorator>
  <Border x:Name="BottomShade" IsHitTestVisible="False"/>
  <Border x:Name="CoverShade" Background="{StaticResource Card.CoverHover}" IsHitTestVisible="False" Opacity="0"/>
  <Border x:Name="ExpansionShade" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0"/>
  <Border x:Name="TitleShade" Height="64" VerticalAlignment="Top" IsHitTestVisible="False"/>
  <Grid x:Name="TitleHeader" Visibility="{x:Bind Card.HasLabel,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" Canvas.ZIndex="1" Margin="10,10,10,0" VerticalAlignment="Top" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Width="17" Height="18" Margin="0,2,6,0" VerticalAlignment="Top" Visibility="{x:Bind Card.HasCalendarDay,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}">
    <Border BorderBrush="{x:Bind Foreground,Mode=OneWay}" BorderThickness="1" CornerRadius="2" Margin="0,3,0,0"/><Path Data="M 0,7 L 17,7 M 4,0 L 4,5 M 13,0 L 13,5" Stroke="{x:Bind Foreground,Mode=OneWay}" StrokeThickness="1"/>
    <TextBlock Text="{x:Bind Card.DayOfMonth,Mode=OneWay,TargetNullValue=''}" Foreground="{x:Bind Foreground,Mode=OneWay}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
   </Grid>
   <TextBlock Grid.Column="1" Text="{x:Bind Card.Label,Mode=OneWay,TargetNullValue=''}" Foreground="{x:Bind Foreground,Mode=OneWay}" FontSize="17" LineHeight="24" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
  </Grid>
  <Grid x:Name="CoverInfo" Visibility="{x:Bind Card.HasLabel,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},ConverterParameter=Not,FallbackValue=Collapsed}" Margin="10,10,10,0" VerticalAlignment="Top" IsHitTestVisible="False">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Visibility="{x:Bind Card.HasPlayCount,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}">
    <Path Width="11" Height="12" Margin="0,1,4,0" Stretch="Uniform" Stroke="{x:Bind Foreground,Mode=OneWay}" StrokeThickness="1.4"
      Data="M 1,9 L 1,6 C 1,0 11,0 11,6 L 11,9 M 1,6 L 3,6 L 3,11 L 1,11 Z M 9,6 L 11,6 L 11,11 L 9,11 Z"/>
    <TextBlock x:Name="PlayCount" Text="{x:Bind Card.PlayCountText,Mode=OneWay,TargetNullValue=''}" Foreground="{x:Bind Foreground,Mode=OneWay}" FontSize="11"/>
   </StackPanel>
   <TextBlock x:Name="FMLabel" Grid.Column="1" Text="{x:Bind Card.CoverLabel,Mode=OneWay,TargetNullValue=''}" Foreground="{x:Bind Foreground,Mode=OneWay}" FontSize="12"
     Visibility="{x:Bind Card.HasCoverLabel,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}" TextTrimming="CharacterEllipsis"/>
  </Grid>
  <Canvas x:Name="CaptionHost" Grid.Row="1" Margin="10,6" IsHitTestVisible="False">
   <StackPanel x:Name="ContentBlock">
    <StackPanel.RenderTransform><TranslateTransform x:Name="ContentTranslation"/></StackPanel.RenderTransform>
    <Grid x:Name="CaptionSlot" Height="36"><TextBlock x:Name="Caption" Text="{x:Bind Card.Caption,Mode=OneWay,TargetNullValue=''}" Foreground="{x:Bind Foreground,Mode=OneWay}" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Bottom" MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/></Grid>
    <Border x:Name="PreviewBlock" Padding="0,8,0,0" MinHeight="44" Opacity="0">
     <ItemsControl x:Name="PreviewRows" ItemsSource="{x:Bind PreviewItems}" VerticalAlignment="Bottom" IsTabStop="False">
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:EntryPreviewRow">
       <TextBlock Text="{x:Bind Text}" Margin="{x:Bind Margin}" FontSize="13" Height="25" LineHeight="25" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </Border>
   </StackPanel>
  </Canvas>
  <Button x:Name="OpenButton" Grid.RowSpan="2" Click="Open_Click" IsEnabled="{x:Bind Card.CanOpen,Mode=OneWay,FallbackValue=False}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" MinWidth="0" MinHeight="0" UseSystemFocusVisuals="True" FontWeight="Normal" Template="{StaticResource MeowFilm.ContentButtonTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="{x:Bind Card.Title,Mode=OneWay,TargetNullValue=''}"/>
  <Button x:Name="PlayButton" Style="{StaticResource MeowFilm.GhostButton}" RequestedTheme="Dark" Width="36" Height="36" MinWidth="36" MinHeight="36" Padding="0" CornerRadius="18" Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Play_Click" IsEnabled="{x:Bind Card.CanPlay,Mode=OneWay,FallbackValue=False}" AutomationProperties.Name="{x:Bind Card.Title,Mode=OneWay,TargetNullValue=''}" Opacity="0">
   <local:CardPlayGlyph IsBusy="{x:Bind Card.IsPreparing,Mode=OneWay,FallbackValue=False}" Foreground="{x:Bind Foreground,Mode=OneWay}"/>
  </Button>
 </Grid>
</UserControl>
