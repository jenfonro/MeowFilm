<UserControl x:Class="MeowFilm.Capabilities.MusicCatalogCardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 xmlns:art="using:MeowFilm.Desktop.Artwork"
 xmlns:desktop="using:MeowFilm.Desktop">
 <UserControl.Resources>
  <ResourceDictionary>
   <Style x:Key="Card.OpenButton" TargetType="Button">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template" Value="{StaticResource MeowFilm.ContentButtonTemplate}"/>
   </Style>
   <Style x:Key="Card.ActionButton" TargetType="Button">
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="Margin" Value="2,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
   </Style>

   <DataTemplate x:Key="SongTemplate" x:DataType="local:MusicCatalogCard">
    <Border Height="84" CornerRadius="12" Background="Transparent" local:CardMotion.Enabled="True">
     <Grid>
      <Border CornerRadius="12" Background="{ThemeResource MeowFilm.Brush.Surface}" IsHitTestVisible="False" Opacity="0" local:CardMotion.HoverOpacity="True"/>
      <Button Style="{StaticResource Card.OpenButton}" Padding="8" Tag="{x:Bind}" IsEnabled="{x:Bind CanOpen,Mode=OneWay}" AutomationProperties.Name="{x:Bind Title,Mode=OneWay}" Click="Open_Click">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="60"/>
         <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Width="50" Height="50" HorizontalAlignment="Left" local:CardClip.Radius="8">
         <art:ArtworkImage Address="{x:Bind Cover,Mode=OneWay}" DisplayIdentity="{x:Bind SongId,Mode=OneWay}" Width="50" Height="50" Stretch="UniformToFill"/>
         <Border Background="#40000000" IsHitTestVisible="False" Opacity="0" local:CardMotion.HoverOpacity="True" Visibility="{x:Bind CanPlay,Mode=OneWay,Converter={StaticResource MeowFilm.Visible}}">
          <local:CardPlayGlyph Foreground="White" IsBusy="{x:Bind IsPreparing,Mode=OneWay}"/>
         </Border>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" local:CardMotion.HoverRightMargin="72">
         <TextBlock Text="{x:Bind Title,Mode=OneWay}" FontSize="14" LineHeight="20" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
         <TextBlock Text="{x:Bind Subtitle,Mode=OneWay}" FontSize="12" LineHeight="18" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </StackPanel>
       </Grid>
      </Button>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Background="{ThemeResource MeowFilm.Brush.Surface}" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" local:CardMotion.HoverOpacity="True" local:CardMotion.HoverVisibility="True" local:CardMotion.HoverHitTest="True">
       <desktop:FavoriteButton IconSize="16" Width="36" Height="36" MinWidth="36" MinHeight="36" CornerRadius="18" Margin="0" Padding="0" AutomationProperties.Name="收藏" IsEnabled="{x:Bind CanFavorite,Mode=OneWay}" Click="Favorite_Click" Loaded="FavoriteButton_Loaded"/>
       <Button Style="{StaticResource MeowFilm.GhostButton}" Width="36" Height="36" MinWidth="36" MinHeight="36" CornerRadius="18" Margin="0" Padding="0" AutomationProperties.Name="歌曲操作" Click="More_Click">
        <FontIcon Glyph="&#xE712;" FontSize="16"/>
       </Button>
      </StackPanel>
     </Grid>
    </Border>
   </DataTemplate>

   <DataTemplate x:Key="RowTemplate" x:DataType="local:MusicCatalogCard">
    <Button Style="{StaticResource Card.OpenButton}" Tag="{x:Bind}" IsEnabled="{x:Bind CanOpen,Mode=OneWay}" AutomationProperties.Name="{x:Bind Title,Mode=OneWay}" Click="Open_Click">
     <Grid Height="64">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="60"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <art:ArtworkImage Address="{x:Bind Cover,Mode=OneWay}" DisplayIdentity="{x:Bind SongId,Mode=OneWay}" Width="48" Height="48" Stretch="UniformToFill"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,16,0">
       <TextBlock Text="{x:Bind Title,Mode=OneWay}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <TextBlock Text="{x:Bind Subtitle,Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </StackPanel>
     </Grid>
    </Button>
   </DataTemplate>

   <DataTemplate x:Key="AlbumRankTemplate" x:DataType="local:MusicCatalogCard">
    <Button Style="{StaticResource Card.OpenButton}" Tag="{x:Bind}" IsEnabled="{x:Bind CanOpen,Mode=OneWay}" AutomationProperties.Name="{x:Bind Title,Mode=OneWay}" Click="Open_Click">
     <Grid Height="72">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="44"/>
       <ColumnDefinition Width="76"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind RankText,Mode=OneWay}" FontSize="22" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <art:ArtworkImage Grid.Column="1" Address="{x:Bind Cover,Mode=OneWay}" DisplayIdentity="{x:Bind SongId,Mode=OneWay}" Width="64" Height="64" Stretch="UniformToFill"/>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,16,0">
       <TextBlock Text="{x:Bind Title,Mode=OneWay}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <TextBlock Text="{x:Bind Subtitle,Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Grid.Column="3" Text="{x:Bind SalesText,Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     </Grid>
    </Button>
   </DataTemplate>

   <DataTemplate x:Key="RankingTemplate" x:DataType="local:MusicCatalogCard">
    <Grid local:CardMotion.Enabled="True">
     <Button Style="{StaticResource Card.OpenButton}" Tag="{x:Bind}" IsEnabled="{x:Bind CanOpen,Mode=OneWay}" AutomationProperties.Name="{x:Bind Title,Mode=OneWay}" Click="Open_Click">
      <Border Padding="20" Height="154" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}">
       <Grid>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <TextBlock Text="{x:Bind Title,Mode=OneWay}" FontSize="18" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="1" Text="{x:Bind UpdateFrequency,Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="96"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <Grid Width="80" Height="80" HorizontalAlignment="Left">
          <art:ArtworkImage ResourceSlot="third" Address="{x:Bind ThirdPreviewCover,Mode=OneWay}" DisplayIdentity="{x:Bind ThirdPreviewIdentity,Mode=OneWay}" Width="80" Height="80" Stretch="UniformToFill" Margin="12,12,-6,-4"/>
          <art:ArtworkImage ResourceSlot="second" Address="{x:Bind SecondPreviewCover,Mode=OneWay}" DisplayIdentity="{x:Bind SecondPreviewIdentity,Mode=OneWay}" Width="80" Height="80" Stretch="UniformToFill" Margin="6,6,-3,-2"/>
          <art:ArtworkImage ResourceSlot="first" Address="{x:Bind FirstPreviewCover,Mode=OneWay}" DisplayIdentity="{x:Bind FirstPreviewIdentity,Mode=OneWay}" Width="80" Height="80" Stretch="UniformToFill"/>
          <Button Style="{StaticResource Card.ActionButton}" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" local:CardMotion.HoverOpacity="True" local:CardMotion.HoverHitTest="True" AutomationProperties.Name="播放" IsEnabled="{x:Bind CanPlay,Mode=OneWay}" Visibility="{x:Bind CanPlay,Mode=OneWay,Converter={StaticResource MeowFilm.Visible}}" Click="Play_Click">
           <local:CardPlayGlyph Foreground="White" IsBusy="{x:Bind IsPreparing,Mode=OneWay}"/>
          </Button>
         </Grid>
         <ItemsControl Grid.Column="1" Margin="0,0,12,0" ItemsSource="{x:Bind TopPreviewSongs,Mode=OneWay}">
          <ItemsControl.ItemTemplate>
           <DataTemplate x:DataType="local:MusicRankPreview">
            <TextBlock Text="{x:Bind DisplayLine}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </Grid>
       </Grid>
      </Border>
     </Button>
    </Grid>
   </DataTemplate>

   <DataTemplate x:Key="PlaylistTemplate" x:DataType="local:MusicCatalogCard">
    <Grid local:CardMotion.Enabled="True">
     <Button Style="{StaticResource Card.OpenButton}" Tag="{x:Bind}" IsEnabled="{x:Bind CanOpen,Mode=OneWay}" AutomationProperties.Name="{x:Bind Title,Mode=OneWay}" Click="Open_Click">
      <StackPanel>
       <local:AspectRatioDecorator AspectRatio="1,1">
        <Grid CornerRadius="8" Background="#E7EAF0" local:CardClip.Radius="8">
         <art:ArtworkImage Address="{x:Bind Cover,Mode=OneWay}" DisplayIdentity="{x:Bind SongId,Mode=OneWay}" Stretch="UniformToFill"/>
         <TextBlock Text="{x:Bind Title,Mode=OneWay}" FontSize="18" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10" Visibility="{x:Bind HasCover,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},ConverterParameter=Not}"/>
         <Border Background="{StaticResource Card.CoverHover}" IsHitTestVisible="False" Opacity="0" local:CardMotion.HoverOpacity="True" Visibility="{x:Bind CanPlay,Mode=OneWay,Converter={StaticResource MeowFilm.Visible}}"/>
         <Button Style="{StaticResource Card.ActionButton}" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" local:CardMotion.HoverOpacity="True" local:CardMotion.HoverHitTest="True" AutomationProperties.Name="播放" IsEnabled="{x:Bind CanPlay,Mode=OneWay}" Visibility="{x:Bind CanPlay,Mode=OneWay,Converter={StaticResource MeowFilm.Visible}}" Click="Play_Click">
          <local:CardPlayGlyph Foreground="White" IsBusy="{x:Bind IsPreparing,Mode=OneWay}"/>
         </Button>
        </Grid>
       </local:AspectRatioDecorator>
       <TextBlock Text="{x:Bind Title,Mode=OneWay}" FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight" MaxLines="2" Height="40" VerticalAlignment="Top" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </Button>
     <Button Style="{StaticResource Card.ActionButton}" Content="心动" HorizontalAlignment="Right" VerticalAlignment="Bottom" AutomationProperties.Name="心动" IsEnabled="{x:Bind CanHeartbeatFavorites,Mode=OneWay}" Visibility="{x:Bind CanHeartbeatFavorites,Mode=OneWay,Converter={StaticResource MeowFilm.Visible}}" Click="Heartbeat_Click"/>
    </Grid>
   </DataTemplate>

   <DataTemplate x:Key="RankCoverTemplate" x:DataType="local:MusicCatalogCard">
    <Grid local:CardMotion.Enabled="True">
     <Button Style="{StaticResource Card.OpenButton}" Tag="{x:Bind}" IsEnabled="{x:Bind CanOpen,Mode=OneWay}" AutomationProperties.Name="{x:Bind Title,Mode=OneWay}" Click="Open_Click">
      <local:AspectRatioDecorator AspectRatio="1,1">
       <Grid CornerRadius="8" Background="#E7EAF0" local:CardClip.Radius="8">
        <art:ArtworkImage Address="{x:Bind Cover,Mode=OneWay}" DisplayIdentity="{x:Bind SongId,Mode=OneWay}" Stretch="UniformToFill"/>
        <TextBlock Text="{x:Bind Title,Mode=OneWay}" FontSize="18" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10" Visibility="{x:Bind HasCover,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},ConverterParameter=Not}"/>
        <Button Style="{StaticResource Card.ActionButton}" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" local:CardMotion.HoverOpacity="True" local:CardMotion.HoverHitTest="True" AutomationProperties.Name="播放" IsEnabled="{x:Bind CanPlay,Mode=OneWay}" Visibility="{x:Bind CanPlay,Mode=OneWay,Converter={StaticResource MeowFilm.Visible}}" Click="Play_Click">
         <local:CardPlayGlyph Foreground="White" IsBusy="{x:Bind IsPreparing,Mode=OneWay}"/>
        </Button>
       </Grid>
      </local:AspectRatioDecorator>
     </Button>
    </Grid>
   </DataTemplate>

   <DataTemplate x:Key="BannerTemplate" x:DataType="local:MusicCatalogCard">
    <Grid local:CardMotion.Enabled="True">
     <Button Style="{StaticResource Card.OpenButton}" Tag="{x:Bind}" IsEnabled="{x:Bind CanOpen,Mode=OneWay}" AutomationProperties.Name="{x:Bind Title,Mode=OneWay}" Click="Open_Click">
      <local:AspectRatioDecorator AspectRatio="2.56,1">
       <Grid CornerRadius="8" Background="#E7EAF0" local:CardClip.Radius="8">
        <art:ArtworkImage Address="{x:Bind Cover,Mode=OneWay}" DisplayIdentity="{x:Bind SongId,Mode=OneWay}" Stretch="Uniform"/>
        <TextBlock Text="{x:Bind Title,Mode=OneWay}" FontSize="18" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10" Visibility="{x:Bind HasCover,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},ConverterParameter=Not}"/>
        <Button Style="{StaticResource Card.ActionButton}" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" local:CardMotion.HoverOpacity="True" local:CardMotion.HoverHitTest="True" AutomationProperties.Name="播放" IsEnabled="{x:Bind CanPlay,Mode=OneWay}" Visibility="{x:Bind CanPlay,Mode=OneWay,Converter={StaticResource MeowFilm.Visible}}" Click="Play_Click">
         <local:CardPlayGlyph Foreground="White" IsBusy="{x:Bind IsPreparing,Mode=OneWay}"/>
        </Button>
       </Grid>
      </local:AspectRatioDecorator>
     </Button>
    </Grid>
   </DataTemplate>

   <DataTemplate x:Key="ArtistTemplate" x:DataType="local:MusicCatalogCard">
    <Grid local:CardMotion.Enabled="True">
     <Button Style="{StaticResource Card.OpenButton}" Tag="{x:Bind}" IsEnabled="{x:Bind CanOpen,Mode=OneWay}" AutomationProperties.Name="{x:Bind Title,Mode=OneWay}" Click="Open_Click">
      <StackPanel>
       <local:AspectRatioDecorator AspectRatio="1,1">
        <Grid CornerRadius="1000" Background="#E7EAF0" local:CardClip.Radius="1000">
         <art:ArtworkImage Address="{x:Bind Cover,Mode=OneWay}" DisplayIdentity="{x:Bind SongId,Mode=OneWay}" Stretch="UniformToFill"/>
         <TextBlock Text="{x:Bind Title,Mode=OneWay}" FontSize="18" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10" Visibility="{x:Bind HasCover,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},ConverterParameter=Not}"/>
         <Button Style="{StaticResource Card.ActionButton}" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" local:CardMotion.HoverOpacity="True" local:CardMotion.HoverHitTest="True" AutomationProperties.Name="播放" IsEnabled="{x:Bind CanPlay,Mode=OneWay}" Visibility="{x:Bind CanPlay,Mode=OneWay,Converter={StaticResource MeowFilm.Visible}}" Click="Play_Click">
          <local:CardPlayGlyph Foreground="White" IsBusy="{x:Bind IsPreparing,Mode=OneWay}"/>
         </Button>
        </Grid>
       </local:AspectRatioDecorator>
       <TextBlock Text="{x:Bind Title,Mode=OneWay}" FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight" MaxLines="2" Height="40" VerticalAlignment="Top" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{x:Bind Subtitle,Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
    </Grid>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <ContentPresenter x:Name="CardHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
</UserControl>
