<UserControl x:Class="MeowFilm.Capabilities.MusicCatalogSectionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 xmlns:desktop="using:MeowFilm.Desktop">
 <UserControl.Resources>
  <ResourceDictionary>
   <DataTemplate x:Key="EntryCardTemplate">
    <local:EntryCard Loaded="EntryCard_Loaded" OpenRequested="EntryOpen" PlayRequested="EntryPlay"/>
   </DataTemplate>
   <DataTemplate x:Key="CardTemplate.Playlist">
    <local:MusicCatalogCardView Presentation="Playlist" Loaded="CardView_Loaded"/>
   </DataTemplate>
   <DataTemplate x:Key="CardTemplate.RankCover">
    <local:MusicCatalogCardView Presentation="RankCover" Loaded="CardView_Loaded"/>
   </DataTemplate>
   <DataTemplate x:Key="CardTemplate.Row">
    <local:MusicCatalogCardView Presentation="Row" Loaded="CardView_Loaded"/>
   </DataTemplate>
   <DataTemplate x:Key="CardTemplate.AlbumRank">
    <local:MusicCatalogCardView Presentation="AlbumRank" Loaded="CardView_Loaded"/>
   </DataTemplate>
   <DataTemplate x:Key="CardTemplate.Banner">
    <local:MusicCatalogCardView Presentation="Banner" Loaded="CardView_Loaded"/>
   </DataTemplate>
   <DataTemplate x:Key="CardTemplate.Ranking">
    <local:MusicCatalogCardView Presentation="Ranking" Loaded="CardView_Loaded"/>
   </DataTemplate>
   <DataTemplate x:Key="CardTemplate.Song">
    <local:MusicCatalogCardView Presentation="Song" Loaded="CardView_Loaded"/>
   </DataTemplate>
   <DataTemplate x:Key="CardTemplate.Artist">
    <local:MusicCatalogCardView Presentation="Artist" Loaded="CardView_Loaded"/>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <StackPanel Margin="0,0,0,32">
  <Grid Margin="0,0,0,18" MinHeight="24" Visibility="{x:Bind HasHeading, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="{x:Bind SectionTitle, Mode=OneWay}" FontSize="18" VerticalAlignment="Center"/>
    <ProgressRing x:Name="SectionLoadingRing" x:Load="{x:Bind IsSectionLoading, Mode=OneWay}" Width="14" Height="14" Margin="8,0,0,0" IsActive="True"/>
    <Button Content="›" Padding="6,0" Visibility="{x:Bind ShowActionButton, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" Click="Action_Click"/>
   </StackPanel>
   <Button Grid.Column="1" Content="查看更多" IsEnabled="{x:Bind CanBrowse, Mode=OneWay}" Visibility="{x:Bind ShowMoreButton, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" AutomationProperties.Name="{x:Bind MoreAccessibleName, Mode=OneWay}" Click="More_Click"/>
   <Button Grid.Column="1" Width="28" Height="24" MinHeight="0" MinWidth="0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#8B9096" IsEnabled="{x:Bind CanBrowse, Mode=OneWay}" Visibility="{x:Bind ShowRefreshButton, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" AutomationProperties.Name="刷新推荐" Click="Refresh_Click">
    <Canvas Width="20" Height="20">
     <Path Data="M16.5,6 A7.5,7.5 0 1 0 17.2,12 M16.5,1.5 L16.5,6 12,6" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="#8B9096"/>
    </Canvas>
   </Button>
  </Grid>
  <ItemsControl Margin="0,0,0,12" ItemsSource="{x:Bind SectionTabs, Mode=OneWay}" Visibility="{x:Bind HasTabs, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
   <ItemsControl.ItemsPanel>
    <ItemsPanelTemplate><desktop:WrapPanel/></ItemsPanelTemplate>
   </ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate>
    <DataTemplate x:DataType="local:MusicCatalogTab">
     <Button Margin="0,0,8,0" Content="{x:Bind Title}" Tag="{x:Bind}" AutomationProperties.ItemStatus="{x:Bind ItemStatus, Mode=OneWay}" Click="SectionTab_Click"/>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
  <Grid>
   <local:Shelf x:Name="SingleRowShelf" Visibility="Collapsed" HorizontalOffsetCommitted="Shelf_OffsetCommitted"/>
   <local:Shelf x:Name="SongColumnShelf" RowsPerColumn="3" MinimumCardWidth="400" CardTemplate="{StaticResource CardTemplate.Song}" Visibility="Collapsed" HorizontalOffsetCommitted="Shelf_OffsetCommitted"/>
   <ItemsControl x:Name="CardsItems" Visibility="Collapsed"/>
  </Grid>
 </StackPanel>
</UserControl>
