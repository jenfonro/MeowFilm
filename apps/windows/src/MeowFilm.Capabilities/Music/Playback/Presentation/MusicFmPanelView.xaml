<UserControl x:Class="MeowFilm.Capabilities.MusicFmPanelView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 xmlns:desktop="using:MeowFilm.Desktop"
 RequestedTheme="Dark">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="Fm.Brush.FgNormal" Color="#F5F4F7"/>
     <SolidColorBrush x:Key="Fm.Brush.FgMuted" Color="#D4D2D8"/>
     <SolidColorBrush x:Key="Fm.Brush.ModeBg" Color="#16FFFFFF"/>
     <SolidColorBrush x:Key="Fm.Brush.SceneBg" Color="#10FFFFFF"/>
     <SolidColorBrush x:Key="Fm.Brush.BorderDefault" Color="#34FFFFFF"/>
     <SolidColorBrush x:Key="Fm.Brush.PanelBorder" Color="Transparent"/>
     <Thickness x:Key="Fm.PanelBorderThickness">0</Thickness>
     <SolidColorBrush x:Key="Fm.Brush.SceneSurface" Color="#14FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#40FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#55FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#34FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#34FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#F5F4F7"/>
     <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#F5F4F7"/>
     <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#32FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#40FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#55FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#E6FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#E6FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#E6FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#F5F4F7"/>
     <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#F5F4F7"/>
     <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#F5F4F7"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="Fm.Brush.FgNormal" Color="{ThemeResource SystemColorWindowTextColor}"/>
     <SolidColorBrush x:Key="Fm.Brush.FgMuted" Color="{ThemeResource SystemColorWindowTextColor}"/>
     <SolidColorBrush x:Key="Fm.Brush.ModeBg" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="Fm.Brush.SceneBg" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="Fm.Brush.BorderDefault" Color="{ThemeResource SystemColorWindowTextColor}"/>
     <SolidColorBrush x:Key="Fm.Brush.PanelBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
     <Thickness x:Key="Fm.PanelBorderThickness">1</Thickness>
     <SolidColorBrush x:Key="Fm.Brush.SceneSurface" Color="{ThemeResource SystemColorWindowColor}"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style x:Key="Player.FmChoiceBase" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{ThemeResource Fm.Brush.BorderDefault}"/>
    <Setter Property="Foreground" Value="{ThemeResource Fm.Brush.FgNormal}"/>
    <Setter Property="Background" Value="{ThemeResource Fm.Brush.ModeBg}"/>
   </Style>
   <Style x:Key="Player.FmSceneChoice" TargetType="ToggleButton" BasedOn="{StaticResource Player.FmChoiceBase}">
    <Setter Property="Background" Value="{ThemeResource Fm.Brush.SceneBg}"/>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Border x:Name="PanelBorder" Width="368" Padding="14" CornerRadius="14" BorderThickness="{ThemeResource Fm.PanelBorderThickness}" BorderBrush="{ThemeResource Fm.Brush.PanelBorder}" Translation="0,0,24" TabFocusNavigation="Cycle">
  <Border.Shadow><ThemeShadow/></Border.Shadow>
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <Grid Margin="0,0,0,12">
    <TextBlock x:Name="FmTitle" Text="{x:Bind Queue.PlaybackFmTitle, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource Fm.Brush.FgMuted}" VerticalAlignment="Center" TextAlignment="Center"/>
    <Button x:Name="CloseFmButton" Style="{StaticResource MeowFilm.IconButton}" Width="28" Height="28" MinWidth="28" MinHeight="28" CornerRadius="6" Foreground="{ThemeResource Fm.Brush.FgNormal}" HorizontalAlignment="Right" Content="&#xE711;" Click="CloseFm_Click" AutomationProperties.Name="关闭频道选择"/>
   </Grid>
   <ScrollViewer x:Name="FmScroll" Grid.Row="1" Style="{StaticResource MeowFilm.OverlayScrollViewer}" MaxHeight="520">
    <StackPanel>
     <ItemsControl x:Name="FmModeChoices" ItemsSource="{x:Bind ModeChoices}">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="local:MusicFmChoiceItem">
        <ToggleButton Tag="{x:Bind}" IsChecked="{x:Bind IsSelected}" Style="{StaticResource Player.FmChoiceBase}"
         MinHeight="64" Margin="0,0,0,10" Padding="12" FontSize="16"
         AutomationProperties.Name="{x:Bind Name}" AutomationProperties.ItemStatus="{x:Bind ItemStatus}"
         Click="Choice_Click">
         <TextBlock Text="{x:Bind Name}" FontSize="16" Foreground="{ThemeResource Fm.Brush.FgNormal}" TextAlignment="Center" TextWrapping="Wrap"/>
        </ToggleButton>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock x:Name="FmSceneCaption" Text="场景模式" FontSize="13" Foreground="{ThemeResource Fm.Brush.FgMuted}" Margin="0,12,0,12"/>
     <Border x:Name="FmSceneSurface" CornerRadius="12" Padding="6" Background="{ThemeResource Fm.Brush.SceneSurface}">
      <ItemsControl x:Name="FmSceneChoices" ItemsSource="{x:Bind SceneChoices}">
       <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
         <local:AdaptiveCardPanel MinimumCardWidth="70" MaximumCardWidth="Infinity" MaximumColumns="4" CardGap="0" RowGap="0"/>
        </ItemsPanelTemplate>
       </ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:MusicFmChoiceItem">
         <ToggleButton Tag="{x:Bind}" IsChecked="{x:Bind IsSelected}" Style="{StaticResource Player.FmSceneChoice}"
          MinHeight="84" Margin="2" Padding="2,10,2,10" FontSize="12"
          AutomationProperties.Name="{x:Bind Name}" AutomationProperties.ItemStatus="{x:Bind ItemStatus}"
          Click="Choice_Click">
          <StackPanel Spacing="10">
           <local:MusicPlaybackIcon Key="{x:Bind IconKey}" Width="25" Height="25" HorizontalAlignment="Center" Foreground="{ThemeResource Fm.Brush.FgNormal}"/>
           <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="{ThemeResource Fm.Brush.FgNormal}" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
         </ToggleButton>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Border>
</UserControl>
