<UserControl x:Class="MeowFilm.Capabilities.MusicAppearanceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:desktop="using:MeowFilm.Desktop"
 UseLayoutRounding="True">
 <StackPanel>
  <Border Style="{StaticResource Settings.Section}">
   <StackPanel>
    <TextBlock Text="播放器配色" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,8"/>
    <ComboBox Tag="colorMode" Width="190" HorizontalAlignment="Left" Style="{StaticResource MeowFilm.SettingsComboBox}"
              ItemsSource="{x:Bind Settings.ColorModes}" DisplayMemberPath="Name" SelectedValuePath="Key"
              SelectedValue="{x:Bind Settings.AppearanceColorMode,Mode=OneWay}" SelectionChanged="Choice_Changed"
              IsEnabled="{x:Bind Settings.CanEditAppearance,Mode=OneWay}" AutomationProperties.Name="播放器配色"/>
    <StackPanel Margin="0,12,0,0">
     <TextBlock Text="固定配色" Style="{StaticResource Settings.Text}" Margin="0,0,0,8"/>
     <desktop:ColorSelection x:Name="PaletteSelection" Value="{x:Bind Settings.AppearanceColorPalette,Mode=OneWay}"
                             Label="播放器固定配色" IsEnabled="{x:Bind Settings.CanEditFixedAppearance,Mode=OneWay}" ValueCommitted="Palette_Committed"/>
    </StackPanel>
    <Button Content="重新读取" Style="{StaticResource Settings.QuietButton}" HorizontalAlignment="Left" Click="Retry_Click" Margin="0,12,0,0"
            Visibility="{x:Bind Settings.AppearanceStatus,Mode=OneWay,Converter={StaticResource MeowFilm.Visible}}"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Settings.Section}">
   <StackPanel>
    <TextBlock Text="歌单样式" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,8"/>
    <ComboBox Tag="playlistView" Width="190" HorizontalAlignment="Left" Style="{StaticResource MeowFilm.SettingsComboBox}"
              ItemsSource="{x:Bind Settings.PlaylistViews}" DisplayMemberPath="Name" SelectedValuePath="Key"
              SelectedValue="{x:Bind Settings.AppearancePlaylistView,Mode=OneWay}" SelectionChanged="Choice_Changed"
              IsEnabled="{x:Bind Settings.CanEditAppearance,Mode=OneWay}" AutomationProperties.Name="歌单样式"/>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
