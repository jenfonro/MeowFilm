<UserControl x:Class="MeowFilm.Capabilities.SearchResultsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Capabilities"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop;assembly=MeowFilm.Desktop"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="/MeowFilm.Capabilities;component/Presentation/CapabilityTheme.xaml"/>
   <ResourceDictionary Source="/MeowFilm.Capabilities;component/Settings/SettingsTheme.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="Search.Tab" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
   <Setter Property="Margin" Value="0,0,24,0"/><Setter Property="Padding" Value="0,4,0,8"/>
   <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" CornerRadius="4">
     <Grid>
      <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      <Border x:Name="SelectionIndicator" Width="20" Height="3" CornerRadius="1.5"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False">
       <Border.Style><Style TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
         </DataTrigger>
         <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True">
          <Setter Property="Background" Value="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}"/>
         </Trigger>
        </Style.Triggers>
       </Style></Border.Style>
      </Border>
     </Grid>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <MultiDataTrigger><MultiDataTrigger.Conditions>
     <Condition Binding="{Binding Selected}" Value="True"/>
     <Condition Binding="{Binding IsEnabled,RelativeSource={RelativeSource Self}}" Value="True"/>
     <Condition Binding="{Binding Path=(desktop:DesktopTheme.IsHighContrast),RelativeSource={RelativeSource Self}}" Value="False"/>
    </MultiDataTrigger.Conditions>
     <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
    </MultiDataTrigger>
   </Style.Triggers>
  </Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="40,20,24,20" MaxWidth="1490">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,24">
   <TextBlock Text="{Binding Query}" FontSize="23" TextTrimming="CharacterEllipsis"/>
   <DockPanel Margin="0,14,0,0">
    <StackPanel x:Name="FilmTools" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" Margin="16,0,0,0">
     <TextBlock Text="{Binding MetadataStatus}" Margin="0,0,16,0" Style="{StaticResource Capability.Muted}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="原始列表" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <CheckBox x:Name="RawListToggle" IsChecked="{Binding RawListMode}" Style="{StaticResource Settings.Switch}" VerticalAlignment="Center" AutomationProperties.Name="原始列表"/>
    </StackPanel>
    <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
     <ItemsControl ItemsSource="{Binding Tabs}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Content="{Binding Label}" Tag="{Binding Id}" Style="{StaticResource Search.Tab}" Click="Tab_Click" AutomationProperties.Name="{Binding Label,StringFormat={}{0}搜索结果}"/>
     </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </DockPanel>
   <desktop:NoticeOutlet Message="{Binding Error}"/>
  </StackPanel>
  <ContentControl x:Name="MusicHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <ScrollViewer x:Name="NovelScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled" Style="{StaticResource MeowFilm.OverlayScrollViewer}" AutomationProperties.Name="小说搜索结果"/>
  <Grid x:Name="FilmBody" Grid.Row="1" Visibility="Collapsed">
   <ScrollViewer x:Name="FilmScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Style="{StaticResource MeowFilm.OverlayScrollViewer}">
    <StackPanel>
     <ItemsControl ItemsSource="{Binding Cards}" AutomationProperties.Name="影视搜索结果">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:AdaptiveCardPanel CardGap="24"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><local:FilmCard Activated="Card_Activated"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="{Binding Status}" Margin="0,16" HorizontalAlignment="Center" Style="{StaticResource Capability.Muted}"/>
     <Button Content="加载更多" Click="More_Click" IsEnabled="{Binding CanLoadMore}" HorizontalAlignment="Center"
             Visibility="{Binding HasMore,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
