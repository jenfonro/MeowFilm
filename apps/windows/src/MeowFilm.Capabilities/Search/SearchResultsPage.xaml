<UserControl x:Class="MeowFilm.Capabilities.SearchResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MeowFilm.Capabilities" xmlns:desktop="using:MeowFilm.Desktop">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="ms-appx:///MeowFilm.Capabilities/Presentation/CapabilityTheme.xaml"/>
  <ResourceDictionary Source="ms-appx:///MeowFilm.Capabilities/Settings/SettingsTheme.xaml"/>
 </ResourceDictionary.MergedDictionaries><local:MusicVisibilityConverter x:Key="Visible"/>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="40,20,24,20" MaxWidth="1490"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,24"><TextBlock Text="{Binding Query}" FontSize="23" TextTrimming="CharacterEllipsis"/>
   <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Tabs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
     <Button Tag="{Binding Id}" Click="Tab_Click" Background="Transparent" BorderThickness="0" Padding="0,4,0,8" Margin="0,0,24,0" AutomationProperties.Name="{Binding Label}"><Grid><TextBlock Text="{Binding Label}" Margin="0,0,0,6"/><Border Width="20" Height="3" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{ThemeResource MeowFilm.Brush.Accent}" Visibility="{Binding Selected,Converter={StaticResource Visible}}"/></Grid></Button>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <StackPanel x:Name="FilmTools" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed" Margin="16,0,0,0"><TextBlock Text="{Binding MetadataStatus}" Margin="0,0,16,0" Style="{StaticResource Capability.Muted}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="原始列表" VerticalAlignment="Center" Margin="0,0,8,0"/><CheckBox x:Name="RawListToggle" IsChecked="{Binding RawListMode,Mode=TwoWay}" Style="{StaticResource Settings.Switch}" VerticalAlignment="Center" AutomationProperties.Name="原始列表"/></StackPanel>
   </Grid><desktop:NoticeOutlet Message="{Binding Error}"/>
  </StackPanel>
  <ContentControl x:Name="MusicHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <ScrollViewer x:Name="NovelScroll" x:FieldModifier="internal" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource MeowFilm.OverlayScrollViewer}" AutomationProperties.Name="小说搜索结果"/>
  <Grid x:Name="FilmBody" Grid.Row="1" Visibility="Collapsed">
   <GridView x:Name="FilmItems" ItemsSource="{Binding Cards}" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="影视搜索结果" SizeChanged="Film_SizeChanged" ContainerContentChanging="Film_ContainerChanging">
    <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0,0,36,36"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/></Style></GridView.ItemContainerStyle>
    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
    <GridView.ItemTemplate><DataTemplate><local:FilmCard Activated="Card_Activated"/></DataTemplate></GridView.ItemTemplate>
    <GridView.Footer><StackPanel><TextBlock Text="{Binding Status}" Margin="0,16" HorizontalAlignment="Center" Style="{StaticResource Capability.Muted}" AutomationProperties.LiveSetting="Polite"/><Button Content="加载更多" Click="More_Click" IsEnabled="{Binding CanLoadMore}" HorizontalAlignment="Center" Visibility="{Binding HasMore,Converter={StaticResource Visible}}"/></StackPanel></GridView.Footer>
   </GridView>
  </Grid>
 </Grid>
</UserControl>
