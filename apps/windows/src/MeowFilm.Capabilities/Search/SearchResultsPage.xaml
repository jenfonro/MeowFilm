<UserControl x:Class="MeowFilm.Capabilities.SearchResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MeowFilm.Capabilities" xmlns:desktop="using:MeowFilm.Desktop">
 <Grid Margin="40,20,24,20" MaxWidth="1490"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,24"><TextBlock Text="{x:Bind Page.Query, Mode=OneWay}" FontSize="23" TextTrimming="CharacterEllipsis"/>
   <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{x:Bind Page.Tabs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:SearchResultTab">
     <Grid Margin="0,0,24,0">
      <RadioButton GroupName="SearchResultTabs" Content="{x:Bind Label}" Tag="{x:Bind Id}" IsChecked="{x:Bind Selected, Mode=OneWay}" Style="{StaticResource Capability.UnderlineTab}" AutomationProperties.Name="{x:Bind AccessibleName}" Click="Tab_Click"/>
      <Border Width="20" Height="3" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False" Background="{ThemeResource MeowFilm.Brush.Accent}" Visibility="{x:Bind Selected, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}"/>
     </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <StackPanel x:Name="FilmTools" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed" Margin="16,0,0,0"><TextBlock Text="{x:Bind Page.MetadataStatus, Mode=OneWay}" Margin="0,0,16,0" Style="{StaticResource Capability.Muted}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="原始列表" VerticalAlignment="Center" Margin="0,0,8,0"/><CheckBox x:Name="RawListToggle" IsChecked="{x:Bind Page.RawListMode, Mode=OneWay}" Click="RawList_Click" Style="{StaticResource MeowFilm.Switch}" VerticalAlignment="Center" AutomationProperties.Name="原始列表"/></StackPanel>
   </Grid>
  </StackPanel>
  <ContentControl x:Name="MusicHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <ScrollViewer x:Name="NovelScroll" x:FieldModifier="internal" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource MeowFilm.OverlayScrollViewer}" AutomationProperties.Name="小说搜索结果">
   <StackPanel x:Name="NovelLayout">
    <ItemsControl x:Name="NovelStatus" ItemsSource="{x:Bind NovelStatuses}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><desktop:WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="local:NovelSearchStatusItem">
       <TextBlock Text="{x:Bind Text, Mode=OneWay}" Style="{StaticResource MeowFilm.MutedText}" FontSize="12" Margin="0,0,12,8"/>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl x:Name="NovelBooks" ItemsSource="{x:Bind NovelCardItems}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><desktop:WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="local:NovelSearchCardItem">
       <Button Tag="{x:Bind}" Style="{StaticResource MeowFilm.QuietButton}" Padding="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" Click="NovelCard_Click">
        <StackPanel Width="148" Margin="0,0,24,24">
         <local:NovelImage Sources="{x:Bind Sources, Mode=OneWay}" Book="{x:Bind Book, Mode=OneWay}" Width="148" Height="200" Margin="0,0,0,10"/>
         <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource MeowFilm.Text}" FontSize="15" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{x:Bind Author, Mode=OneWay}" Style="{StaticResource MeowFilm.MutedText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Button>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="NovelState" Style="{StaticResource MeowFilm.MutedText}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
     <Button x:Name="NovelMoreButton" Content="加载更多" Style="{StaticResource MeowFilm.Button}" Click="NovelMore_Click"/>
     <Button x:Name="NovelCancelButton" Content="取消" Style="{StaticResource MeowFilm.Button}" Click="NovelCancel_Click"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="FilmBody" Grid.Row="1" Visibility="Collapsed">
   <GridView x:Name="FilmItems" Margin="0,0,-36,0" ItemsSource="{x:Bind Page.Cards, Mode=OneWay}" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="影视搜索结果" SizeChanged="Film_SizeChanged" ContainerContentChanging="Film_ContainerChanging">
    <GridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource MeowFilm.BareGridViewItem}"><Setter Property="Padding" Value="0,0,36,36"/></Style></GridView.ItemContainerStyle>
    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
    <GridView.ItemTemplate><DataTemplate x:DataType="local:FilmSearchCardItem"><local:FilmCard Activated="Card_Activated"/></DataTemplate></GridView.ItemTemplate>
    <GridView.Footer><StackPanel><TextBlock Text="{x:Bind Page.Status, Mode=OneWay}" Margin="0,16" HorizontalAlignment="Center" Style="{StaticResource Capability.Muted}" AutomationProperties.LiveSetting="Polite"/><Button Content="加载更多" Click="More_Click" IsEnabled="{x:Bind Page.CanLoadMore, Mode=OneWay}" HorizontalAlignment="Center" Visibility="{x:Bind Page.HasMore, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}"/></StackPanel></GridView.Footer>
   </GridView>
  </Grid>
 </Grid>
</UserControl>
