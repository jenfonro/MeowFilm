<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:desktop="using:MeowFilm.Desktop" xmlns:local="using:MeowFilm.Capabilities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MeowFilm.Capabilities.CatalogBrowseView" Background="Transparent" UseLayoutRounding="True">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="Catalog.FilterBorder" Color="Transparent" />
     <Thickness x:Key="Catalog.FilterBorderThickness">0</Thickness>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="Catalog.FilterBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
     <Thickness x:Key="Catalog.FilterBorderThickness">1</Thickness>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style x:Key="Catalog.MoreButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
    <Setter Property="Foreground" Value="{ThemeResource MeowFilm.Brush.Muted}" />
    <Setter Property="Padding" Value="13,5,11,5" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
   </Style>
   <Style x:Key="Catalog.ShelfTitleButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
    <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.SectionHeading}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,0,8,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
   </Style>
   <Style x:Key="Catalog.ShelfRefreshButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.IconButton}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0" />
   </Style>
   <Style x:Key="Catalog.PageButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
    <Setter Property="MinWidth" Value="128" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="CornerRadius" Value="22" />
   </Style>
   <Style x:Key="Catalog.FilterGroup" TargetType="Border" BasedOn="{StaticResource MeowFilm.FilterGroup}">
    <Setter Property="BorderBrush" Value="{ThemeResource Catalog.FilterBorder}" />
    <Setter Property="BorderThickness" Value="{ThemeResource Catalog.FilterBorderThickness}" />
   </Style>
   <Style x:Key="Catalog.FilterChip" TargetType="ToggleButton" BasedOn="{StaticResource MeowFilm.FilterChip}">
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="ToggleButton">
       <Grid>
        <VisualStateManager.VisualStateGroups>
         <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="CatalogFilterContent.Background" Value="{ThemeResource MeowFilm.Brush.Hover}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="CatalogFilterContent.Background" Value="{ThemeResource MeowFilm.Brush.Pressed}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="CatalogFilterContent.Opacity" Value="0.6" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Checked"><VisualState.Setters>
           <Setter Target="CatalogFilterContent.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}" />
           <Setter Target="CatalogFilterContent.Foreground" Value="{ThemeResource MeowFilm.Brush.AccentText}" />
          </VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPointerOver"><VisualState.Setters>
           <Setter Target="CatalogFilterContent.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}" />
           <Setter Target="CatalogFilterContent.Foreground" Value="{ThemeResource MeowFilm.Brush.AccentText}" />
          </VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPressed"><VisualState.Setters>
           <Setter Target="CatalogFilterContent.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}" />
           <Setter Target="CatalogFilterContent.Foreground" Value="{ThemeResource MeowFilm.Brush.AccentText}" />
          </VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedDisabled"><VisualState.Setters>
           <Setter Target="CatalogFilterContent.Background" Value="{ThemeResource MeowFilm.Brush.AccentSoft}" />
           <Setter Target="CatalogFilterContent.Foreground" Value="{ThemeResource MeowFilm.Brush.AccentText}" />
           <Setter Target="CatalogFilterContent.Opacity" Value="0.6" />
          </VisualState.Setters></VisualState>
         </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ContentPresenter x:Name="CatalogFilterContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
       </Grid>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <local:CatalogActionNameConverter x:Key="Catalog.ActionName" />
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Background="Transparent">
  <Grid Visibility="{x:Bind Controller.IsHome, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
   <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource MeowFilm.OverlayScrollViewer}" Visibility="{x:Bind Controller.HasSections, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
    <ItemsControl ItemsSource="{x:Bind Controller.BrowseSections, Mode=OneWay}" Margin="40,12,40,20">
     <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
       <StackPanel />
      </ItemsPanelTemplate>
     </ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="local:CatalogHomeSection">
       <StackPanel Margin="0,0,0,28">
        <Grid Margin="0,0,0,16">
         <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>
         <Button Tag="{x:Bind}" Click="More_Click" Style="{StaticResource Catalog.ShelfTitleButton}" AutomationProperties.Name="{x:Bind Title, Converter={StaticResource Catalog.ActionName}, ConverterParameter=查看更多}">
          <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind Title}" FontSize="{StaticResource MeowFilm.Font.Size.SectionHeading}" VerticalAlignment="Center" /><FontIcon Glyph="&#xE76C;" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
         </Button>
         <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Tag="{x:Bind}" Content="{x:Bind ActionText}" Click="HomeAction_Click" Style="{StaticResource Catalog.MoreButton}" IsEnabled="{x:Bind CanAction, Mode=OneWay}" Visibility="{x:Bind ShowAction, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" AutomationProperties.Name="{x:Bind ActionText}" />
          <Button Click="HomeRefresh_Click" Style="{StaticResource Catalog.ShelfRefreshButton}" IsEnabled="{x:Bind CanRefresh, Mode=OneWay}" Visibility="{x:Bind ShowRefresh, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" AutomationProperties.Name="{x:Bind Title, Converter={StaticResource Catalog.ActionName}, ConverterParameter=刷新}"><FontIcon Glyph="&#xE72C;" FontSize="16" /></Button>
         </StackPanel>
        </Grid>
        <local:CatalogShelf Admitted="Shelf_Admitted" ItemActivated="Shelf_ItemActivated" RetryRequested="Shelf_RetryRequested" />
       </StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <ProgressRing x:Name="HomeLoadingRing" x:Load="{x:Bind Controller.ShowHomeLoading, Mode=OneWay, FallbackValue=False}" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="{x:Bind Controller.ShowHomeStatus, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
    <TextBlock Text="{x:Bind Controller.HomeStatusText, Mode=OneWay}" Foreground="{ThemeResource MeowFilm.Brush.Muted}" FontSize="15" TextAlignment="Center" />
    <Button Content="重试" HorizontalAlignment="Center" Style="{StaticResource Catalog.PageButton}" Visibility="{x:Bind Controller.CanRetryHome, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" Click="HomeRetry_Click" AutomationProperties.Name="重试加载首页" />
    <Button Content="导入书源" HorizontalAlignment="Center" Style="{StaticResource Catalog.PageButton}" Visibility="{x:Bind Controller.CanImportHome, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" Click="HomeImport_Click" AutomationProperties.Name="导入书源" />
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="DataScroll" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource MeowFilm.OverlayScrollViewer}" Visibility="{x:Bind Controller.IsData, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
   <StackPanel Margin="40,12,40,36">
    <Grid Margin="0,0,0,16">
     <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
     </Grid.ColumnDefinitions>
     <TextBlock x:Name="DataTitle" Text="{x:Bind Controller.BrowseActiveData.Title, Mode=OneWay}" Style="{StaticResource MeowFilm.SectionHeading}" />
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Button Content="{x:Bind Controller.BrowseActiveData.ActionText, Mode=OneWay}" Click="DataAction_Click" Style="{StaticResource Catalog.MoreButton}" IsEnabled="{x:Bind Controller.BrowseActiveData.CanAction, Mode=OneWay}" Visibility="{x:Bind Controller.BrowseActiveData.ShowAction, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" AutomationProperties.Name="{x:Bind Controller.DataActionAutomationName, Mode=OneWay}" />
      <Button Content="刷新" Click="DataRefresh_Click" Style="{StaticResource Catalog.MoreButton}" IsEnabled="{x:Bind Controller.BrowseActiveData.CanRefresh, Mode=OneWay}" Visibility="{x:Bind Controller.BrowseActiveData.ShowRefresh, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" AutomationProperties.Name="{x:Bind Controller.DataRefreshAutomationName}" />
     </StackPanel>
    </Grid>
    <Border Margin="0,0,0,20" Visibility="{x:Bind Controller.BrowseActiveData.FiltersVisibility, Mode=OneWay}">
     <ItemsControl x:Name="DataFilters" ItemsSource="{x:Bind Controller.BrowseActiveData.FilterRows, Mode=OneWay}">
      <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate>
        <StackPanel />
       </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="local:CatalogFilterRow">
        <Grid Margin="0,5">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <TextBlock Text="{x:Bind Label}" Style="{StaticResource MeowFilm.FilterLabel}" />
         <Border Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource Catalog.FilterGroup}">
          <ItemsControl ItemsSource="{x:Bind Options}">
           <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
             <desktop:WrapPanel />
            </ItemsPanelTemplate>
           </ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:CatalogFilterOption">
             <ToggleButton Content="{x:Bind Label}" Tag="{x:Bind}" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Style="{StaticResource Catalog.FilterChip}" Click="Filter_Click" AutomationProperties.Name="{x:Bind AutomationName}" />
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </Border>
        </Grid>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </Border>
    <Grid MinHeight="260">
     <ProgressRing x:Name="DataLoadingRing" x:Load="{x:Bind Controller.BrowseActiveData.ShowLoading, Mode=OneWay, FallbackValue=False}" IsActive="True" />
     <ItemsControl x:Name="DataItems" ItemsSource="{x:Bind Controller.BrowseActiveData.Items, Mode=OneWay}" AutomationProperties.Name="{x:Bind Controller.DataListAutomationName}" Visibility="{x:Bind Controller.BrowseActiveData.HasItems, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
      <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate>
        <local:AdaptiveCardPanel />
       </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="local:ICatalogCardDisplay">
        <local:FilmCard CardActivated="DataCard_Activated" />
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind Controller.BrowseActiveData.ShowStatus, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}">
      <TextBlock Text="{x:Bind Controller.BrowseActiveData.StatusText, Mode=OneWay}" Foreground="{ThemeResource MeowFilm.Brush.Muted}" FontSize="15" TextAlignment="Center" />
      <Button Content="重试" Margin="0,14,0,0" Style="{StaticResource Catalog.PageButton}" Visibility="{x:Bind Controller.BrowseActiveData.CanRetry, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" Click="DataRetry_Click" AutomationProperties.Name="{x:Bind Controller.DataRetryAutomationName}" />
     </StackPanel>
    </Grid>
    <Button x:Name="DataPageAction" HorizontalAlignment="Center" Content="{x:Bind Controller.BrowseActiveData.PageActionText, Mode=OneWay}" IsEnabled="{x:Bind Controller.BrowseActiveData.CanPage, Mode=OneWay}" Visibility="{x:Bind Controller.BrowseActiveData.ShowPageAction, Mode=OneWay, Converter={StaticResource MeowFilm.Visible}}" Style="{StaticResource Catalog.PageButton}" Click="DataPageAction_Click" AutomationProperties.Name="{x:Bind Controller.DataMoreAutomationName}" />
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
