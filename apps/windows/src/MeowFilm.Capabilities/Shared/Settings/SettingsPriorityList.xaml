<UserControl x:Class="MeowFilm.Capabilities.SettingsPriorityList"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 x:Name="Root" IsTabStop="True">
 <StackPanel>
  <TextBlock Text="{x:Bind Title,Mode=OneWay}" FontSize="14" Margin="0,0,0,12"
             Visibility="{x:Bind ShowTitle,Mode=OneWay,Converter={StaticResource MeowFilm.Visible}}"/>
  <Border x:Name="ListSurface" Style="{StaticResource Settings.ListSurface}">
   <Grid>
    <ListView x:Name="PriorityItems" Style="{StaticResource Settings.List}" ItemContainerStyle="{StaticResource Settings.ListItem}"
              ItemsSource="{x:Bind ItemsSource,Mode=OneWay}" IsEnabled="{x:Bind CanEdit,Mode=OneWay}"
              AutomationProperties.Name="{x:Bind Title,Mode=OneWay}">
     <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
     <ListView.ItemTemplate><DataTemplate x:DataType="local:ISettingsPriorityItem">
      <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource MeowFilm.Brush.Border}"><Grid Height="50">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
       <Thumb Grid.Column="3" Style="{StaticResource Settings.Grip}" DragStarted="Grip_Started" DragDelta="Grip_Delta" DragCompleted="Grip_Completed"
              KeyDown="Grip_KeyDown" AutomationProperties.Name="{x:Bind Label}"/>
       <Image x:Name="ItemLogo" Grid.Column="0" Source="{x:Bind LogoUri,Converter={StaticResource Settings.ImageUri}}" Width="22" Height="22" Margin="0,0,10,0"
              Visibility="Collapsed" Loaded="ItemLogo_Loaded" AutomationProperties.Name="{x:Bind Label}"/>
       <TextBlock Grid.Column="1" Text="{x:Bind Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       <CheckBox x:Name="ItemToggle" Grid.Column="2" Style="{StaticResource MeowFilm.Switch}" Margin="8,0" Tag="{x:Bind}" Click="Enabled_Click"
                 IsChecked="{x:Bind Enabled,Mode=OneWay}" Visibility="Visible" Loaded="ItemToggle_Loaded"
                 AutomationProperties.Name="{x:Bind Label}"/>
      </Grid></Border>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <Canvas x:Name="DragOverlay" IsHitTestVisible="False"/>
   </Grid>
  </Border>
 </StackPanel>
</UserControl>
