<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MeowFilm.Capabilities" xmlns:desktop="using:MeowFilm.Desktop">
 <ResourceDictionary.ThemeDictionaries><ResourceDictionary x:Key="HighContrast">
  <SolidColorBrush x:Key="Settings.Brush.SwitchOn" Color="{ThemeResource SystemColorHighlightColor}"/>
 </ResourceDictionary></ResourceDictionary.ThemeDictionaries>
 <SolidColorBrush x:Key="Settings.Brush.Ground" Color="Transparent"/>
 <SolidColorBrush x:Key="Settings.Brush.Rule" Color="#E5E7EB"/>
 <SolidColorBrush x:Key="Settings.Brush.ListSurface" Color="#B8F8FAFC"/>
 <SolidColorBrush x:Key="Settings.Brush.Active" Color="#F3F4F6"/>
 <SolidColorBrush x:Key="Settings.Brush.Selected" Color="#E4F2FC"/>
 <SolidColorBrush x:Key="Settings.Brush.SwitchOn" Color="#22C55E"/>
 <local:SettingsValueConverter x:Key="Settings.PlatformLogo" Kind="PlatformLogo"/>
 <local:SettingsValueConverter x:Key="Settings.QualityName" Kind="QualityName"/>
 <local:SettingsValueConverter x:Key="Settings.Not" Kind="Not"/>
 <local:SettingsValueConverter x:Key="Settings.InverseVisibility" Kind="InverseVisibility"/>
 <local:SettingsValueConverter x:Key="Settings.PrefixName" Kind="PrefixName"/>
 <local:SettingsValueConverter x:Key="Settings.RestoreSourceName" Kind="RestoreSourceName"/>
 <local:SettingsValueConverter x:Key="Settings.SourceTone" Kind="SourceTone"/>
 <local:SettingsValueConverter x:Key="Settings.SourceDot" Kind="SourceDot"/>
 <desktop:StringToVisibilityConverter x:Key="Settings.StatusVisibility"/>
 <Style x:Key="Settings.Text" TargetType="TextBlock" BasedOn="{StaticResource Capability.Text}"><Setter Property="FontSize" Value="14"/></Style>
 <Style x:Key="Settings.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Capability.Muted}"><Setter Property="FontSize" Value="12"/></Style>
 <Style x:Key="Settings.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource MeowFilm.SettingsSectionTitle}"/>
 <Style x:Key="Settings.Section" TargetType="Border" BasedOn="{StaticResource MeowFilm.SettingsSection}"/>
 <Style x:Key="Settings.Button" TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
  <Setter Property="MinHeight" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="14,5"/>
  <Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="CornerRadius" Value="10"/>
 </Style>
 <Style x:Key="Settings.QuietButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.GhostButton}">
  <Setter Property="MinHeight" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,5"/>
  <Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="CornerRadius" Value="10"/>
 </Style>
 <Style x:Key="Settings.PrimaryButton" TargetType="Button" BasedOn="{StaticResource MeowFilm.PrimaryButton}">
  <Setter Property="MinHeight" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,5"/><Setter Property="FontSize" Value="13"/>
 </Style>
 <Style x:Key="Settings.DangerButton" TargetType="Button" BasedOn="{StaticResource Settings.Button}">
  <Setter Property="Foreground" Value="{ThemeResource MeowFilm.Brush.Error}"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderBrush" Value="{ThemeResource MeowFilm.Brush.Error}"/>
  <Setter Property="Template" Value="{StaticResource MeowFilm.ManagementDeleteButtonTemplate}"/>
 </Style>
 <Style x:Key="Settings.CheckBox" TargetType="CheckBox" BasedOn="{StaticResource MeowFilm.ManagementCheck}"><Setter Property="MinWidth" Value="24"/><Setter Property="MinHeight" Value="32"/></Style>
 <Style x:Key="Settings.TextBox" TargetType="TextBox" BasedOn="{StaticResource MeowFilm.TextBox}">
  <Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,6"/>
 </Style>
 <Style x:Key="Settings.PopupSurface" TargetType="Border">
  <Setter Property="Background" Value="{ThemeResource MeowFilm.Brush.Surface}"/><Setter Property="BorderBrush" Value="{ThemeResource MeowFilm.Brush.Border}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="0"/>
 </Style>
 <Style x:Key="Settings.PopupTitle" TargetType="TextBlock" BasedOn="{StaticResource Settings.SectionTitle}"><Setter Property="FontSize" Value="18"/></Style>
 <Style x:Key="Settings.PopupClose" TargetType="Button" BasedOn="{StaticResource Settings.QuietButton}">
  <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="0"/>
  <Setter Property="FontFamily" Value="{ThemeResource MeowFilm.Font.Icons}"/>
 </Style>
 <Style x:Key="Settings.RuleSurface" TargetType="Border" BasedOn="{StaticResource Settings.PopupSurface}"><Setter Property="Padding" Value="12,8"/></Style>
 <Style x:Key="Settings.ListSurface" TargetType="Border" BasedOn="{StaticResource Settings.PopupSurface}"><Setter Property="Padding" Value="6"/></Style>
 <Style x:Key="Settings.RowDivider" TargetType="Border"><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{ThemeResource MeowFilm.Brush.Border}"/></Style>
 <Style x:Key="Settings.ListHeader" TargetType="TextBlock" BasedOn="{StaticResource Settings.Subtitle}"/>
 <Style x:Key="Settings.List" TargetType="ListView">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled"/>
  <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
 </Style>
 <Style x:Key="Settings.ListItem" TargetType="ListViewItem">
  <Setter Property="MinHeight" Value="52"/><Setter Property="Height" Value="52"/><Setter Property="Padding" Value="10,0"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 </Style>
 <Style x:Key="Settings.Grip" TargetType="Thumb">
  <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="IsTabStop" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent" CornerRadius="6">
   <Path x:Name="Bars" Width="14" Height="10" Data="M 0,1 H 14 M 0,5 H 14 M 0,9 H 14" Stroke="{ThemeResource MeowFilm.Brush.Muted}" StrokeThickness="1.5"
         HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
