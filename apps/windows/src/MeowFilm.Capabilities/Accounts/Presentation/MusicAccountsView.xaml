<UserControl x:Class="MeowFilm.Capabilities.MusicAccountsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Capabilities"
 xmlns:desktop="using:MeowFilm.Desktop"
 xmlns:art="using:MeowFilm.Desktop.Artwork"
 x:Name="AccountsRoot" Foreground="{ThemeResource MeowFilm.Brush.Text}">
 <UserControl.Resources>
  <ResourceDictionary>
   <local:AccountAccessibleNameConverter x:Key="Account.AccessibleName"/>
   <Style x:Key="Account.PlatformName" TargetType="TextBlock" BasedOn="{StaticResource Settings.Text}">
    <Setter Property="Margin" Value="12,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   </Style>
   <Style x:Key="Account.PreferenceSwitch" TargetType="CheckBox" BasedOn="{StaticResource Settings.Switch}">
    <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   <Style x:Key="Account.Dash" TargetType="TextBlock" BasedOn="{StaticResource Settings.Text}">
    <Setter Property="Text" Value="—"/><Setter Property="Foreground" Value="{ThemeResource MeowFilm.Brush.Muted}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   <DataTemplate x:Key="Account.Person">
    <Grid>
     <Grid x:Name="Person" Visibility="{Binding IsLoggedIn,Converter={StaticResource MeowFilm.BoolToVisibility}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="32" Height="32" VerticalAlignment="Center">

       <art:ArtworkImage Address="{Binding Avatar}" Width="32" Height="32" Stretch="UniformToFill"
                         Visibility="{Binding IsLoggedIn,Converter={StaticResource MeowFilm.BoolToVisibility},FallbackValue=Collapsed}"
                         AutomationProperties.Name="{Binding Name,Converter={StaticResource Account.AccessibleName},ConverterParameter=头像}">
        <art:ArtworkImage.Resources>
         <Style TargetType="Button" BasedOn="{StaticResource Settings.QuietButton}"/>
        </art:ArtworkImage.Resources>
       </art:ArtworkImage>
      </Grid>
      <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Settings.Text}" FontSize="{StaticResource MeowFilm.Font.Size.Body}" LineHeight="21" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Membership}" Style="{StaticResource Settings.Subtitle}" FontSize="11" LineHeight="19" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </Grid>
     <TextBlock x:Name="AccountState" Visibility="{Binding IsLoggedIn,Converter={StaticResource Settings.InverseVisibility}}" Text="{Binding DisplayName}" Style="{StaticResource Settings.Subtitle}" FontSize="{StaticResource MeowFilm.Font.Size.Compact}"
                VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </Grid>
   </DataTemplate>
   <DataTemplate x:Key="Account.Public">
    <TextBlock Text="无需登录" Style="{StaticResource Settings.Subtitle}" FontSize="{StaticResource MeowFilm.Font.Size.Compact}" VerticalAlignment="Center"/>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid x:Name="Root">
  <StackPanel>
   <ScrollViewer x:Name="AccountTableScroll" Style="{StaticResource MeowFilm.SettingsScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                 IsTabStop="False" SizeChanged="AccountTableScroll_SizeChanged"
                 AutomationProperties.Name="平台账号表">
    <Grid x:Name="AccountTable" MinWidth="640">
     <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid x:Name="AccountTableHeader" Margin="7,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="196"/><ColumnDefinition Width="8"/>
       <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
       <ColumnDefinition Width="112"/><ColumnDefinition Width="8"/>
       <ColumnDefinition Width="112"/><ColumnDefinition Width="8"/>
       <ColumnDefinition Width="112"/><ColumnDefinition Width="8"/>
       <ColumnDefinition Width="146"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="平台" Style="{StaticResource Account.Header}"/>
      <TextBlock Grid.Column="2" Text="账号" Style="{StaticResource Account.Header}"/>
      <TextBlock Grid.Column="4" Text="播放上报" Style="{StaticResource Account.Header}" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="6" Text="收藏同步" Style="{StaticResource Account.Header}" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="8" Text="歌单同步" Style="{StaticResource Account.Header}" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="10" Text="操作" Style="{StaticResource Account.Header}" HorizontalAlignment="Center"/>
     </Grid>
     <Border x:Name="AccountBody" Grid.Row="1" Style="{StaticResource Settings.ListSurface}">
      <ItemsControl x:Name="PlatformSettingsList"
                    ItemsSource="{Binding AccountTableRows,ElementName=AccountsRoot}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border x:Name="AccountTableRow" Style="{StaticResource Account.Row}">
         <Grid x:Name="AccountCells" Loaded="AccountCells_Loaded">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="196"/><ColumnDefinition Width="8"/>
           <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
           <ColumnDefinition Width="112"/><ColumnDefinition Width="8"/>
           <ColumnDefinition Width="112"/><ColumnDefinition Width="8"/>
           <ColumnDefinition Width="112"/><ColumnDefinition Width="8"/>
           <ColumnDefinition Width="146"/>
          </Grid.ColumnDefinitions>
          <Grid VerticalAlignment="Center">
           <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Image Source="{Binding Platform,Converter={StaticResource Settings.PlatformLogo}}" Width="26" Height="26"
                  AutomationProperties.Name="{Binding Name,Converter={StaticResource Account.AccessibleName},ConverterParameter=标志}"/>
           <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Account.PlatformName}"/>
          </Grid>
          <Grid Grid.Column="2">
           <ContentControl Content="{Binding Source}" ContentTemplate="{StaticResource Account.Person}"
                           HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" IsTabStop="False"
                           Visibility="{Binding IsPublicCatalog,Converter={StaticResource Settings.InverseVisibility}}"/>
           <TextBlock Text="无需登录" Style="{StaticResource Settings.Subtitle}" VerticalAlignment="Center"
                      Visibility="{Binding IsPublicCatalog,Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
          </Grid>
          <Grid Grid.Column="4">
           <CheckBox Style="{StaticResource Account.PreferenceSwitch}"
                     Visibility="{Binding Source.IsLoggedIn,Converter={StaticResource MeowFilm.BoolToVisibility},FallbackValue=Collapsed}" IsEnabled="{Binding Source.CanEditFeedback,FallbackValue=False}" IsChecked="{Binding Source.FeedbackEnabled,Mode=OneWay}"
                     Tag="{Binding Source}" Click="Feedback_Click" AutomationProperties.Name="{Binding Name,Converter={StaticResource Account.AccessibleName},ConverterParameter=播放上报}"/>
           <TextBlock Style="{StaticResource Account.Dash}" Visibility="{Binding Source.IsLoggedIn,Converter={StaticResource Settings.InverseVisibility},FallbackValue=Visible}"/>
          </Grid>
          <Grid Grid.Column="6">
           <CheckBox Style="{StaticResource Account.PreferenceSwitch}"
                     Visibility="{Binding Source.IsLoggedIn,Converter={StaticResource MeowFilm.BoolToVisibility},FallbackValue=Collapsed}" IsEnabled="{Binding Source.CanEditSync,FallbackValue=False}" IsChecked="{Binding Source.FavoritesSyncEnabled,Mode=OneWay}"
                     Tag="{Binding Source}" Click="FavoritesSync_Click" AutomationProperties.Name="{Binding Name,Converter={StaticResource Account.AccessibleName},ConverterParameter=收藏歌曲同步}"/>
           <TextBlock Style="{StaticResource Account.Dash}" Visibility="{Binding Source.IsLoggedIn,Converter={StaticResource Settings.InverseVisibility},FallbackValue=Visible}"/>
          </Grid>
          <Grid Grid.Column="8">
           <CheckBox Style="{StaticResource Account.PreferenceSwitch}"
                     Visibility="{Binding Source.IsLoggedIn,Converter={StaticResource MeowFilm.BoolToVisibility},FallbackValue=Collapsed}" IsEnabled="{Binding Source.CanEditSync,FallbackValue=False}" IsChecked="{Binding Source.PlaylistsSyncEnabled,Mode=OneWay}"
                     Tag="{Binding Source}" Click="PlaylistsSync_Click" AutomationProperties.Name="{Binding Name,Converter={StaticResource Account.AccessibleName},ConverterParameter=歌单同步}"/>
           <TextBlock Style="{StaticResource Account.Dash}" Visibility="{Binding Source.IsLoggedIn,Converter={StaticResource Settings.InverseVisibility},FallbackValue=Visible}"/>
          </Grid>
          <Grid Grid.Column="10">
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Source.IsLoggedIn,Converter={StaticResource MeowFilm.BoolToVisibility},FallbackValue=Collapsed}">
            <Button Tag="{Binding Source}" Click="RefreshDetails_Click" Style="{StaticResource Settings.QuietButton}" Content="{Binding Source.RefreshText}"
                    IsEnabled="{Binding Source.CanRefresh,FallbackValue=False}" AutomationProperties.Name="{Binding Name,Converter={StaticResource Account.AccessibleName},ConverterParameter=刷新资料}"/>
            <Button Content="退出登录" Tag="{Binding Source}" Click="Logout_Click" Style="{StaticResource Settings.QuietButton}" Margin="8,0,0,0"
                    IsEnabled="{Binding Source.CanLogout,FallbackValue=False}" AutomationProperties.Name="{Binding Name,Converter={StaticResource Account.AccessibleName},ConverterParameter=退出账号}"/>
           </StackPanel>
           <Button Content="登录" Tag="{Binding Source}" Click="Login_Click" Style="{StaticResource Settings.PrimaryButton}"
                   Visibility="{Binding Source.ShowLogin,Converter={StaticResource MeowFilm.BoolToVisibility},FallbackValue=Collapsed}" IsEnabled="{Binding Source.CanLogin,FallbackValue=False}"
                   MinWidth="70" HorizontalAlignment="Center" VerticalAlignment="Center"
                   AutomationProperties.Name="{Binding Name,Converter={StaticResource Account.AccessibleName},ConverterParameter=登录}"/>
           <TextBlock Style="{StaticResource Account.Dash}" Visibility="{Binding Source.ShowActionDash,Converter={StaticResource MeowFilm.BoolToVisibility},FallbackValue=Visible}"/>
          </Grid>
          <desktop:NoticeOutlet Message="{Binding Source.DetailsStatus}"/>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </Border>
    </Grid>
   </ScrollViewer>
   <Button Content="确认同步变更" Click="ConfirmSync_Click" HorizontalAlignment="Left"
           Style="{StaticResource Settings.Button32}" Margin="0,16,0,0"
           Visibility="{Binding LibrarySync.HasConfirmation,Converter={StaticResource MeowFilm.BoolToVisibility}}"
           IsEnabled="{Binding LibrarySync.CanEdit}"/>
   <desktop:NoticeOutlet Message="{Binding AccountNotice}"/>
   <desktop:NoticeOutlet Message="{Binding FeedbackStatus}"/>
   <desktop:NoticeOutlet Message="{Binding LibrarySync.Status}"/>
  </StackPanel>

  <Grid x:Name="ModalStash" Visibility="Collapsed">
   <Border x:Name="LogoutPopupSurface" Width="240" Style="{StaticResource Settings.PopupSurface}" CornerRadius="10" Padding="20"
           TabFocusNavigation="Cycle" KeyDown="LogoutPopup_KeyDown" AutomationProperties.Name="退出账号确认">
    <StackPanel>
     <TextBlock Text="退出此账号？" FontSize="{StaticResource MeowFilm.Font.Size.Body}" Margin="0,0,0,16"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelLogoutButton" Content="取消" Click="CancelLogout_Click" MinWidth="64"
              Style="{StaticResource Settings.QuietButton}" AutomationProperties.Name="取消退出账号"/>
      <Button Content="确定" Click="ConfirmLogout_Click" MinWidth="64" Margin="8,0,0,0"
              Style="{StaticResource Settings.PrimaryButton}" AutomationProperties.Name="确定退出账号"/>
     </StackPanel>
    </StackPanel>
   </Border>
   <local:AccountLoginSurface x:Name="LoginSurface"
           Style="{StaticResource Account.LoginSurface}" CloseRequested="CloseLogin_Click">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{ThemeResource Settings.Brush.Active}" CornerRadius="6" Margin="0,0,0,16" Padding="2">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button x:Name="QrModeButton" Content="二维码登录" Click="QrMode_Click"
               Style="{StaticResource Login.Segment}"/>
       <Button Grid.Column="1" x:Name="SmsModeButton" Content="验证码登录" Click="SmsMode_Click"
               Style="{StaticResource Login.Segment}" IsEnabled="{Binding ShowAccountSms}"/>
      </Grid>
     </Border>
     <Grid Grid.Row="1">
      <StackPanel x:Name="QrPanel" HorizontalAlignment="Center">
       <Border Style="{StaticResource Account.QrFrame}">
        <Image x:Name="AccountQrImage" Source="{Binding AccountQrImage}" Stretch="Uniform"

               AutomationProperties.Name="{Binding AccountQrAccessibleName}"/>
       </Border>
       <Button Content="刷新二维码" Click="RefreshQr_Click" HorizontalAlignment="Center" Margin="0,14,0,0"
               Style="{StaticResource Settings.QuietButton}" IsEnabled="{Binding CanBeginAccountQr}"/>
       <TextBlock Text="{Binding AccountStatus}" Style="{StaticResource Settings.Subtitle}"
                  HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="{StaticResource MeowFilm.Font.Size.Compact}"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
        <Button x:Name="SaveQrButton" Content="保存二维码" Click="SaveQr_Click" Style="{StaticResource Settings.Button32}" IsEnabled="{Binding CanSaveAccountQr}"/>
       </StackPanel>
      </StackPanel>
      <StackPanel x:Name="SmsPanel" Visibility="Collapsed" VerticalAlignment="Center">
       <Border CornerRadius="6" BorderBrush="{ThemeResource MeowFilm.Brush.Border}"
               BorderThickness="1" Height="40" Margin="0,0,0,12">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <TextBlock Text="+86" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Border Grid.Column="1" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="0,8"/>
         <TextBox x:Name="SmsPhoneInput" Grid.Column="2" BorderThickness="0" Background="Transparent"
                  MinHeight="0" Padding="12,6" MaxLength="15" AutomationProperties.Name="手机号"/>
        </Grid>
       </Border>
       <Border CornerRadius="6" BorderBrush="{ThemeResource MeowFilm.Brush.Border}"
               BorderThickness="1" Height="40" Margin="0,0,0,16">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
         <PasswordBox x:Name="SmsCodeInput" BorderThickness="0" Background="Transparent"
                      Padding="12,6" MaxLength="8" VerticalContentAlignment="Center"
                      AutomationProperties.Name="验证码"/>
         <Border Grid.Column="1" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="0,8"/>
         <Button x:Name="SmsSendButton" Grid.Column="2" Content="{Binding AccountSmsSendText}" Click="SmsSend_Click"
                 Style="{StaticResource Settings.QuietButton}" IsEnabled="{Binding CanSendAccountSms}"/>
        </Grid>
       </Border>
       <Button x:Name="SmsLoginButton" Content="登录" Click="SmsLogin_Click"
               Style="{StaticResource Settings.PrimaryButton}" IsEnabled="{Binding CanLoginAccountSms}"/>
       <TextBlock Text="{Binding AccountStatus}" Style="{StaticResource Settings.Subtitle}"
                  HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="{StaticResource MeowFilm.Font.Size.Compact}"/>
      </StackPanel>
     </Grid>
    </Grid>
   </local:AccountLoginSurface>
  </Grid>
 </Grid>
</UserControl>
