<UserControl x:Class="MeowFilm.Desktop.NoticeStack"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Desktop"
 MaxWidth="460"
 HorizontalAlignment="Right"
 VerticalAlignment="Bottom"
 IsTabStop="False">
 <ItemsControl x:Name="NoticeItems" IsTabStop="False">
  <ItemsControl.ItemTemplate>
   <DataTemplate x:DataType="local:NoticeEntry">
    <Border Padding="16,10,10,10" Margin="0,0,0,8" CornerRadius="10" BorderThickness="1"
            HorizontalAlignment="Right" Translation="0,0,16"
            Background="{ThemeResource MeowFilm.Brush.FloatingSurface}"
            BorderBrush="{ThemeResource MeowFilm.Brush.Border}"
            PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited"
            Loaded="OnCardLoaded">
     <Border.Shadow><ThemeShadow/></Border.Shadow>
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                 Foreground="{ThemeResource MeowFilm.Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
      <Button Grid.Column="1" Style="{StaticResource MeowFilm.IconButton}" Content="&#xE711;"
              Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="0" VerticalAlignment="Center"
              Visibility="{x:Bind DismissVisibility}" Click="OnDismissClick"
              AutomationProperties.Name="关闭通知"/>
     </Grid>
    </Border>
   </DataTemplate>
  </ItemsControl.ItemTemplate>
 </ItemsControl>
</UserControl>
