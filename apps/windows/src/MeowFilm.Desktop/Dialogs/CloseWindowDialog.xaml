<UserControl x:Class="MeowFilm.Desktop.CloseWindowDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Desktop"
 UseLayoutRounding="True"
 TabFocusNavigation="Cycle"
 KeyDown="OnPreviewKeyDown" AutomationProperties.Name="关闭主窗口">
 <UserControl.Style>
  <Style TargetType="UserControl">
   <Setter Property="Foreground" Value="{ThemeResource MeowFilm.Brush.Text}"/>

  </Style>
 </UserControl.Style>
 <Grid Background="Transparent">
  <Border x:Name="DialogSurface" Style="{ThemeResource MeowFilm.FloatingSurface}" MaxWidth="440"
          Margin="24" Padding="20" VerticalAlignment="Center">
   <StackPanel>
    <local:DockPanel Margin="0,0,0,16">
     <Button x:Name="DismissButton" local:DockPanel.Dock="Right" Style="{ThemeResource MeowFilm.IconButton}"
             Content="&#xE711;" Width="30" Height="30" MinHeight="30" Margin="8,0,0,0"
             Click="OnCancelClick" AutomationProperties.Name="取消关闭选择"/>
     <TextBlock x:Name="DialogTitle" Text="关闭主窗口" Style="{ThemeResource MeowFilm.SectionHeading}" Margin="0"
                VerticalAlignment="Center" TextWrapping="Wrap"/>
    </local:DockPanel>
    <CheckBox x:Name="RememberChoice" Content="记住我的选择" Padding="4" Margin="0,0,0,16"
              VerticalContentAlignment="Center" AutomationProperties.Name="记住我的选择">
     <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource MeowFilm.ManagementCheck}">
      <Setter Property="Foreground" Value="{ThemeResource MeowFilm.Brush.Text}"/>
     </Style></CheckBox.Style>
    </CheckBox>
    <local:WrapPanel x:Name="Choices" HorizontalAlignment="Right">
     <Button x:Name="MinimizeChoice" Content="最小化到托盘" Margin="0,0,8,8"
             Tag="MinimizeToTray" Click="OnChoiceClick"
             AutomationProperties.Name="最小化到托盘"/>
     <Button x:Name="ExitChoice" Content="退出" Margin="0,0,8,8"
             Tag="Exit" Click="OnChoiceClick"
             AutomationProperties.Name="退出"/>
     <Button x:Name="CancelChoice" Content="取消" Margin="0,0,0,8"
             Style="{ThemeResource MeowFilm.QuietButton}" Click="OnCancelClick"
             AutomationProperties.Name="取消"/>
    </local:WrapPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
