<UserControl x:Class="MeowFilm.Desktop.DesktopPageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MeowFilm.Desktop"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Focusable="False" IsTabStop="False"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding Navigation, RelativeSource={RelativeSource AncestorType=local:DesktopPageHeader}}"
                            VerticalContentAlignment="Center" Focusable="False" IsTabStop="False" />
            <TextBlock x:Name="Heading" Grid.Column="1" Visibility="Collapsed"
                       Style="{DynamicResource MeowFilm.Title}" VerticalAlignment="Center" Margin="8,0,20,0"
                       AutomationProperties.HeadingLevel="Level1" />
            <ContentControl x:Name="LeadingSlot" Grid.Column="2" Visibility="Collapsed"
                            VerticalContentAlignment="Center" Focusable="False" IsTabStop="False" />
        </Grid>
        <StackPanel x:Name="TrailingHeader" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <ContentControl x:Name="TrailingSlot" VerticalContentAlignment="Center" Margin="0,0,8,0"
                            Focusable="False" IsTabStop="False" />
            <ItemsControl x:Name="HeaderActions">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Tag="{Binding}" Click="OnActionClick"
                                IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{Binding AutomationName}"
                                Style="{DynamicResource MeowFilm.HeaderAction}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
