<UserControl x:Class="MeowFilm.Desktop.GeneralSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Desktop"
 UseLayoutRounding="True"
 Foreground="{ThemeResource MeowFilm.Brush.Text}"
 Loaded="View_Loaded">
 <Grid Style="{StaticResource MeowFilm.SettingsPage}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Border Style="{StaticResource MeowFilm.SettingsNavigationBar}">
   <StackPanel x:Name="Areas" Orientation="Horizontal">
    <RadioButton Content="外观" Tag="appearance" IsChecked="True" Style="{StaticResource MeowFilm.SettingsArea}" Checked="Area_Checked" KeyDown="Area_KeyDown"/>
    <RadioButton Content="首页数据源" Tag="sources" Style="{StaticResource MeowFilm.SettingsArea}" Checked="Area_Checked" KeyDown="Area_KeyDown"/>
    <RadioButton Content="缓存控制" Tag="cache" Style="{StaticResource MeowFilm.SettingsArea}" Checked="Area_Checked" KeyDown="Area_KeyDown"/>
    <RadioButton x:Name="WindowArea" Content="窗口行为" Tag="window" Visibility="Collapsed"
                 Style="{StaticResource MeowFilm.SettingsArea}" Checked="Area_Checked" KeyDown="Area_KeyDown"
                 AutomationProperties.Name="窗口行为"/>
    <RadioButton x:Name="ShortcutsArea" Content="快捷键" Tag="shortcuts" Visibility="Collapsed" Style="{StaticResource MeowFilm.SettingsArea}" Checked="Area_Checked" KeyDown="Area_KeyDown"/>
   </StackPanel>
  </Border>
  <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Style="{StaticResource MeowFilm.SettingsScrollViewer}" AutomationProperties.Name="通用设置">
   <Grid x:Name="SettingsPages">
    <StackPanel x:Name="AppearancePage">
    <Border Style="{StaticResource MeowFilm.SettingsSection}">
     <StackPanel>
      <TextBlock Text="主题颜色" Style="{StaticResource MeowFilm.SettingsSectionTitle}" Margin="0,0,0,8"/>
      <local:ColorSelection x:Name="ThemeSelection" Label="主题颜色" Value="{x:Bind appearance.ThemeColor,Mode=OneWay}"
                            IsEnabled="{x:Bind appearance.CanEdit,Mode=OneWay}" ValueCommitted="Theme_Committed"/>
      <Button Content="重新读取" HorizontalAlignment="Left" Style="{StaticResource MeowFilm.QuietButton}" Click="Reload_Click"
              Visibility="{x:Bind appearance.Status,Mode=OneWay,Converter={StaticResource MeowFilm.Visible}}"/>
     </StackPanel>
    </Border>
    <StackPanel x:Name="AppearanceContributions"/>
    </StackPanel>
    <StackPanel x:Name="HomeSourceContributions" Visibility="Collapsed"/>
    <StackPanel x:Name="CachePage" Visibility="Collapsed">
     <StackPanel x:Name="CacheContributions"/>
     <Border x:Name="UserDataSection" Style="{StaticResource MeowFilm.SettingsSection}" Visibility="Collapsed">
      <StackPanel>
       <TextBlock Text="本机数据" Style="{StaticResource MeowFilm.SettingsSectionTitle}" Margin="0,0,0,8"/>
       <Button x:Name="ClearUserDataButton" Content="清除全部数据" HorizontalAlignment="Left"
               Click="ClearUserData_Click" AutomationProperties.Name="清除全部数据"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <StackPanel x:Name="WindowBehaviorPage" Visibility="Collapsed">
     <Border Style="{StaticResource MeowFilm.SettingsSection}">
      <StackPanel>
       <TextBlock Text="关闭主窗口时" Style="{StaticResource MeowFilm.SettingsSectionTitle}" Margin="0,0,0,8"/>
       <ComboBox x:Name="CloseBehaviorSelection" Width="190" HorizontalAlignment="Left"
                 Style="{StaticResource MeowFilm.SettingsComboBox}" UseSystemFocusVisuals="True"
                 IsEnabled="{x:Bind closePreferences.CanEdit,Mode=OneWay,FallbackValue=False}"
                 SelectionChanged="CloseBehavior_Changed" AutomationProperties.Name="关闭主窗口时">
        <ComboBoxItem Content="每次询问" Tag="Ask" AutomationProperties.Name="每次询问"/>
        <ComboBoxItem Content="最小化到托盘" Tag="MinimizeToTray" AutomationProperties.Name="最小化到托盘"/>
        <ComboBoxItem Content="退出应用" Tag="Exit" AutomationProperties.Name="退出应用"/>
       </ComboBox>
       <Button x:Name="ReloadClosePreferencesButton" Content="重新读取" HorizontalAlignment="Left"
               Style="{StaticResource MeowFilm.QuietButton}" Click="CloseReload_Click" AutomationProperties.Name="重新读取窗口行为"
               Visibility="{x:Bind closePreferences.Status,Mode=OneWay,Converter={StaticResource MeowFilm.Visible},FallbackValue=Collapsed}"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <ContentControl x:Name="ShortcutsPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch"/>
   </Grid>
  </ScrollViewer>
 </Grid>
</UserControl>
