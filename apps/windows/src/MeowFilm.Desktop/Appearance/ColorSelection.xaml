<UserControl x:Class="MeowFilm.Desktop.ColorSelection"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Desktop"
 x:Name="Root" UseLayoutRounding="True">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/MeowFilm.Desktop;component/Theme.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <WrapPanel>
  <ComboBox x:Name="Choices" Width="190" Style="{StaticResource MeowFilm.SettingsComboBox}"
            DisplayMemberPath="Name" SelectedValuePath="Key" SelectionChanged="Choice_Changed"
            AutomationProperties.Name="{Binding Label,ElementName=Root}"/>
  <local:ColorPicker x:Name="Custom" Margin="12,0,0,0" Label="{Binding Label,ElementName=Root}"
                     ColorCommitted="Custom_Committed"/>
 </WrapPanel>
</UserControl>
