<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Desktop"
 xmlns:desktop="clr-namespace:MeowFilm.Desktop">
 <Style x:Key="MeowFilm.ScrollPage" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="MeowFilm.ScrollThumb" TargetType="Thumb">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
   <Border x:Name="Chrome" Width="6" CornerRadius="3" Background="{DynamicResource MeowFilm.Brush.Border}" Margin="2,0"/>
   <ControlTemplate.Triggers>
    <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="MeowFilm.OverlayScrollViewer" TargetType="ScrollViewer">
  <Setter Property="local:OverlayScrollChrome.Enabled" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
   <Grid ClipToBounds="True">
    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
    <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" Width="10" Margin="0,0,2,0" HorizontalAlignment="Right"
     Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}"
     Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Opacity="0" Background="Transparent">
     <ScrollBar.Template><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
       <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource MeowFilm.ScrollPage}"/></Track.DecreaseRepeatButton>
       <Track.Thumb><Thumb Style="{StaticResource MeowFilm.ScrollThumb}" MinHeight="28"/></Track.Thumb>
       <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource MeowFilm.ScrollPage}"/></Track.IncreaseRepeatButton>
      </Track></Grid>
     </ControlTemplate></ScrollBar.Template>
    </ScrollBar>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="local:OverlayScrollChrome.Active" Value="True"><Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="0.6"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions>
     <Condition Property="local:OverlayScrollChrome.Active" Value="True"/><Condition SourceName="PART_VerticalScrollBar" Property="IsMouseOver" Value="True"/>
    </MultiTrigger.Conditions><Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/></MultiTrigger>
    <Trigger SourceName="PART_VerticalScrollBar" Property="IsMouseCaptureWithin" Value="True"><Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/></Trigger>
    <Trigger Property="desktop:DesktopTheme.IsHighContrast" Value="True"><Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
