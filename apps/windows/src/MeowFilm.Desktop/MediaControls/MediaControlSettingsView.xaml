<UserControl x:Class="MeowFilm.Desktop.MediaControlSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Desktop"
 UseLayoutRounding="True" SnapsToDevicePixels="True"
 Loaded="View_Loaded" Unloaded="View_Unloaded" IsVisibleChanged="View_VisibilityChanged"
 PreviewKeyDown="View_KeyDown" PreviewKeyUp="View_KeyUp" LostKeyboardFocus="View_LostFocus">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/MeowFilm.Desktop;component/Theme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <Style x:Key="Shortcut.Editor" TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
    <Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="8,4"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   </Style>
   <Style x:Key="Shortcut.Clear" TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
    <Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="2,0,0,0"/>
   </Style>
   <Style x:Key="Shortcut.Error" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource MeowFilm.Font.Size.Caption}"/><Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,4,0,0"/><Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Error}"/>
    <Style.Triggers>
     <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
     </Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Shortcut.Switch" TargetType="CheckBox">
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="18"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource MeowFilm.FocusVisual}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
     <Grid Width="32" Height="18">
      <Border x:Name="Track" CornerRadius="9" Background="{DynamicResource MeowFilm.Brush.Border}"/>
      <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2,0" HorizontalAlignment="Left" Fill="{DynamicResource MeowFilm.Brush.Surface}"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Track" Property="Background" Value="{DynamicResource MeowFilm.Brush.Accent}"/>
       <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource MeowFilm.Brush.Disabled}"/></Trigger>
      <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
       <Setter TargetName="Track" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
       <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
       <Setter TargetName="Track" Property="BorderThickness" Value="1"/>
       <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
      </Trigger>
      <MultiTrigger><MultiTrigger.Conditions>
       <Condition Property="local:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsChecked" Value="True"/>
      </MultiTrigger.Conditions>
       <Setter TargetName="Track" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
       <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
      </MultiTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <UserControl.Style><Style TargetType="UserControl">
  <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
  <Style.Triggers><Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
  </Trigger></Style.Triggers>
 </Style></UserControl.Style>
 <StackPanel>
  <Border Style="{StaticResource MeowFilm.SettingsSection}">
   <StackPanel>
    <TextBlock Text="快捷键" Style="{StaticResource MeowFilm.SettingsSectionTitle}" Margin="0,0,0,8"/>
    <Grid MinHeight="36">
     <TextBlock Text="全局快捷键" VerticalAlignment="Center"/>
     <CheckBox x:Name="GlobalSwitch" Style="{StaticResource Shortcut.Switch}" HorizontalAlignment="Right"
               IsChecked="{Binding Preferences.GlobalEnabled,Mode=OneWay}" IsEnabled="{Binding CanEdit}"
               AutomationProperties.Name="全局快捷键" Click="GlobalSwitch_Click"/>
    </Grid>
    <Grid MinHeight="36">
     <TextBlock Text="使用系统媒体快捷键" VerticalAlignment="Center"/>
     <CheckBox x:Name="SystemMediaSwitch" Style="{StaticResource Shortcut.Switch}" HorizontalAlignment="Right"
               IsChecked="{Binding Preferences.SystemMediaEnabled,Mode=OneWay}" IsEnabled="{Binding CanEdit}"
               AutomationProperties.Name="使用系统媒体快捷键" Click="SystemMediaSwitch_Click"/>
    </Grid>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource MeowFilm.SettingsSection}">
   <StackPanel>
    <Grid Margin="0,0,0,8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="136"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock Text="功能说明" FontWeight="{StaticResource MeowFilm.Font.Weight.Strong}"/>
     <TextBlock Grid.Column="1" Text="应用内快捷键" FontWeight="{StaticResource MeowFilm.Font.Weight.Strong}" Margin="0,0,8,0"/>
     <TextBlock Grid.Column="2" Text="全局快捷键" FontWeight="{StaticResource MeowFilm.Font.Weight.Strong}" Margin="8,0,0,0"/>
    </Grid>
    <ItemsControl x:Name="ShortcutRows">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="0,4">
       <Grid.ColumnDefinitions><ColumnDefinition Width="136"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Label}" VerticalAlignment="Top" Margin="0,8,8,0" TextWrapping="Wrap"/>
       <StackPanel Grid.Column="1" Margin="0,0,8,0">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button Tag="local" Style="{StaticResource Shortcut.Editor}" Click="Record_Click" AutomationProperties.Name="{Binding LocalName}"
                 IsEnabled="{Binding LocalEditorEnabled}">
          <TextBlock Text="{Binding LocalText}" TextTrimming="CharacterEllipsis"/>
         </Button>
         <Button Grid.Column="1" Tag="local" Content="清除" Style="{StaticResource Shortcut.Clear}" Click="Clear_Click" AutomationProperties.Name="{Binding ClearLocalName}"
                 IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Grid>
        <TextBlock Text="{Binding LocalError}" Style="{StaticResource Shortcut.Error}"/>
       </StackPanel>
       <Grid Grid.Column="2" Margin="8,0,0,0">
        <StackPanel>
         <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
          <DataTrigger Binding="{Binding HasGlobal}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         </Style.Triggers></Style></StackPanel.Style>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Tag="global" Style="{StaticResource Shortcut.Editor}" Click="Record_Click" AutomationProperties.Name="{Binding GlobalName}"
                  IsEnabled="{Binding GlobalEditorEnabled}">
           <TextBlock Text="{Binding GlobalText}" TextTrimming="CharacterEllipsis"/>
          </Button>
          <Button Grid.Column="1" Tag="global" Content="清除" Style="{StaticResource Shortcut.Clear}" Click="Clear_Click" AutomationProperties.Name="{Binding ClearGlobalName}"
                  IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
         </Grid>
         <TextBlock Text="{Binding GlobalError}" Style="{StaticResource Shortcut.Error}"/>
        </StackPanel>
        <TextBlock Text="不适用" VerticalAlignment="Top" Margin="0,8,0,0">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers><DataTrigger Binding="{Binding HasGlobal}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
         </Style></TextBlock.Style>
        </TextBlock>
       </Grid>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <WrapPanel Margin="0,8,0,0">
     <Button x:Name="RefreshButton" Content="重新检测" Style="{StaticResource MeowFilm.QuietButton}" Click="Refresh_Click"/>
     <Button x:Name="ReloadButton" Content="重新读取" Style="{StaticResource MeowFilm.QuietButton}" Click="Reload_Click"
             Visibility="{Binding Status,Converter={x:Static local:GeneralSettingsView.StatusVisibility}}"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <local:NoticeOutlet Message="{Binding Status}"/>
  <local:NoticeOutlet x:Name="EditorNotice"/>
 </StackPanel>
</UserControl>
