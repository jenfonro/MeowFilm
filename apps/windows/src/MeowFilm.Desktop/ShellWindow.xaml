<local:DesktopWindow x:Class="MeowFilm.Desktop.ShellWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Desktop" Title="meowfilm">
 <Grid x:Name="WindowFrame" Background="{ThemeResource MeowFilm.Brush.AppBackground}">
  <Grid.Resources>
   <Style x:Key="ShellNavigationItem" TargetType="ListViewItem" BasedOn="{StaticResource MeowFilm.NavigationItem}">
    <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="14,6"/>
   </Style>
   <DataTemplate x:Key="ShellNavigationTemplate">
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <local:NavigationIcon PathData="{Binding IconData}" Glyph="{Binding Glyph}" Width="18" Height="18" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </Grid>
   </DataTemplate>
  </Grid.Resources>
  <Grid x:Name="PresentationSurface" SizeChanged="OnPresentationSizeChanged">
   <Border x:Name="ApplicationBackground" Background="{ThemeResource MeowFilm.Brush.AppBackground}" IsHitTestVisible="False"/>
   <ContentControl x:Name="RootInteractionGate" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <Grid x:Name="RootLayout" TabFocusNavigation="Cycle">
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="SidebarBackground" Grid.RowSpan="2" BorderBrush="{ThemeResource MeowFilm.Brush.SidebarBorder}" BorderThickness="0,0,1,0" IsHitTestVisible="False">
     <Grid><local:SidebarBackdrop x:Name="SidebarMaterial" Source="{Binding ElementName=ApplicationBackground}"/><Border x:Name="SidebarTint" Background="#66FFFFFF"/></Grid>
    </Border>
    <Border x:Name="SidebarEdge" Grid.Column="1" Grid.RowSpan="2" Width="30" HorizontalAlignment="Left" IsHitTestVisible="False">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#12395467" Offset="0"/><GradientStop Color="#00395467" Offset="1"/></LinearGradientBrush></Border.Background>
    </Border>
    <Grid x:Name="CaptionDragRegion" Grid.ColumnSpan="2" Height="64" Background="Transparent"/>
    <StackPanel x:Name="Brand" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,16,0" IsHitTestVisible="False">
     <Border Width="29" Height="29" CornerRadius="15" Margin="0,0,10,0" Background="{ThemeResource MeowFilm.Brush.Accent}">
      <TextBlock Text="m" FontSize="21" Foreground="{ThemeResource MeowFilm.Brush.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="meowfilm" Style="{StaticResource MeowFilm.Title}" VerticalAlignment="Center"/>
    </StackPanel>
    <ScrollViewer x:Name="SidebarScroll" Grid.Row="1" Margin="16,22,8,16" IsTabStop="False" IsEnabled="{Binding IsInteractive}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,0,8,0">
      <ListView x:Name="ModuleNavigationList" Style="{StaticResource MeowFilm.NavigationList}" ItemContainerStyle="{StaticResource ShellNavigationItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ContainerContentChanging="OnNavigationContainerContentChanging" SelectionChanged="OnModuleSelectionChanged" AutomationProperties.Name="媒体类型">
       <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:NavigationIcon PathData="{Binding Module.Navigation[0].IconData}" Glyph="{Binding Module.Navigation[0].Glyph}" Width="18" Height="18" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Module.Title}" VerticalAlignment="Center"/>
       </Grid></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <Border Height="1" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="14,22,14,16"/>
      <ListView x:Name="NavigationList" Style="{StaticResource MeowFilm.NavigationList}" ItemContainerStyle="{StaticResource ShellNavigationItem}" ItemTemplate="{StaticResource ShellNavigationTemplate}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ContainerContentChanging="OnNavigationContainerContentChanging" SelectionChanged="OnNavigationSelectionChanged" AutomationProperties.Name="内容导航"/>
      <ListView x:Name="PublicNavigationList" Style="{StaticResource MeowFilm.NavigationList}" ItemContainerStyle="{StaticResource ShellNavigationItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ContainerContentChanging="OnNavigationContainerContentChanging" SelectionChanged="OnPublicPageSelectionChanged" AutomationProperties.Name="公共页面">
       <ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" Width="30" FontFamily="{StaticResource MeowFilm.Font.Icons}"/><TextBlock Text="{Binding Title}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <ListView x:Name="CollectionNavigationList" Margin="0,20,0,0" Style="{StaticResource MeowFilm.NavigationList}" ItemContainerStyle="{StaticResource ShellNavigationItem}" ItemTemplate="{StaticResource ShellNavigationTemplate}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ContainerContentChanging="OnNavigationContainerContentChanging" SelectionChanged="OnNavigationSelectionChanged" AutomationProperties.Name="我的">
       <ListView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
        <StackPanel><Border Height="1" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="8,0"/>
         <Grid Margin="12,20,8,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" Style="{StaticResource MeowFilm.NavigationGroup}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Command="{Binding Action}" Visibility="{Binding HasAction, Converter={StaticResource MeowFilm.BoolToVisibility}}" AutomationProperties.Name="{Binding Action.AutomationName}" Content="&#xE710;" FontFamily="{StaticResource MeowFilm.Font.Icons}" Style="{StaticResource MeowFilm.QuietButton}" Width="28" Height="28" MinHeight="28" Padding="0"/>
         </Grid></StackPanel>
       </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle>
      </ListView>
      <ContentControl x:Name="SidebarContributionHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" IsTabStop="False"/>
     </StackPanel>
    </ScrollViewer>
    <Grid Grid.Column="1" Margin="34,0,150,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <local:DesktopPageHeader x:Name="PageHeaderHost" IsEnabled="{Binding IsInteractive}">
      <local:DesktopPageHeader.Navigation>
       <Grid x:Name="SearchChrome" VerticalAlignment="Center" HorizontalAlignment="Left" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Width="24" Height="32" Style="{StaticResource MeowFilm.IconButton}" Click="OnBackClick" IsEnabled="{Binding CanGoBack}" Content="&#xE72B;" AutomationProperties.Name="返回" AutomationProperties.AcceleratorKey="Alt+Left"/>
        <Button x:Name="ForwardButton" Grid.Column="1" Width="24" Height="32" Style="{StaticResource MeowFilm.IconButton}" Click="OnForwardClick" IsEnabled="{Binding CanGoForward}" Content="&#xE72A;" AutomationProperties.Name="前进" AutomationProperties.AcceleratorKey="Alt+Right"/>
       </Grid>
      </local:DesktopPageHeader.Navigation>
      <local:DesktopPageHeader.Center>
       <Grid x:Name="SearchInput" MaxWidth="430" Height="34" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" MinWidth="0" Height="34" MinHeight="34" Padding="36,4,52,4" FontSize="12" Style="{StaticResource MeowFilm.TextBox}" TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" TextCompositionStarted="OnSearchCompositionStarted" TextCompositionEnded="OnSearchCompositionEnded" AutomationProperties.Name="搜索" AutomationProperties.AcceleratorKey="Ctrl+K"/>
        <local:EqualWidthComboBox x:Name="SearchTargetPicker" Width="92" Height="28" MinHeight="0" Padding="28,0,0,0" FontSize="12" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" SelectedValuePath="Id" Visibility="Collapsed" Background="Transparent" BorderThickness="0" AutomationProperties.Name="搜索目标">
         <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12"/></DataTemplate></ComboBox.ItemTemplate>
        </local:EqualWidthComboBox>
        <FontIcon Glyph="&#xE721;" FontSize="15" Width="28" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Border x:Name="SearchDivider" Width="1" Height="16" Background="{ThemeResource MeowFilm.Brush.Border}" Margin="94,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
        <TextBlock Text="Ctrl K" FontSize="11" Foreground="{ThemeResource MeowFilm.Brush.Muted}" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
       </Grid>
      </local:DesktopPageHeader.Center>
     </local:DesktopPageHeader>
     <StackPanel x:Name="CaptionBar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="NotificationButton" Style="{StaticResource MeowFilm.CaptionButton}" IsEnabled="{Binding IsInteractive}" AutomationProperties.Name="通知">
       <Path Data="M5,17 L19,17 17,14 17,9 A5,5 0 0 0 7,9 L7,14 Z M10,20 L14,20" Width="14" Height="16" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round" Stroke="{Binding Foreground,ElementName=NotificationButton}"/>
      </Button>
      <Button x:Name="SettingsButton" Style="{StaticResource MeowFilm.CaptionButton}" FontSize="17" Content="&#xE713;" IsEnabled="{Binding IsInteractive}" Click="OnSettingsClick" AutomationProperties.Name="设置"/>
     </StackPanel>
    </Grid>
    <Grid x:Name="ContentRegion" Grid.Row="1" Grid.Column="1"><ContentControl IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsEnabled="{Binding IsInteractive}"><Grid x:Name="ContentDeck"/></ContentControl></Grid>
    <Grid x:Name="PlayerDetailSurface" Grid.RowSpan="3" Grid.ColumnSpan="2" Canvas.ZIndex="20" Visibility="Collapsed" TabFocusNavigation="Cycle">
     <Grid.RenderTransform><TranslateTransform x:Name="PlayerDetailTransform"/></Grid.RenderTransform>
     <ContentControl x:Name="PlayerDetailHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False"/>
     <Grid x:Name="PlayerDetailChrome">
      <Button x:Name="PlayerDetailBackButton" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource MeowFilm.IconButton}" Width="40" Height="40" Margin="20,16,0,0" Foreground="#ECECEE" Click="OnBackClick" Content="&#xE70D;" AutomationProperties.Name="收起播放器"/>
     </Grid>
    </Grid>
    <Button x:Name="QueueDismissSurface" Grid.RowSpan="2" Grid.ColumnSpan="2" Canvas.ZIndex="28" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0" IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnQueueDismissClick" AutomationProperties.Name="收起播放列表"/>
    <Border x:Name="QueueSurface" Translation="0,0,16" Grid.RowSpan="2" Grid.ColumnSpan="2" Canvas.ZIndex="30" Width="386" Margin="0,76,12,16" HorizontalAlignment="Right" Style="{StaticResource MeowFilm.FloatingSurface}" CornerRadius="12" Visibility="Collapsed">
     <Border.RenderTransform><TranslateTransform x:Name="QueueTransform"/></Border.RenderTransform>
     <Border.Shadow><ThemeShadow/></Border.Shadow>
     <ContentControl x:Name="QueueHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False"/>
    </Border>
    <local:PlayerDialogHost x:Name="ChannelDialogHost" Grid.RowSpan="3" Grid.ColumnSpan="2" Canvas.ZIndex="40"/>
    <Border x:Name="PlayerFrame" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed">
     <ContentControl x:Name="PlayerHost" IsEnabled="{Binding IsInteractive}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False"/>
    </Border>
   </Grid>
   </ContentControl>
   <local:CloseWindowDialog x:Name="CloseDialog" Canvas.ZIndex="90" Visibility="Collapsed"/>
   <local:UserDataResetDialog x:Name="ResetDialog" Canvas.ZIndex="110" Visibility="Collapsed"/>
   <ContentControl x:Name="NotificationInteractionGate" Canvas.ZIndex="100" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <StackPanel x:Name="NotificationOverlay" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="560" Margin="24,76,24,12">
    <Border x:Name="StatusPanel" Style="{StaticResource MeowFilm.Surface}" Margin="0,0,0,8" Padding="14,10" CornerRadius="10" Visibility="Collapsed">
     <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" Spacing="6">
       <Button Content="取消" Click="OnCancelClick" AutomationProperties.Name="取消当前操作" Visibility="{Binding CanCancel, Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
       <Button Content="重试" Click="OnRetryClick" AutomationProperties.Name="重试" Visibility="{Binding CanRetry, Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
       <Button Style="{StaticResource MeowFilm.IconButton}" Content="&#xE711;" Click="OnDismissStatusClick" AutomationProperties.Name="关闭状态" Visibility="{Binding CanDismiss, Converter={StaticResource MeowFilm.BoolToVisibility}}"/>
      </StackPanel>
     </Grid>
    </Border>
    <local:NoticeStack x:Name="Notices"/>
   </StackPanel>
   </ContentControl>
  </Grid>
 </Grid>
</local:DesktopWindow>
