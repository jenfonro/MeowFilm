<local:DesktopWindow x:Class="MeowFilm.Desktop.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeowFilm.Desktop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="meowfilm" Width="1110" Height="869"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp"
        PreviewMouseDown="OnChannelHeaderPointer" PreviewMouseUp="OnChannelHeaderPointer"
        local:PlayerSurfaceInput.DismissRequested="OnQueueDismissClick"
        AutomationProperties.Name="meowfilm">
    <local:DesktopWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MeowFilm.Desktop;component/Theme.xaml" />
                <ResourceDictionary Source="/MeowFilm.Desktop;component/OverlayScrollChrome.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ShellNavigationItem" TargetType="ListBoxItem" BasedOn="{StaticResource MeowFilm.NavigationItem}">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Padding" Value="14,6"/>
            </Style>
            <DataTemplate x:Key="ShellNavigationTemplate">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Path x:Name="Outline" Data="{Binding IconData}" Width="18" Height="18" Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                    <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{DynamicResource MeowFilm.Font.Icons}"
                               FontSize="16" VerticalAlignment="Center" Focusable="False" Visibility="Collapsed"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IconData}" Value="{x:Null}">
                        <Setter TargetName="Outline" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </local:DesktopWindow.Resources>
    <local:DesktopWindow.Style>
        <Style TargetType="{x:Type local:DesktopWindow}">
            <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.AppBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}" />
            <Style.Triggers>
                <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </local:DesktopWindow.Style>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Border}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Margin" Value="{x:Static SystemParameters.WindowResizeBorderThickness}" />
                    </DataTrigger>
                    <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid x:Name="PresentationSurface" ClipToBounds="True" SizeChanged="OnPresentationSizeChanged">
        <Border x:Name="ApplicationBackground" IsHitTestVisible="False"
                Background="{Binding Background, ElementName=WindowFrame}" />
        <Grid x:Name="RootLayout" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarBackground" Grid.RowSpan="2" ClipToBounds="True" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.SidebarBorder}" />
                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                        <Style.Triggers>
                            <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                <local:SidebarBackdrop x:Name="SidebarMaterial" Source="{Binding ElementName=ApplicationBackground}">
                    <local:SidebarBackdrop.Style>
                        <Style TargetType="local:SidebarBackdrop">
                            <Setter Property="Effect"><Setter.Value><BlurEffect Radius="12" RenderingBias="Performance" /></Setter.Value></Setter>
                            <Style.Triggers>
                                <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Effect" Value="{x:Null}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </local:SidebarBackdrop.Style>
                </local:SidebarBackdrop>
                <Border x:Name="SidebarTint" Background="#66FFFFFF">
                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                        <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers></Style></Border.Style>
                </Border>
                </Grid>
            </Border>
            <Border x:Name="SidebarEdge" Grid.Column="1" Grid.RowSpan="2" Width="30"
                    HorizontalAlignment="Left" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#12395467" Offset="0"/>
                                    <GradientStop Color="#00395467" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Visibility, ElementName=SidebarBackground}" Value="Collapsed">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <StackPanel x:Name="Brand" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,16,0"
                        IsHitTestVisible="False">
                <Border Width="29" Height="29" CornerRadius="15" Margin="0,0,10,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Accent}" />
                            <Style.Triggers>
                                <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="m" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Focusable="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.OnAccent}" />
                                <Style.Triggers>
                                    <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Text="meowfilm" Style="{DynamicResource MeowFilm.Title}" VerticalAlignment="Center" />
            </StackPanel>

            <ScrollViewer x:Name="SidebarScroll" PreviewMouseWheel="OnSidebarWheel" Style="{StaticResource MeowFilm.OverlayScrollViewer}" Grid.Row="1" Margin="16,22,8,16" Focusable="False" IsEnabled="{Binding IsInteractive}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
                <ListBox x:Name="ModuleNavigationList" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Style="{StaticResource MeowFilm.NavigationList}" IsSynchronizedWithCurrentItem="False"
                         SelectionChanged="OnModuleSelectionChanged" AutomationProperties.Name="媒体类型">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource ShellNavigationItem}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Module.Title}"/>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path x:Name="Outline" Data="{Binding Module.Navigation[0].IconData}" Width="18" Height="18"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            <TextBlock x:Name="Glyph" Text="{Binding Module.Navigation[0].Glyph}"
                                       FontFamily="{DynamicResource MeowFilm.Font.Icons}" FontSize="16"
                                       VerticalAlignment="Center" Focusable="False" Visibility="Collapsed"/>
                            <TextBlock Grid.Column="1" Text="{Binding Module.Title}" VerticalAlignment="Center"/>
                        </Grid>
                        <DataTemplate.Triggers><DataTrigger Binding="{Binding Module.Navigation[0].IconData}" Value="{x:Null}">
                            <Setter TargetName="Outline" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                        </DataTrigger></DataTemplate.Triggers>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Border Height="1" Background="{DynamicResource MeowFilm.Brush.Border}" Margin="14,22,14,16"/>
                <ListBox ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="NavigationList" Padding="0" Style="{StaticResource MeowFilm.NavigationList}"
                         IsSynchronizedWithCurrentItem="False"
                         ItemContainerStyle="{StaticResource ShellNavigationItem}" ItemTemplate="{StaticResource ShellNavigationTemplate}"
                         SelectionChanged="OnNavigationSelectionChanged" AutomationProperties.Name="内容导航"/>
                <ListBox ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="PublicNavigationList" Margin="0" Padding="0"
                         Style="{StaticResource MeowFilm.NavigationList}"
                         ItemContainerStyle="{StaticResource ShellNavigationItem}"
                         SelectionChanged="OnPublicPageSelectionChanged" AutomationProperties.Name="公共页面">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Width="25" FontFamily="{DynamicResource MeowFilm.Font.Icons}" />
                                <TextBlock Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="CollectionNavigationList" Margin="0,20,0,0" Padding="0" Style="{StaticResource MeowFilm.NavigationList}"
                         IsSynchronizedWithCurrentItem="False"
                         ItemContainerStyle="{StaticResource ShellNavigationItem}" ItemTemplate="{StaticResource ShellNavigationTemplate}"
                         SelectionChanged="OnNavigationSelectionChanged" AutomationProperties.Name="我的">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Height="1" Background="{DynamicResource MeowFilm.Brush.Border}" Margin="8,0,8,0"/>
                                        <DockPanel Margin="12,20,8,8">
                                            <Button DockPanel.Dock="Right" Content="&#xE710;"
                                                    Command="{Binding Items[0].GroupAction}"
                                                    AutomationProperties.Name="{Binding Items[0].GroupAction.AutomationName}"
                                                    Width="28" Height="28" MinHeight="28" Padding="0"
                                                    FontFamily="{DynamicResource MeowFilm.Font.Icons}" FontSize="14">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MeowFilm.QuietButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Items[0].GroupAction}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource MeowFilm.NavigationGroup}" Margin="0"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
                <ContentControl x:Name="SidebarContributionHost" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Top" Focusable="False" IsTabStop="False"/>
            </StackPanel></ScrollViewer>

            <Grid Grid.Column="1" Margin="34,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:DesktopPageHeader x:Name="PageHeaderHost" IsEnabled="{Binding IsInteractive}"/>
                <Grid x:Name="SearchChrome" VerticalAlignment="Center" HorizontalAlignment="Left"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Width="24" Height="32" Margin="0,0,12,0"
                            Click="OnBackClick" IsEnabled="{Binding CanGoBack}"
                            AutomationProperties.Name="返回" AutomationProperties.AcceleratorKey="Alt+Left">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MeowFilm.IconButton}">
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style></Button.Style>
                        <Path Data="M14,6 L8,12 14,18" Width="7" Height="12" Stretch="Uniform" StrokeThickness="1.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="ForwardButton" Grid.Column="1" Width="24" Height="32"
                            Style="{StaticResource MeowFilm.IconButton}" Click="OnForwardClick" IsEnabled="{Binding CanGoForward}"
                            AutomationProperties.Name="前进" AutomationProperties.AcceleratorKey="Alt+Right">
                        <Path Data="M10,6 L16,12 10,18" Width="7" Height="12" Stretch="Uniform" StrokeThickness="1.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>
                    <Grid x:Name="SearchInput" MaxWidth="430" Height="34" VerticalAlignment="Center"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBox x:Name="SearchBox" MinWidth="0" Width="Auto"
                                 Height="34" MinHeight="34" Padding="36,4,52,4" FontSize="12"
                                 TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" AutomationProperties.Name="搜索"
                                 AutomationProperties.AcceleratorKey="Ctrl+K">
                            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource MeowFilm.TextBox}">
                                <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.InputSurface}"/>
                            </Style></TextBox.Style>
                        </TextBox>
                        <ComboBox x:Name="SearchTargetPicker" Width="60" Height="28" MinHeight="0" FontSize="12"
                                  Margin="32,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  DisplayMemberPath="Label" SelectedValuePath="Id" Visibility="Collapsed" Padding="4,0,6,0"
                                  Background="Transparent" BorderThickness="0"
                                  Style="{StaticResource MeowFilm.ComboBox}" AutomationProperties.Name="搜索目标"/>
                        <Border x:Name="SearchDivider" Width="1" Height="16" Background="{DynamicResource MeowFilm.Brush.Border}"
                                Margin="94,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Button x:Name="SearchButton" Margin="2,0,0,0"
                                Width="32" Height="32" MinHeight="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Click="OnSearchClick" AutomationProperties.Name="搜索">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MeowFilm.IconButton}">
                                <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
                            </Style></Button.Style>
                            <Path Data="M17,10.5 A6.5,6.5 0 1 1 4,10.5 A6.5,6.5 0 1 1 17,10.5 M16,16 L21,21"
                                  Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource MeowFilm.Brush.Muted}"
                                   Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                <StackPanel x:Name="CaptionBar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="NotificationButton" Style="{StaticResource MeowFilm.CaptionButton}"
                            IsEnabled="{Binding IsInteractive}" AutomationProperties.Name="通知">
                        <Path Data="M5,17 L19,17 17,14 17,9 A5,5 0 0 0 7,9 L7,14 Z M10,20 L14,20"
                              Width="14" Height="16" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource MeowFilm.CaptionButton}" FontSize="17" Content="&#xE713;"
                            IsEnabled="{Binding IsInteractive}" Click="OnSettingsClick" AutomationProperties.Name="设置" />
                    <Button Style="{StaticResource MeowFilm.CaptionButton}" Content="&#xE921;"
                            Click="OnMinimizeClick" AutomationProperties.Name="最小化" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource MeowFilm.CaptionButton}"
                            Click="OnMaximizeClick">
                        <Button.Content><TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" /></Button.Content>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource MeowFilm.CloseButton}" Content="&#xE8BB;"
                            IsEnabled="{Binding IsInteractive}" Click="OnCloseClick" AutomationProperties.Name="关闭" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ContentRegion" Grid.Row="1" Grid.Column="1">
                <Grid x:Name="ContentDeck" IsEnabled="{Binding IsInteractive}" />
            </Grid>

            <Grid x:Name="PlayerDetailSurface" Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="20"
                  Visibility="Collapsed" ClipToBounds="True" KeyboardNavigation.TabNavigation="Cycle">
                <Grid.RenderTransform><TranslateTransform x:Name="PlayerDetailTransform" /></Grid.RenderTransform>
                <ContentControl x:Name="PlayerDetailHost" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" Focusable="False" IsTabStop="False" />
                <Grid x:Name="PlayerDetailChrome">
                    <Button x:Name="PlayerDetailBackButton" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Style="{StaticResource MeowFilm.IconButton}" Width="40" Height="40" Margin="20,16,0,0"
                            Foreground="#ECECEE" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnBackClick" AutomationProperties.Name="收起播放器">
                        <Path Data="M1,1 L8,8 15,1" Width="16" Height="10" Stretch="Uniform" Stroke="#ECECEE" StrokeThickness="1.5"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,16,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource MeowFilm.CaptionButton}" Content="&#xE921;" Foreground="#ECECEE"
                                Click="OnMinimizeClick" AutomationProperties.Name="最小化" />
                        <Button x:Name="PlayerDetailMaximizeButton" Style="{StaticResource MeowFilm.CaptionButton}" Foreground="#ECECEE"
                                Click="OnMaximizeClick">
                            <Button.Content><TextBlock x:Name="PlayerDetailMaximizeGlyph" Text="&#xE922;" /></Button.Content>
                        </Button>
                        <Button Style="{StaticResource MeowFilm.CloseButton}" Content="&#xE8BB;" Foreground="#ECECEE"
                                Click="OnCloseClick" AutomationProperties.Name="关闭" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Button x:Name="QueueDismissSurface" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="28"
                    Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0"
                    Focusable="False" IsTabStop="False" Click="OnQueueDismissClick"
                    AutomationProperties.Name="收起播放列表" />
            <Border x:Name="QueueSurface" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="30"
                    Width="386" Margin="0,76,12,16" HorizontalAlignment="Right"
                    Style="{StaticResource MeowFilm.FloatingSurface}" CornerRadius="12"
                    Visibility="Collapsed">
                <Border.RenderTransform><TranslateTransform x:Name="QueueTransform" /></Border.RenderTransform>
                <ContentControl x:Name="QueueHost" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" Focusable="False" IsTabStop="False" SizeChanged="OnQueueHostSizeChanged" />
            </Border>

            <local:PlayerDialogHost x:Name="ChannelDialogHost" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="40"/>

            <!-- Auto-sized layout row, never an overlay on scrolling content. No player is created by the shell. -->
            <Border x:Name="PlayerFrame" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed">
                <ContentControl x:Name="PlayerHost" IsEnabled="{Binding IsInteractive}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Focusable="False" IsTabStop="False" />
            </Border>
        </Grid>
        <local:CloseWindowDialog x:Name="CloseDialog" Panel.ZIndex="90" Visibility="Collapsed"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <local:UserDataResetDialog x:Name="ResetDialog" Panel.ZIndex="110" Visibility="Collapsed"
                                   shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <StackPanel x:Name="NotificationOverlay" Panel.ZIndex="100" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="560" Margin="24,76,24,12">
                <Border x:Name="StatusPanel" Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource MeowFilm.Surface}">
                            <Setter Property="Padding" Value="14,10" />
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasStatus}" Value="True" />
                                        <Condition Binding="{Binding IsBusy}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsShutdownConfirmationOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.ErrorSurface}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Error}" />
                                </DataTrigger>
                                <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Content="取消" Click="OnCancelClick" AutomationProperties.Name="取消当前操作"
                                    Visibility="{Binding CanCancel, Converter={StaticResource MeowFilm.BoolToVisibility}}" />
                            <Button Content="重试" Click="OnRetryClick" Margin="0,0,6,0" AutomationProperties.Name="重试"
                                    Visibility="{Binding CanRetry, Converter={StaticResource MeowFilm.BoolToVisibility}}" />
                            <Button Style="{StaticResource MeowFilm.IconButton}" Content="&#xE711;" Click="OnDismissStatusClick"
                                    AutomationProperties.Name="关闭状态"
                                    Visibility="{Binding CanDismiss, Converter={StaticResource MeowFilm.BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel x:Name="ShutdownConfirmation" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                    Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
                                    AutomationProperties.Name="退出确认"
                                    Visibility="{Binding IsShutdownConfirmationOpen, Converter={StaticResource MeowFilm.BoolToVisibility}}">
                            <TextBlock Text="保存或清理尚未确认完成。强制退出可能丢失未保存的更改，仍要退出吗？"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="WaitForShutdownButton" Content="继续等待" Click="OnWaitForShutdownClick"
                                        IsEnabled="{Binding CanWaitForShutdown}" Margin="0,0,8,0"
                                        AutomationProperties.Name="继续等待关闭" />
                                <Button x:Name="ForceExitButton" Content="强制退出" Click="OnForceExitClick"
                                        IsEnabled="{Binding CanForceExit}" AutomationProperties.Name="强制退出" />
                                <Button x:Name="CancelShutdownButton" Content="取消关闭" Click="OnCancelShutdownClick" Margin="8,0,0,0"
                                        IsEnabled="{Binding CanCancelShutdown}" AutomationProperties.Name="取消关闭" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            <local:NoticeStack x:Name="Notices"/>
        </StackPanel>
        </Grid>
    </Border>
</local:DesktopWindow>
