<Window x:Class="MeowFilm.Desktop.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeowFilm.Desktop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="meowfilm" Width="1110" Height="869" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown"
        AutomationProperties.Name="meowfilm">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MeowFilm.Desktop;component/Theme.xaml" />
                <ResourceDictionary Source="/MeowFilm.Desktop;component/OverlayScrollChrome.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Window}" />
            <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}" />
            <Style.Triggers>
                <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="72" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Border}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Margin" Value="{x:Static SystemParameters.WindowResizeBorderThickness}" />
                    </DataTrigger>
                    <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid x:Name="PresentationSurface" ClipToBounds="True" SizeChanged="OnPresentationSizeChanged">
        <Grid x:Name="RootLayout" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="203" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarBackground" Grid.RowSpan="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Border}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <StackPanel x:Name="Brand" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,16,0"
                        IsHitTestVisible="False">
                <Border Width="29" Height="29" CornerRadius="15" Margin="0,0,10,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Accent}" />
                            <Style.Triggers>
                                <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="m" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Focusable="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.OnAccent}" />
                                <Style.Triggers>
                                    <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Text="meowfilm" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <ScrollViewer x:Name="SidebarScroll" PreviewMouseWheel="OnSidebarWheel" Style="{StaticResource MeowFilm.OverlayScrollViewer}" Grid.Row="1" Margin="23,15,8,16" Focusable="False" IsEnabled="{Binding IsInteractive}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
                <ListBox ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="NavigationList" Padding="0" Style="{StaticResource MeowFilm.NavigationList}"
                         IsSynchronizedWithCurrentItem="False"
                         ItemContainerStyle="{StaticResource MeowFilm.NavigationItem}"
                         SelectionChanged="OnNavigationSelectionChanged" AutomationProperties.Name="导航">

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:NavigationItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource MeowFilm.Font.Icons}"
                                           FontSize="16" VerticalAlignment="Center" Focusable="False" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="PublicNavigationList" Margin="0" Padding="0"
                         Style="{StaticResource MeowFilm.NavigationList}"
                         ItemContainerStyle="{StaticResource MeowFilm.NavigationItem}"
                         SelectionChanged="OnPublicPageSelectionChanged" AutomationProperties.Name="公共页面">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Width="25" FontFamily="{DynamicResource MeowFilm.Font.Icons}" />
                                <TextBlock Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="CollectionNavigationList" Margin="0,20,0,0" Padding="0" Style="{StaticResource MeowFilm.NavigationList}"
                         IsSynchronizedWithCurrentItem="False"
                         ItemContainerStyle="{StaticResource MeowFilm.NavigationItem}"
                         SelectionChanged="OnNavigationSelectionChanged" AutomationProperties.Name="我的歌单">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel><Border Height="1" Background="{DynamicResource MeowFilm.Brush.Border}" Margin="8,0,8,0"/><TextBlock Text="{Binding Name}" Style="{StaticResource MeowFilm.NavigationGroup}" /></StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:NavigationItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource MeowFilm.Font.Icons}"
                                           FontSize="16" VerticalAlignment="Center" Focusable="False" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel></ScrollViewer>

            <Grid x:Name="CaptionBar" Grid.Column="1" Margin="40,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="SearchChrome" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0"
                      IsEnabled="{Binding IsInteractive}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Width="28" Margin="0,0,8,0" Content="&#xE76B;"
                            Click="OnBackClick" IsEnabled="{Binding CanGoBack}"
                            AutomationProperties.Name="返回" AutomationProperties.AcceleratorKey="Alt+Left" ToolTip="返回">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MeowFilm.IconButton}">
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Border}"/>
                        </Style></Button.Style>
                    </Button>
                    <Grid x:Name="SearchInput" Grid.Column="1" Width="300" MaxWidth="360">
                        <TextBox x:Name="SearchBox" MinWidth="140" Width="Auto" MaxWidth="360"
                                 Height="36" MinHeight="36" Padding="38,4,12,4"
                                 TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" AutomationProperties.Name="搜索"
                                 AutomationProperties.AcceleratorKey="Ctrl+F">
                            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource MeowFilm.TextBox}">
                                <Setter Property="BorderBrush" Value="#E3E6ED"/>
                                <Setter Property="Background" Value="#EFF1F6"/>
                            </Style></TextBox.Style>
                        </TextBox>
                        <Button x:Name="SearchButton" Content="&#xE721;" Margin="2,0,0,0"
                                Width="32" Height="32" MinHeight="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Click="OnSearchClick" AutomationProperties.Name="搜索" ToolTip="搜索">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MeowFilm.IconButton}">
                                <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Muted}"/>
                            </Style></Button.Style>
                        </Button>
                    </Grid>
                </Grid>
                <StackPanel x:Name="PageHeader" Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="380,0,12,0"
                            IsEnabled="{Binding IsInteractive}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ContentControl x:Name="HeaderSlot" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                    Focusable="False" IsTabStop="False" />
                    <ItemsControl x:Name="HeaderActions">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Tag="{Binding}" Click="OnHeaderActionClick"
                                        IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{Binding AutomationName}"
                                        Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MeowFilm.Button}">
                                            <Setter Property="Padding" Value="12,6" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.Accent}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.OnAccent}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Accent}" />
                                                </DataTrigger>
                                                <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!-- One shared caption bar; settings scopes do not switch application modes. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="SettingsButton" Style="{StaticResource MeowFilm.CaptionButton}" FontSize="17" Content="&#xE713;"
                            IsEnabled="{Binding IsInteractive}" Click="OnSettingsClick" AutomationProperties.Name="设置" ToolTip="设置" />
                    <Button Style="{StaticResource MeowFilm.CaptionButton}" Content="&#xE921;"
                            Click="OnMinimizeClick" AutomationProperties.Name="最小化" ToolTip="最小化" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource MeowFilm.CaptionButton}"
                            Click="OnMaximizeClick">
                        <Button.Content><TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" /></Button.Content>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource MeowFilm.CloseButton}" Content="&#xE8BB;"
                            IsEnabled="{Binding IsInteractive}" Click="OnCloseClick" AutomationProperties.Name="关闭" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ContentRegion" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                <Grid x:Name="ContentDeck" IsEnabled="{Binding IsInteractive}" />
            </Grid>

            <Grid x:Name="PlayerDetailSurface" Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="20"
                  Visibility="Collapsed" ClipToBounds="True" KeyboardNavigation.TabNavigation="Cycle">
                <Grid.RenderTransform><TranslateTransform x:Name="PlayerDetailTransform" /></Grid.RenderTransform>
                <ContentControl x:Name="PlayerDetailHost" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" Focusable="False" IsTabStop="False" />
                <Grid x:Name="PlayerDetailChrome">
                    <Button x:Name="PlayerDetailBackButton" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Style="{StaticResource MeowFilm.IconButton}" Width="40" Height="40" Margin="20,16,0,0"
                            Foreground="#ECECEE" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnBackClick" AutomationProperties.Name="收起播放器" ToolTip="收起播放器">
                        <Path Data="M1,1 L8,8 15,1" Width="16" Height="10" Stretch="Uniform" Stroke="#ECECEE" StrokeThickness="1.5"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,16,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource MeowFilm.CaptionButton}" Content="&#xE921;" Foreground="#ECECEE"
                                Click="OnMinimizeClick" AutomationProperties.Name="最小化" ToolTip="最小化" />
                        <Button x:Name="PlayerDetailMaximizeButton" Style="{StaticResource MeowFilm.CaptionButton}" Foreground="#ECECEE"
                                Click="OnMaximizeClick">
                            <Button.Content><TextBlock x:Name="PlayerDetailMaximizeGlyph" Text="&#xE922;" /></Button.Content>
                        </Button>
                        <Button Style="{StaticResource MeowFilm.CloseButton}" Content="&#xE8BB;" Foreground="#ECECEE"
                                Click="OnCloseClick" AutomationProperties.Name="关闭" ToolTip="关闭" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Button x:Name="QueueDismissSurface" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="28"
                    Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0"
                    Focusable="False" IsTabStop="False" Click="OnQueueDismissClick"
                    AutomationProperties.Name="收起播放列表" />
            <Border x:Name="QueueSurface" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="30"
                    Width="386" Margin="0,84,0,16" HorizontalAlignment="Right"
                    Background="{DynamicResource MeowFilm.Brush.Surface}" CornerRadius="12,0,0,12"
                    Visibility="Collapsed" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity=".22" Color="#44000000" />
                </Border.Effect>
                <Border.RenderTransform><TranslateTransform x:Name="QueueTransform" /></Border.RenderTransform>
                <ContentControl x:Name="QueueHost" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" Focusable="False" IsTabStop="False" />
            </Border>

            <!-- Auto-sized layout row, never an overlay on scrolling content. No player is created by the shell. -->
            <Border x:Name="PlayerFrame" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed">
                <ContentControl x:Name="PlayerHost" IsEnabled="{Binding IsInteractive}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Focusable="False" IsTabStop="False" />
            </Border>
        </Grid>
        <StackPanel x:Name="NotificationOverlay" Panel.ZIndex="100" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="560" Margin="24,84,24,12">
                <Border x:Name="StatusPanel" Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource MeowFilm.Surface}">
                            <Setter Property="Padding" Value="14,10" />
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasStatus}" Value="True" />
                                        <Condition Binding="{Binding IsBusy}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsShutdownConfirmationOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MeowFilm.Brush.ErrorSurface}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource MeowFilm.Brush.Error}" />
                                </DataTrigger>
                                <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Content="取消" Click="OnCancelClick" AutomationProperties.Name="取消当前操作"
                                    Visibility="{Binding CanCancel, Converter={StaticResource MeowFilm.BoolToVisibility}}" />
                            <Button Content="重试" Click="OnRetryClick" Margin="0,0,6,0" AutomationProperties.Name="重试"
                                    Visibility="{Binding CanRetry, Converter={StaticResource MeowFilm.BoolToVisibility}}" />
                            <Button Style="{StaticResource MeowFilm.IconButton}" Content="&#xE711;" Click="OnDismissStatusClick"
                                    AutomationProperties.Name="关闭状态" ToolTip="关闭状态"
                                    Visibility="{Binding CanDismiss, Converter={StaticResource MeowFilm.BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel x:Name="ShutdownConfirmation" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                    Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
                                    AutomationProperties.Name="退出确认"
                                    Visibility="{Binding IsShutdownConfirmationOpen, Converter={StaticResource MeowFilm.BoolToVisibility}}">
                            <TextBlock Text="保存或清理尚未确认完成。强制退出可能丢失未保存的更改，仍要退出吗？"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="WaitForShutdownButton" Content="继续等待" Click="OnWaitForShutdownClick"
                                        IsEnabled="{Binding CanWaitForShutdown}" Margin="0,0,8,0"
                                        AutomationProperties.Name="继续等待关闭" />
                                <Button x:Name="ForceExitButton" Content="强制退出" Click="OnForceExitClick"
                                        IsEnabled="{Binding CanForceExit}" AutomationProperties.Name="强制退出" />
                                <Button x:Name="CancelShutdownButton" Content="取消关闭" Click="OnCancelShutdownClick" Margin="8,0,0,0"
                                        IsEnabled="{Binding CanCancelShutdown}" AutomationProperties.Name="取消关闭" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            <local:NoticeStack x:Name="Notices"/>
        </StackPanel>
        </Grid>
    </Border>
</Window>
