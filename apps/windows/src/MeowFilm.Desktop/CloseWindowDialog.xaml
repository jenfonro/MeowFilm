<UserControl x:Class="MeowFilm.Desktop.CloseWindowDialog" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MeowFilm.Desktop"
 UseLayoutRounding="True" SnapsToDevicePixels="True"
 KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
 PreviewKeyDown="OnPreviewKeyDown" AutomationProperties.Name="关闭主窗口">
 <UserControl.Style>
  <Style TargetType="UserControl">
   <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
   <Style.Triggers><Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
   </Trigger></Style.Triggers>
  </Style>
 </UserControl.Style>
 <Grid Background="Transparent">
  <Border x:Name="DialogSurface" Style="{DynamicResource MeowFilm.FloatingSurface}" MaxWidth="440"
          Margin="24" Padding="20" VerticalAlignment="Center">
   <StackPanel>
    <DockPanel Margin="0,0,0,16">
     <Button x:Name="DismissButton" DockPanel.Dock="Right" Style="{DynamicResource MeowFilm.IconButton}"
             Content="&#xE711;" Width="30" Height="30" MinHeight="30" Margin="8,0,0,0"
             Click="OnCancelClick" AutomationProperties.Name="取消关闭选择"/>
     <TextBlock x:Name="DialogTitle" Text="关闭主窗口" Style="{DynamicResource MeowFilm.SectionHeading}" Margin="0"
                VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
    <CheckBox x:Name="RememberChoice" Content="记住我的选择" Padding="4" Margin="0,0,0,16"
              VerticalContentAlignment="Center" AutomationProperties.Name="记住我的选择">
     <CheckBox.Style><Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Text}"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource MeowFilm.FocusVisual}"/>
      <Style.Triggers>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MeowFilm.Brush.Disabled}"/></Trigger>
       <Trigger Property="local:DesktopTheme.IsHighContrast" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
       </Trigger>
       <MultiTrigger><MultiTrigger.Conditions>
        <Condition Property="local:DesktopTheme.IsHighContrast" Value="True"/><Condition Property="IsEnabled" Value="False"/>
       </MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/></MultiTrigger>
      </Style.Triggers>
     </Style></CheckBox.Style>
    </CheckBox>
    <WrapPanel x:Name="Choices" HorizontalAlignment="Right">
     <Button x:Name="MinimizeChoice" Content="最小化到托盘" Margin="0,0,8,8"
             Tag="{x:Static local:WindowCloseBehavior.MinimizeToTray}" Click="OnChoiceClick"
             AutomationProperties.Name="最小化到托盘"/>
     <Button x:Name="ExitChoice" Content="退出" Margin="0,0,8,8"
             Tag="{x:Static local:WindowCloseBehavior.Exit}" Click="OnChoiceClick"
             AutomationProperties.Name="退出"/>
     <Button x:Name="CancelChoice" Content="取消" Margin="0,0,0,8"
             Style="{DynamicResource MeowFilm.QuietButton}" Click="OnCancelClick"
             AutomationProperties.Name="取消"/>
    </WrapPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
