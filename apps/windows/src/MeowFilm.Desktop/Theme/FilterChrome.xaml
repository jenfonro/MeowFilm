<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MeowFilm.Desktop">
<Style x:Key="MeowFilm.FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource MeowFilm.MutedText}"><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="MeowFilm.FilterGroup" TargetType="Border"><Setter Property="Background" Value="{ThemeResource MeowFilm.Brush.FloatingSurface}"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="3"/></Style>
 <Style x:Key="MeowFilm.FilterChip" TargetType="ButtonBase"><Setter Property="FontFamily" Value="XamlAutoFontFamily"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{ThemeResource MeowFilm.Brush.Muted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="10,3"/><Setter Property="Margin" Value="1"/><Setter Property="CornerRadius" Value="14"/></Style>
</ResourceDictionary>
