<UserControl x:Class="MeowFilm.Desktop.ManagementList"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:MeowFilm.Desktop">
 <Grid x:Name="Layout">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <local:DockPanel x:Name="Toolbar" Margin="0,0,0,8">
   <StackPanel x:Name="ToolsPanel" local:DockPanel.Dock="Right" Orientation="Horizontal"/>
   <TextBox x:Name="SearchBox" Style="{StaticResource MeowFilm.ManagementSearch}" MinWidth="120"
            Padding="12,9,12,9" Margin="0,0,12,0" PlaceholderText="搜索"
            AutomationProperties.Name="搜索"/>
  </local:DockPanel>
  <Border x:Name="Card" Grid.Row="1" Style="{StaticResource MeowFilm.FloatingSurface}"
          CornerRadius="22" BorderThickness="1" Padding="8,8,8,76">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid x:Name="Header" Margin="7,0,7,6" MinHeight="32" Visibility="Collapsed">
     <CheckBox x:Name="HeaderAll" Style="{StaticResource MeowFilm.ManagementCheck}"
               VerticalAlignment="Center" HorizontalAlignment="Center"
               AutomationProperties.Name="全选" Click="HeaderAll_Click"/>
    </Grid>
    <ListView x:Name="List" Grid.Row="1" BorderThickness="0" Background="Transparent"
              HorizontalContentAlignment="Stretch" SelectionMode="None" AllowDrop="True"
              Style="{StaticResource MeowFilm.ManagementList}"
              ItemContainerStyle="{StaticResource MeowFilm.ManagementListItem}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              AutomationProperties.AutomationId="management.list"
              DragItemsStarting="List_DragItemsStarting"
              DragItemsCompleted="List_DragItemsCompleted"/>
    <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource MeowFilm.MutedText}"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0"/>
   </Grid>
  </Border>
  <Border x:Name="FloatingBar" Grid.Row="1" Style="{StaticResource MeowFilm.FloatingSurface}"
          CornerRadius="26" BorderThickness="1" Padding="14,8,12,8" Margin="12,0,12,12"
          Height="52" VerticalAlignment="Bottom">
   <local:DockPanel>
    <StackPanel local:DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="InverseButton" Content="反选" Style="{StaticResource MeowFilm.QuietButton}"
             Background="{ThemeResource MeowFilm.Brush.InputSurface}" Height="32" MinHeight="32"
             Padding="16,0" Margin="4,0,0,0" AutomationProperties.Name="反选" Click="Inverse_Click"/>
     <Button x:Name="RemoveButton" Content="删除" Style="{StaticResource MeowFilm.QuietButton}"
             Background="{ThemeResource MeowFilm.Brush.InputSurface}" Height="32" MinHeight="32"
             Padding="16,0" Margin="4,0,0,0" AutomationProperties.Name="删除" Click="Remove_Click"/>
     <Button x:Name="MoreButton" Content="···" Style="{StaticResource MeowFilm.QuietButton}"
             Background="{ThemeResource MeowFilm.Brush.InputSurface}" Height="32" MinHeight="32"
             Padding="16,0" Margin="4,0,0,0" AutomationProperties.Name="批量更多操作" Click="More_Click"/>
    </StackPanel>
    <CheckBox x:Name="SelectAllCheck" Style="{StaticResource MeowFilm.ManagementCheck}"
              VerticalAlignment="Center" AutomationProperties.AutomationId="management.selectAll"
              Click="SelectAll_Click"/>
   </local:DockPanel>
  </Border>
 </Grid>
</UserControl>
