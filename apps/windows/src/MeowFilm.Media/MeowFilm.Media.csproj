<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <FilmKernelRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..\.cache\windows-film-kernel'))</FilmKernelRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MeowFilm.Threading/MeowFilm.Threading.csproj" />
    <ProjectReference Include="../MeowFilm.Core/MeowFilm.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(FilmKernelRoot)\output\FilmKernelBuild.g.cs" />
    <Content Include="$(FilmKernelRoot)\output\meowfilm_film_kernel.dll">
      <Link>film-kernel\meowfilm_film_kernel.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(FilmKernelRoot)\output\build-receipt.json">
      <Link>film-kernel\build-receipt.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="BuildFilmKernel" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\..\..\scripts\windows\build-film-kernel.ps1&quot; -Configuration $(Configuration)" />
  </Target>
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[1.8.260921001]" />
  </ItemGroup>
</Project>
