+/* hvcE export backported from FFmpeg 0834db516348d253b2c51f969188501d324c698d
+ * (LGPL-2.1-or-later). Kept separate from BL hvcC, including when hvcE comes first. */
+static int mov_read_hvce(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+{
+    AVStream *st = get_curr_st(c);
+    AVPacketSideData *sd;
+    int ret;
+
+    if (!st)
+        return 0;
+    if (atom.size < 23 || atom.size > INT_MAX - AV_INPUT_BUFFER_PADDING_SIZE)
+        return AVERROR_INVALIDDATA;
+
+    sd = av_packet_side_data_new(&st->codecpar->coded_side_data,
+                                 &st->codecpar->nb_coded_side_data,
+                                 AV_PKT_DATA_HEVC_CONF, atom.size, 0);
+    if (!sd)
+        return AVERROR(ENOMEM);
+    ret = ffio_read_size(pb, sd->data, atom.size);
+    return ret < 0 ? ret : 0;
+}
