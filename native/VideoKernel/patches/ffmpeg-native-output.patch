+/* Query on the decoding context while it still owns the actual session. */
+static int videotoolbox_hardware_decode(AVCodecContext *avctx)
+{
+    AVVideotoolboxContext *context = videotoolbox_get_context(avctx);
+    CFTypeRef value = NULL;
+    int result = -1;
+    if (!context || !context->session)
+        return -1;
+    if (VTSessionCopyProperty(context->session,
+                              kVTDecompressionPropertyKey_UsingHardwareAcceleratedVideoDecoder,
+                              kCFAllocatorDefault, &value) == noErr && value) {
+        if (CFGetTypeID(value) == CFBooleanGetTypeID())
+            result = CFBooleanGetValue(value);
+        CFRelease(value);
+    }
+    return result;
+}
