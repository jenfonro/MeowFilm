# Source-repository allowlist. Review new top-level source directories before adding them.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/build-ios.sh
!/build-windows.ps1
!/package.json
!/package-lock.json
!/LICENSES/
!/docs/
!/native/
!/apps/
!/packages/
!/scripts/
!/tests/
!/.github/

**/node_modules/
**/.npm-cache/
**/.cache/
**/.build/
**/.swiftpm/
**/DerivedData/
**/build/
**/dist/
**/xcuserdata/
**/*.xcuserstate
**/.DS_Store
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*.xcresult/
**/*.ipa
**/*.xcarchive/
**/.local/
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.mobileprovision
**/.ssh/
**/bin/
**/obj/
**/.vs/
**/TestResults/
**/*.user
**/*.suo