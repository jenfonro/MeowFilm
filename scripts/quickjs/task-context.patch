+/* Consumed by the trusted SDK before user code is installed. The host removes
+   the temporary global even for SDKs which do not use task contexts. */
+static JSValue qts_task_context(JSContext *ctx, JSValueConst this_val,
+                                int argc, JSValueConst *argv) {
+  JSRuntime *rt = JS_GetRuntime(ctx);
+  double value;
+  if (argc) {
+    if (!JS_IsNumber(argv[0]) || JS_ToFloat64(ctx, &value, argv[0]) < 0 ||
+        !isfinite(value) || value < 0 || value > 9007199254740991.0 ||
+        floor(value) != value) {
+      return JS_ThrowTypeError(ctx, "Invalid task context");
+    }
+    JS_SetAsyncContext(rt, value);
+  }
+  return JS_NewFloat64(ctx, JS_GetAsyncContext(rt));
+}
+
@@ -490,0 +508,10 @@
+  JSValue global = JS_GetGlobalObject(ctx);
+  JSValue task_context = JS_NewCFunction(ctx, qts_task_context, "", 0);
+  if (JS_IsException(task_context) ||
+      JS_DefinePropertyValueStr(ctx, global, "__meowTaskContext", task_context,
+                                JS_PROP_CONFIGURABLE) < 0) {
+    JS_FreeValue(ctx, global);
+    JS_FreeContext(ctx);
+    return NULL;
+  }
+  JS_FreeValue(ctx, global);
