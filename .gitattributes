# Stable source and documentation bytes across Windows and macOS.
*.md text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gypi text eol=lf
*.swift text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.patch text eol=lf
*.plist text eol=lf
*.entitlements text eol=lf
*.pbxproj text eol=lf
*.xcscheme text eol=lf
*.svg text eol=lf
*.txt text eol=lf
NOTICE text eol=lf
LICENSE text eol=lf
COPYING text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.xaml text eol=lf
*.ps1 text eol=lf
*.config text eol=lf
*.Config text eol=lf
*.manifest text eol=lf
# Preserve the exact pinned upstream license bytes, including its Apache URL indent.
LICENSES/node-LICENSE.txt whitespace=-space-before-tab
# The pinned QR generator license ends with an intentional extra newline.
LICENSES/qr-code-generator-LICENSE.txt whitespace=-blank-at-eof
# These pinned MIT texts retain their original CRLF bytes.
LICENSES/api-enhanced-MIT.txt -text whitespace=cr-at-eol
LICENSES/KuGouMusicApi-MIT.txt -text whitespace=cr-at-eol
# Preserve the pinned SkiaSharp package notices, including their original whitespace.
LICENSES/SkiaSharp-MIT.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
LICENSES/SkiaSharp-THIRD-PARTY-NOTICES.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Native engine sources are verified byte-for-byte, including on autocrlf hosts.
native/JavaScript/quickjs/* -text
native/JavaScript/*.c text eol=lf
